// Bundled rather than taken from the system, so the type is the same
// everywhere: IBM Plex Sans in the three weights the scale uses, and IBM Plex
// Mono for the times that tick. Their licence is in THIRD-PARTY.md.
import "../fonts/IBMPlexSans-Medium.ttf";
import "../fonts/IBMPlexSans-SemiBold.ttf";
import "../fonts/IBMPlexSans-Bold.ttf";
import "../fonts/IBMPlexMono-Medium.ttf";

// The design tokens, named for what they are for rather than for their
// values, so that changing a role is one edit.

/// Every duration the interface animates over, so that the Animations switch
/// on the accessibility page can turn all of them to zero at once. The two
/// tip delays are not motion, and keep their length.
export global Motion {
    /// The settings' Animations switch: written from the saved setting at
    /// startup and by the switch.
    in-out property <bool> chosen: true;
    /// Whether the desktop asks for less motion (see `platform::motion`).
    in-out property <bool> system-still: false;
    /// Whether anything moves: only if neither asks for stillness, since
    /// either is somebody saying motion is a problem for them.
    out property <bool> enabled: Motion.chosen && !Motion.system-still;

    /// The wash arriving under the pointer, for every hover highlight alike:
    /// one gesture at different speeds makes an interface feel loose. Short,
    /// because feedback that lands after the eye has moved on is missed.
    out property <duration> highlight: Motion.enabled ? 45ms : 0ms;
    /// A row's chevron or Play glyph leans the way the row goes while the pointer
    /// is on it. Slower than a highlight because motion is more noticeable.
    out property <duration> lean: Motion.enabled ? 90ms : 0ms;
    /// A track thickening under the pointer: the timeline, the volume, the
    /// sliders and the scroll bars.
    out property <duration> track-grow: Motion.enabled ? 100ms : 0ms;
    /// A surface fading in or out and rising the few pixels it travels: the
    /// panels, the bar, the flash, the tip. The glass fades with it.
    out property <duration> surface: Motion.enabled ? 120ms : 0ms;
    /// A switch's knob crossing its track, and the track's colour with it;
    /// the volume's fill fading with a mute.
    out property <duration> switch: Motion.enabled ? 120ms : 0ms;
    /// How long a pill stays up after its switch is pressed: the flip, and
    /// a beat to see it on, before the pill fades. Without animations, the
    /// beat alone.
    out property <duration> flip-seen: Motion.switch + 150ms;
    /// A page sliding sideways in a panel, and the panel's height with it.
    /// Longer than `surface` because it travels rather than arrives.
    out property <duration> drill: Motion.enabled ? 220ms : 0ms;
    /// A list carried to its current row by the way back to it. Longer than a
    /// drill because the distance can be a whole season, and at a drill's
    /// length the rows go past as a smear.
    out property <duration> glide: Motion.enabled ? 300ms : 0ms;

    /// How long the pointer rests on a control before its tip shows: long
    /// enough that crossing the bar raises nothing, short enough that stopping
    /// on an unfamiliar glyph feels answered.
    out property <duration> tip-delay: 500ms;
    /// How soon after a tip goes the next one shows without the delay. Once
    /// someone is reading along the bar, making each neighbour wait again
    /// turns it into a stutter.
    out property <duration> tip-grace: 300ms;
    /// How long a row armed by its first press waits for the second: long
    /// enough to read the new wording and press again, short enough that an
    /// armed row won't catch a press meant for something else.
    out property <duration> armed-for: 2500ms;
    /// How long an open runs before the way in says it is in flight: longer
    /// than a film on a local disk takes to start, which leaves the way in
    /// before the words could be read, and short enough that a folder still
    /// being read on a share is answered before the press seems lost.
    out property <duration> slow-open: 200ms;
}

/// Every colour in the interface: white at a few alphas, and one dark, for a
/// switch's knob and a field's well.
/// Kept in one place because values written at each use drift apart.
export global Paint {
    // --- text and glyphs ------------------------------------------------------
    //
    // Every word is the same full white. The glass is held dark enough for
    // the dimmest word to read on it over a bright frame (see
    // `legible_ceiling`), and any word a step under white held it darker than
    // the glass should look. Lit, Strong and Body name what a word is for, so
    // a call site says so; weight, size and place are what tell them apart on
    // screen. Below them, Quiet is for marks and Dim for a glyph with nowhere
    // to go, and neither is ever text.

    /// The active state, and where the pointer or the keyboard is: the current
    /// row, the flash, the end-of-file prompt. Also every bar glyph that can be
    /// pressed, which at a lower step reads as greyed out over a bright frame.
    out property <color> lit: #ffffff;
    /// Text that leads: the media title, times and values, a fatal headline;
    /// and a resume measure's fill and an off switch's knob.
    out property <color> strong: #ffffff;
    /// Every other word: row labels, section headings, a show's name, a row's
    /// icon, and what sits beside or under them, such as a shortcut's keys, a
    /// row's running time and the prose hints. The lowest step of text, which
    /// the glass's ceiling is worked out from.
    out property <color> body: #ffffff;
    /// A mark on or beside a track: a chapter's dot or the volume's unity
    /// dot ahead of the fill, which is cut round it rather than drawn over it;
    /// a scroll thumb.
    out property <color> quiet: #ffffffa0;
    /// A bar button with nowhere to go, the one mark meant to look greyed out.
    out property <color> dim: #ffffff80;

    // --- marks ------------------------------------------------------------------

    /// The played length of the timeline: the one near-solid white, so it
    /// reads as a measurement rather than as text.
    out property <color> played: #fffffff2;
    /// The filled length of a slider or the volume; a lit switch track.
    out property <color> fill: #ffffffcc;
    /// The unfilled length of every track, switch and measure, and the rim
    /// round a field's well.
    out property <color> rail: #ffffff2e;
    /// Dark on a lit switch track, so the knob reads as a hole punched in it.
    out property <color> knob: #101010e6;
    /// A field's well, the slot words are typed into: a smoke of the knob's
    /// dark over the glass, which darkens what is under it by the same share
    /// over every frame, so the frame still shows through and the words stand
    /// further off it than off the glass.
    out property <color> well: #1010104d;
    /// The window before a frame exists.
    out property <color> ground: #000000;

    // --- washes -----------------------------------------------------------------
    //
    // The pointer's, an open panel's and the keyboard's are 0x20 apart, like
    // the text steps. Any closer and, over moving video, hover and focus look
    // alike and nothing shows which row Enter will press.

    /// Where the keyboard is, on a row or a pill's choice. A wash rather than
    /// a ring, because nothing in the interface draws an outline but a
    /// field's rim; on a bar button it also stands on a disc of glass of its
    /// own.
    out property <color> wash-ring: #ffffff54;
    /// A button whose panel is open, a hovered stepper disc. A step under the
    /// ring's, so the button a panel came from and the keyboard's place can't
    /// be taken for each other.
    out property <color> wash-strong: #ffffff34;
    /// A hovered icon button, a stepper's disc at rest, or a choice on the
    /// end-of-file pill. Never a row's, so it never has to be told apart from
    /// the row washes.
    out property <color> wash-button: #ffffff24;
    /// A hovered row of any kind; a scroll bar's rail.
    out property <color> wash-soft: #ffffff14;

    // --- on the keyboard's ring --------------------------------------------------
    //
    // Under glass the ring is milk glass, lighter than the glass around it
    // over every frame, so what stands on it is drawn dark, as the knob is on
    // a lit switch track: the marks above, turned over. With no glass the ring
    // is its wash, and what stands on it keeps the colours above.

    /// Whether the panes are drawn as glass, which the driver says: switched
    /// off, or with nothing to draw them after a failure, they are not.
    in-out property <bool> glass: true;
    /// Words, glyphs, fills and the active mark on the ring.
    out property <color> on-ring: Paint.glass ? Paint.knob : Paint.lit;
    /// A rail on the ring, a well and its rim, or a disc at rest.
    out property <color> on-ring-rail: Paint.glass ? #1010102e : Paint.rail;
    /// A wash on the ring: a hovered disc, the question a remove asks.
    out property <color> on-ring-wash: Paint.glass ? #10101034 : Paint.wash-strong;
    /// A lit switch's knob on the ring, light on its dark track.
    out property <color> on-ring-knob: Paint.glass ? Paint.lit : Paint.knob;
}

/// The type scale, as roles rather than sizes, so a role can change without
/// finding every literal. Roles that share a size are told apart by weight,
/// or by one being figures and the other prose.
///
/// The floor is 12px, and only for capitals, which are read by their shape.
/// Smaller white text over moving video is recognised rather than read, which
/// is no use for a number that changes.
export global Type {
    /// The interface's family, in the three weights below.
    out property <string> face: "IBM Plex Sans";
    /// Times that tick: the two ends of the timeline and the time over the
    /// seek preview. Monospaced so a counting figure keeps its width instead
    /// of shuffling sideways every second.
    out property <string> numerals: "IBM Plex Mono";
    /// 600. The media title, a notice from the flash, a fatal headline. (The
    /// row that is playing is body size at 700; see `MenuRow`.)
    out property <length> title: 14px;
    /// 500. Row labels, menu items, switch labels: anything that names
    /// something you can press.
    out property <length> body: 14px;
    /// 500. A playlist heading that carries a show's name: a section label's
    /// weight and alpha, but in its own case and size and untracked, because
    /// it is the user's word rather than the interface's.
    out property <length> named: 13px;
    /// 500. Figures: timestamps, slider and stepper values, a row's running
    /// time, a shortcut's keys. Also the labels of the dense rows those sit
    /// in, which read as part of the same line rather than as menu entries.
    out property <length> readout: 13px;
    /// 500. Prose under something else: the drop hint, the line under a
    /// failure saying what usually fixes it. A readout's size under its own
    /// name, because prose is what would want a different size first.
    out property <length> hint: 13px;
    /// 500, capitals, tracked. Section headings, and the way back out of
    /// a page.
    out property <length> label: 12px;
    /// Tracking for `label` only. The air between the capitals is what marks
    /// them as a label, which lets them sit at the body's weight: at 700 a
    /// label put more ink on screen than the rows under it, and read as a
    /// heading.
    out property <length> label-track: 1px;
    /// A character standing in for an icon: the stepper's minus and plus.
    /// Sized against the disc it sits in (`Rows.stepper-disc`), not against
    /// the text.
    out property <length> glyph: 16px;
    /// The word on the end-of-file pill, said louder than a row, sized
    /// against the full-size arrow beside it.
    out property <length> prompt: 16px;
    /// 600. The words beside the flash's glyph, in the middle of the
    /// picture: the largest words here, because they are read in a
    /// glance over a moving film, often from across the room.
    out property <length> callout: 18px;

    /// The only three weights the bundled files carry. Plain is Medium,
    /// because at 400 the 13–14px lines read thin over glass, and Plex's 450
    /// Text weight was not quite enough.
    out property <int> weight-plain: 500;
    /// Title, Prompt and Callout, and the way in's *Continue*.
    out property <int> weight-title: 600;
    /// The current row in a list.
    out property <int> weight-current: 700;
}

/// The two sizes the icon set is shown at: the one its 24×24 drawings are
/// made for, and three quarters of it. Both keep the drawings' 2px line on
/// whole and half pixels; at any other size it falls off the pixel grid and
/// blurs, so a smaller size needs its own drawing.
export global Icons {
    /// A glyph standing on its own: the bar's buttons and the window's, the
    /// end-of-file pill's choices, the flash.
    out property <length> full: 24px;
    /// A glyph beside words in a row: its icon, chevron or warning, and a
    /// heading's mark, although a heading's words are smaller.
    out property <length> row: 18px;
    /// A switch, as wide as the settings draw it, where a pill's choice
    /// turns one on in place of its glyph.
    out property <length> switch: 34px;
}

/// How thick the tracks are drawn. Each one a hand can take thickens by
/// `grow` under the pointer or a drag, about its centre line, so every track
/// answers the hand alike.
export global Rails {
    /// The bar's timeline and volume.
    out property <length> bar: 5px;
    /// A slider in a panel: thinner than the bar's, because it sits inside a
    /// panel of rows rather than alone on glass.
    out property <length> slider: 4px;
    /// A resume measure, which nothing drags, so it never grows.
    out property <length> measure: 4px;
    /// A scroll bar.
    out property <length> scroll: 3px;
    out property <length> grow: 2px;
}

export global Panels {
    /// The gap, so the end rows sit as far from the panel's top and bottom
    /// as every row does from its sides.
    out property <length> pad: Rows.gap;
    out property <length> radius: Rows.radius + Rows.gap;
}

/// Metrics for the rows and the washes behind them.
///
/// A row spans its panel's width, but the panel's glass has rounded corners,
/// so a full-width wash would leak past the glass on the first and last row.
/// The wash is inset and rounded to keep it on the glass, as a native menu's is.
export global Rows {
    // The wash is inset by `gap` on every side, so a panel radius of
    // `radius + gap` keeps the end rows' corners concentric with the panel's,
    // and every row in between matches them. Any other radius and the gap
    // pinches at 45°. Change `radius` or `gap`.
    out property <length> radius: 16px;
    out property <length> gap: 16px;
    out property <length> pad: 14px;

    /// Where a label starts and a trailing control ends, from the panel edge,
    /// so text sits inside the wash rather than on its rim.
    out property <length> label-x: Rows.gap + Rows.pad;
    out property <length> trail-x: Rows.gap + Rows.pad;
    /// Between a row's icon and its words: a drill row's, and the rows laid
    /// out like one, a way back and Continue.
    out property <length> drill-gap: 14px;
    /// Between the parts of the two denser rows: a slider's icon, name, track
    /// and value, and a stepper's icon, name, discs and value.
    out property <length> dense-gap: 14px;
    /// Between a row's words and the keys after them, which a tip keeps too,
    /// since a tip is one row of the shortcuts list.
    out property <length> keys-gap: 12px;
    /// How far a row's chevron or Play glyph leans the way the row goes while
    /// the pointer is on it. Words and glyphs are already full white, so a
    /// hover can't light them; a lean is a change you see without one.
    out property <length> lean: 2px;
    /// Space before a row that isn't part of the list above it, such as a
    /// reset or a setting about the list, so it isn't read as one more entry.
    /// The row gap, since that is already the space between ideas.
    out property <length> group-gap: Rows.gap;
    /// The trailing columns a list's rows line up: a remove button's disc, a
    /// running time's column at its narrowest (an hour-long time), and a
    /// drill row's chevron with its gap. Here so a panel can add up how wide
    /// its rows ask to be.
    out property <length> bin: 28px;
    out property <length> time-col: 48px;
    out property <length> chevron-col: Icons.row + Rows.drill-gap;
    /// A stepper's minus and plus discs, and how wide it sets its value
    /// unless the row asks for more or less room.
    out property <length> stepper-disc: 26px;
    out property <length> stepper-value: 62px;
    /// A resume measure's length. Fixed rather than a share of the row, so it
    /// reads the same at any panel width and never grows into a rule; shorter
    /// than any likely title, so it doesn't read as part of the words.
    out property <length> measure: 44px;

    /// The air one surface keeps from the next: a panel or the hover label
    /// above the timeline, the credits pill above it, a notice beside the
    /// panel it answers, the seek preview beside a panel.
    out property <length> offset: 12px;
    /// How far into a scrolling list its end blurs and thins away, where rows
    /// run on past it: several rows deep, so the list is seen running on
    /// rather than ending at a line. The keyboard's ring keeps this much list
    /// ahead of it (`ScrollList.reveal`), so it never stands in the blur.
    out property <length> fade: 96px;
    /// How far a list runs on up under the heading or way back over it, and
    /// down into the gap before rows that follow it. The player draws the
    /// heading over the soft edge (`HeadMark`), so the rows thin away under
    /// its words rather than taking them along.
    out property <length> tuck: Rows.heading;

    /// The row heights. Here rather than in `MainWindow` because components
    /// outside it can't see its properties.
    out property <length> row: 34px;
    /// A heading over a group of rows.
    out property <length> heading: 28px;
    /// One line of the Hint role, for a `NoteRow` to be as many of tall as
    /// it may wrap to.
    out property <length> note-line: 18px;
    /// A film the way in offers: a row's line, and a hint's under it for
    /// what the film belongs to and how much of it is left.
    out property <length> resume-row: Rows.row + Rows.note-line;
    /// The two denser rows on the settings pages: a slider, which is a label
    /// and a track, and a stepper, which is a label and two discs.
    out property <length> slider-row: 30px;
    out property <length> stepper-row: 38px;
    /// A row carrying a switch, taller than a list row because the switch is
    /// taller than a line of text.
    out property <length> toggle-row: 40px;

}

/// The bar's fixed sizes, which the pills over the picture share so they
/// stand as tall as its row of buttons.
///
/// Every length the bar is placed by is arithmetic on these and the window's
/// width, never read from a layout: the glass is sampled every frame, and a
/// binding that depends on a layout forces a full layout pass each time it is
/// read, which dragged resizing down to 4fps.
export global Bar {
    /// How far one notch of a mouse wheel scrolls, as Slint reports it. The
    /// wheel's handlers take a step a notch, adding up the small amounts a
    /// touchpad sends, which would otherwise each take a whole step.
    out property <length> notch: 60px;
    out property <length> btn: 40px;
    /// The air either side of a button's glyph.
    out property <length> btn-air: (Bar.btn - Icons.full) / 2;
    out property <length> btn-gap: 6px;
    out property <length> pill-pad: 4px;
    out property <length> vol-w: 96px;
    /// Inset for text at the end of a row of buttons: after the title, and
    /// in the end-of-file and credits pills, where `pill-pad` would run the
    /// words into the capsule's curve.
    out property <length> pill-text-pad: 18px;
    out property <length> pill-h: Bar.btn + 2 * Bar.pill-pad;
    out property <length> pill-radius: Bar.pill-h / 2;
    out property <length> pill-gap: 10px;
    /// Between a pill choice's glyph and its words.
    out property <length> choice-gap: 12px;
    /// Shorter than the row of buttons under it, since it holds a line of
    /// type rather than a glyph.
    out property <length> timeline-h: 30px;
    /// How far in from the bar's ends the end buttons' drawings start: the
    /// row's padding, the air round the glyph in its button, and the 1px the
    /// icon set leaves round each drawing.
    out property <length> glyph-inset: Bar.pill-pad + Bar.btn-air + 1px;
    /// The glass round the bar's rows, on every side: as much as takes the
    /// end buttons' corner out to the panels', so the bar's corner is
    /// concentric with them and the same as the panels'.
    out property <length> pad: Panels.radius - Bar.pill-radius;
    out property <length> height: 2 * Bar.pad + Bar.timeline-h + Bar.pill-h;
}

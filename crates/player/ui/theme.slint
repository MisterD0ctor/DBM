// Bundled rather than taken from the system, so the type is the same
// everywhere: IBM Plex Sans in the three weights the scale uses, and IBM Plex
// Mono for the times that tick. Their licence is in THIRD-PARTY.md.
import "../fonts/IBMPlexSans-Medium.ttf";
import "../fonts/IBMPlexSans-SemiBold.ttf";
import "../fonts/IBMPlexSans-Bold.ttf";
import "../fonts/IBMPlexMono-Medium.ttf";

// The design tokens, named for what they are for rather than for their
// values, so that changing a role is one edit.

/// Every duration the interface animates over, so that the Animations switch
/// on the accessibility page can turn all of them to zero at once. The two
/// tip delays are not motion, and keep their length.
export global Motion {
    /// Written only from the saved setting at startup and by the switch.
    in-out property <bool> enabled: true;

    /// The wash arriving under the pointer, for every hover highlight alike:
    /// one gesture at different speeds makes an interface feel loose. Short,
    /// because feedback that lands after the eye has moved on is missed.
    out property <duration> highlight: Motion.enabled ? 45ms : 0ms;
    /// A track thickening under the pointer: the timeline, the volume, the
    /// sliders and the scroll bars.
    out property <duration> track-grow: Motion.enabled ? 100ms : 0ms;
    /// A surface fading in or out and rising the few pixels it travels: the
    /// panels, the bar, the flash, the tip. The glass fades with it.
    out property <duration> surface: Motion.enabled ? 120ms : 0ms;
    /// A switch's knob crossing its track, and the track's colour with it.
    out property <duration> switch: Motion.enabled ? 120ms : 0ms;
    /// The title pill resizing to a new title, so a file change doesn't make
    /// it jump.
    out property <duration> title-width: Motion.enabled ? 160ms : 0ms;
    /// A page sliding sideways in a panel, and the panel's height with it.
    /// Longer than `surface` because it travels rather than arrives.
    out property <duration> drill: Motion.enabled ? 220ms : 0ms;
    /// A list carried to its current row by the way back to it. Longer than a
    /// drill because the distance can be a whole season, and at a drill's
    /// length the rows go past as a smear.
    out property <duration> glide: Motion.enabled ? 300ms : 0ms;

    /// How long the pointer rests on a control before its tip shows: long
    /// enough that crossing the bar raises nothing, short enough that stopping
    /// on an unfamiliar glyph feels answered.
    out property <duration> tip-delay: 500ms;
    /// How soon after a tip goes the next one shows without the delay. Once
    /// someone is reading along the bar, making each neighbour wait again
    /// turns it into a stutter.
    out property <duration> tip-grace: 300ms;
}

/// Every colour in the interface: white at a few alphas, and one dark knob.
/// Kept in one place because values written at each use drift apart.
export global Paint {
    // --- text and glyphs ------------------------------------------------------
    //
    // Every word is on one of two steps, Lit or the one Strong and Body share,
    // because the glass is held dark enough for the lowest step of text to
    // read on it over a bright frame (see `legible_ceiling`), and a dimmer
    // step held it darker than the glass should look. Below them, Quiet is for
    // marks and Dim for a glyph with nowhere to go, and neither is ever text.
    //
    // Roles that already differ by place, case, size or tracking share a step
    // rather than get a near-copy of one.

    /// The active state, and where the pointer or the keyboard is: the current
    /// row, a hovered chevron, the flash, the end-of-file prompt. Also every bar
    /// glyph that can be pressed, which at a lower step reads as greyed out
    /// over a bright frame.
    out property <color> lit: #ffffff;
    /// Text that leads: the media title, times and values, a fatal headline,
    /// and a resume measure's fill.
    out property <color> strong: #ffffff;
    /// Every other word: row labels, section headings, a show's name, a row's
    /// icon, and what sits beside or under them, such as a shortcut's keys, a
    /// row's running time and the prose hints. The lowest step of text, which
    /// the glass's ceiling is worked out from.
    out property <color> body: #ffffff;
    /// A mark on or beside a track: a chapter's dot ahead of the played
    /// length, the volume's unity dot off the fill, a scroll thumb.
    out property <color> quiet: #ffffffa0;
    /// A bar button with nowhere to go, the one mark meant to look greyed out.
    out property <color> dim: #ffffff80;

    // --- marks ------------------------------------------------------------------

    /// The played length of the timeline: the one near-solid white, so it
    /// reads as a measurement rather than as text.
    out property <color> played: #fffffff2;
    /// The filled length of a slider or the volume; a lit switch track.
    out property <color> fill: #ffffffcc;
    /// The unfilled length of every track, switch and measure.
    out property <color> rail: #ffffff2e;
    /// Dark on a lit switch track, so the knob reads as a hole punched in it.
    out property <color> knob: #101010e6;
    /// The window before a frame exists.
    out property <color> ground: #000000;

    // --- washes -----------------------------------------------------------------
    //
    // The pointer's, an open panel's and the keyboard's are 0x20 apart, like
    // the text steps. Any closer and, over moving video, hover and focus look
    // alike and nothing shows which row Enter will press.

    /// Where the keyboard is, on a row or a pill's choice. A wash rather than
    /// a ring, because nothing else in the interface draws an outline; on a
    /// bar button it also stands on a disc of glass of its own.
    out property <color> wash-ring: #ffffff54;
    /// A button whose panel is open, a hovered stepper disc. A step under the
    /// ring's, so the button a panel came from and the keyboard's place can't
    /// be taken for each other.
    out property <color> wash-strong: #ffffff34;
    /// A hovered icon button, or a choice on the end-of-file pill. Never on a
    /// row, so it never has to be told apart from the row washes.
    out property <color> wash-button: #ffffff24;
    /// A hovered row of any kind; a stepper disc at rest; a scroll bar's rail.
    out property <color> wash-soft: #ffffff14;
}

/// The type scale, as roles rather than sizes, so a role can change without
/// finding every literal. Roles that share a size are told apart by weight,
/// or by one being figures and the other prose.
///
/// The floor is 12px, and only for capitals, which are read by their shape.
/// Smaller white text over moving video is recognised rather than read, which
/// is no use for a number that changes.
export global Type {
    /// The interface's family, in the three weights below.
    out property <string> face: "IBM Plex Sans";
    /// Times that tick: the two ends of the timeline and the time over the
    /// seek preview. Monospaced so a counting figure keeps its width instead
    /// of shuffling sideways every second.
    out property <string> numerals: "IBM Plex Mono";
    /// 600. The media title, the flash, a fatal headline. (The row that is
    /// playing is body size at 700; see `MenuRow`.)
    out property <length> title: 14px;
    /// 500. Row labels, menu items, switch labels: anything that names
    /// something you can press.
    out property <length> body: 14px;
    /// 500. A playlist heading that carries a show's name: a section label's
    /// weight and alpha, but in its own case and size and untracked, because
    /// it is the user's word rather than the interface's.
    out property <length> named: 13px;
    /// 500. Figures: timestamps, slider and stepper values, a row's running
    /// time, a shortcut's keys. Also the labels of the dense rows those sit
    /// in, which read as part of the same line rather than as menu entries.
    out property <length> readout: 13px;
    /// 500. Prose under something else: the drop hint, the line under a
    /// failure saying what usually fixes it. A readout's size under its own
    /// name, because prose is what would want a different size first.
    out property <length> hint: 13px;
    /// 500, capitals, tracked. Section headings, and the way back out of
    /// a page.
    out property <length> label: 12px;
    /// Tracking for `label` only. The air between the capitals is what marks
    /// them as a label, which lets them sit at the body's weight: at 700 a
    /// label put more ink on screen than the rows under it, and read as a
    /// heading.
    out property <length> label-track: 1px;
    /// A character standing in for an icon: the stepper's minus and plus.
    /// Sized against the 26px disc it sits in, not against the text.
    out property <length> glyph: 16px;
    /// The one thing said louder than the rest: the word on the end-of-file
    /// pill, sized against the 24px arrow beside it.
    out property <length> prompt: 16px;

    /// The only three weights the bundled files carry. Plain is Medium,
    /// because at 400 the 13–14px lines read thin over glass, and Plex's 450
    /// Text weight was not quite enough.
    out property <int> weight-plain: 500;
    /// Title and Prompt.
    out property <int> weight-title: 600;
    /// The current row in a list.
    out property <int> weight-current: 700;
}

/// Metrics for the rows and the washes behind them.
///
/// A row spans its panel's width, but the panel's glass has rounded corners,
/// so a full-width wash would leak past the glass on the first and last row.
/// The wash is inset and rounded to keep it on the glass, as a native menu's is.
export global Rows {
    // The wash is inset by `gap` on every side, so a panel radius of
    // `radius + gap` keeps the end rows' corners concentric with the panel's,
    // and every row in between matches them. Any other radius and the gap
    // pinches at 45°. Change `radius` or `gap`, and `panel-radius` follows.
    out property <length> radius: 16px;
    out property <length> gap: 16px;
    out property <length> panel-radius: Rows.radius + Rows.gap;
    /// The gap, so the end rows sit as far from the panel's top and bottom
    /// as every row does from its sides.
    out property <length> panel-pad: Rows.gap;

    /// Where a label starts and a trailing control ends, from the panel edge,
    /// so text sits inside the wash rather than on its rim.
    out property <length> label-x: Rows.gap + 14px;
    out property <length> trail-x: Rows.gap + 10px;
    /// Space before a row that isn't part of the list above it, such as a
    /// reset or a setting about the list, so it isn't read as one more entry.
    /// The row gap, since that is already the space between ideas.
    out property <length> group-gap: Rows.gap;

    /// The air one surface keeps from the next: a panel or the hover label
    /// above the timeline, the credits pill above it, the flash's caption
    /// under its ring, the seek preview beside a panel.
    out property <length> offset: 12px;
    /// How much of a scrolling list's end blurs and thins away where rows run
    /// on past it: short enough that the row above is whole, long enough that
    /// the row in it is plainly leaving.
    out property <length> fade: 28px;

    /// The row heights. Here rather than in `MainWindow` because components
    /// outside it can't see its properties.
    out property <length> row: 34px;
    /// A heading over a group of rows.
    out property <length> heading: 28px;
    /// The two denser rows on the settings pages: a slider, which is a label
    /// and a track, and a stepper, which is a label and two discs.
    out property <length> slider-row: 30px;
    out property <length> stepper-row: 38px;
    /// A row carrying a switch, taller than a list row because the switch is
    /// taller than a line of text.
    out property <length> toggle-row: 40px;

}

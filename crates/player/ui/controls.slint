// Controls that are not rows: the icon buttons, a stepper's discs, and the
// choices on the end-of-file pill.

import { Chrome, Tip } from "globals.slint";
import { Bar, Icons, Motion, Paint, Rows, Type } from "theme.slint";
import { RingPane } from "ring.slint";
import { Squircle } from "squircle.slint";

/// The colours a `Glyph` comes in, each `Paint`'s of the same name.
export enum Shade { lit, on-ring, dim }

/// A glyph in one of the interface's fixed colours: a picture per colour, the
/// one wanted shown, rather than one picture recoloured.
///
/// Slint draws a recoloured picture into a texture of its own, and draws it
/// again whenever anything its colour was worked out from changes, even to
/// the same colour. A ring hangs on where the keyboard is and the bar's on
/// whether a panel is open, so recoloured, every panel opening would draw
/// every glyph on the bar and in the panel again, a texture and a framebuffer
/// each: 6ms of the opening's first frame here, where these take under one
/// (`DBM_FIRST_OPEN`). These never change colour.
export component Glyph inherits Rectangle {
    in property <image> source;
    in property <Shade> shade;

    for glyph in [
        { shade: Shade.lit, colour: Paint.lit },
        { shade: Shade.on-ring, colour: Paint.on-ring },
        { shade: Shade.dim, colour: Paint.dim },
    ]: Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: contain;
        colorize: glyph.colour;
        visible: root.shade == glyph.shade;
    }
}

/// A round glyph button: the bar's, and the window's own at its top.
///
/// A state the button controls, like mute, is shown by the caller swapping
/// `icon`, not by a wash: on a bar of controls a wash read as chrome rather
/// than as the state.
export component IconButton inherits Rectangle {
    in property <image> icon;
    /// The panel this button opens is showing, so its wash is held.
    in property <bool> open;
    /// Any size but the one the icon set is drawn for resamples it.
    in property <length> glyph: Icons.full;
    /// What this button is called, and the key that does the same thing.
    /// A button with no `tip` shows none rather than an empty one.
    in property <string> tip;
    in property <string> keys;
    /// Whether the keyboard is on this button: the bar's own ring, reached
    /// with Tab while nothing is open.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    /// Whether pressing it would do anything, such as Previous on a
    /// playlist's first file. A disabled button is dimmed, so it doesn't
    /// promise what it can't do.
    in property <bool> enabled: true;
    /// Whether the pointer is on it, which holds up what it stands on.
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: Bar.btn;
    height: Bar.btn;
    border-radius: self.height / 2;
    // Under glass the ring and the open state are the disc the window lays
    // under the button (`MainWindow.ring-disc`, `MainWindow.open-disc`).
    background: root.ring ? (Paint.glass ? transparent : Paint.wash-ring)
        : root.open ? (Paint.glass ? transparent : Paint.wash-strong)
        : touch.has-hover && root.enabled ? Paint.wash-button
        : transparent;
    animate background { duration: Motion.highlight; easing: ease-out; }

    accessible-role: button;
    accessible-label: root.tip;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    Glyph {
        source: root.icon;
        width: root.glyph;
        height: root.glyph;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        // Lit whenever it can be pressed, because over a bright frame
        // anything less reads as greyed out; dark on the milk disc the window
        // lays under the ring or an open panel's button.
        shade: !root.enabled ? Shade.dim : root.ring || root.open ? Shade.on-ring : Shade.lit;
    }

    // The keyboard gets the same tip as the pointer, or a bar walked with Tab
    // would be unnamed marks.
    changed ring => {
        if (root.tip == "") {
            return;
        }
        if (root.ring) {
            root.tip-claim = Tip.point(root.tip, root.keys, root.tip-cx);
        } else {
            Tip.release(root.tip-claim);
        }
    }

    // A name that changes while it is up (Fullscreen becoming Leave
    // fullscreen from the F key) is put up again rather than left stale.
    changed tip => {
        if (Tip.seq == root.tip-claim) {
            root.tip-claim = Tip.point(root.tip, root.keys, root.tip-cx);
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        // `moved` only fires while a button is held, so plain hovering has
        // to come through `pointer-event`.
        pointer-event(event) => {
            Chrome.pointed(event.kind == PointerEventKind.down);
        }
        clicked => {
            // Pressing answers the question, and a tip left over the result
            // hides it. It comes back on the next arrival, as a native
            // tooltip does.
            Tip.release(root.tip-claim);
            if (root.enabled) {
                root.clicked();
            }
        }

        // On arrival and departure rather than bound, so `absolute-position`,
        // which costs a layout query, is read when the hand moves rather than
        // every frame.
        //
        // Sliding along the bar fires the next button's arrival and this
        // one's departure in no promised order, so leaving releases only this
        // button's claim and can't take down the next one's tip.
        changed has-hover => {
            if (root.tip == "") {
                return;
            }
            if (self.has-hover) {
                root.tip-claim = Tip.point(root.tip, root.keys, root.tip-cx);
            } else {
                Tip.release(root.tip-claim);
            }
        }
    }

    private property <length> tip-cx:
        root.absolute-position.x + root.width / 2;
    /// This button's claim on the tip, from `Tip.point`; -1 until it has
    /// put one up.
    private property <int> tip-claim: -1;
}

/// One end of a stepper, as a component so `StepperRow` doesn't hold two
/// copies of it.
export component StepButton inherits Rectangle {
    in property <string> glyph;
    /// The ring is on its row, which lights everything in it.
    in property <bool> lit;
    callback clicked();

    accessible-role: button;
    accessible-label: root.glyph == "+" ? @tr("Increase") : @tr("Decrease");
    accessible-action-default => {
        root.clicked();
    }

    width: Rows.stepper-disc;
    height: Rows.stepper-disc;
    border-radius: self.height / 2;
    background: root.lit ? (touch.has-hover ? Paint.on-ring-wash : Paint.on-ring-rail)
        : touch.has-hover ? Paint.wash-strong : Paint.wash-button;
    animate background { duration: Motion.highlight; easing: ease-out; }

    Text {
        text: root.glyph;
        color: root.lit ? Paint.on-ring : Paint.strong;
        font-size: Type.glyph;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed(event.kind == PointerEventKind.down);
        }
        clicked => {
            root.clicked();
        }
    }
}

/// A switch as the settings draw it: a rail, and a knob that is at the end
/// it is on, in the ring's colours while the keyboard is on it.
///
/// Pictures rather than rounded rectangles, because the renderer draws a
/// rounded corner as a few straight chords, and at 18px a capsule's ends
/// came to a point. A picture is rendered at the size it is shown, curve and
/// all.
export component SwitchMark inherits Rectangle {
    in property <bool> checked;
    in property <bool> ring;
    /// The rail showing round the knob.
    property <length> inset: 2px;

    width: Icons.switch;
    height: 18px;

    Image {
        width: 100%;
        height: 100%;
        source: @image-url("shapes/switch-track.svg");
        colorize: root.checked ? (root.ring ? Paint.on-ring : Paint.fill)
            : (root.ring ? Paint.on-ring-rail : Paint.rail);
        animate colorize { duration: Motion.switch; easing: ease-out; }
    }
    knob := Image {
        x: root.checked ? root.width - self.width - root.inset : root.inset;
        y: root.inset;
        width: root.height - 2 * root.inset;
        height: self.width;
        source: @image-url("shapes/switch-knob.svg");
        // Dark on the lit track, light on the dark one: the knob reads as a
        // hole punched in the switch either way. Full white off, since over a
        // bright frame the rail's track all but sinks into the glass and the
        // knob is what is left to read the switch by.
        colorize: root.checked ? (root.ring ? Paint.on-ring-knob : Paint.knob)
            : (root.ring ? Paint.on-ring : Paint.strong);
        animate x { duration: Motion.switch; easing: ease-out; }
    }
}

/// What leads a pill's choice: its glyph, or the switch the choice turns on.
export enum ChoiceMark {
    glyph,
    /// The switch as offered, before the choice is pressed.
    switch-off,
    /// The switch once pressed, turning on as the pill goes.
    switch-on,
}

/// One thing the end-of-file pill offers. A capsule of its own, so that when
/// there are two, each lights under the pointer rather than the whole pill.
export component EndChoice inherits Rectangle {
    in property <ChoiceMark> mark: ChoiceMark.glyph;
    /// Shown while `mark` is the glyph.
    in property <image> icon;
    in property <string> label;
    /// Where the words start, from this capsule's own edge.
    in property <length> pad;
    in property <length> gap;
    /// Whether the keyboard is on this choice, which is part of the bar's Tab
    /// walk while the pill is up.
    in property <bool> focused;
    /// How far inside the pill's glass it sits, so its corners follow the
    /// pill's: zero when it fills the pill, the pill's padding when it shares
    /// it with another.
    in property <length> inset;
    /// How much of the capsule a count has filled from its start, 0 to 1:
    /// the credits pill counting down to going on by itself.
    in property <float> filled;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    callback picked();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.picked();
    }

    Squircle {
        radius: root.height / 2;
        inset: root.inset;
        fill: root.ring ? (Paint.glass ? transparent : Paint.wash-ring)
            : touch.has-hover ? Paint.wash-button
            : transparent;
        animate fill { duration: Motion.highlight; easing: ease-out; }
    }

    // As under a row: the ring is this pane of milk glass, and its wash is
    // only for when there is no glass.
    RingPane {
        radius: root.height / 2;
        on: root.ring;
    }

    // A whole capsule's wash clipped to the share counted, so the start
    // keeps the capsule's curve.
    Rectangle {
        x: 0px;
        width: root.filled * root.width;
        visible: root.filled > 0;
        clip: true;

        Squircle {
            x: 0px;
            width: root.width;
            radius: root.height / 2;
            inset: root.inset;
            fill: root.ring ? Paint.on-ring-wash : Paint.wash-button;
        }
    }

    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: root.gap;
        alignment: center;

        if root.mark == ChoiceMark.glyph: glyph := Glyph {
            source: root.icon;
            width: Icons.full;
            height: Icons.full;
            y: (parent.height - self.height) / 2;
            shade: root.ring ? Shade.on-ring : Shade.lit;
        }
        if root.mark != ChoiceMark.glyph: Rectangle {
            width: Icons.switch;

            SwitchMark {
                y: (parent.height - self.height) / 2;
                checked: root.mark == ChoiceMark.switch-on;
                ring: root.ring;
            }
        }
        Text {
            text: root.label;
            color: root.ring ? Paint.on-ring : Paint.lit;
            font-size: Type.prompt;
            font-weight: Type.weight-title;
            vertical-alignment: center;
            // The parent caps the capsule's width, so a longer name elides
            // rather than running out through the rim.
            overflow: elide;
            min-width: 0px;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed(event.kind == PointerEventKind.down);
        }
        clicked => {
            Chrome.bump();
            root.picked();
        }
    }
}

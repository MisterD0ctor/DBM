// A list that scrolls, for the panels whose rows can outgrow the window.

import { Chrome } from "globals.slint";
import { Motion, Paint, Rows } from "theme.slint";

/// A list that scrolls when it is handed less height than its content needs.
///
/// The height comes from the caller and the content height is arithmetic on
/// the row count, so nothing here has to measure anything — which keeps panel
/// geometry a calculation rather than a layout query, for the reason given at
/// the top of `MainWindow`.
export component ScrollList inherits Rectangle {
    /// What the rows add up to, unconstrained.
    in property <length> content-height;
    /// How far the list has been scrolled, as the negative offset Flickable
    /// keeps. Exposed so a test can confirm the wheel reaches it — there is
    /// otherwise nothing on screen a test can read.
    out property <length> offset: flick.viewport-y;

    clip: true;

    /// Bring one row into view, by its top and height inside the list.
    ///
    /// Called when the keyboard moves rather than bound to anything: the
    /// pointer owns this list the rest of the time, and a binding on
    /// `viewport-y` would take the flick and the wheel away from it. Scrolls
    /// by the least that works, so arrowing down a long list walks the
    /// bottom edge instead of jumping the row to the middle.
    public function reveal(top: length, h: length) {
        if (top < -flick.viewport-y) {
            flick.viewport-y = -top;
        } else if (top + h > -flick.viewport-y + root.height) {
            flick.viewport-y = root.height - top - h;
        }
    }

    /// Put one row in the middle, as far as the ends of the list allow.
    ///
    /// For a panel opening, rather than a ring moving. The least scroll that
    /// shows a row lands it on the bottom edge, which is right for a walk and
    /// wrong for an arrival: the episode you are on belongs with the ones
    /// either side of it in view.
    public function centre(top: length, h: length) {
        flick.viewport-y = min(0px,
            max(root.height - root.content-height, (root.height - h) / 2 - top));
    }

    /// Move the list by a distance, stopping at its ends.
    ///
    /// For a page that is read rather than walked. `reveal` and `centre` both
    /// take a row, because every other list here has one the ring can stand
    /// on; the shortcuts page has none, so its keys move the list itself.
    /// Home and End are the same call asked for more than there is.
    public function scroll-by(dy: length) {
        flick.viewport-y = clamp(flick.viewport-y - dy,
            min(0px, root.height - root.content-height), 0px);
    }

    /// The same movement, asked for by a caller that cannot reach this list.
    ///
    /// The settings pages are built inside a conditional so the drill can
    /// slide them, which puts every element on them out of reach of the key
    /// handler at the window. So the keys leave the distance in `asked-by`
    /// and bump `asked-tick`, and the list picks it up here. The tick is
    /// what makes a second press of the same key a second movement.
    ///
    /// It still goes through `scroll-by`, which reads the live offset — so
    /// the wheel and the flick keep the list between two presses instead of
    /// being snapped back to wherever the keyboard last left it.
    in property <length> asked-by;
    in property <int> asked-tick;
    changed asked-tick => {
        root.scroll-by(root.asked-by);
    }

    flick := Flickable {
        width: 100%;
        height: 100%;
        viewport-width: self.width;
        viewport-height: root.content-height;

        VerticalLayout {
            // Rows keep their own height instead of being stretched to fill,
            // so a short list sits at the top rather than spreading out.
            alignment: start;
            @children
        }
    }

    // --- the scroll bar ---
    //
    // It says there is more below and roughly where you are, and it can be
    // taken hold of. It was a hint only once, and a thumb that shows where a
    // long list is but will not be moved there is the one thing on a panel
    // that looks like a control and is not: a season of episodes was a
    // wheel's worth of turning from one end to the other.

    /// How far the list can go: what it holds, less what it shows.
    property <length> reach: max(0px, root.content-height - root.height);
    /// The rail, inset from the list's top and bottom.
    property <length> rail-inset: 2px;
    property <length> rail-h: root.height - 2 * root.rail-inset;
    /// Proportional to how much of the list is on screen, with a floor so a
    /// very long list still leaves something to see, and to take hold of.
    property <length> thumb-h: max(24px,
        root.rail-h * (root.height / max(1px, root.content-height)));
    /// How far the thumb's top can travel down the rail.
    property <length> thumb-run: max(0px, root.rail-h - root.thumb-h);
    property <length> thumb-y:
        root.thumb-run * (-flick.viewport-y / max(1px, root.reach));
    /// Where on the thumb the pointer took hold, measured from its top.
    property <length> held;

    /// Put the held point of the thumb at `y` on the rail, and the list where
    /// that leaves it.
    function drag(y: length) {
        flick.viewport-y = -root.reach
            * (clamp(y - root.held, 0px, root.thumb-run)
                / max(1px, root.thumb-run));
    }

    // Grows under the pointer or a drag the way every track here does, and
    // about its own centre line, so it thickens rather than shifts.
    Rectangle {
        x: parent.width - 5.5px - self.width / 2;
        y: root.rail-inset;
        width: grip.has-hover || grip.pressed ? 5px : 3px;
        height: root.rail-h;
        border-radius: self.width / 2;
        background: Paint.wash-soft;
        visible: root.reach > 0;
        animate width { duration: Motion.track-grow; easing: ease-out; }

        Rectangle {
            y: root.thumb-y;
            width: 100%;
            height: root.thumb-h;
            border-radius: parent.border-radius;
            background: Paint.quiet;
        }
    }

    // The whole margin the rows' washes leave clear, not the 3px that is
    // drawn: a target that thin is one nobody can take hold of.
    grip := TouchArea {
        x: parent.width - self.width;
        width: Rows.gap;
        height: 100%;
        visible: root.reach > 0;
        mouse-cursor: pointer;
        /// The pointer, in the rail's terms.
        property <length> at: self.mouse-y - root.rail-inset;
        pointer-event(event) => {
            Chrome.pointed(event.kind == PointerEventKind.down);
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                // On the thumb, it is held where it was taken, so it does not
                // jump under the hand. On the rail, the thumb is brought to
                // the pointer by its middle and the drag carries on from
                // there, which is one press to anywhere in the list.
                root.held = self.at >= root.thumb-y
                    && self.at <= root.thumb-y + root.thumb-h
                    ? self.at - root.thumb-y
                    : root.thumb-h / 2;
                root.drag(self.at);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag(self.at);
            }
        }
        // The wheel still turns the list from here. Left to fall through to
        // the list underneath it would, but a refused wheel takes this
        // area's hover with it, and the bar would thin under a pointer that
        // had not moved.
        scroll-event(event) => {
            root.scroll-by(-event.delta-y);
            return EventResult.accept;
        }
    }
}

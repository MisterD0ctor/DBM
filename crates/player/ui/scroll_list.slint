// A list that scrolls, for the panels whose rows can outgrow the window.

import { Chrome } from "globals.slint";
import { ScrollFade } from "models.slint";
import { Motion, Paint, Rows } from "theme.slint";

/// The press target for the angle at one end of a list that points to its
/// current row: a row-sized square, centred across that end.
///
/// Only the press: the pipeline draws the angle and its hover circle after
/// the soft edge (see `ScrollFade.way`), which would otherwise thin them away
/// with the rows. Without this target, a press on the angle would go to the
/// row under it and play an episode nobody chose.
component WayToCurrent inherits Rectangle {
    /// How much of the angle is on, 0..1. At zero there is nothing to press.
    in property <float> shown;
    /// Under the pointer, and on.
    out property <bool> lit: root.visible && touch.has-hover;
    callback go();
    /// The wheel turned over it, for the list to scroll by.
    callback turned(length);

    width: Rows.row;
    height: Rows.row;
    visible: root.shown > 0.004;

    accessible-role: button;
    accessible-label: @tr("Scroll to the current one");
    accessible-action-default => {
        root.go();
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed(event.kind == PointerEventKind.down);
        }
        clicked => {
            root.go();
        }
        // Accepted rather than passed on, as the scroll bar's is, because a
        // refused wheel event takes the hover with it.
        scroll-event(event) => {
            root.turned(-event.delta-y);
            return EventResult.accept;
        }
    }
}

/// A list that scrolls when it is given less height than its content needs.
///
/// The caller supplies both heights, worked out from row counts, so nothing
/// here measures the layout (see "bar geometry" in `MainWindow` for why).
export component ScrollList inherits Rectangle {
    /// What the rows add up to, unconstrained.
    in property <length> content-height;
    /// The height the list has once its panel stops moving, which differs
    /// from its height only during a drill. Whether it scrolls is judged by
    /// this, or a page drilled into from a shorter one would show a scroll
    /// bar and a soft edge for the length of the move.
    in property <length> rest-height: root.height;
    /// Whether there is more of the list than it shows, once it has arrived.
    property <bool> scrolls: root.content-height > root.rest-height + 0.5px;
    /// How far the list has been scrolled, as Flickable's negative offset.
    /// Exposed for the tests, which have nothing else on screen to read.
    out property <length> offset: flick.content-y;

    /// Where the list is and how far it is from each end, for the soft edge.
    ///
    /// Its place in the window comes from the layout, which the panels
    /// otherwise avoid. These lists sit in sliding pages, and computing where
    /// each is mid-slide would mean keeping a second copy of the layout by
    /// hand; it is only read while a list is on show. The margins beside the
    /// rows' washes are left out, so the scroll bar in the right one keeps
    /// its shape at the ends of its rail.
    out property <ScrollFade> fade: {
        x: root.absolute-position.x + Rows.gap,
        y: root.absolute-position.y,
        width: root.width - 2 * Rows.gap,
        height: root.height,
        top: root.top-soft,
        bottom: root.bottom-soft,
        right: 0,
        way: max(root.current-above, root.current-below),
        way-x: root.absolute-position.x + root.width / 2,
        way-y: root.absolute-position.y + (root.current-above >= root.current-below
            ? Rows.row / 2 : root.height - Rows.row / 2),
        way-up: root.current-above >= root.current-below,
        way-lit: root.way-lit,
    };
    /// How far the soft edge at each end has come on, 0..1: how far the list
    /// has moved from that end, up to a strip's worth.
    property <float> top-soft: root.scrolls
        ? clamp(-flick.content-y / Rows.fade, 0, 1) : 0;
    property <float> bottom-soft: root.scrolls
        ? clamp((root.content-height - root.height + flick.content-y) / Rows.fade, 0, 1)
        : 0;

    clip: true;

    /// The current row (the file playing, the track in use) by its top and
    /// height inside the list. A list with none leaves the height at zero.
    in property <length> current-top;
    in property <length> current-h;

    /// The angle fades out as the current row comes into view, measured by
    /// how far the row's nearer edge has come in from that end. The fade
    /// starts at this distance: zero, as soon as any of the row shows.
    property <length> way-fade-from: 0px;
    /// It ends this far past the inner side of the soft edge: zero, once the
    /// row's edge is clear of the blur.
    property <length> way-fade-past: 0px;
    /// How far in from each end the current row's nearer edge has come. The
    /// bottom is measured at rest, as `scrolls` is, so a page mid-drill
    /// doesn't point at a row that only the move is hiding.
    property <length> current-in-top: root.current-top + root.current-h + flick.content-y;
    property <length> current-in-bottom:
        root.rest-height - flick.content-y - root.current-top;
    /// How much of the angle is on at each end.
    property <float> current-above: root.scrolls && root.current-h > 0
        ? 1 - clamp((root.current-in-top - root.way-fade-from)
            / max(1px, Rows.fade * root.top-soft + root.way-fade-past - root.way-fade-from),
            0, 1)
        : 0;
    property <float> current-below: root.scrolls && root.current-h > 0
        ? 1 - clamp((root.current-in-bottom - root.way-fade-from)
            / max(1px, Rows.fade * root.bottom-soft + root.way-fade-past
                - root.way-fade-from),
            0, 1)
        : 0;

    /// Bring a row into view, by its top and height inside the list.
    ///
    /// Called when the keyboard moves rather than bound, since a binding on
    /// `content-y` would take the list from the wheel and the flick. It
    /// scrolls by the least that works, so arrowing down walks the bottom
    /// edge, but keeps a row's worth of list past the ring: the ends are where
    /// rows blur away, and the next row has to be readable.
    public function reveal(top: length, h: length) {
        if (top - root.lead(h) < -flick.content-y) {
            flick.content-y = min(0px, root.lead(h) - top);
        } else if (top + h + root.lead(h) > -flick.content-y + root.height) {
            flick.content-y = max(min(0px, root.height - root.content-height),
                root.height - top - h - root.lead(h));
        }
    }

    /// How much list is kept past a revealed row: one row, or less in a list
    /// too short to spare one on both sides.
    pure function lead(h: length) -> length {
        return max(0px, min(h, (root.height - h) / 2));
    }

    /// Put a row in the middle, as far as the ends of the list allow.
    ///
    /// For a panel opening, where `reveal` would leave the row on the bottom
    /// edge: the current episode belongs with its neighbours in view.
    public function centre(top: length, h: length) {
        flick.content-y = root.centred(top, h);
    }

    /// Where `centre` puts the list for a row.
    pure function centred(top: length, h: length) -> length {
        return min(0px, max(root.height - root.content-height, (root.height - h) / 2 - top));
    }

    /// Ease the list to an offset.
    ///
    /// A binding on `content-y` would take the list from the wheel and the
    /// flick for good, so the list follows the animated `glide-y` step by step
    /// in `changed`. Finding any other offset there means a hand took the
    /// list on the way, and the glide lets go.
    function glide-to(y: length) {
        // With animations off, jump. A zero-length glide would leave
        // `glide-y` at the last target, so a second press to the same offset
        // would be no change and move nothing.
        if (Motion.glide == 0ms) {
            root.gliding = false;
            flick.content-y = y;
            return;
        }
        // Start from where the list is, not from where the last glide ended.
        root.glide-placing = true;
        root.glide-y = flick.content-y;
        root.glide-placing = false;
        root.glided = flick.content-y;
        root.gliding = true;
        root.glide-y = y;
    }
    property <length> glide-y;
    property <bool> glide-placing;
    property <bool> gliding;
    /// Where the glide last put the list.
    property <length> glided;
    animate glide-y {
        duration: root.glide-placing ? 0ms : Motion.glide;
        easing: ease-in-out;
    }
    changed glide-y => {
        if (!root.gliding) {
            return;
        }
        if (flick.content-y != root.glided) {
            root.gliding = false;
            return;
        }
        flick.content-y = root.glide-y;
        root.glided = root.glide-y;
    }

    /// Move the list by a distance, stopping at its ends.
    ///
    /// For the shortcuts page, which has no rows the ring can stand on, so its
    /// keys move the list itself. Home and End pass more than there is.
    public function scroll-by(dy: length) {
        flick.content-y = clamp(flick.content-y - dy,
            min(0px, root.height - root.content-height), 0px);
    }

    /// `reveal`, for a caller that can't reach this list: the settings pages,
    /// built inside conditions. Bumping the tick makes asking for the same row
    /// again a new request, for when the wheel has moved the list since.
    in property <length> reveal-top;
    in property <length> reveal-h;
    in property <int> reveal-tick;
    changed reveal-tick => {
        root.reveal(root.reveal-top, root.reveal-h);
    }

    /// `scroll-by`, for a caller that can't reach this list.
    ///
    /// The settings pages are built inside a conditional so the drill can
    /// slide them, which puts them out of the window's key handler's reach.
    /// So the keys set `asked-by` and bump `asked-tick`; the tick makes a
    /// repeated press a new movement. `scroll-by` reads the live offset, so
    /// the wheel's movement between presses is kept.
    in property <length> asked-by;
    in property <int> asked-tick;
    changed asked-tick => {
        root.scroll-by(root.asked-by);
    }

    flick := Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: root.content-height;

        VerticalLayout {
            // Rows keep their own height, so a short list sits at the top
            // rather than spreading out.
            alignment: start;
            @children
        }
    }

    // --- the scroll bar ---
    //
    // Draggable as well as a hint, because a thumb looks like a control, and a
    // season of episodes is a lot of wheel to turn.

    /// How far the list can go: what it holds, less what it shows.
    property <length> reach: max(0px, root.content-height - root.height);
    /// The rail, inset from the list's top and bottom.
    property <length> rail-inset: 2px;
    property <length> rail-h: root.height - 2 * root.rail-inset;
    /// In proportion to how much of the list is on screen, with a floor so a
    /// very long list still leaves something to see and take hold of.
    property <length> thumb-h: max(24px,
        root.rail-h * (root.height / max(1px, root.content-height)));
    /// How far the thumb's top can travel down the rail.
    property <length> thumb-run: max(0px, root.rail-h - root.thumb-h);
    property <length> thumb-y:
        root.thumb-run * (-flick.content-y / max(1px, root.reach));
    /// Where on the thumb the pointer took hold, measured from its top.
    property <length> held;

    /// Put the held point of the thumb at `y` on the rail, and the list where
    /// that leaves it.
    function drag(y: length) {
        flick.content-y = -root.reach
            * (clamp(y - root.held, 0px, root.thumb-run)
                / max(1px, root.thumb-run));
    }

    // Grows under the pointer or a drag like every track here, about its
    // centre line so it thickens rather than shifts.
    bar := Rectangle {
        x: parent.width - 5.5px - self.width / 2;
        y: root.rail-inset;
        width: grip.has-hover || grip.pressed ? 5px : 3px;
        height: root.rail-h;
        border-radius: self.width / 2;
        background: Paint.wash-soft;
        visible: root.scrolls && root.reach > 0;
        animate width { duration: Motion.track-grow; easing: ease-out; }

        Rectangle {
            y: root.thumb-y;
            width: 100%;
            height: root.thumb-h;
            border-radius: parent.border-radius;
            background: Paint.quiet;
        }
    }

    // The whole margin beside the rows' washes, because the 3px that is
    // drawn is too thin to take hold of.
    grip := TouchArea {
        x: parent.width - self.width;
        width: Rows.gap;
        height: 100%;
        visible: root.scrolls && root.reach > 0;
        mouse-cursor: pointer;
        /// The pointer, in the rail's terms.
        property <length> at: self.mouse-y - root.rail-inset;
        pointer-event(event) => {
            Chrome.pointed(event.kind == PointerEventKind.down);
            if (event.kind == PointerEventKind.down
                && event.button == PointerEventButton.left) {
                // On the thumb, hold it where it was taken so it doesn't jump.
                // On the rail, bring its middle to the pointer and drag from
                // there, so one press reaches anywhere in the list.
                root.held = self.at >= root.thumb-y
                    && self.at <= root.thumb-y + root.thumb-h
                    ? self.at - root.thumb-y
                    : root.thumb-h / 2;
                root.drag(self.at);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag(self.at);
            }
        }
        // Scrolled here rather than passed to the list, because a refused
        // wheel event takes this area's hover with it, and the bar would thin
        // under a pointer that hadn't moved.
        scroll-event(event) => {
            root.scroll-by(-event.delta-y);
            return EventResult.accept;
        }
    }

    // --- the way to the current row ---
    //
    // While the wheel has taken the current row out of sight, an angle at
    // that end points to it, and pressing it carries the list back. It fades
    // by where the row is rather than on a clock, so the only motion is the
    // list's own.

    up-way := WayToCurrent {
        x: (root.width - self.width) / 2;
        y: 0;
        shown: root.current-above;
        go => {
            root.glide-to(root.centred(root.current-top, root.current-h));
        }
        turned(dy) => {
            root.scroll-by(dy);
        }
    }
    down-way := WayToCurrent {
        x: (root.width - self.width) / 2;
        y: root.height - self.height;
        shown: root.current-below;
        go => {
            root.glide-to(root.centred(root.current-top, root.current-h));
        }
        turned(dy) => {
            root.scroll-by(dy);
        }
    }
    /// The hover circle under the angle, eased like a row's wash.
    property <float> way-lit: up-way.lit || down-way.lit ? 1 : 0;
    animate way-lit {
        duration: Motion.highlight;
        easing: ease-out;
    }
}

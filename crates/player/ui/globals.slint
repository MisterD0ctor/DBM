// The globals the Rust side talks to. Each is a global because what raises it
// is buried inside reusable components, which would otherwise need a callback
// threaded through every call site.

/// Activity and the idle clock. Every interactive element reports activity
/// here; the Rust side owns the clock and pushes `idle` back.
export global Chrome {
    /// Reports activity to the Rust side.
    callback activity();
    /// Whether the keyboard's ring is drawn.
    ///
    /// Only once the keyboard is steering: a panel opened with a key, an
    /// arrow, Tab or Enter. Over a panel reached with the mouse, a ring would
    /// compete with the playing row and point where the hand isn't. A mouse
    /// button going down clears it.
    in-out property <bool> focus-visible: false;
    /// Whether nothing has happened for a while.
    ///
    /// Cleared here rather than by the timer that sets it: the timer polls a
    /// few times a second, and waiting for it left the pointer hidden for a
    /// visible moment after the mouse moved.
    in-out property <bool> idle: false;
    /// Bumped by every key and pointer event: input, as distinct from the
    /// activity a film ending also raises. A notice waits for the next one.
    in-out property <int> input-seq: 0;

    /// Call on any activity. Wakes the interface at once and resets the clock.
    public function bump() {
        Chrome.idle = false;
        Chrome.activity();
    }

    /// Ask for the pointer to leave the screen, or to come back.
    ///
    /// A callback rather than a property the Rust side polls, because coming
    /// back is urgent and hiding is not: the pointer must be under the hand
    /// the instant it moves, while hiding three seconds after it stopped can
    /// be a fifth of a second late unnoticed.
    callback hide-pointer(hide: bool);

    /// Pointer activity, and whether a button went down with it. A press also
    /// clears the ring, since the hand has taken over.
    public function pointed(down: bool) {
        Chrome.bump();
        Chrome.input-seq += 1;
        if (down) {
            Chrome.focus-visible = false;
        }
    }

    /// The same, from a row the keyboard can also stand on.
    ///
    /// Moving onto a row the ring isn't on clears the ring, or the hand and
    /// the keys would light different rows and nothing would say which one
    /// Enter presses. Only movement counts: a still pointer raises no events,
    /// so arrowing past it keeps the ring.
    public function pointed-at(down: bool, moved: bool, focused: bool) {
        Chrome.pointed(down);
        if (moved && !focused) {
            Chrome.focus-visible = false;
        }
    }
}

/// Brief feedback for an action whose effect is otherwise off screen.
///
/// Only for what nothing else shows: which way a seek went, that the file
/// changed, where the subtitle delay landed, whether subtitles are on. Mute,
/// volume and panscan move a control already on screen, since a key press
/// wakes the bar.
export global Flash {
    // Indices into the window's own glyph list, because `@image-url` resolves
    // at compile time and the images can't live here. Named so the call sites
    // don't depend on an order they can't see.
    out property <int> seek-back: 0;
    out property <int> seek-forward: 1;
    out property <int> previous: 2;
    out property <int> next: 3;
    out property <int> restart: 4;
    out property <int> delay: 5;

    in-out property <int> icon: 0;
    /// A sentence, when the player has something to say rather than an action
    /// to acknowledge; empty otherwise. A notice is the capsule alone, with no
    /// ring.
    in-out property <string> message: "";
    /// Whether the sentence is a failure rather than news. A failure has the
    /// warning mark before its words.
    in-out property <bool> warning: false;
    /// Where across the picture it appears, 0..1. A seek is thrown towards
    /// the side it seeks to; everything else sits in the middle.
    in-out property <float> at: 0.5;
    /// Bumped on every raise, so the window restarts the dwell even when the
    /// same action repeats, as it does for a held key.
    in-out property <int> seq: 0;
    /// A figure shown on its own, with no ring: 1 the speed, 2 the chapter,
    /// 3 the subtitle track, 4 the audio track, 0 none. The icon set has no
    /// glyph for these, and the figure is the whole answer anyway.
    in-out property <int> figure: 0;

    public function show-figure(kind: int) {
        Flash.figure = kind;
        Flash.message = "";
        Flash.at = 0.5;
        Flash.seq += 1;
    }

    public function show(icon: int, at: float) {
        Flash.icon = icon;
        Flash.figure = 0;
        Flash.message = "";
        Flash.at = at;
        Flash.seq += 1;
    }

    /// Say something a packaged build would otherwise have no console for: a
    /// file that won't play, a folder with nothing in it, sound coming back
    /// after a device disappeared.
    public function notice(text: string) {
        Flash.message = text;
        Flash.warning = false;
        Flash.figure = 0;
        Flash.at = 0.5;
        Flash.seq += 1;
    }

    /// Say that something went wrong: a notice, marked as one.
    public function warn(text: string) {
        Flash.notice(text);
        Flash.warning = true;
    }
}

/// What a control is called, and which key does the same thing.
///
/// The bar's glyphs have no labels, so this is where they are explained, and
/// the key is the part worth learning. One surface for the whole bar, since
/// only one tip is ever up. The accessibility page can turn tips and their
/// keys off; screen readers get the controls' names either way.
export global Tip {
    /// Whether tips go up at all. Off, `point` and `show` put nothing up and
    /// return a claim that never matches.
    in-out property <bool> enabled: true;
    /// Whether a tip names the key as well as the control.
    in-out property <bool> with-keys: true;
    in-out property <string> label;
    in-out property <string> keys;
    /// Centre of the control it belongs to, in window coordinates.
    in-out property <length> cx;
    /// Bumped on every arrival and departure, so the window watches one
    /// property rather than three, and a control can tell whether the tip is
    /// still the one it put up.
    in-out property <int> seq;

    /// Whether the tip goes up without the wait. Set by `show`, cleared by
    /// `point`.
    in-out property <bool> now;

    /// Puts a tip up and returns the claim on it, for `release`.
    public function point(label: string, keys: string, cx: length) -> int {
        if (!Tip.enabled) {
            return -1;
        }
        Tip.label = label;
        Tip.keys = Tip.with-keys ? keys : "";
        Tip.cx = cx;
        Tip.now = false;
        Tip.seq += 1;
        return Tip.seq;
    }

    /// The same, with no wait: for a reading that changes under the hand,
    /// like the volume's. Each notch of the wheel would restart the wait, so
    /// a reading that waited would never arrive while it was wanted.
    public function show(label: string, keys: string, cx: length) -> int {
        if (!Tip.enabled) {
            return -1;
        }
        Tip.label = label;
        Tip.keys = Tip.with-keys ? keys : "";
        Tip.cx = cx;
        Tip.now = true;
        Tip.seq += 1;
        return Tip.seq;
    }

    /// Takes the tip down, but only if `claim` is still the one up.
    ///
    /// A claim rather than the control's position, because a control can move
    /// while its tip is up (fullscreen moves the button just pressed), and a
    /// tip matched by position would then never come down.
    public function release(claim: int) {
        if (Tip.seq == claim) {
            Tip.clear();
        }
    }

    public function clear() {
        Tip.label = "";
        Tip.seq += 1;
    }
}

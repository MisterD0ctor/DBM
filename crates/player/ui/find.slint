// The search for subtitles on OpenSubtitles, as the Rust side sees it: what
// it found, who is signed in, and what the menu asks it to do. The menu's
// own pages and rows stay with the window (see `MainWindow`'s subtitles
// menu), and the answers come from `interface::find`.

import { FoundItem } from "models.slint";

export global Find {
    /// Whether there is any searching to be done: a key, and a film.
    in property <bool> offered;
    /// 0 nothing asked yet, 1 searching, 2 results, 3 none found, 4 failed.
    in-out property <int> state: 0;
    /// Why a search failed, in words.
    in property <string> said;
    in property <[FoundItem]> hits;
    /// The row being fetched, or -1. One at a time.
    in-out property <int> fetching: -1;
    callback search();
    callback fetch(int);
    /// Who is signed in to OpenSubtitles, or empty.
    in property <string> account;
    /// The account's downloads left today, or -1 where OpenSubtitles hasn't
    /// said.
    in property <int> left: -1;
    in-out property <bool> signing-in: false;
    /// Why the last sign-in failed, in words, or empty.
    in-out property <string> sign-in-said;
    /// Sign in with what was typed. Straight to the network thread, and
    /// nowhere else (see `opensubtitles::account`).
    callback sign-in(string, string);
    callback sign-out();
}

// The way in: what an empty window offers, centred in it, and in its place,
// why the player can't show video at all.

import { Chrome } from "globals.slint";
import { Playback } from "playback.slint";
import { Playlist } from "playlist.slint";
import { GlassRect } from "models.slint";
import { MenuHeading, MenuRow, ResumeRow, ShortcutRow } from "rows.slint";
import { Bounds, Surfaces } from "surface.slint";
import { Squircle } from "squircle.slint";
import { Motion, Paint, Panels, Rows, Type } from "theme.slint";

/// Laid over the whole window, which it centres in.
export component WayIn inherits Rectangle {
    /// Not tied to the idle clock, since there is no film to keep clear, and
    /// an empty window that hid its only control would show nothing. Only the
    /// settings panel can open over it.
    in property <bool> open;
    /// The row the keyboard's ring is on.
    in property <int> ring-row;
    /// Why the player can't show video at all, or empty when it can (see the
    /// window's own).
    in property <string> fatal;
    in property <string> fatal-detail;
    in property <string> fatal-note;
    /// Whether a picture is drawn behind the pane for its glass to bend.
    in property <bool> backdrop;
    /// Whether a file dropped on the window reaches the player.
    in property <bool> drop-supported;
    callback settings-asked();
    callback shortcuts-asked();
    callback quit();

    /// The rows the keyboard walks: the failure's two, or each film there is
    /// to continue, the two ways to open, Settings and Shortcuts.
    out property <int> rows: root.fatal != "" ? 2 : root.films + 4;
    out property <float> shown: root.open ? 1.0 : 0.0;
    /// Where the pane is drawn, and its glass.
    out property <Bounds> bounds: {
        x: root.pane-x,
        y: root.pane-y + root.rise,
        width: root.pane-w,
        height: root.pane-h,
    };
    out property <GlassRect> glass: Surfaces.glass(root.pane-x, root.pane-y + root.rise,
        root.pane-w, root.pane-h, Panels.radius, root.shown);
    /// Where the first film's row starts, and how tall each is, for the
    /// harness to point at one.
    out property <length> films-y: root.pane-y + root.rise + Panels.pad;
    out property <length> film-h: Rows.resume-row;

    /// Press a row, as Enter does the ring's.
    public function activate(row: int) {
        if (root.fatal != "") {
            if (row == 0) {
                root.copy-details();
            } else {
                root.quit();
            }
        } else if (row < root.films) {
            if (root.answers) {
                Playlist.open-path(Playback.unfinished[row].path, false);
            }
        } else if (row < root.films + 2) {
            Playlist.request-open(row == root.films + 1);
        } else if (row == root.films + 2) {
            root.settings-asked();
        } else {
            root.shortcuts-asked();
        }
    }

    animate shown {
        duration: Motion.surface;
        easing: ease-out;
    }
    property <length> rise: (1.0 - root.shown) * Surfaces.lift;

    /// Whether the rows that start an open take a press: not while one is in
    /// flight, which a second click would queue behind, and not while the
    /// pane leaves, since the open has ended by then, partway through the
    /// fade, and the second click of a double-click would open the film again.
    property <bool> answers: root.open && !Playlist.opening;
    /// Whether the pane says an open is in flight: those rows at half, and a
    /// line naming what is arriving. Only once it has run `Motion.slow-open`,
    /// since a film on a local disk is playing before the line could be read,
    /// and making room for it would only jerk the pane as it leaves. Held
    /// while the pane leaves, so that it fades as it was rather than changing
    /// size when the open ends partway out; let go once it is up with nothing
    /// in flight.
    property <bool> waiting: false;
    changed answers => {
        if (self.answers) {
            root.waiting = false;
        }
    }
    slow-timer := Timer {
        interval: Motion.slow-open;
        running: root.open && Playlist.opening && !root.waiting;
        triggered => {
            root.waiting = true;
        }
    }
    /// The films offered first, newest at the top. None over a failure,
    /// which opens nothing.
    property <int> films: root.fatal != "" ? 0 : Playback.unfinished.length;
    property <length> panel-pad: 2 * Panels.pad;

    // --- the way in ---------------------------------------------------------
    //
    // Rows and a sentence, centred. Wider than the files panel, which holds
    // the same rows, because it stands alone and carries a sentence. Wider
    // still for a failure, whose sentence must not elide and is followed by
    // the driver's own error text, and for films to continue, whose names
    // beside a measure lost an episode's number at 320px.
    property <length> pane-w: root.fatal != "" || root.films > 0 ? 420px : 320px;
    property <length> pane-h: root.fatal != ""
        ? root.panel-pad + root.line-h + Rows.group-gap
            + root.detail-h + root.fatal-note-h
            + Rows.group-gap + 2 * Rows.row
        : root.panel-pad
            + (root.named ? Rows.heading : root.films * Rows.resume-row + Rows.group-gap)
            + 4 * Rows.row + root.note-h;

    /// One line of the Hint role for a note under a pane's rows, with the
    /// group gap above it. The gap goes with the line, so a pane without a
    /// note has no space left under its last row.
    property <length> note-line-h: 22px;

    /// The line under the way in's rows: the drop hint, or what is being
    /// opened. Nothing when it has neither.
    property <length> note-h: root.drop-supported || root.waiting
        ? Rows.group-gap + root.note-line-h : 0px;

    /// The line under a failure saying what usually puts it right. Separate
    /// from the way in's note, which depends on drop support, so that this
    /// shows on every platform.
    property <length> fatal-note-h: root.fatal-note != ""
        ? Rows.group-gap + root.note-line-h : 0px;
    /// With nothing to continue, the panel is about the player rather than a
    /// film, and it says whose it is where the films would be.
    property <bool> named: root.fatal == "" && root.films == 0;
    /// One line of the Title role, 14px, for the sentence that names the
    /// failure.
    property <length> line-h: 22px;
    /// Three lines of the Hint role, 13px, for the driver's account of it:
    /// what fits without the pane growing taller than the one it replaces,
    /// and a fourth line of a shader log would tell a reader nothing more.
    property <length> detail-h: 54px;
    property <length> pane-x: (root.width - root.pane-w) / 2;
    property <length> pane-y: (root.height - root.pane-h) / 2;

    // --- the failure pane's two rows --------------------------------------------

    /// Whether the details were just copied, so the row can say so.
    property <bool> copied: false;

    /// Put the headline and the driver's words on the clipboard, for a bug
    /// report, since this pane is the only place they appear.
    public function copy-details() {
        fatal-copy.select-all();
        fatal-copy.copy();
        fatal-copy.clear-selection();
        root.copied = true;
        copied-timer.stop();
        copied-timer.start();
    }

    copied-timer := Timer {
        interval: 2000ms;
        running: false;
        triggered => {
            root.copied = false;
            copied-timer.stop();
        }
    }

    /// The text to copy. A hidden one-pixel `TextInput`, because only a text
    /// input can put text on the clipboard.
    fatal-copy := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        read-only: true;
        text: root.fatal + "\n\n" + root.fatal-detail;
    }

    // --- the way in ---------------------------------------------------------
    //
    // Glass with no fill, like every panel, even with no film: the pipeline
    // composites anyway, so the glass resolves over a black frame into a
    // faint lift with an edge, which a fill would cover.
    Rectangle {
        x: root.pane-x;
        y: root.pane-y + root.rise;
        width: root.pane-w;
        height: root.pane-h;
        // A fill only where there is no glass to cover: after a failure,
        // which leaves no render context for the glass pass, and while
        // nothing is drawn behind the pane yet (see `backdrop` and `mark`).
        property <bool> bare: root.fatal != "" || !root.backdrop;
        border-radius: self.bare ? Panels.radius : 0px;
        visible: root.shown > Surfaces.gone;
        opacity: root.shown;
        clip: true;

        // In the glass's own outline, which is the shape it stands in for.
        Squircle {
            radius: Panels.radius;
            fill: parent.bare ? Paint.wash-soft : transparent;
        }

        // So a click that misses a row doesn't reach the play/pause handler.
        TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        VerticalLayout {
            padding-top: Panels.pad;
            padding-bottom: Panels.pad;

            // No rows that open a file: with no render context, a film would
            // play with no picture.
            if root.fatal != "": VerticalLayout {
                Rectangle {
                    height: root.line-h;

                    HorizontalLayout {
                        padding-left: Rows.label-x;
                        padding-right: Rows.trail-x;

                        Text {
                            text: root.fatal;
                            color: Paint.strong;
                            font-size: Type.title;
                            font-weight: Type.weight-title;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: Rows.group-gap;
                }

                // The driver's own words, allowed to wrap to three lines,
                // since this is the only copy of them.
                Rectangle {
                    height: root.detail-h;

                    HorizontalLayout {
                        padding-left: Rows.label-x;
                        padding-right: Rows.label-x;

                        Text {
                            text: root.fatal-detail;
                            color: Paint.body;
                            font-size: Type.hint;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: top;
                        }
                    }
                }

                // The gap is inside the line's height, so a failure with no
                // note leaves no space for one.
                if root.fatal-note-h > 0px: Rectangle {
                    height: root.fatal-note-h;

                    HorizontalLayout {
                        padding-top: Rows.group-gap;
                        padding-left: Rows.label-x;
                        padding-right: Rows.trail-x;

                        Text {
                            text: root.fatal-note;
                            color: Paint.body;
                            font-size: Type.hint;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Something to do about it: copy the words, or leave.
                Rectangle {
                    height: Rows.group-gap;
                }
                MenuRow {
                    label: root.copied ? @tr("Copied") : @tr("Copy details");
                    focused: !Playback.has-file && root.ring-row == 0;
                    picked => {
                        root.copy-details();
                    }
                }
                MenuRow {
                    label: @tr("Close the player");
                    focused: !Playback.has-file && root.ring-row == 1;
                    picked => {
                        root.quit();
                    }
                }
            }

            // With nothing to continue, the player's own name heads the pane,
            // so the first window anyone sees says what is asking. Natural
            // case, as a name.
            if root.named: MenuHeading {
                text: "DBM";
                titular: true;
            }

            // What you were watching comes first, since an empty window is
            // most often opened to get back to it: every film left unfinished,
            // newest first, then a gap, since they are films and the rows
            // below open dialogs.
            if root.films > 0: VerticalLayout {
                for film[index] in Playback.unfinished: ResumeRow {
                    film: film;
                    focused: !Playback.has-file && root.ring-row == index;
                    opacity: root.waiting ? 0.5 : 1.0;
                    animate opacity { duration: Motion.surface; easing: ease-out; }
                    picked => {
                        if (root.answers) {
                            Playlist.open-path(film.path, false);
                        }
                    }
                    // The film being opened is what lights the window then.
                    come-to => {
                        if (!Playlist.opening) {
                            Playback.light-with(film.path);
                        }
                    }
                }
                Rectangle {
                    height: Rows.group-gap;
                }
            }

            // The same rows, words and keys as the files panel on the bar, so
            // they are learned once. Dimmed and inert while an open is in
            // flight, or a second click would queue a second scan. Dimmed here
            // rather than by `ShortcutRow`, whose `inert` reference rows must
            // not fade.
            if root.fatal == "": ShortcutRow {
                label: @tr("Open file…");
                shortcut: @tr("Ctrl+O");
                focused: !Playback.has-file && root.ring-row == root.films;
                inert: Playlist.opening;
                opacity: root.waiting ? 0.5 : 1.0;
                animate opacity { duration: Motion.surface; easing: ease-out; }
                picked => {
                    if (root.answers) {
                        Playlist.request-open(false);
                    }
                }
            }
            if root.fatal == "": ShortcutRow {
                label: @tr("Open folder…");
                shortcut: @tr("Ctrl+Shift+O");
                focused: !Playback.has-file && root.ring-row == root.films + 1;
                inert: Playlist.opening;
                opacity: root.waiting ? 0.5 : 1.0;
                animate opacity { duration: Motion.surface; easing: ease-out; }
                picked => {
                    if (root.answers) {
                        Playlist.request-open(true);
                    }
                }
            }
            // The bar's way to the settings is gone until there is a film.
            // Still working, so not dimmed while opening.
            if root.fatal == "": ShortcutRow {
                label: @tr("Settings");
                shortcut: "S";
                focused: !Playback.has-file && root.ring-row == root.films + 2;
                picked => {
                    root.settings-asked();
                }
            }
            // The reference, one key away from the moment someone is most
            // likely to wonder what the keys are.
            if root.fatal == "": ShortcutRow {
                label: @tr("Shortcuts");
                shortcut: "?";
                focused: !Playback.has-file && root.ring-row == root.films + 3;
                picked => {
                    root.shortcuts-asked();
                }
            }

            // One line for two things never said at once: what else you could
            // do, and what is happening now. The drop is stated rather than
            // shown, because the shell reports nothing until the file lands.
            // The gap comes with the line, so with neither there is no row.
            if root.fatal == "" && root.note-h > 0px: Rectangle {
                height: root.note-h;

                HorizontalLayout {
                    padding-top: Rows.group-gap;
                    padding-left: Rows.label-x;
                    padding-right: Rows.trail-x;

                    Text {
                        // Two branches suffice, since the row exists only when
                        // one of them applies.
                        text: root.waiting
                            ? @tr("Opening {}…", Playlist.opening-name)
                            : @tr("Or drop a file or folder onto the window");
                        color: Paint.body;
                        font-size: Type.hint;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
            }
        }
    }
}

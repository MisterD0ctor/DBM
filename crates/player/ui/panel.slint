// What every panel shares: the box of glass hung above the bar from the
// control it belongs to.

import { Chrome } from "globals.slint";
import { GlassRect } from "models.slint";
import { Bounds, Surfaces } from "surface.slint";
import { Motion, Rows } from "theme.slint";

/// A panel: centred on the control it belongs to and kept inside the
/// window's margins, its bottom edge one `Rows.offset` above the bar, growing
/// upward. Pinned to a margin it still reads as its button's, where clipped
/// at the window's edge it wouldn't.
export component GlassPanel inherits Rectangle {
    in property <bool> open;
    /// Drawn unseen this frame, at no opacity, so that its first opening does
    /// not also pay for drawing it the first time (see `warm`).
    in property <bool> warming;
    /// The middle of the control it hangs from, the window's width, and the
    /// line it opens above: the bar's top.
    in property <length> anchor;
    in property <length> room;
    in property <length> floor;
    /// Whether its size eases with its pages as they drill, so the box and
    /// what is in it move as one. Never while the window is being resized,
    /// or it would trail the window's edge for the whole drag.
    in property <bool> drills;
    in property <bool> resizing;

    out property <float> shown: root.open ? 1.0 : 0.0;
    out property <Bounds> bounds: {
        x: root.x,
        y: root.y,
        width: root.width,
        height: root.height,
    };
    /// The panel's height this frame, as every rect takes it, not the height
    /// it may be easing towards.
    out property <GlassRect> glass: Surfaces.glass(root.x, root.y, root.width, root.height,
        Rows.panel-radius, root.shown);

    // The panel arithmetic's short names. A panel is capped at what fits
    // above the bar, and sized from row counts rather than measured (see
    // `Bar`), so its glass matches what is drawn.
    out property <length> row-h: Rows.row;
    out property <length> heading-h: Rows.heading;
    out property <length> toggle-h: Rows.toggle-row;
    /// The padding above and below the rows, together.
    out property <length> panel-pad: 2 * Rows.panel-pad;
    /// Room for a panel between the bar and a top margin the same as its
    /// side margins.
    out property <length> panel-max-h: root.floor - Rows.offset - Surfaces.margin;
    /// The most the panels whose rows are names someone else wrote, the
    /// tracks and the playlist, may take: a third of the window, so a bigger
    /// window shows more of an episode's title and a release's name, between
    /// the narrowest that leaves the floor's film in view and the widest an
    /// eye takes in one sweep.
    out property <length> list-min-w: 380px;
    out property <length> list-max-w: 540px;
    out property <length> list-w: clamp(root.room * 0.34, root.list-min-w, root.list-max-w);
    /// The settings' width, at which the interface's own words fit in every
    /// language. A list panel holds some of those words too, so it is never
    /// narrower.
    out property <length> words-w: 340px;
    /// A list panel only as wide as its widest row asks, so two short track
    /// names don't take a third of the window.
    public pure function list-fit(want: length) -> length {
        return clamp(want, root.words-w, root.list-w);
    }

    animate shown {
        duration: Motion.surface;
        easing: ease-out;
    }
    property <length> rise: (1.0 - root.shown) * Surfaces.lift;

    x: clamp(root.anchor - self.width / 2, Surfaces.margin,
        root.room - self.width - Surfaces.margin);
    // From its own height, so the panel keeps its bottom edge and grows
    // upward, and the glass, read from this rectangle, follows.
    y: root.floor - self.height - Rows.offset + root.rise;
    animate width, height {
        duration: root.drills && !root.resizing ? Motion.drill : 0ms;
        easing: ease-in-out;
    }
    visible: root.shown > Surfaces.gone || root.warming;
    opacity: root.shown;
    clip: true;
    // The corner a page sliding past is cut at, so it is cut where the glass
    // is. A circle, which stands at most two thirds of a pixel proud of the
    // glass's own corner, inside the glass's soft edge.
    border-radius: root.drills ? Rows.panel-radius : 0px;

    // Catches what the rows don't, so a click on the padding doesn't reach
    // the play/pause handler underneath.
    TouchArea {
        pointer-event(event) => {
            Chrome.pointed(event.kind == PointerEventKind.down);
        }
    }

    @children
}

// The settings pages' contents as the Rust side holds them (see `settings`
// and `interface::sliders`), and what the pages ask of them: a slider moved, a
// page reset or its reset taken back, a switch turned, the size or the
// language changed. The pages themselves stay with the window.

import { ParamItem, Way } from "models.slint";
import { Subtitles } from "subtitles.slint";
import { Tip } from "globals.slint";
import { Motion } from "theme.slint";

/// What a page's reset row puts back: a section of the settings, or, from
/// the subtitles menu, the timing or the size and position.
export enum Reset { none, glass, border, picture, timing, placing }

export global Settings {
    in property <[ParamItem]> glass-params;
    in property <[ParamItem]> border-params;
    in property <[ParamItem]> picture-params;
    /// Every slider's name on a line of its own, measured by `param-measure`
    /// for the column every page sets its names in.
    in property <string> param-names;
    /// The bundled languages besides English, each by its own name. Nothing
    /// here names one, so a build can hold any set.
    in property <[string]> language-names;
    /// The lit row of the language page: 0 the system's, 1 English, then the
    /// built-in ones in the order of `language-names`.
    in-out property <int> language-choice: 0;
    callback choose-language(int);
    in-out property <bool> ambience-on: true;
    in-out property <bool> autoplay: true;
    /// Whether an episode's title sequence is skipped as it starts, and its
    /// credits gone on from once their pill has counted down (see
    /// `playback::skips`). The second only goes as far as autoplay would, so
    /// it is offered only while autoplay is on.
    in-out property <bool> skip-intros: false;
    in-out property <bool> skip-credits: false;
    /// Registry index and its new normalised position.
    callback set-param(int, float);
    /// Restore one section to its defaults: the glass, the ambient border or
    /// the picture, as in `settings::Section`.
    callback reset-section(Reset);
    /// Take back the last reset of a section, or of the subtitles' size and
    /// position.
    callback undo-reset(Reset);
    callback set-ambience(bool);
    callback set-autoplay(bool);
    callback set-skip-intros(bool);
    callback set-skip-credits(bool);
    /// The accessibility page's switch. `Motion.chosen` is already set when
    /// this runs; it saves the choice.
    callback set-animations(bool);
    /// The interface's size, as a multiple of the system's, and a step of it
    /// from the same page, which Rust keeps to the sizes offered that the
    /// display has room for.
    in property <float> scale: 1;
    callback step-scale(Way);
    /// Whether the timeline's right end says what is left of the film rather
    /// than its length, and what that is: `−12:34`. A click on it or the
    /// video page's switch changes it here, and Rust saves it.
    in-out property <bool> show-remaining;
    callback set-show-remaining(bool);
    /// Whether the timeline marks the file's chapters and the seek preview
    /// names them, from the video page; Rust saves it. The chapter keys go on
    /// working either way.
    in-out property <bool> show-chapters: true;
    callback set-show-chapters(bool);
    /// Whether the glass is held dark enough for its words over a bright
    /// frame, from the same page; Rust saves it and tells the pipeline.
    in-out property <bool> legible-glass: true;
    callback set-legible-glass(bool);
    /// The same for its two tip switches: `Tip` is already set, and these
    /// save the choice.
    callback set-tips(bool);
    callback set-tip-keys(bool);

    // Each sets its setting here first, so the next frame shows it before
    // the Rust side, which saves it, has heard.
    public function pick-language(row: int) {
        Settings.language-choice = row;
        Settings.choose-language(row);
    }
    /// Turn the interface's motion on or off, from the switch or from Enter
    /// on its row.
    public function turn-motion(on: bool) {
        Motion.chosen = on;
        Settings.set-animations(on);
    }
    /// Which end of the film the timeline's right end says, the same way.
    public function turn-remaining(on: bool) {
        Settings.show-remaining = on;
        Settings.set-show-remaining(on);
    }
    public function turn-chapters(on: bool) {
        Settings.show-chapters = on;
        Settings.set-show-chapters(on);
    }
    /// Turn the tips on or off, the same way. None is visible while this page
    /// is open, but one can be held under it, so turning them off clears it.
    public function turn-tips(on: bool) {
        Tip.enabled = on;
        if (!on) {
            Tip.clear();
        }
        Settings.set-tips(on);
    }
    public function turn-legible(on: bool) {
        Settings.legible-glass = on;
        Settings.set-legible-glass(on);
    }
    public function turn-tip-keys(on: bool) {
        Tip.with-keys = on;
        Settings.set-tip-keys(on);
    }
}

/// The reset rows, on the settings pages and the subtitles menu's.
///
/// Two presses, then a way back, because settings save at once and a look
/// tuned by eye can't be typed back in. The first press says what the second
/// will do; after the second, the same row offers to undo it until the page
/// is left. The window waits `Motion.armed-for` for the second press, from
/// each first one (see `armed-seq`).
export global Resets {
    in-out property <Reset> armed: Reset.none;
    in-out property <Reset> undoable: Reset.none;
    /// Bumped by every first press, for the window to restart the wait.
    out property <int> armed-seq: 0;
    /// The subtitle delay and speed that stood when the timing was reset.
    property <float> delay: 0;
    property <float> sub-speed: 1;

    public function press(what: Reset) {
        if (Resets.undoable == what) {
            // The timing is the film's alone, so it is put back from here
            // rather than from what the settings saved.
            if (what == Reset.timing) {
                Subtitles.set-timing(Resets.delay, Resets.sub-speed);
            } else {
                Settings.undo-reset(what);
            }
            Resets.undoable = Reset.none;
            return;
        }
        if (Resets.armed != what) {
            Resets.armed = what;
            Resets.armed-seq += 1;
            return;
        }
        Resets.armed = Reset.none;
        Resets.delay = Subtitles.delay;
        Resets.sub-speed = Subtitles.speed;
        if (what == Reset.timing) {
            Subtitles.set-timing(0, 1);
        } else if (what == Reset.placing) {
            Subtitles.reset();
        } else {
            Settings.reset-section(what);
        }
        Resets.undoable = what;
    }

    /// Forget what is armed and what can be taken back, as leaving a page
    /// does.
    public function clear() {
        Resets.armed = Reset.none;
        Resets.undoable = Reset.none;
    }

    /// Whether a reset is one of the subtitles menu's rather than the
    /// settings panel's.
    public pure function is-menu-reset(what: Reset) -> bool {
        return what == Reset.timing || what == Reset.placing;
    }

    /// The warning while the row is armed, since the next press throws a
    /// page of settings away.
    public pure function icon(what: Reset) -> image {
        return Resets.armed == what && Resets.undoable != what
            ? @image-url("../../../public/icons/warning.svg")
            : @image-url("../../../public/icons/reset.svg");
    }

    public pure function label(what: Reset) -> string {
        return Resets.undoable == what ? @tr("Undo reset")
            : Resets.armed == what ? @tr("Press again to reset")
            : what == Reset.timing ? @tr("Reset timing")
            : what == Reset.picture ? @tr("Reset the picture")
            : @tr("Reset to defaults");
    }
}

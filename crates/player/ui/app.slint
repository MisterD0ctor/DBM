// This file owns layout and content; the render pipeline owns material. A
// glass panel publishes its geometry through `glass-rects`, and the pipeline
// draws the glass into the frame before Slint composites this scene over it.
//
// So panels have no background of their own: a fill here would paint over
// the glass, not on it.

import { Chrome, Flash, Tip } from "globals.slint";
import {
    FoundItem, GlassRect, ParamItem, PlaylistGroup, PlaylistItem, ScrollFade, TrackItem
} from "models.slint";
import { Motion, Paint, Rows, Type } from "theme.slint";
import { EndChoice, IconButton } from "controls.slint";
import {
    BackRow, DrillRow, EmptyRow, FoundRow, GroupRow, MenuHeading, MenuRow, NoteRow,
    ParamSlider, PlaylistRow, ResumeRow, ShortcutRow, StepperRow, ToggleRow,
} from "rows.slint";
import { AccountPage } from "account.slint";
import { Ring } from "ring.slint";
import { ScrollList } from "scroll_list.slint";
import { Shapes, Squircle } from "squircle.slint";

// What the Rust side reaches besides the window: the globals it drives and
// the structs it fills in.
export { Chrome, Flash, Tip, Motion, Paint, Shapes, GlassRect, ParamItem, PlaylistGroup, PlaylistItem, TrackItem }

export component MainWindow inherits Window {
    // For the task bar and the window switcher, at 256px because window
    // managers scale down better than up. The Windows executable's icon is a
    // separate resource compiled in by `build.rs`.
    icon: @image-url("../icons/128x128@2x.png");

    // --- from the render pipeline ---
    // Written from the rendering notifier, and only when the texture is
    // recreated, never per frame.
    in property <image> video-frame;
    // Targets only grow, so resizing costs no reallocation, which leaves the
    // texture larger than the image in it. This is the part in use, which
    // the video's `source-clip` trims to.
    in property <int> video-clip-w: 1;
    in property <int> video-clip-h: 1;

    // --- mirrored from mpv, via PlayerState ---
    in property <string> media-title;
    /// The title without its show, or nothing for what has none; see
    /// `title-short`.
    in property <string> media-episode;
    in property <string> elapsed: "0:00";
    in property <string> total: "0:00";
    /// Playback position, 0..1.
    in property <float> progress: 0;
    in property <bool> paused;
    in property <bool> muted;
    in property <float> volume: 100;
    in property <bool> has-file;
    /// mpv is holding the last frame of a finished file.
    in property <bool> at-end;
    /// ...and nothing comes after it in the playlist, so all that is left to
    /// offer is this file again.
    in property <bool> at-last;
    /// Nothing comes before this file in the playlist.
    in property <bool> at-first;
    /// The next file as its playlist row names it ("E04 · Slabtown"), for the
    /// end and credits pills. Empty when there is none or the list can't say.
    in property <string> next-label;
    /// The subtitle delay as a number, beside `sub-delay-text`, so undoing a
    /// reset can put it back.
    in property <float> sub-delay;
    /// The speed subtitles run at against the film, for the same undo. Never
    /// shown: it is 1 unless a sync found them timed for another frame rate.
    in property <float> sub-speed: 1;
    /// Where the sync row stands: 0 at rest, 1 listening to the film, 2 with
    /// a sync just made that it can take back.
    in-out property <int> sync-state: 0;
    /// The delay and speed that stood before that sync.
    in property <float> sync-was-delay;
    in property <float> sync-was-speed: 1;
    /// Which row of each list is the current one, or -1. Worked out on the
    /// Rust side, since a model can't be searched from here. The playlist's
    /// is `playlist-current-group` and the row inside it.
    in property <int> sub-current: -1;
    in property <int> audio-current: -1;
    /// The last film left unfinished, offered by the way in. Empty when there
    /// is none; found once, off the frame path, a moment after startup.
    in property <string> resume-path;
    in property <string> resume-title;
    /// The show it is an episode of, or empty for a film. Shown on its own
    /// line above Continue, where a playlist puts a show's name.
    in property <string> resume-show;
    in property <float> resume-progress;
    property <bool> has-resume: root.resume-path != "";
    in property <string> resume-left;
    /// Whether a picture is drawn behind the way in for its glass to bend.
    /// It needs a film left unfinished and a seek-preview atlas built for it,
    /// so a fresh profile stays at Ground (see the way in's fill).
    in property <bool> backdrop;
    /// Where the way on goes once a list has run out, and what it is called:
    /// the next season when a folder beside this one holds the same show,
    /// otherwise the newest other film still unfinished. Looked for at the
    /// end of the last file, so empty until then or when there is none.
    in property <string> onward-path;
    in property <string> onward-label;
    /// Whether that is more of the same show. Only then does the credits pill
    /// offer it: skipping an episode's credits for the next one is expected,
    /// but skipping a film's credits for another film is not.
    in property <bool> onward-season;
    /// At the end of the last file, where it is an episode, the season it
    /// ends: *Season 4 finished*. Empty otherwise.
    in property <string> season-done;
    /// The playing file, for the dialogs to open near.
    in property <string> current-path;
    in property <float> duration;
    /// Playback speed, as a number and as a person writes it: "1.5×".
    in property <float> speed: 1;
    in property <string> speed-text: "1×";
    property <bool> speed-shown: root.has-file && (root.speed < 0.999 || root.speed > 1.001);
    /// Chapter starts, in seconds. Empty for most files.
    in property <[float]> chapter-marks;
    /// What the chapter playing is called.
    in property <string> chapter-label;
    /// An episode's closing credits are playing: a chapter named for them in
    /// the file's second half or one after it, or else the stretch its ending
    /// shares with the next episode's. A film's too, where a scene follows
    /// them. Decided on the Rust side.
    in property <bool> credits-rolling;
    /// Where the scene after the credits starts, in seconds, where one does:
    /// what skipping them lands on. 0 where they run to the end.
    in property <float> after-credits;
    /// An episode's title sequence is playing with enough left to be worth
    /// skipping, and where it ends, in seconds. Found from a chapter named for
    /// it, or else from the stretch this episode shares with its neighbours
    /// (see `titles`).
    in property <bool> intro-rolling;
    in property <float> intro-end;
    /// Whether subtitles are actually on screen: mpv's `sub-visibility` and a
    /// track selected. Either alone misleads, since visibility with no track
    /// shows nothing, and a track with visibility off is only the one the
    /// next toggle brings back.
    in property <bool> subs-visible;
    in property <bool> panscan;
    // --- seek preview ---
    // The thumbnail is one tile of a sprite atlas, picked with `source-clip`
    // as the video is. Nothing here knows how the atlas was made.
    in property <string> preview-time: "0:00";
    in property <image> preview-sprite;
    in property <int> preview-tile-w;
    in property <int> preview-tile-h;
    in property <int> preview-clip-x;
    in property <int> preview-clip-y;

    // Subtitle adjustments, formatted on the Rust side, which owns the units.
    in property <string> sub-delay-text: "0.00 s";
    /// The widest the delay reads, either way, on a line each, for Timing's
    /// readout to be as wide as in the language spoken.
    in property <string> sub-delay-widest;
    in property <string> sub-scale-text: "1.00×";
    in property <string> sub-pos-text: "100%";
    in property <[TrackItem]> sub-tracks;
    in property <[TrackItem]> audio-tracks;

    // --- finding subtitles on OpenSubtitles --------------------------------
    //
    // In a build with an API key, the subtitle list's last row opens a page
    // listing what OpenSubtitles holds for the film. Picking one fetches and
    // loads it, and goes back to the tracks with it lit. Both are network
    // round trips on the Rust side (see `opensubtitles`). A download refused
    // for want of an account opens a third page, one further in, to sign in
    // on, and signing in fetches it (see `AccountPage`).

    /// Whether there is any searching to be done: a key, and a film.
    in property <bool> find-offered;
    /// The search's page is the one the subtitles menu shows.
    in-out property <bool> find-open: false;
    /// 0 nothing asked yet, 1 searching, 2 results, 3 none found, 4 failed.
    in-out property <int> find-state: 0;
    /// Why a search failed, in words.
    in property <string> find-said;
    in property <[FoundItem]> find-hits;
    /// The row being fetched, or -1. One at a time.
    in-out property <int> find-fetching: -1;
    callback find-subtitles();
    callback fetch-subtitle(int);
    /// Who is signed in to OpenSubtitles, or empty.
    in property <string> find-account;
    /// The account's downloads left today, or -1 where OpenSubtitles hasn't
    /// said.
    in property <int> find-left: -1;
    /// The account's page is the one the subtitles menu shows.
    in-out property <bool> account-open: false;
    in-out property <bool> signing-in: false;
    /// Why the last sign-in failed, in words, or empty.
    in-out property <string> sign-in-said;
    /// Why the sign-in's page opened: the refusal that sent the person there.
    property <string> sign-in-why;
    /// Sign in with what was typed. Straight to the network thread, and
    /// nowhere else (see `opensubtitles::account`).
    callback sign-in(string, string);
    callback sign-out();
    property <bool> signed-in: root.find-account != "";
    /// How many results the search's page lists, from its second row.
    property <int> find-hit-count: root.find-state == 2 ? root.find-hits.length : 0;
    /// The account's row on the search's page, under the results, while
    /// someone is signed in.
    property <int> find-account-at: 1 + root.find-hit-count;
    /// The result whose download asked for the sign-in, or -1, so the way
    /// back from signing in lands on it.
    property <int> find-asked: -1;
    /// The account's page is on screen, so its fields may have the keyboard.
    property <bool> account-shown: root.menu-open && root.find-open && root.account-open;
    /// Counts the ring's presses of *Sign in* (see `AccountPage`).
    property <int> sign-in-presses: 0;
    /// Remove a track loaded from its own file: a subtitle when the flag is
    /// set, an audio track otherwise.
    callback remove-track(int, bool);

    /// Delete on a tracks panel: arms the track the ring is on, or removes it
    /// if it is armed, where it can be removed; says whether it could.
    function remove-focused-track() -> bool {
        if (root.audio-open) {
            if (root.focus-row < root.audio-tracks.length
                    && root.audio-tracks[root.focus-row].external) {
                root.remove-row(root.audio-tracks[root.focus-row].id, false);
                return true;
            }
            return false;
        }
        if (root.find-open || root.subs-page != 0) {
            return false;
        }
        if (root.focus-row >= 1 && root.focus-row <= root.sub-tracks.length
                && root.has-subs) {
            if (root.sub-tracks[root.focus-row - 1].external) {
                root.remove-row(root.sub-tracks[root.focus-row - 1].id, true);
                return true;
            }
        }
        return false;
    }

    /// Show the search's page, searching only if it has no answer yet, since
    /// a list found a moment ago is still good. Public for the test that
    /// walks it.
    public function open-find() {
        root.subs-page = 0;
        root.menu-leaf = 3;
        root.find-open = true;
        root.focus-row = 0;
        if (root.find-state != 1 && root.find-state != 2) {
            root.find-subtitles();
        }
    }

    /// Back to the tracks, on the row that opened the search.
    function close-find() {
        root.find-open = false;
        root.account-open = false;
        root.find-asked = -1;
        root.focus-row = root.subs-focus-count - 1;
    }

    /// A download was refused until someone signs in: the sign-in's page,
    /// saying `why`, if the search's page is still the one showing. Says
    /// whether it was, since otherwise the refusal is a notice like any
    /// other.
    public function offer-sign-in(row: int, why: string) -> bool {
        if (!root.menu-open || !root.find-open || root.account-open) {
            return false;
        }
        root.find-asked = row;
        root.sign-in-why = why;
        root.open-account();
        return true;
    }

    /// The account's page, on its first field, or on *Sign out*.
    function open-account() {
        root.account-open = true;
        root.sign-in-said = "";
        root.focus-row = 1;
    }

    /// Back to the search: on the result that asked for the sign-in, or on
    /// the account's row, or where it was if signing out took it away.
    public function close-account() {
        root.account-open = false;
        root.focus-row = root.find-asked >= 0 ? root.find-asked + 1
            : min(root.find-account-at, root.find-focus-count - 1);
        root.find-asked = -1;
    }

    /// Enter on the account's page. On a field it moves on, and from the
    /// password it sends, as *Sign in* does.
    function account-activate() {
        if (root.focus-row == 0) {
            root.close-account();
        } else if (root.signed-in) {
            root.sign-out();
            root.close-account();
        } else if (root.focus-row == 1) {
            root.focus-row = 2;
        } else {
            root.sign-in-presses += 1;
        }
    }

    /// The ring is on one of the sign-in's fields, which have the keyboard
    /// while it is (see `Field`).
    property <bool> on-field: root.account-shown && !root.signed-in
        && (root.focus-row == 1 || root.focus-row == 2);
    // Back to the window once the ring leaves the fields, or the page goes,
    // however it goes: otherwise nothing would answer the keys until the
    // next click.
    changed on-field => {
        if (!root.on-field) {
            keys.focus();
        }
    }

    function fetch-row(row: int) {
        if (root.find-fetching < 0 && row >= 0 && row < root.find-hits.length) {
            root.fetch-subtitle(row);
        }
    }

    /// The search's page: its way back, then its results, or one line saying
    /// it is searching, found nothing, or failed; then, a group gap under
    /// them, what is OpenSubtitles' rather than the film's: the account
    /// signed in, and the credit it asks for where its subtitles are picked.
    property <int> find-focus-count: 1 + root.find-hit-count + (root.signed-in ? 1 : 0);
    property <length> find-natural: root.find-state == 2
        ? root.find-hits.length * root.row-h : root.row-h;
    /// The credit's line: a heading's height, as a line about the rows
    /// rather than one of them.
    property <length> credit-h: Rows.heading;
    /// What isn't the list: the way back, and under the gap the account's
    /// row and the credit.
    property <length> find-fixed: root.row-h + Rows.group-gap
        + (root.signed-in ? root.row-h : 0px) + root.credit-h;
    property <length> find-h: min(root.panel-pad + root.find-fixed + root.find-natural,
        root.panel-max-h);
    property <length> find-list-h: root.find-state == 2
        ? max(0px, menu.height - root.panel-pad - root.find-fixed) : 0px;
    property <length> find-rest-h: min(root.find-natural,
        max(0px, root.panel-max-h - root.panel-pad - root.find-fixed));
    /// The account's page: its way back, then why it opened, the two fields
    /// and *Sign in and download*, and why that failed; or who is signed in,
    /// what is left, and *Sign out*.
    property <int> account-focus-count: root.signed-in ? 2 : 4;
    property <length> account-h: root.panel-pad + root.row-h * (root.signed-in
        ? 3 + (root.find-left >= 0 ? 1 : 0)
        : 4 + (root.sign-in-said != "" ? 1 : 0))
        + (!root.signed-in && root.sign-in-why != ""
            ? 2 * Rows.note-line + Rows.group-gap : 0px);
    // --- the subtitles' own pages ---------------------------------------------
    //
    // While a subtitle is showing, two rows under the tracks lead to a page
    // each: its timing, which is this film's alone, and the size and position
    // every film's subtitles take. Both are judged by eye, so neither is
    // offered with nothing on screen to judge.

    /// The page the menu shows when it isn't the search's: 0 the tracks,
    /// 1 timing, 2 size and position.
    property <int> subs-page: 0;
    /// Which page the pane one step in draws: 1 timing, 2 size and position,
    /// 3 the search. Held rather than read from `subs-page` and `find-open`,
    /// which have gone back to the tracks while the page sliding out still
    /// has to draw.
    property <int> menu-leaf: 3;
    /// The timing's page: its way back, Sync to speech and Timing, then a gap
    /// and the reset while there is something to reset.
    property <length> timing-page-h: root.panel-pad + 2 * root.row-h + Rows.stepper-row
        + (root.timing-resettable ? Rows.group-gap + root.row-h : 0px);
    /// The size and position's page: its way back, the two steppers, a gap
    /// and the reset.
    property <length> placing-page-h: root.panel-pad + 2 * root.row-h
        + 2 * Rows.stepper-row + Rows.group-gap;
    /// The rows of whichever of the two is showing, counted the same way. The
    /// reset is the fourth row on both.
    property <int> subs-page-count: root.subs-page == 1 && !root.timing-resettable ? 3 : 4;
    /// What the reset on that page resets (see "resetting a page").
    property <int> subs-page-reset: root.subs-page == 1 ? 3 : 4;

    /// The ring is on the tracks' page, where the rows go by `focus-row`
    /// alone; on any other page the same number is another page's row.
    property <bool> on-tracks: root.menu-open && !root.find-open && root.subs-page == 0;
    /// The ring is on `row` of page `page` of the two.
    pure function subs-ring(page: int, row: int) -> bool {
        return root.menu-open && !root.find-open && root.subs-page == page
            && root.focus-row == row;
    }

    /// Open one of the two pages on its way back, as a settings page opens.
    /// Public so a test can show one.
    public function open-subs-page(page: int) {
        if (!root.menu-open) {
            root.open-menu(true);
        }
        if (!root.subs-showing) {
            return;
        }
        root.find-open = false;
        root.account-open = false;
        root.menu-leaf = page;
        root.subs-page = page;
        root.focus-row = 0;
    }

    /// Back to the tracks, on the row that opened the page.
    function close-subs-page() {
        root.focus-row = root.subs-pages-at + root.subs-page - 1;
        root.subs-page = 0;
    }

    /// Enter on one of the two pages. The steppers are moved by left and
    /// right, and Enter on one does nothing.
    function subs-page-activate() {
        if (root.focus-row == 0) {
            root.close-subs-page();
        } else if (root.subs-page == 1 && root.focus-row == 1) {
            root.sync-row();
        } else if (root.focus-row == 3) {
            root.reset-row(root.subs-page-reset);
        }
    }

    /// The subtitles menu's height: whichever of its pages is showing.
    property <length> menu-h: root.find-open
        ? (root.account-open ? root.account-h : root.find-h)
        : root.subs-page == 1 ? root.timing-page-h
        : root.subs-page == 2 ? root.placing-page-h
        : root.subs-h;
    /// A page sliding in over the tracks, as a settings page does, and the
    /// account's over the search's.
    property <float> menu-drill: root.find-open ? (root.account-open ? 2.0 : 1.0)
        : root.subs-page != 0 ? 1.0 : 0.0;
    animate menu-drill {
        duration: root.resizing ? 0ms : Motion.drill;
        easing: ease-in-out;
    }
    /// Between the tracks and one of their pages. Both then hang from the
    /// menu's bottom edge, which stays put, rather than from its top, which
    /// moves: the row the ring comes back to is near the bottom, and hung
    /// from the top it would rise into the panel from under it. At rest they
    /// hang from the top, where both ways agree, so a row a page gains in
    /// place shows at its foot as the panel grows to it.
    property <bool> menu-moving: root.menu-drill > 0.0 && root.menu-drill < 1.0;
    /// The playlist in the parts the panel shows: its seasons, or the shows
    /// and films of a folder holding several (see `shelf`). A single part is
    /// shown as a plain list; several get a page listing them, and a page each.
    in property <[PlaylistGroup]> playlist-groups;
    /// Which part holds the file playing, or -1.
    in property <int> playlist-current-group: -1;
    /// Whether any part is more than one file, and so opens rather than
    /// plays. File rows beside such a part leave the chevron's column empty,
    /// so the columns line up.
    in property <bool> playlist-drills;
    /// The page the panel is on: -1 for the list of parts, otherwise that
    /// part's files. `in-out` because the Rust side keeps it on the same part
    /// when the parts around it change.
    in-out property <int> playlist-page: 0;
    property <bool> playlist-tiered: root.playlist-groups.length > 1;
    property <bool> playlist-top: root.playlist-tiered && root.playlist-page < 0;
    /// 0 on the list of parts, 1 on a part's page: the playlist's `drill`,
    /// animated so the change of page can be followed. A single part has no
    /// list of parts, so this stays 1.
    property <float> playlist-drill: root.playlist-top ? 0.0 : 1.0;
    animate playlist-drill {
        duration: Motion.drill;
        easing: ease-in-out;
    }
    /// Which part the drilled-in page draws.
    ///
    /// Held rather than read from `playlist-page`, which is -1 during the way
    /// back, while the page sliding out still has to draw its part. Updated
    /// here rather than at the call sites, because the Rust side moves the
    /// page too.
    property <int> playlist-leaf: 0;
    changed playlist-page => {
        if (root.playlist-page >= 0) {
            root.playlist-leaf = root.playlist-page;
        }
    }
    /// The part on the drilled-in page, and its files.
    property <int> playlist-shown-group: root.playlist-tiered ? root.playlist-leaf : 0;
    property <[PlaylistItem]> playlist-entries:
        root.playlist-groups[root.playlist-shown-group].entries;
    /// The rows the list scrolls through, and whether a way back leads them
    /// as focus row 0.
    property <int> playlist-rows: root.playlist-top
        ? root.playlist-groups.length : root.playlist-entries.length;
    property <int> playlist-lead: root.playlist-tiered && !root.playlist-top ? 1 : 0;
    /// What to call the playlist: the show's name when every entry is from
    /// one, "PLAYLIST" otherwise. Decided on the Rust side, which parses the
    /// names.
    in property <string> playlist-heading: "PLAYLIST";
    /// Whether that heading is a show's name or the generic label.
    in property <bool> playlist-named;
    // One list per settings page, split on the Rust side so each page binds
    // straight to its own rows.
    in property <[ParamItem]> glass-params;
    in property <[ParamItem]> border-params;
    /// Every slider's name on a line of its own, measured by `param-measure`
    /// for the column both pages set their names in.
    in property <string> param-names;
    /// 2px wider than the widest name, so with the row's 8px spacing the
    /// track sits 10px off the words.
    property <length> param-name-w: param-measure.preferred-width + 2px;
    /// Why the player can't show video at all, or empty when it can.
    ///
    /// Set once, during graphics setup, and never cleared: every way it can be
    /// set leaves the player with no render context for the rest of the run.
    in property <string> fatal: "";
    /// The failure in the graphics driver's or mpv's own words, kept apart so
    /// `fatal` stays readable. On screen because a packaged build has no
    /// console for it.
    in property <string> fatal-detail: "";
    /// What usually puts it right, worded for the failure it is. Not always
    /// the driver: refused shaders can be the player's fault, and blaming the
    /// driver would send someone to update one that was never the problem.
    in property <string> fatal-note: "";
    // --- keyboard reach ---
    //
    // Every panel can be driven from the keyboard, because a player that
    // hides its chrome after three seconds shouldn't need a mouse to change
    // the subtitle track.
    //
    // One integer rather than a focus scope per row. The panels are already
    // arithmetic, and an index can skip what a traversal order can't:
    // headings, the empty row and the shortcuts reference, where a ring would
    // be a dead step to press through.
    //
    // The arrow keys already seek and set the volume, so a panel claims them
    // only while the row under the ring can use them: left and right adjust
    // a focused slider or stepper, and otherwise still seek.
    /// Which row the keyboard is on inside whatever is open. `out` for the
    /// tests, since the ring is only a wash and gives them nothing to read.
    out property <int> focus-row: 0;
    /// The subtitles menu's rows: the tracks, `Off` among them since it is
    /// the one people reach for, then the ways to the pages of the one
    /// showing, then the search.
    property <int> subs-focus-count: root.subs-track-rows + (root.subs-showing ? 2 : 0)
        + (root.find-offered ? 1 : 0);
    property <int> subs-track-rows: root.has-subs ? 1 + root.sub-tracks.length : 0;
    /// Where the ways to the pages start: Timing, then Size & position.
    property <int> subs-pages-at: root.subs-track-rows;
    /// How many rows what is on screen offers the keyboard. Zero, as when a
    /// film plays with nothing open, means the keys ignore the ring.
    property <int> focus-count:
        root.menu-open ? (root.find-open
            ? (root.account-open ? root.account-focus-count : root.find-focus-count)
            : root.subs-page != 0 ? root.subs-page-count : root.subs-focus-count)
        : root.audio-open ? root.audio-tracks.length
        : root.playlist-open ? root.playlist-lead + root.playlist-rows + 1
        : root.files-open ? 2
        : root.settings-open ? root.settings-focus-count
        : (!root.has-file && root.fatal == "") ? 4 + root.invite-first
        : (!root.has-file && root.fatal != "") ? 2
        : 0;
    /// The way in's rows start one further down when the first is Continue.
    property <int> invite-first: root.has-resume ? 1 : 0;
    /// Whether the first Enter presses Continue on an empty window. Elsewhere
    /// the first Enter only shows the ring, since nobody chose the row it
    /// would press, but Continue is what the window was opened to get back to.
    property <bool> continue-sure: !root.has-file && root.fatal == ""
        && !root.panel-open && root.has-resume && root.focus-row == 0;
    /// A page whose last row is its reset. The ring stops at the ends of
    /// these rather than wrapping, so Up from the top can't land on the row
    /// that throws a page of tuning away.
    property <bool> focus-has-reset: root.settings-open
        ? root.settings-page == 1 || root.settings-page == 2
        : root.menu-open && !root.find-open && root.subs-page != 0
            && root.subs-page-count == 4;
    /// Per page: the rows, the way back, and the reset after them, plus the
    /// switch on the ambient border's.
    /// Accessibility has no reset, since each switch undoes itself, and the
    /// shortcuts page has only the way back.
    property <int> settings-focus-count:
        root.settings-page == 0 ? 5
        : root.settings-page == 1 ? 2 + root.glass-params.length
        : root.settings-page == 2 ? 3 + root.border-params.length
        : root.settings-page == 3 ? 5
        : root.settings-page == 5 ? 1 + root.language-count
        : 1;
    /// The same count for `leaf-page`, which on the way back out isn't the
    /// page the keyboard is on. Counting off the live page would light the
    /// wrong reset row on a page halfway out of the panel.
    property <int> leaf-focus-count:
        root.leaf-page == 1 ? 2 + root.glass-params.length
        : root.leaf-page == 2 ? 3 + root.border-params.length
        : root.leaf-page == 3 ? 5
        : root.leaf-page == 5 ? 1 + root.language-count
        : 1;

    /// The bundled languages besides English, each by its own name. Nothing
    /// here names one, so a build can hold any set.
    in property <[string]> language-names;
    /// The lit row of the language page: 0 the system's, 1 English, then the
    /// built-in ones in the order of `language-names`.
    in-out property <int> language-choice: 0;
    /// Its rows, the two fixed ones included.
    property <int> language-count: 2 + root.language-names.length;
    callback choose-language(int);

    function pick-language(row: int) {
        root.language-choice = row;
        root.choose-language(row);
    }

    /// Whether an open is in flight, from the path reaching the worker until
    /// mpv has the file. That covers the scan, the playlist and mpv's own
    /// open, during which there is nothing to show yet.
    in property <bool> opening: false;
    /// What is being opened, named the way a person would name it: the file
    /// or the folder, not the path.
    in property <string> opening-name: "";
    // Effect switches: in-out because the saved settings push them at
    // startup, and a click or a key sets them here.
    in-out property <bool> ambience-on: true;
    in-out property <bool> autoplay: true;
    /// Registry index and its new normalised position.
    callback set-param(int, float);
    /// Restore one section to its defaults: 0 glass, 1 ambient border, as in
    /// `settings::Section`.
    callback reset-section(int);
    /// Take back the last reset of a settings page, as the panel numbers them.
    callback undo-reset(int);
    /// One rung of the speed ladder from the speed shown, -1 or +1.
    callback step-speed(float, int);
    callback reset-speed();
    callback frame-step(int);
    callback chapter-step(int);
    /// Subtitles or audio, and which way.
    callback cycle-track(bool, int);
    callback quit();
    /// Straight to the window rather than through `minimized`, which a Wayland
    /// client is never told has been undone (see `window::minimize`).
    callback minimize();
    callback set-ambience(bool);
    callback set-autoplay(bool);
    /// The accessibility page's switch. `Motion.enabled` is already set when
    /// this runs; it saves the choice and tells the pipeline, which draws the
    /// backdrop's fade.
    callback set-animations(bool);
    /// Whether the glass is held dark enough for its words over a bright
    /// frame, from the same page; Rust saves it and tells the pipeline.
    in-out property <bool> legible-glass: true;
    callback set-legible-glass(bool);
    /// The same for its two tip switches: `Tip` is already set, and these
    /// save the choice.
    callback set-tips(bool);
    callback set-tip-keys(bool);

    // --- actions, executed on the Rust side ---
    // Keys are handled here rather than in Rust because Slint's `Key.*`
    // constants are private-use characters, so Rust gets named intentions
    // rather than keycodes.
    callback toggle-pause();
    callback toggle-mute();
    callback toggle-subtitles();
    callback toggle-panscan();
    callback toggle-fullscreen();
    callback leave-fullscreen();
    callback restart();
    /// This file again, from the start, playing.
    callback replay();
    /// The next file, playing.
    callback play-next();
    /// Past the title sequence or the credits: seconds from the start,
    /// landing exactly.
    callback skip-to(float);
    /// Seconds, signed.
    callback seek-relative(float);
    /// Absolute position as 0..1 of the file, landing exactly.
    callback seek-fraction(float);
    /// A drag in progress, coalesced on the Rust side and seeked to keyframes
    /// while the hand is fast and to the frame once it slows. The release
    /// lands with `seek-fraction`.
    callback seek-scrub(float);
    /// The button is still down on the timeline, and where the pointer is.
    /// Sent a few times a second, moving or not, because no pointer event
    /// says that a drag has stopped.
    callback seek-held(float);
    /// Where the pointer is over the timeline, 0..1. Answered by setting
    /// `preview-time` and the tile offsets, since the formatting and the tile
    /// arithmetic live on the Rust side, where they are tested.
    callback preview-at(float);
    callback nudge-volume(float);
    callback nudge-sub-delay(float);
    callback nudge-sub-scale(float);
    callback nudge-sub-pos(float);
    /// The subtitles' size and position back to their defaults.
    callback reset-subtitles();
    /// Listen to the film and move the subtitles onto its speech. The answer
    /// arrives some seconds later, as `sync-state` leaving 1.
    callback sync-subtitles();
    /// Put this film's subtitles at a delay and a speed, and keep its place
    /// at once: what stood before a sync or a reset of the timing, or the
    /// reset itself.
    callback set-timing(float, float);
    /// -1 previous, +1 next.
    callback playlist-step(int);
    /// Ask for a video, or for a folder to play through.
    callback open-file();
    callback open-folder();
    /// A path to open, from a dialog or a drop. The flag is whether arriving
    /// at a file with a saved place asks where to start (see `arriving`),
    /// which it does unless the opening was Continue.
    callback open-path(string, bool);
    /// The file just opened was left part way, and is held paused there until
    /// the centre pill is answered: on from there, or from the beginning (see
    /// `playback::arrival`).
    in property <bool> arriving;
    /// Where it was left, as the timeline writes a time.
    in property <string> arrival-from;
    /// The answer: true for from the beginning.
    callback arrival-answer(bool);
    /// Where a file that autoplay started from the beginning had been left,
    /// for its first ten seconds, as the timeline writes a time; empty
    /// otherwise. The corner pill offers to go on from there.
    in property <string> resume-offer;
    callback take-resume-offer();
    /// Track id, or -1 to turn subtitles off.
    callback select-subtitle(int);
    callback select-audio(int);
    callback play-index(int);
    callback set-volume(float);
    /// A click on the video, deferred in Rust so that a double-click can
    /// cancel it rather than pause and unpause on the way to fullscreen.
    callback video-clicked();
    callback video-double-clicked();

    // Pushed from Rust at startup, so `commands.rs` is the one place these
    // are defined.
    in property <float> seek-step: 10;
    in property <float> volume-step: 2;
    in property <float> delay-step: 0.1;
    in property <float> sub-scale-step: 0.05;
    in property <float> sub-pos-step: 2;
    in property <float> scroll-seek-step: 1;
    in property <float> fine-seek-step: 1;
    /// Matches mpv's own ceiling, so 100% sits where mpv puts it.
    in property <float> volume-max: 200;

    // Indexed rather than picked by a conditional chain, because twenty
    // branches overflowed the compiler's stack.
    property <[image]> volume-icons: [
        @image-url("../../../public/icons/volume-000.svg"),
        @image-url("../../../public/icons/volume-001.svg"),
        @image-url("../../../public/icons/volume-010.svg"),
        @image-url("../../../public/icons/volume-020.svg"),
        @image-url("../../../public/icons/volume-030.svg"),
        @image-url("../../../public/icons/volume-040.svg"),
        @image-url("../../../public/icons/volume-050.svg"),
        @image-url("../../../public/icons/volume-060.svg"),
        @image-url("../../../public/icons/volume-070.svg"),
        @image-url("../../../public/icons/volume-080.svg"),
        @image-url("../../../public/icons/volume-090.svg"),
        @image-url("../../../public/icons/volume-100.svg"),
        @image-url("../../../public/icons/volume-110.svg"),
        @image-url("../../../public/icons/volume-120.svg"),
        @image-url("../../../public/icons/volume-130.svg"),
        @image-url("../../../public/icons/volume-140.svg"),
        @image-url("../../../public/icons/volume-150.svg"),
        @image-url("../../../public/icons/volume-160.svg"),
        @image-url("../../../public/icons/volume-170.svg"),
        @image-url("../../../public/icons/volume-180.svg"),
    ];
    // 0 is silence, 1 the "barely on" glyph, then one per 10 units.
    property <int> volume-index: root.volume < 0.5 ? 0
        : root.volume < 10 ? 1
        : Math.min(19, 1 + Math.floor(root.volume / 10));

    // in-out so the tests can open them.
    in-out property <bool> menu-open: false;
    in-out property <bool> audio-open: false;
    in-out property <bool> playlist-open: false;
    in-out property <bool> files-open: false;
    in-out property <bool> settings-open: false;
    /// Which page the settings panel shows: 0 the list, then its rows in
    /// order (1 glass, 2 ambient border, 3 accessibility, 4 shortcuts,
    /// 5 language), so the focused row plus one is its page.
    /// Pages replace each other in place, so there is only one settings glass
    /// rect. Out so a test can say which page a key left it on.
    out property <int> settings-page: 0;
    in-out property <bool> fullscreen: false;
    // Rust owns the idle clock; what it means is decided here. The chrome
    // stays up while a panel is open, while a film is paused, since pausing
    // is stopping to look at where you are, and under a pointer resting on
    // the bar or the window's buttons, rather than leaving from under the
    // hand about to use them.
    property <bool> controls-visible: !Chrome.idle || root.panel-open
        || (root.paused && root.has-file && !root.stepped)
        || root.bar-hovered || root.window-hovered;
    /// Whether the pointer is on the bar: its pane, its two tracks or one
    /// of its buttons.
    property <bool> bar-hovered: bar-pane.has-hover || scrub.has-hover || vol.has-hover
        || playlist-button.hovered || files-button.hovered || back-button.hovered
        || previous-button.hovered || play-button.hovered || next-button.hovered
        || forward-button.hovered || mute-button.hovered || audio-button.hovered
        || subs-button.hovered || settings-button.hovered || panscan-button.hovered
        || fullscreen-button.hovered;
    property <bool> window-hovered: window-pane.has-hover || minimize-button.hovered
        || maximize-button.hovered || close-button.hovered;

    /// Whether the pause is one a frame step made. Stepping is looking at
    /// the picture, which the bar would cover the foot of, not at where you
    /// are, so the bar isn't held for it.
    property <bool> stepped: false;
    /// A step sent and not yet landed. mpv steps from a pause by playing a
    /// frame and pausing again, and that moment of play is no one resuming.
    property <bool> step-landing: false;
    // Given up on after a while, since a step that never shows as play
    // would otherwise outlast it and keep a later resume from counting.
    Timer {
        interval: 500ms;
        running: root.step-landing;
        triggered => {
            root.step-landing = false;
        }
    }
    changed paused => {
        if (root.paused) {
            root.step-landing = false;
        } else if (!root.step-landing) {
            root.stepped = false;
        }
    }

    /// Whether the timeline is up on its own, after a seek from the keyboard:
    /// the one thing a seek changes, without the buttons.
    property <bool> timeline-glimpse: false;
    glimpse-timer := Timer {
        interval: Chrome.hide-after;
        running: false;
        triggered => {
            glimpse-timer.stop();
            root.timeline-glimpse = false;
        }
    }

    /// Whether what is loaded is up on its own, the bar's title group without
    /// the rest: as a file starts, since its name is the one thing worth
    /// seeing then, and while an open is in flight, since "Opening …" there
    /// is the only sign a slow scan hasn't been ignored.
    property <bool> title-glimpse: root.opening || root.title-lingering;
    /// A file's three seconds of that, as it starts; an open's last as long
    /// as the open.
    property <bool> title-lingering: false;
    title-timer := Timer {
        interval: Chrome.hide-after;
        running: false;
        triggered => {
            title-timer.stop();
            root.title-lingering = false;
        }
    }

    // Ends `Chrome.settling`: long enough for a window going in or out of
    // fullscreen to reach its new size, short enough that a hand reaching
    // for the mouse straight after finds the chrome.
    Timer {
        interval: 500ms;
        running: Chrome.settling;
        triggered => {
            Chrome.settling = false;
        }
    }

    /// The seek is newer news than the file's name, so it takes the title's
    /// place.
    function glimpse-timeline() {
        root.key-wake = 1;
        root.timeline-glimpse = true;
        glimpse-timer.stop();
        glimpse-timer.start();
        root.title-lingering = false;
        title-timer.stop();
    }

    function glimpse-title() {
        root.title-lingering = true;
        title-timer.stop();
        title-timer.start();
    }

    /// Put the chrome away for a key or a double-click that asked for the
    /// picture, glimpses and all.
    function put-away() {
        Chrome.rest();
        root.timeline-glimpse = false;
        glimpse-timer.stop();
        root.title-lingering = false;
        title-timer.stop();
    }

    /// What the key being handled does to the chrome: 0 wakes it; 1 brings
    /// up nothing, for a key whose own answer is enough (its flash, the
    /// timeline, the picture), though it keeps up what is; 2 puts it away,
    /// for a key that asked for the picture: more of it, or the film going
    /// on.
    property <int> key-wake: 0;

    /// Shift and the rest pressed alone, which arrive as keys of their own
    /// ahead of the key they modify, and would wake the bar before a Shift+→
    /// could decide it shouldn't.
    function lone-modifier(text: string) -> bool {
        return text == Key.Shift || text == Key.ShiftR || text == Key.Control
            || text == Key.ControlR || text == Key.Alt || text == Key.AltGr
            || text == Key.Meta || text == Key.MetaR;
    }

    function after-key(text: string) {
        if (root.key-wake == 2) {
            root.put-away();
        } else if ((root.key-wake == 0 && !root.lone-modifier(text)) || !Chrome.idle) {
            Chrome.bump();
        }
    }

    /// Whether the pointer should be off screen: over a film with the chrome
    /// gone, but never on an empty window, where it is how the way in is
    /// reached.
    ///
    /// Decided here and carried out by `cursor` on the Rust side, which says
    /// why a `mouse-cursor` binding can't do it. `out` so a test can read the
    /// decision.
    out property <bool> pointer-hidden: root.has-file && !root.controls-visible;

    changed pointer-hidden => {
        Chrome.hide-pointer(root.pointer-hidden);
    }

    // A ring on the bar goes with the bar, or Enter twenty minutes later
    // would press whatever it was last on. A ring on a pill stays, since the
    // pills outlast the bar on purpose. With no film the ring is on the way
    // in, which stays too.
    //
    // The place is kept for the next Tab, because reading along the bar one
    // tip at a time is slow enough for the idle clock to run out partway.
    changed controls-visible => {
        if (!root.controls-visible && root.has-file && root.bar-focus < root.pill-stop) {
            root.bar-resume = Chrome.focus-visible;
            Chrome.focus-visible = false;
        }
        root.shape-bar();
    }

    changed timeline-glimpse => {
        root.shape-bar();
    }

    changed title-glimpse => {
        root.shape-bar();
    }

    /// Whether the bar is whole, or a part of it alone. Left as it is while
    /// the bar leaves, so it fades out in the shape it had rather than
    /// shrinking first.
    property <bool> bar-whole: true;
    /// Which part is up when the bar isn't whole: 0 the timeline, 1 what is
    /// loaded.
    property <int> bar-part: 0;
    /// Whether the bar takes its new shape at once, as it does when it was
    /// gone, rather than growing into it.
    property <bool> bar-snap: false;

    function shape-bar() {
        if (!(root.controls-visible || root.timeline-glimpse || root.title-glimpse)) {
            return;
        }
        // From one part alone to the other there is nothing to grow through.
        root.bar-snap = root.bar-shown < root.shown-epsilon
            || (!root.bar-whole && root.bar-part != root.part-alone());
        root.bar-part = root.part-alone();
        root.bar-whole = root.controls-visible;
    }

    /// The part to show alone, the seek's before the file's.
    pure function part-alone() -> int {
        return root.timeline-glimpse ? 0 : root.title-glimpse ? 1 : root.bar-part;
    }

    /// Scroll whichever list the ring is in to keep its row in view.
    function focus-scroll() {
        if (root.menu-open && root.find-open) {
            if (!root.account-open && root.focus-row >= 1
                    && root.focus-row < root.find-account-at) {
                find-list.reveal((root.focus-row - 1) * root.row-h, root.row-h);
            }
        } else if (root.menu-open) {
            if (root.subs-page == 0 && root.focus-row < root.subs-track-rows) {
                subs-list.reveal(root.focus-row * root.row-h, root.row-h);
            }
        } else if (root.audio-open) {
            audio-list.reveal(root.focus-row * root.row-h, root.row-h);
        } else if (root.playlist-open && root.focus-row >= root.playlist-lead
                && root.focus-row < root.playlist-lead + root.playlist-rows) {
            if (root.playlist-top) {
                playlist-top-list.reveal(root.focus-row * root.row-h, root.row-h);
            } else {
                playlist-leaf-list.reveal(
                    (root.focus-row - root.playlist-lead) * root.row-h, root.row-h);
            }
        } else if (root.settings-open && root.settings-page != 4
                && (root.settings-page == 0 || root.focus-row > 0)) {
            root.settings-reveal-top =
                root.settings-row-top(root.settings-page, root.focus-row);
            root.settings-reveal-h =
                root.settings-row-h(root.settings-page, root.focus-row);
            root.settings-reveal-tick += 1;
        }
    }

    changed focus-row => {
        root.focus-scroll();
    }

    /// Turn the ring on at a row and bring that row into view. The scroll is
    /// explicit because the ring often comes up on the row it was already on,
    /// which the wheel may have moved off screen since.
    function focus-show(row: int) {
        Chrome.focus-visible = true;
        root.focus-row = row;
        root.focus-scroll();
    }

    /// The row the subtitles menu opens on: the subtitle in use, or Off when
    /// none is showing.
    property <int> subs-open-row: root.has-subs && root.subs-visible
        && root.sub-current >= 0 ? root.sub-current + 1 : 0;

    // Otherwise a ring left up by the way in would land on the bar as a film
    // arrives, on a button nobody chose. A ring a pill has taken stays: a file
    // opened from outside arrives with its question in the same frame, and the
    // two handlers run in no promised order.
    changed has-file => {
        if (root.bar-focus < root.pill-stop
                || !(root.arriving || root.at-end || root.corner-offered)) {
            Chrome.focus-visible = false;
        }
        root.bar-resume = false;
    }

    // A film ending wakes the clock although nobody touched anything: the bar
    // comes back with the way on, and the fade gets frames, which nothing else
    // asks for once mpv stops producing them. The ring goes to the pill, as
    // for the credits, so Enter at the end of anything is the way on.
    changed at-end => {
        if (root.at-end) {
            Chrome.bump();
            if (root.bar-reach) {
                root.bar-focus = root.pill-stop;
                Chrome.focus-visible = true;
            }
        } else if (root.bar-focus >= root.pill-stop && !root.corner-offered && !root.arriving) {
            Chrome.focus-visible = false;
            root.bar-focus = 0;
        }
    }

    // A file held on its saved place is a question, answered in the middle of
    // the picture. The panel it was chosen from closes and the ring goes to
    // the pill, so choosing an episode and going on with it is Enter, Enter.
    changed arriving => {
        if (root.arriving) {
            Chrome.bump();
            root.close-others();
            root.bar-focus = root.pill-stop;
            Chrome.focus-visible = true;
        } else if (root.bar-focus >= root.pill-stop && !root.corner-offered && !root.at-end) {
            Chrome.focus-visible = false;
            root.bar-focus = 0;
        }
    }

    // The credits or the title sequence starting brings up their pill alone,
    // not the bar: the pill is the one thing on offer, and the bar would only
    // cover the names. Doing nothing is watching them. The ring goes to the
    // pill so Enter skips them, and leaves with the pill, or Enter would skip
    // the episode that just started.
    changed corner-offered => {
        if (root.corner-offered) {
            root.bar-focus = root.pill-stop;
            Chrome.focus-visible = true;
        } else if (root.bar-focus >= root.pill-stop && !root.centre-up) {
            // At the end the end pill takes the same stop, and its first
            // choice is the same way on, so the ring stays for it.
            Chrome.focus-visible = false;
            root.bar-focus = 0;
        }
    }
    property <length> panel-radius: Rows.panel-radius;
    property <length> panel-margin: 24px;

    // --- appearing and disappearing ---
    //
    // Every surface fades in and rises a few pixels into place, enough to read
    // as arriving; the window's buttons come down into theirs. Each has one
    // animated number for how far in it is, which drives its opacity, its
    // offset and its glass rect, so they can't drift apart. All take
    // `Motion.surface`, and the seek preview half of it.
    /// How far a surface sits from its place before it arrives.
    property <length> lift: 6px;

    // Hidden with no film loaded, when most of its buttons can do nothing.
    property <float> bar-shown: (root.controls-visible || root.timeline-glimpse
        || root.title-glimpse) && root.has-file ? 1.0 : 0.0;
    /// 1 with the bar whole, 0 with a part alone (see `bar-sink`).
    property <float> bar-full: root.bar-whole ? 1.0 : 0.0;
    animate bar-full {
        duration: root.bar-snap ? 0ms : Motion.surface;
        easing: ease-out;
    }
    /// The buttons' row, which comes in over the second half of the bar's
    /// growing, once the timeline has mostly risen out of its way.
    property <float> pills-shown: root.bar-shown * clamp(2 * root.bar-full - 1, 0, 1);
    /// What is loaded, which is up alone as a file starts.
    property <float> loaded-shown: root.bar-part == 1 ? root.bar-shown : root.pills-shown;
    /// The timeline's row, which is up alone after a seek, and comes in
    /// like the buttons as the bar grows from what is loaded.
    property <float> timeline-shown: root.bar-part == 1 ? root.pills-shown : root.bar-shown;
    property <float> menu-shown: root.menu-open ? 1.0 : 0.0;
    property <float> audio-shown: root.audio-open ? 1.0 : 0.0;
    property <float> playlist-shown: root.playlist-open ? 1.0 : 0.0;
    property <float> settings-shown: root.settings-open ? 1.0 : 0.0;
    property <float> files-shown: root.files-open ? 1.0 : 0.0;
    property <float> preview-shown: root.preview-open ? 1.0 : 0.0;
    property <float> end-shown: root.centre-up ? 1.0 : 0.0;
    /// The centre pill is up: at the end of a file, or at the start of one
    /// held on its saved place. Never both, so it is one surface, one glass
    /// and one stop.
    property <bool> centre-up: (root.at-end || root.arriving) && root.has-file;
    /// Stands aside for an open panel, and for the seek preview when the two
    /// would meet: glass is never laid on glass.
    property <float> credits-shown: root.corner-offered && !root.panel-open
        && !root.credits-crowded ? 1.0 : 0.0;
    /// The way in. Not tied to the idle clock, since there is no film to keep
    /// clear, and an empty window that hid its only control would show
    /// nothing. Only the settings panel can open over it.
    property <float> invite-shown: !root.has-file && !root.settings-open
        ? 1.0 : 0.0;
    /// The window's own buttons: with the chrome, and always over an empty
    /// window, which has no film to keep clear. Never in fullscreen, where
    /// the film has the whole screen and Esc is the way out.
    property <float> window-shown: (root.controls-visible || !root.has-file)
        && !root.fullscreen && !root.window-crowded ? 1.0 : 0.0;

    animate bar-shown, menu-shown, audio-shown, playlist-shown, settings-shown,
            files-shown, end-shown, credits-shown, invite-shown,
            window-shown, tip-shown {
        duration: Motion.surface;
        easing: ease-out;
    }

    /// Half that, because the preview isn't announcing anything: it follows a
    /// pointer already moving along the track, and at the full duration it
    /// trails the hand.
    animate preview-shown {
        duration: Motion.surface / 2;
        easing: ease-out;
    }

    /// Below this a surface is gone: not drawn, not hit-tested, and its rect
    /// dropped on the Rust side rather than uploaded as invisible glass.
    property <float> shown-epsilon: 0.004;

    /// The rise, per surface. Zero once arrived.
    property <length> bar-rise: (1.0 - root.bar-shown) * root.lift;
    property <length> menu-rise: (1.0 - root.menu-shown) * root.lift;
    property <length> audio-rise: (1.0 - root.audio-shown) * root.lift;
    property <length> playlist-rise: (1.0 - root.playlist-shown) * root.lift;
    property <length> settings-rise: (1.0 - root.settings-shown) * root.lift;
    property <length> files-rise: (1.0 - root.files-shown) * root.lift;
    property <length> preview-rise: (1.0 - root.preview-shown) * root.lift;
    property <length> end-rise: (1.0 - root.end-shown) * root.lift;
    property <length> credits-rise: (1.0 - root.credits-shown) * root.lift;
    property <length> invite-rise: (1.0 - root.invite-shown) * root.lift;
    /// Above their place rather than below: the buttons come in from the
    /// window's top edge, as the bar does from its bottom one.
    property <length> window-drop: (root.window-shown - 1.0) * root.lift;

    // --- the way in ---------------------------------------------------------
    //
    // Rows and a sentence, centred. Wider than the files panel, which holds
    // the same rows, because it stands alone and carries a sentence. Wider
    // still for a failure, whose sentence must not elide and is followed by
    // the driver's own error text, and for a film to continue, whose name
    // beside a measure lost an episode's number at 320px.
    property <length> invite-w: root.fatal != "" || root.has-resume ? 420px : 320px;
    property <length> invite-h: root.fatal != ""
        ? root.panel-pad + root.invite-line-h + Rows.group-gap
            + root.invite-detail-h + root.fatal-note-h
            + Rows.group-gap + 2 * Rows.row
        : root.panel-pad + root.invite-first * (Rows.row + Rows.group-gap)
            + (root.invite-show || root.invite-named ? Rows.heading : 0px)
            + 4 * Rows.row + root.invite-note-h;
    /// Whether a file dropped on this window reaches the player, from
    /// `dropped::SUPPORTED`. The two places that mention dropping, under the
    /// way in and on the shortcuts page, only do so where it works.
    in property <bool> drop-supported;

    /// One line of the Hint role for a note under a pane's rows, with the
    /// group gap above it. The gap goes with the line, so a pane without a
    /// note has no space left under its last row.
    property <length> note-line-h: 22px;

    /// The line under the way in's rows: the drop hint, or what is being
    /// opened. Nothing when it has neither.
    property <length> invite-note-h: root.drop-supported || root.opening
        ? Rows.group-gap + root.note-line-h : 0px;

    /// The line under a failure saying what usually puts it right. Separate
    /// from the way in's note, which depends on drop support, so that this
    /// shows on every platform.
    property <length> fatal-note-h: root.fatal-note != ""
        ? Rows.group-gap + root.note-line-h : 0px;
    /// Continue carries its show's name on a heading line above it.
    property <bool> invite-show: root.has-resume && root.resume-show != "";
    /// With nothing to continue, the panel is about the player rather than a
    /// film, and it says whose it is in the same place and the same role.
    property <bool> invite-named: root.fatal == "" && !root.has-resume;
    /// One line of the Title role, 14px, for the sentence that names the
    /// failure.
    property <length> invite-line-h: 22px;
    /// Three lines of the Hint role, 13px, for the driver's account of it:
    /// what fits without the pane growing taller than the one it replaces,
    /// and a fourth line of a shader log would tell a reader nothing more.
    property <length> invite-detail-h: 54px;
    property <length> invite-x: (root.width - root.invite-w) / 2;
    property <length> invite-y: (root.height - root.invite-h) / 2;

    // --- bar geometry ---
    //
    // Every length below is arithmetic on constants and `root.width`, never
    // read from a layout. `glass-rects` samples this geometry every frame, and
    // a binding that depends on a layout forces a full layout pass each time
    // it is read, which dragged resizing down to 4fps.
    //
    // The same constants place the bar's groups, their controls and the
    // points the panels hang from, so nothing has to be kept in agreement by
    // hand.
    property <length> btn: 40px;
    property <length> btn-gap: 6px;
    property <length> pill-pad: 4px;
    property <length> vol-w: 96px;
    /// Inset for text at the end of a row of buttons: after the title, and
    /// in the end-of-file and credits pills, where `pill-pad` would run the
    /// words into the capsule's curve.
    property <length> pill-text-pad: 18px;
    property <length> pill-h: root.btn + 2 * root.pill-pad;
    property <length> pill-radius: root.pill-h / 2;
    property <length> pill-gap: 10px;
    /// Shorter than the row of buttons under it, since it holds a line of
    /// type rather than a 24px glyph.
    property <length> timeline-h: 30px;
    /// Wide enough for the longest either time can read, which is the total,
    /// and never narrower than "00:00", with `glyph-inset` either side.
    ///
    /// A time at its full width then starts and ends where the end buttons'
    /// drawings do. Measured rather than assumed, since a figure's width is up
    /// to the font. Set from the total, so the row doesn't shift when the
    /// elapsed time passes the hour.
    property <length> time-w: max(time-measure.preferred-width,
        minutes-measure.preferred-width) + 2 * root.glyph-inset;
    /// How far in from the bar's ends the end buttons' drawings start: the
    /// row's padding, the 24px glyph centred in its button, and the 1px the
    /// icon set leaves round its 22px drawings.
    property <length> glyph-inset: root.pill-pad + (root.btn - 24px) / 2 + 1px;

    /// The glass round the bar's rows, on every side: as much as takes the
    /// end buttons' corner out to the panels', so the bar's corner is
    /// concentric with them and the same as the panels'.
    property <length> bar-pad: root.panel-radius - root.pill-radius;
    /// Where the rows go, inside that. The pane is the margins' own box.
    property <length> bar-x: root.panel-margin + root.bar-pad;
    property <length> bar-w: root.width - 2 * root.bar-x;
    property <length> bar-h: 2 * root.bar-pad + root.timeline-h + root.pill-h;
    property <length> pills-y: root.height - root.panel-margin - root.bar-pad
        - root.pill-h;
    out property <length> timeline-y: root.pills-y - root.timeline-h;
    /// The top of the bar's glass, which panels, the tip and the seek
    /// preview open above.
    property <length> bar-top: root.timeline-y - root.bar-pad;
    /// How far below its place the bar's top is drawn with a part alone: by
    /// the buttons' row under the timeline, so it rests where the buttons
    /// would and covers as little of the picture as it can; by the timeline
    /// over what is loaded, which keeps its place.
    property <length> bar-sink: (1.0 - root.bar-full)
        * (root.bar-part == 1 ? root.timeline-h : root.pill-h);
    /// The top of the bar's glass as drawn, which is what the subtitles and
    /// the corner pill keep above.
    property <length> bar-edge: root.bar-top + root.bar-sink;
    property <length> bar-drawn-h: root.bar-h - root.bar-sink;
    /// The pane's width: the window's, less the margins, or what is loaded
    /// with `bar-pad` round it, growing to the right from there.
    property <length> bar-drawn-w: root.bar-part == 1
        ? root.loaded-pane-w + (root.width - 2 * root.panel-margin - root.loaded-pane-w)
            * root.bar-full
        : root.width - 2 * root.panel-margin;
    property <length> loaded-pane-w: root.left-w + 2 * root.bar-pad;
    /// How far below its place the timeline's row is drawn: with the bar's
    /// top when it is up alone, and in place while the bar grows over it
    /// from what is loaded.
    property <length> timeline-sink: root.bar-part == 1 ? 0px : root.bar-sink;

    /// Transport: previous, back, play, forward, next.
    property <length> center-w: 2 * root.pill-pad + 5 * root.btn + 4 * root.btn-gap;
    /// Mute, volume, audio, subtitles, settings, panscan, fullscreen.
    property <length> right-w:
        2 * root.pill-pad + 6 * root.btn + root.vol-w + 6 * root.btn-gap;
    /// Everything in the title group that is not the title: the padding
    /// before the two buttons, the buttons with their gaps, and the text
    /// inset after the title.
    property <length> left-fixed:
        root.lp-title + root.pill-text-pad
        + (root.speed-shown ? speed-measure.preferred-width + root.btn-gap : 0px);
    /// The title group hugs its title, up to what the transport leaves room
    /// for. Past that the title runs out at the group's end.
    property <length> left-w: clamp(
        root.title-w + root.left-fixed,
        root.left-fixed,
        root.center-x - root.bar-x - root.pill-gap);
    /// Width the title wants, measured from `Text`s that are never drawn
    /// (`title-measure` and `episode-measure`, at the bottom), because asking
    /// the title inside the group would make its width depend on itself. The
    /// choice between the two is made here rather than in their words, which
    /// would make the window's size depend on itself.
    property <length> title-w: root.title-short
        ? episode-measure.preferred-width : title-measure.preferred-width;
    /// Short of room, the title drops the show's name: it is what one show's
    /// episodes share, and the episode is what tells them apart. Judged by
    /// the most room the title could have rather than the room it has, which
    /// the choice itself would change.
    property <bool> title-short: !root.opening && root.media-episode != ""
        && title-measure.preferred-width > root.title-room-most;
    property <length> title-room-most: max(0px,
        root.center-x - root.bar-x - root.pill-gap - root.left-fixed);
    /// What the title says.
    property <string> title-text: root.opening ? @tr("Opening {}…", root.opening-name)
        : root.title-short ? root.media-episode
        : root.media-title;

    /// Centred in the window, until that would bring it closer to the right
    /// group than the gap (below about 1080px). From there it keeps the gap
    /// and moves left, and the title group gives up the width.
    property <length> center-x: min(root.bar-x + (root.bar-w - root.center-w) / 2,
        root.right-x - root.pill-gap - root.center-w);
    property <length> right-x: root.bar-x + root.bar-w - root.right-w;

    /// The track runs between the two times, clear of both.
    property <length> total-x: root.bar-x + root.bar-w - root.time-w;
    out property <length> scrub-x: root.bar-x + root.time-w + root.pill-gap;
    out property <length> scrub-w: root.bar-w - 2 * (root.time-w + root.pill-gap);
    /// The middle of the volume track, for the test that turns a wheel over
    /// it and the capture of its tip.
    out property <length> vol-cx:
        root.right-x + root.pill-pad + root.btn + root.btn-gap + root.vol-w / 2;
    out property <length> vol-cy: root.pills-y + root.pill-h / 2;

    // Where each control sits inside the right group, for the panels that
    // hang from them.
    property <length> rp-audio:
        root.pill-pad + root.btn + root.btn-gap + root.vol-w + root.btn-gap;
    property <length> rp-subs: root.rp-audio + root.btn + root.btn-gap;
    property <length> rp-settings: root.rp-subs + root.btn + root.btn-gap;

    property <length> audio-anchor: root.right-x + root.rp-audio + root.btn / 2;
    out property <length> subs-anchor: root.right-x + root.rp-subs + root.btn / 2;
    property <length> settings-anchor: root.right-x + root.rp-settings + root.btn / 2;
    // Playlist, then open, then the title, so the two buttons and the panels
    // that hang from them stand in one place whatever the film is called.
    // Only the group's far end moves with the title.
    property <length> lp-playlist: root.pill-pad;
    property <length> lp-open: root.lp-playlist + root.btn + root.btn-gap;
    property <length> lp-title: root.lp-open + root.btn + root.btn-gap;

    property <length> files-anchor: root.bar-x + root.lp-open + root.btn / 2;
    out property <length> playlist-anchor:
        root.bar-x + root.lp-playlist + root.btn / 2;

    // --- resizing ---
    /// Whether the window is being resized: from its size first changing
    /// until it has kept still for a moment, and from startup until it first
    /// settles.
    ///
    /// While it is, the panels' eased page heights jump, or they would trail
    /// the window's edge for the whole drag. A binding on the size rather
    /// than a flag set by a handler, because the handler runs a frame late,
    /// and that frame would ease.
    property <bool> resizing: root.width != root.settled-width
        || root.height != root.settled-height;
    /// How far the settings panel is from its target height, for the test
    /// that drags the window's size and expects it to be zero.
    out property <length> resize-lag: root.settings-open
        ? abs(settings.height - min(root.panel-pad + settings.body, root.panel-max-h))
        : 0px;
    /// The window's size once it last kept still.
    property <length> settled-width: -1px;
    property <length> settled-height: -1px;
    /// Called from the window's size handlers, further down beside the tip's,
    /// since a property can only have one.
    function window-resized() {
        resize-settle.stop();
        resize-settle.start();
    }
    resize-settle := Timer {
        interval: 200ms;
        running: true;
        triggered => {
            resize-settle.stop();
            root.settled-width = root.width;
            root.settled-height = root.height;
        }
    }

    // --- the window's own buttons -------------------------------------------
    //
    // Minimize, maximize and close on one small pane of glass, in the
    // window's top corner at its own margins.
    property <length> window-btn-margin: 10px;
    property <length> window-btn: 28px;
    property <length> window-btn-gap: root.btn-gap;
    /// The glass round the buttons. The pane's corner is theirs plus this, so
    /// the end buttons sit concentric in its ends.
    property <length> window-btn-pad: 3px;
    property <length> window-btn-step: root.window-btn + root.window-btn-gap;
    property <length> window-pane-w: 2 * root.window-btn-pad + root.window-btn
        + 2 * root.window-btn-step;
    property <length> window-pane-h: 2 * root.window-btn-pad + root.window-btn;
    /// At the margin, so that close is the button nearest the corner.
    property <length> window-pane-x: root.width - root.window-btn-margin
        - root.window-pane-w;
    property <length> window-pane-y: root.window-btn-margin;
    /// An open panel tall enough to reach their row, in their column, puts
    /// them away, since it was asked for and they weren't.
    property <bool> window-crowded: root.panel-open
        && root.bar-top - root.panel-h - Rows.offset
            < root.window-pane-y + root.window-pane-h + Rows.offset
        && root.panel-x + root.panel-w + Rows.offset > root.window-pane-x;

    // --- end of playback ---
    //
    // One pill in the middle of the picture, where the film just stopped and
    // nothing else competes for the eye, as tall as the bar's row of buttons.
    property <length> end-h: root.pill-h;
    /// Text inset, matching the title's.
    property <length> end-pad: root.pill-text-pad;
    property <length> end-gap: 12px;
    /// Whether there is a second thing to offer: the way on, at the end of
    /// the last file, or Continue for a file held on its saved place. Restart
    /// alone at the end of a season or a lone film is the least wanted offer.
    property <bool> end-two: root.at-last || root.arriving;
    /// With two choices, each is a capsule inset by a bar button's padding,
    /// which keeps it concentric with the pill: 24px outside, a 4px gap, 20px
    /// inside.
    property <length> end-inset: root.end-two ? root.pill-pad : 0px;
    /// Less padding inside an inset choice, so its words still start 18px
    /// from the pill's edge.
    property <length> end-choice-pad: root.end-pad - root.end-inset;
    /// The way on, by name: the next season, or the film left unfinished.
    /// The folder dialog is the last resort, for when the player can name
    /// nothing, because this is the loudest the interface speaks.
    property <string> end-onward-label: root.onward-path != ""
        ? root.onward-label : @tr("Open folder…");
    /// The widest the pill grows before its words elide: half the bar, since
    /// a film's name can run to a sentence, and this is a capsule in the
    /// picture rather than a banner across it.
    property <length> end-max: root.bar-w / 2;
    property <length> end-first-w: min(
        2 * root.end-choice-pad + 24px + root.end-gap + end-measure.preferred-width,
        root.end-max - (root.end-two
            ? 2 * root.end-inset + root.btn-gap + root.end-second-w : 0px));
    property <length> end-second-w:
        2 * root.end-choice-pad + 24px + root.end-gap + end-folder-measure.preferred-width;
    property <length> end-w: root.end-two
        ? 2 * root.end-inset + root.end-first-w + root.btn-gap + root.end-second-w
        : root.end-first-w;
    /// Where the pill sits with nothing in its way. A move is tested from
    /// here rather than from where it puts the pill, which would make it
    /// depend on itself.
    property <length> end-middle-x: (root.width - root.end-w) / 2;
    property <length> end-middle-y: (root.height - root.end-h) / 2;
    /// An open panel over where the pill sits. The seek preview stands down
    /// for one, but the pill may be the question playback is paused on, so
    /// it moves aside instead.
    property <bool> end-crowded: root.panel-open
        && root.end-middle-x + root.end-w + Rows.offset > root.panel-x
        && root.end-middle-x < root.panel-x + root.panel-w + Rows.offset
        && root.end-middle-y + root.end-h + Rows.offset
            > root.bar-top - Rows.offset - root.panel-h;
    /// The room beside the open panel, on the side away from it. At the
    /// smallest window it still holds the widest pill.
    property <bool> end-panel-left: root.panel-x + root.panel-w / 2 < root.width / 2;
    property <length> end-room-from: root.end-panel-left
        ? root.panel-x + root.panel-w + Rows.offset : root.panel-margin;
    property <length> end-room-to: root.end-panel-left
        ? root.width - root.panel-margin : root.panel-x - Rows.offset;
    property <length> end-x: !root.end-crowded ? root.end-middle-x
        : clamp((root.end-room-from + root.end-room-to - root.end-w) / 2,
            root.panel-margin, root.width - root.panel-margin - root.end-w);
    // A sideways move, so at the pace of the other one, a page's.
    animate end-x {
        duration: root.resizing ? 0ms : Motion.drill;
        easing: ease-in-out;
    }
    /// The seek preview under the pill, which reaches the middle in a window
    /// under about 600px tall. It is what the hand is doing, so rather than
    /// stand down it stays, and the pill rises clear. Its column counts too,
    /// so a pointer elsewhere on the track leaves the pill where it is.
    property <bool> end-over-preview: root.preview-open && !root.preview-crowded
        && root.preview-x + root.preview-w + Rows.offset > root.end-x
        && root.preview-x < root.end-x + root.end-w + Rows.offset
        && root.preview-y < root.end-middle-y + root.end-h + Rows.offset;
    property <length> end-y: root.end-over-preview
        ? min(root.end-middle-y, root.preview-y - Rows.offset - root.end-h)
        : root.end-middle-y;
    // At a surface's pace, since it makes way for one arriving.
    animate end-y {
        duration: root.resizing ? 0ms : Motion.surface;
        easing: ease-out;
    }
    /// Restart at the end of the last file, and otherwise the next file by
    /// name (which is only seen with autoplay off). Named for the same reason
    /// as the way on; the bare *Next* is for when the list can't say.
    property <string> end-label: root.arriving ? @tr("From the beginning")
        : root.at-last ? @tr("Restart")
        : root.next-label != "" ? root.next-label : @tr("Next");
    /// What the first of two choices says: the way on, or, for a file held on
    /// its saved place, going on from that time, since the time is what to
    /// decide by.
    property <string> end-first-label: root.arriving
        ? @tr("Continue from {}", root.arrival-from)
        : root.end-onward-label;

    // --- the credits pill ---
    //
    // The credits are when the next episode is wanted, but people also watch
    // them, so the offer keeps out of the middle, where the names roll. It
    // takes the bottom right corner: at the margin while the bar is away, and
    // lifted onto the row panels open from while the bar is up.
    /// Somewhere to go: the next file, or the next season found beside this
    /// one when this is the last.
    property <bool> credits-onward: !root.at-last || root.onward-season;
    /// A scene follows the credits, so the offer is to skip to it rather than
    /// past it: the scene is the episode's, and the way on comes after it.
    property <bool> credits-skip: root.after-credits > 0;
    property <bool> credits-offered: root.credits-rolling && root.has-file
        && !root.at-end && !root.arriving && (root.credits-skip || root.credits-onward)
        && root.fatal == "";
    /// The same pill while an episode's title sequence plays, offering to
    /// skip it. Same corner, for the same reason: people watch it too.
    property <bool> intro-offered: root.intro-rolling && root.has-file
        && !root.at-end && !root.arriving && root.fatal == "";
    /// And for the first ten seconds of a file that autoplay started from
    /// the top although it had been left part way: the offer to go on from
    /// there. Autoplay can't stop to ask, so this is how it asks (see
    /// `playback::arrival`).
    property <bool> resume-offered: root.resume-offer != "" && root.has-file
        && !root.at-end && !root.arriving && root.fatal == "";
    /// Any of them. Intro and credits fall in different halves of a file;
    /// should a file say both, the credits win. The passed-over place wins
    /// over the intro, since going on from it skips the intro too, and it
    /// only lasts ten seconds.
    property <bool> corner-offered: root.credits-offered || root.intro-offered
        || root.resume-offered;
    /// Which: 0 the way on, 1 past the title sequence, 2 the place passed
    /// over, 3 past the credits to the scene after them; -1 for none.
    property <int> corner-offer: root.resume-offered ? 2
        : root.credits-offered ? (root.credits-skip ? 3 : 0)
        : root.intro-offered ? 1
        : -1;
    /// Which the pill is dressed as. The offer ends the moment the pill is
    /// pressed, but the pill takes `Motion.surface` to fade, and has to keep
    /// saying the same thing meanwhile. So the last offer, and the place it
    /// named, are remembered until the next one.
    property <int> corner-was: 0;
    property <int> corner-says: root.corner-offer >= 0 ? root.corner-offer : root.corner-was;
    /// Either skip: further into this file.
    property <bool> corner-says-skip: root.corner-says == 1 || root.corner-says == 3;
    changed corner-offer => {
        if (root.corner-offer >= 0) {
            root.corner-was = root.corner-offer;
        }
    }
    property <string> resume-offer-said;
    changed resume-offer => {
        if (root.resume-offer != "") {
            root.resume-offer-said = root.resume-offer;
        }
    }
    /// Named like the end pill's way on: the next file as its row says it,
    /// or the next season at the end of one. *Next episode* when neither can
    /// be said.
    out property <string> credits-label: root.corner-says == 2
        ? @tr("Continue from {}", root.resume-offer-said)
        : root.corner-says == 1 ? @tr("Skip intro")
        : root.corner-says == 3 ? @tr("Skip credits")
        : !root.at-last && root.next-label != "" ? root.next-label
        : root.at-last && root.onward-path != "" ? root.onward-label
        : @tr("Next episode");
    /// No wider than the bar's right group, the corner it keeps to, so a long
    /// episode title elides rather than reach over the rolling names.
    property <length> credits-w: min(
        2 * root.pill-text-pad + 24px + root.end-gap + credits-measure.preferred-width,
        root.right-w);
    property <length> credits-x: root.width - root.panel-margin - root.credits-w;
    /// Driven by the bar's own fade, so it moves exactly with the bar. What
    /// is loaded alone never reaches the pill's column, so the pill rises
    /// only as the bar grows from it.
    property <length> credits-y: root.height - root.panel-margin - root.pill-h
        - (root.bar-part == 1 ? root.bar-shown * root.bar-full : root.bar-shown)
            * (root.height - root.panel-margin - root.bar-edge + Rows.offset);
    /// The seek preview reaching the pill's column. The preview is what the
    /// pointer asked for, so the pill is the one that goes.
    property <bool> credits-crowded: root.preview-open
        && root.preview-x + root.preview-w + Rows.offset > root.credits-x;

    // --- the action flash ---
    //
    // A glyph in a ring at the centre of the picture, and under it the one
    // number that has nowhere else to appear. It takes no pointer events,
    // since it is an answer, not a control.
    property <[image]> flash-icons: [
        @image-url("../../../public/icons/seek-backward.svg"),
        @image-url("../../../public/icons/seek-forward.svg"),
        @image-url("../../../public/icons/step-backward.svg"),
        @image-url("../../../public/icons/step-forward.svg"),
        @image-url("../../../public/icons/rewind.svg"),
        @image-url("../../../public/icons/subtitle-time.svg"),
    ];
    /// The size the icon set is drawn for: the ring gives it presence, so
    /// it isn't scaled up.
    property <length> flash-glyph: 24px;
    /// 16px of air around the glyph, twice a bar button's. Any wider and the
    /// ring becomes the subject rather than the glyph's setting.
    property <length> flash-ring: root.flash-glyph + 2 * 16px;
    /// Whether this is the player speaking rather than acknowledging a key.
    property <bool> flash-is-notice: Flash.message != "";
    /// Whether the glyph ring is drawn: an acknowledgement has one, a notice
    /// and a figure are their words alone.
    property <bool> flash-has-ring: !root.flash-is-notice && Flash.figure == 0;
    /// The track a J or # landed on, read live, because the list is re-read
    /// a moment after the cycle and the caption has to catch up.
    property <string> flash-sub-label: root.subs-visible && root.sub-current >= 0
        && root.sub-current < root.sub-tracks.length
        ? root.sub-tracks[root.sub-current].label : @tr("Subtitles off");
    property <string> flash-audio-label: root.audio-current >= 0
        && root.audio-current < root.audio-tracks.length
        ? root.audio-tracks[root.audio-current].label : @tr("No audio");
    /// The level as words, for the volume's label and its keys' flash. Muted,
    /// it says so, since the level is then a number nothing is heard at.
    property <string> volume-said: root.muted
        ? @tr("Muted")
        : @tr("Volume {}%", Math.round(root.volume));
    /// Set once a notice has had its dwell: it then stays until the next key
    /// or pointer event, so a failure glanced away from is still there.
    property <bool> flash-waiting: false;
    property <int> input-seq: Chrome.input-seq;
    changed input-seq => {
        if (root.flash-waiting) {
            root.flash-waiting = false;
            root.flash-shown = 0.0;
        }
    }
    /// The words under the ring. Live, because mpv reports a new delay a beat
    /// after the key, and the figure has to be the one it lands on.
    property <string> flash-text: root.flash-is-notice ? Flash.message
        : Flash.figure == 1 ? root.speed-text
        : Flash.figure == 2 ? root.chapter-label
        : Flash.figure == 3 ? root.flash-sub-label
        : Flash.figure == 4 ? root.flash-audio-label
        : Flash.figure == 5 ? root.volume-said
        : Flash.icon == Flash.delay ? root.sub-delay-text : "";
    property <length> flash-text-h: 28px;
    property <length> flash-text-pad: 14px;
    /// Wide enough for the words, but never wider than the bar, since a
    /// failure can name a long path.
    property <length> flash-text-w: min(
        flash-measure.preferred-width + 2 * root.flash-text-pad + root.flash-mark-w,
        root.bar-w);
    /// A failure's warning mark and the gap after it; nothing otherwise.
    property <bool> flash-warns: root.flash-is-notice && Flash.warning;
    property <length> flash-mark: 18px;
    property <length> flash-mark-w: root.flash-warns ? root.flash-mark + 8px : 0px;
    /// Centred on `Flash.at`, kept inside the window's margins.
    function flash-x(w: length) -> length {
        return clamp(root.width * Flash.at - w / 2,
            root.panel-margin,
            max(root.panel-margin, root.width - w - root.panel-margin));
    }
    /// The panel the notice on show answers, and so sits beside: 1 the
    /// subtitles menu, 2 the playlist, 3 the files, 4 the settings, 5 the
    /// audio panel, 0 none.
    ///
    /// A notice raised with a panel open is nearly always that panel's
    /// answer, and belongs by the row that asked rather than in the middle.
    /// Fixed when the notice is raised, so it stays beside its panel while
    /// both fade out.
    property <int> flash-panel: 0;
    property <length> flash-panel-x: root.flash-panel == 1 ? menu.x
        : root.flash-panel == 2 ? playlist-panel.x
        : root.flash-panel == 3 ? files-panel.x
        : root.flash-panel == 5 ? audio-panel.x
        : settings.x;
    property <length> flash-panel-w: root.flash-panel == 1 ? menu.width
        : root.flash-panel == 2 ? playlist-panel.width
        : root.flash-panel == 3 ? files-panel.width
        : root.flash-panel == 5 ? audio-panel.width
        : settings.width;
    property <length> flash-panel-h: root.flash-panel == 1 ? menu.height
        : root.flash-panel == 2 ? playlist-panel.height
        : root.flash-panel == 3 ? files-panel.height
        : root.flash-panel == 5 ? audio-panel.height
        : settings.height;
    /// To the panel's left, unless the panel is too far left for the words
    /// to fit.
    property <bool> flash-leftward: root.flash-panel-x - Rows.offset
        - root.flash-text-w >= root.panel-margin;
    property <length> flash-text-x: root.flash-panel == 0
        ? root.flash-x(root.flash-text-w)
        : root.flash-leftward
            ? root.flash-panel-x - Rows.offset - root.flash-text-w
            : root.flash-panel-x + root.flash-panel-w + Rows.offset;
    /// How far down its panel the middle of the row that asked sits (see
    /// `asked-row`). Negative when no row is known, and the notice sits level
    /// with the panel's top edge.
    property <length> flash-row: -1px;
    /// A notice beside a panel slides out from it rather than rising: from
    /// the panel's edge to the offset it rests at.
    property <length> flash-slide: root.flash-panel == 0 ? 0px
        : (1.0 - root.flash-shown) * Rows.offset * (root.flash-leftward ? 1 : -1);
    property <length> flash-y: (root.height - root.flash-ring) / 2;
    /// Under the ring, or in its place when there is none, and under the way
    /// in when that is on screen, since both are centred and the notice would
    /// otherwise cover the rows it answers.
    property <length> flash-text-y: root.flash-panel != 0
        ? root.bar-top - root.flash-panel-h - Rows.offset
            + (root.flash-row < 0 ? 0px : root.flash-row - root.flash-text-h / 2)
        : !root.flash-has-ring
        ? (root.has-file
            ? (root.height - root.flash-text-h) / 2
            : root.invite-y + root.invite-h + Rows.offset)
        : root.flash-y + root.flash-ring + Rows.offset;
    /// Long enough to read a two-character number, short enough that a held
    /// key flickers rather than strobes. Longer for a figure, which is read
    /// rather than recognised, and longer still for a sentence.
    property <duration> flash-dwell: root.flash-is-notice ? 3200ms
        : Flash.figure != 0 ? 1200ms : 700ms;
    property <float> flash-shown: 0;
    animate flash-shown {
        duration: Motion.surface;
        easing: ease-out;
    }
    property <length> flash-rise: (1.0 - root.flash-shown) * root.lift;
    /// The caption's rise, which is zero beside a panel, where it slides.
    property <length> flash-text-rise: root.flash-panel == 0 ? root.flash-rise : 0px;

    // Watched through a local property, because a `changed` handler must be
    // on the element that declares the property. Each raise restarts the
    // dwell rather than extending it.
    property <int> flash-seq: Flash.seq;
    changed flash-seq => {
        root.flash-panel = !root.flash-is-notice ? 0
            : root.menu-open ? 1
            : root.playlist-open ? 2
            : root.files-open ? 3
            : root.settings-open ? 4
            : root.audio-open ? 5 : 0;
        root.flash-row = root.flash-panel == 4 || root.flash-panel == 1
            ? root.asked-row : -1px;
        root.flash-shown = 1.0;
        root.flash-waiting = false;
        flash-timer.stop();
        flash-timer.start();
    }

    /// A notice beside a panel goes when the panel does, or left beside
    /// nothing it would read as a new event.
    property <bool> flash-panel-open: root.flash-panel == 1 ? root.menu-open
        : root.flash-panel == 2 ? root.playlist-open
        : root.flash-panel == 3 ? root.files-open
        : root.flash-panel == 4 ? root.settings-open
        : root.flash-panel == 5 ? root.audio-open : true;
    changed flash-panel-open => {
        if (!root.flash-panel-open) {
            flash-timer.stop();
            root.flash-waiting = false;
            root.flash-shown = 0.0;
        }
    }

    flash-timer := Timer {
        interval: root.flash-dwell;
        running: false;
        triggered => {
            flash-timer.stop();
            if (root.flash-is-notice) {
                root.flash-waiting = true;
            } else {
                root.flash-shown = 0.0;
            }
        }
    }

    /// Whether any panel is open. Tips open on the line panels do, so a tip
    /// stands down while any panel is up rather than working out whether it
    /// would land under it.
    property <bool> panel-open: root.menu-open || root.audio-open
        || root.playlist-open || root.files-open || root.settings-open;

    property <length> tip-h: 28px;
    property <length> tip-pad: 12px;
    /// Between the name and the key, matching the shortcuts list, since a
    /// tip is one row of that list.
    property <length> tip-gap: 12px;
    property <length> tip-w: min(
        tip-label-measure.preferred-width
            + (root.tip-key != "" ? root.tip-gap + tip-keys-measure.preferred-width : 0px)
            + 2 * root.tip-pad,
        root.bar-w);
    /// Centred on its button, kept inside the bar's margins so a tip on the
    /// last button doesn't hang off the window.
    property <length> tip-x: clamp(root.tip-at - root.tip-w / 2,
        root.panel-margin, root.width - root.panel-margin - root.tip-w);
    /// Above the bar, on the line panels open from, because any lower it
    /// would be glass on glass.
    property <length> tip-y: root.bar-top - root.tip-h - Rows.offset
        - (root.tip-over-credits ? root.pill-h + Rows.offset : 0px);
    /// A tip that would land on the credits pill goes up a row, over it,
    /// since the pill was there first.
    property <bool> tip-over-credits: root.corner-offered && !root.panel-open
        && root.tip-x + root.tip-w + Rows.offset > root.credits-x;
    property <float> tip-shown: 0.0;
    /// How much of the tip is drawn, and the only thing that decides it.
    ///
    /// A binding rather than a check when the pointer arrives, because both
    /// ways a tip goes wrong happen after it is up: the bar can leave from
    /// under a still pointer, and a panel can open over it. Scaled by the
    /// bar, it can't outlive the button it names.
    property <float> tip-on: root.panel-open || root.tip-cut
        ? 0.0
        : root.tip-shown * root.pills-shown;
    property <length> tip-rise: (1.0 - root.tip-shown) * root.lift;

    /// What the tip shows, copied from `Tip` only when a tip goes up, so a
    /// tip fading out keeps its own name and place rather than taking on the
    /// next one's.
    property <string> tip-text;
    property <string> tip-key;
    property <length> tip-at;
    /// Up, or on its way.
    property <bool> tip-up;
    /// Came down within `tip-grace`, so the next one need not wait.
    property <bool> tip-warm;
    /// Taken away without a fade, by a resize or a panel; cleared by the next
    /// tip to rise with no panel open. A panel only hides what it covers, so
    /// without the cut, closing it would uncover a tip mid-fade.
    property <bool> tip-cut;

    function raise-tip() {
        root.tip-text = Tip.label;
        root.tip-key = Tip.keys;
        root.tip-at = Tip.cx;
        root.tip-up = true;
        root.tip-warm = false;
        root.tip-cut = root.panel-open;
        tip-cool.stop();
        root.tip-shown = 1.0;
    }

    changed panel-open => {
        if (root.panel-open) {
            root.tip-cut = true;
        }
    }

    // Watched through a local property, as the flash's is.
    property <int> tip-seq: Tip.seq;
    changed tip-seq => {
        tip-timer.stop();
        if (Tip.label == "") {
            if (root.tip-up && !root.tip-cut) {
                root.tip-warm = true;
                tip-cool.restart();
            }
            root.tip-up = false;
            root.tip-shown = 0.0;
        } else if (root.tip-up || root.tip-warm || Tip.now) {
            // A tip is up or only just went, so the new name takes its place
            // without the wait; a changed reading doesn't wait either.
            root.raise-tip();
        } else {
            tip-timer.start();
        }
    }

    // A resize moves every control out from under the tip, whose place was
    // fixed when it rose, so it goes at once rather than fading in the wrong
    // place.
    changed width => {
        root.tip-cut = true;
        Tip.clear();
        root.window-resized();
    }
    changed height => {
        root.tip-cut = true;
        Tip.clear();
        root.window-resized();
    }

    tip-timer := Timer {
        interval: Motion.tip-delay;
        running: false;
        triggered => {
            root.raise-tip();
            tip-timer.stop();
        }
    }

    tip-cool := Timer {
        interval: Motion.tip-grace;
        running: false;
        triggered => {
            root.tip-warm = false;
            tip-cool.stop();
        }
    }

    // --- subtitles above the bar ---
    /// The highest a subtitle may rest while the bar is up, in mpv's
    /// `sub-pos` (percent of the window's height, from the top). It keeps
    /// mpv's bottom margin above the bar, so the bar arriving reads as
    /// the floor rising. The Rust side takes the lower of this and the
    /// person's own Position (see `subline`).
    out property <float> subtitle-ceiling: 100 * root.bar-edge / root.height;
    /// How much of that applies this frame, faded with the bar so the line
    /// climbs and settles rather than leaping.
    ///
    /// Not while Position is being set: held at the ceiling, the line wouldn't
    /// visibly move for small steps, so it drops to where it rests until
    /// Size or Timing is used or the page is left.
    out property <float> subtitle-lift: (root.controls-visible || root.timeline-glimpse
        || root.title-glimpse) && root.has-file && !(root.placing-subtitles && root.menu-open
            && root.subs-page == 2) ? 1.0 : 0.0;
    /// Whether Position was the last of the subtitles' three adjustments used.
    property <bool> placing-subtitles: false;
    animate subtitle-lift {
        duration: Motion.surface;
        easing: ease-out;
    }
    // --- seek preview ---
    //
    // Shown while the pointer is over the timeline, centred on it and kept
    // inside the bar's margins. Sized to the tile when there is one and to
    // the timestamp alone otherwise, so it is useful before the thumbnails are
    // ready, and without ffmpeg, where they never will be.
    //
    // Tied to the bar as well as the pointer, since a still pointer never
    // bumps the idle clock and the bar could fade from under it. It stands
    // down only for a panel actually in its way (`preview-crowded`), not for
    // any open panel as a tip does, because it is what the pointer asked for.
    property <bool> preview-open: (scrub.has-hover || scrub.pressed)
        && root.controls-visible && !root.preview-crowded;
    property <bool> preview-has-tile: root.preview-tile-w > 0 && root.preview-tile-h > 0;
    /// Wide enough for the glass's bevel, which rolls over about 8px at this
    /// corner and would otherwise sit under the thumbnail.
    property <length> preview-pad: 9px;
    /// Its own corner, because a surface this small with the panels' 32px
    /// radius would be all corner.
    property <length> preview-radius: 18px;
    /// Concentric with the preview's corner, by the rule the rows follow:
    /// the radii differ by the padding between them.
    property <length> preview-tile-radius: root.preview-radius - root.preview-pad;
    property <length> preview-caption: 22px;
    property <length> preview-w: root.preview-has-tile
        ? root.preview-tile-w * 1px + 2 * root.preview-pad
        : 74px;
    property <length> preview-h: root.preview-has-tile
        ? root.preview-tile-h * 1px + 2 * root.preview-pad + root.preview-caption
        : 26px;
    /// Where along the track the pointer is, in the track's own coordinates.
    property <length> preview-cursor: clamp(scrub.mouse-x, 0px, root.scrub-w);
    /// Centred on the pointer and kept inside the bar's margins.
    property <length> preview-x: clamp(
        root.scrub-x + root.preview-cursor - root.preview-w / 2,
        root.panel-margin,
        root.width - root.panel-margin - root.preview-w);
    property <length> preview-y: root.bar-top - 10px - root.preview-h;

    /// The column the open panel occupies. Opening a panel closes the others
    /// (`close-others`), so there is only ever one to test against.
    property <length> panel-x: root.menu-open ? menu.x
        : root.audio-open ? audio-panel.x
        : root.playlist-open ? playlist-panel.x
        : root.files-open ? files-panel.x
        : settings.x;
    property <length> panel-w: root.menu-open ? menu.width
        : root.audio-open ? audio-panel.width
        : root.playlist-open ? playlist-panel.width
        : root.files-open ? files-panel.width
        : settings.width;
    /// Its height, up from a bottom edge that is always one `Rows.offset`
    /// above the bar.
    property <length> panel-h: root.menu-open ? menu.height
        : root.audio-open ? audio-panel.height
        : root.playlist-open ? playlist-panel.height
        : root.files-open ? files-panel.height
        : settings.height;
    /// The open panel's right edge, for the test that drags a list's thumb.
    out property <length> panel-right: root.panel-x + root.panel-w;
    /// And its left, for the one that presses the way back to a list's
    /// current row.
    out property <length> panel-left: root.panel-x;

    /// The preview landing on the open panel, which was there first, so the
    /// preview fades out (still following the pointer) rather than lay glass
    /// on glass.
    ///
    /// Only the columns are tested: the preview's top is always above a
    /// panel's bottom edge, so two that share a column always overlap.
    property <bool> preview-crowded: root.panel-open
        && root.preview-x + root.preview-w + Rows.offset > root.panel-x
        && root.preview-x < root.panel-x + root.panel-w + Rows.offset;

    /// Room for a panel between the bar and a top margin the same as its
    /// side margins.
    property <length> panel-max-h:
        root.bar-top - Rows.offset - root.panel-margin;

    // --- list panels ---
    //
    // A panel is capped at what fits above the bar, and its lists share what
    // is left. Two lists in one panel get half each, except that a list which
    // fits in its half keeps its height and hands the rest to the other, so a
    // long list beside a short one doesn't scroll for nothing. Arithmetic on
    // row counts rather than measured, and `out` so a test can check it.
    /// Short names for the two heights the panel arithmetic uses most.
    property <length> row-h: Rows.row;
    property <length> heading-h: Rows.heading;
    property <length> toggle-h: Rows.toggle-row;

    /// Every key the handlers below answer to, for the shortcuts page. Kept
    /// in this file, above the handlers, so the reference and the bindings
    /// don't drift apart.
    ///
    /// A row with a heading opens a section, and one without belongs to the
    /// section above, so moving a key between groups is moving one line. Keys
    /// for the two ends of one action stand side by side, `← →`, but take a
    /// slash where either is a name or has a modifier, `J / Shift+J`, since a
    /// space inside `Shift+J` would read as a third key.
    property <[{label: string, keys: string, heading: string, icon: image, dropping: bool}]> shortcuts: [
        { heading: @tr("PLAYBACK"), icon: @image-url("../../../public/icons/play-pause.svg"),
          label: @tr("Play / pause"), keys: @tr("Space") },
        { label: @tr("Back / forward {} seconds", root.seek-step), keys: "← →" },
        { label: @tr("Back / forward {} second", root.fine-seek-step), keys: @tr("Shift+← →") },
        { label: @tr("Restart"), keys: @tr("Home") },
        { label: @tr("Previous / next file"), keys: @tr("Ctrl+← →") },
        { label: @tr("Previous / next chapter"), keys: @tr("PgUp PgDn") },
        // Named, because a comma and a full stop at readout size are specks
        // nobody can read as keys.
        { label: @tr("Frame back / forward"), keys: @tr("Comma / Period") },
        { label: @tr("Slower / faster"), keys: "[ ]" },
        { label: @tr("Normal speed"), keys: @tr("Backspace") },

        { heading: @tr("AUDIO"), icon: @image-url("../../../public/icons/volume.svg"),
          label: @tr("Volume"), keys: "↑ ↓" },
        { label: @tr("Mute"), keys: "M" },
        { label: @tr("Next audio track"), keys: "#" },

        { heading: @tr("SUBTITLES"), icon: @image-url("../../../public/icons/subtitles.svg"),
          label: @tr("Subtitles on / off"), keys: "C" },
        { label: @tr("Subtitles earlier / later"), keys: @tr("Z / Shift+Z") },
        { label: @tr("Next / previous subtitle track"), keys: @tr("J / Shift+J") },

        { heading: @tr("PICTURE"), icon: @image-url("../../../public/icons/monitor.svg"),
          label: @tr("Fill or fit the window"), keys: "T" },
        { label: @tr("Fullscreen"), keys: "F / F11" },
        { label: @tr("Ambient border"), keys: "B" },

        { heading: @tr("PANELS"), icon: @image-url("../../../public/icons/panel.svg"),
          label: @tr("Subtitles"), keys: "V" },
        { label: @tr("Audio"), keys: "A" },
        { label: @tr("Playlist"), keys: "P" },
        { label: @tr("Settings"), keys: "S" },
        { label: @tr("Shortcuts"), keys: "?" },

        { heading: @tr("NAVIGATION"), icon: @image-url("../../../public/icons/navigation.svg"),
          label: @tr("Move in a panel"), keys: "↑ ↓" },
        { label: @tr("First / last in a list"), keys: @tr("Home End") },
        { label: @tr("A page up / down a list"), keys: @tr("PgUp PgDn") },
        { label: @tr("Move along the bar"), keys: @tr("Tab") },
        { label: @tr("Choose, or adjust"), keys: @tr("Enter / ← →") },
        { label: @tr("Close, or leave fullscreen"), keys: @tr("Esc") },
        { label: @tr("Remove an added track"), keys: @tr("Delete") },

        { heading: @tr("FILES"), icon: @image-url("../../../public/icons/folder-open.svg"),
          label: @tr("Open file"), keys: @tr("Ctrl+O") },
        { label: @tr("Open folder"), keys: @tr("Ctrl+Shift+O") },

        // Not keys, but written nowhere else, and the player's one reference
        // shouldn't leave out what the pointer does.
        { heading: @tr("POINTER"), icon: @image-url("../../../public/icons/mouse.svg"),
          label: @tr("Play / pause"), keys: @tr("Click the picture") },
        { label: @tr("Fullscreen"), keys: @tr("Double-click") },
        { label: @tr("Volume"), keys: @tr("Wheel over its slider") },
        { label: @tr("Seek a second"), keys: @tr("Wheel over the timeline") },
        // The one row here that is not true everywhere; see `drop-supported`.
        { label: @tr("Open"), keys: @tr("Drop a file or folder"), dropping: true },
    ];
    /// How many of the rows above open a section. Counted by hand because
    /// Slint can't fold an array and the page's height must be arithmetic
    /// (see "bar geometry"). Miscounted, the panel won't fit its contents.
    property <int> shortcut-sections: 8;
    property <length> shortcuts-natural: root.shortcuts.length * root.row-h
        + root.shortcut-sections * root.heading-h
        // The space above every heading but the first.
        + (root.shortcut-sections - 1) * Rows.group-gap
        // Less the drop row where it isn't drawn, which stays in the list so
        // the rows remain one literal.
        - (root.drop-supported ? 0px : root.row-h);

    // --- the settings pages' lists ---
    //
    // Every settings page is a list under its way back, and the first page is
    // one list, so a page too tall for a small window scrolls rather than
    // cutting off controls nobody could then reach.

    /// What a page holds under its way back, unconstrained. From row counts
    /// rather than the layout's `preferred-height`, for the reason under
    /// "bar geometry".
    pure function page-natural(page: int) -> length {
        // The controls, the gap, and the reset that follows them.
        if (page == 1) {
            return root.glass-params.length * Rows.slider-row + Rows.group-gap + root.row-h;
        }
        // The switch and a gap before them.
        if (page == 2) {
            return root.sliders-top(2) + root.border-params.length * Rows.slider-row
                + Rows.group-gap + root.row-h;
        }
        if (page == 3) {
            return 4 * root.toggle-h;
        }
        if (page == 4) {
            return root.shortcuts-natural;
        }
        if (page == 5) {
            return root.language-count * root.row-h;
        }
        return 0px;
    }
    /// The first page: two headings and five rows that lead somewhere. The
    /// second heading follows a group and takes the gap.
    property <length> front-natural: 2 * root.heading-h + 5 * root.row-h
        + Rows.group-gap;
    /// What is left of the panel for each list: all of it on the first page,
    /// and what the way back leaves on the others.
    property <length> front-list-h: max(0px, settings.height - root.panel-pad);
    property <length> leaf-list-h: max(0px, settings.height - root.panel-pad - root.row-h);
    /// The same once the panel has finished moving (see `rest-height` on the
    /// list).
    property <length> front-rest-h: min(root.front-natural,
        max(0px, root.panel-max-h - root.panel-pad));
    property <length> leaf-rest-h: min(root.page-natural(root.leaf-page),
        max(0px, root.panel-max-h - root.panel-pad - root.row-h));
    /// The row the keyboard is on, for the page's list to bring into view.
    /// The pages are built inside conditions, out of the key handler's reach,
    /// so it is left here with a tick (see `ScrollList.reveal-tick`).
    property <length> settings-reveal-top;
    property <length> settings-reveal-h;
    property <int> settings-reveal-tick;

    /// How many sliders a page of them has, the row the first is, and how far
    /// down the list it starts: under the ambient border's switch and a gap.
    pure function sliders-on(page: int) -> int {
        return page == 1 ? root.glass-params.length : root.border-params.length;
    }
    pure function sliders-from(page: int) -> int {
        return page == 2 ? 2 : 1;
    }
    pure function sliders-top(page: int) -> length {
        return page == 2 ? root.toggle-h + Rows.group-gap : 0px;
    }
    /// Whether a row of a page of sliders is one of them.
    pure function is-slider(page: int, row: int) -> bool {
        return (page == 1 || page == 2) && row >= root.sliders-from(page)
            && row < root.sliders-from(page) + root.sliders-on(page);
    }
    /// Where a row of a settings page is in its list, and how tall it is.
    /// Row 0 of every page but the first is the way back, which is not in
    /// the list.
    pure function settings-row-top(page: int, row: int) -> length {
        if (page == 0) {
            // A heading over rows 0 and 2, the second after a gap.
            return row * root.row-h + root.heading-h
                + (row >= 2 ? root.heading-h + Rows.group-gap : 0px);
        }
        // The ambient border's switch, the sliders, then the gap and the reset.
        if (page == 2 && row == 1) {
            return 0px;
        }
        if (page == 1 || page == 2) {
            return root.sliders-top(page) + (root.is-slider(page, row)
                ? (row - root.sliders-from(page)) * Rows.slider-row
                : root.sliders-on(page) * Rows.slider-row + Rows.group-gap);
        }
        if (page == 3) {
            return (row - 1) * root.toggle-h;
        }
        return (row - 1) * root.row-h;
    }
    pure function settings-row-h(page: int, row: int) -> length {
        if (root.is-slider(page, row)) {
            return Rows.slider-row;
        }
        if (page == 2 && row == 1) {
            return root.toggle-h;
        }
        if (page == 3) {
            return root.toggle-h;
        }
        return root.row-h;
    }
    property <length> panel-pad: 2 * Rows.panel-pad;

    // Each tracks panel is a heading over one list. A list with nothing in it
    // says so in one line, rather than leave a heading over nothing.
    property <bool> has-subs: root.sub-tracks.length > 0;
    property <bool> has-audio: root.audio-tracks.length > 0;
    /// No tracks and nothing to search with.
    property <bool> subs-empty: !root.has-subs && !root.find-offered;

    /// The "Off" row belongs to the subtitle list, so it counts with it.
    out property <length> subs-natural: root.has-subs
        ? (1 + root.sub-tracks.length) * root.row-h
        : root.subs-empty ? root.row-h : 0px;
    /// Under the list, a group gap below the tracks when there are any to
    /// set it off from, then the ways to the pages of the one showing and
    /// to the search.
    property <length> subs-fixed: (root.subs-showing ? 2 * root.row-h : 0px)
        + (root.find-offered ? root.row-h : 0px)
        + (root.has-subs && (root.subs-showing || root.find-offered) ? Rows.group-gap : 0px);
    /// A subtitle is showing, so there is a timing to sync and to set, and a
    /// size and position to judge.
    property <bool> subs-showing: root.has-subs && root.subs-visible && root.sub-current >= 0;
    /// The timing is off zero, as the way to its page says.
    property <bool> timing-moved: abs(root.sub-delay) >= 0.005
        || abs(root.sub-speed - 1) >= 0.0005;
    /// The timing's reset is offered while there is something to reset, and
    /// stays to be taken back.
    property <bool> timing-resettable: root.timing-moved
        || root.reset-armed == 3 || root.reset-undoable == 3;
    /// Timing's readout, as wide as the delay reads at its widest.
    property <length> timing-value-w: max(62px, delay-measure.preferred-width + 4px);
    out property <length> audio-natural: root.has-audio
        ? root.audio-tracks.length * root.row-h : root.row-h;
    out property <length> subs-h: min(
        root.panel-pad + root.heading-h + root.subs-natural + root.subs-fixed,
        root.panel-max-h);
    out property <length> subs-list-h:
        max(0px, root.subs-h - root.panel-pad - root.heading-h - root.subs-fixed);
    out property <length> audio-h: min(
        root.panel-pad + root.heading-h + root.audio-natural, root.panel-max-h);
    out property <length> audio-list-h:
        max(0px, root.audio-h - root.panel-pad - root.heading-h);

    /// A part's page is headed by its way back, which is a row; the list of
    /// parts, and a list of one part, by a heading.
    property <length> playlist-head-h: root.playlist-lead > 0 ? root.row-h : root.heading-h;
    out property <length> playlist-natural: root.playlist-rows * root.row-h;
    out property <length> playlist-h: min(
        root.panel-pad + root.playlist-head-h + root.playlist-natural
            + Rows.group-gap + root.toggle-h,
        root.panel-max-h);
    /// The room the two pages share: the panel inside its padding, less the
    /// switch below them, which belongs to neither page.
    ///
    /// From the panel's height this frame rather than `playlist-h`, its
    /// destination, which differs during a drill's animation; otherwise the
    /// switch, packed after this, would jump while the panel eased. Reading a
    /// height property is not a layout query, so the "bar geometry" rule
    /// holds.
    property <length> playlist-pages-h: max(0px,
        playlist-panel.height - root.panel-pad - Rows.group-gap - root.toggle-h);
    /// Each page's list under its own head: a heading on the list of parts,
    /// a way back on a part's page. Both are needed while the two slide past
    /// each other.
    property <length> playlist-top-list-h:
        max(0px, root.playlist-pages-h - root.heading-h);
    /// Under a way back when there are parts to go back to, otherwise under
    /// the panel's heading, which is shorter than a row.
    property <length> playlist-leaf-list-h: max(0px, root.playlist-pages-h
        - (root.playlist-tiered ? root.row-h : root.heading-h));
    /// Each list's height once the panel has finished moving to its page:
    /// all of its rows, or what the tallest panel leaves for them (see
    /// `rest-height` on the list).
    property <length> playlist-pages-rest-h: max(0px,
        root.panel-max-h - root.panel-pad - Rows.group-gap - root.toggle-h);
    property <length> playlist-top-rest-h: min(root.playlist-top-natural,
        max(0px, root.playlist-pages-rest-h - root.heading-h));
    property <length> playlist-leaf-rest-h: min(root.playlist-leaf-natural,
        max(0px, root.playlist-pages-rest-h
            - (root.playlist-tiered ? root.row-h : root.heading-h)));
    /// The list showing, for the keys that measure a page by it.
    out property <length> playlist-list-h: root.playlist-lead > 0
        ? root.playlist-leaf-list-h : root.playlist-top-list-h;
    /// What each page's rows add up to. The showing page's is also
    /// `playlist-natural`, which sizes the panel.
    property <length> playlist-top-natural: root.playlist-groups.length * root.row-h;
    property <length> playlist-leaf-natural: root.playlist-entries.length * root.row-h;

    /// Where the showing list starts in the window, for the test that takes
    /// hold of its scroll bar.
    out property <length> playlist-list-top:
        playlist-panel.y + root.panel-pad + root.playlist-head-h;
    /// Scroll offsets, for the test that checks a wheel over a list moves it.
    out property <length> subs-scroll: subs-list.offset;
    out property <length> playlist-scroll: root.playlist-top
        ? playlist-top-list.offset : playlist-leaf-list.offset;

    /// Centre a panel on the control it belongs to, kept inside the margins:
    /// pinned to a margin it still reads as its button's, where clipped at
    /// the window's edge it wouldn't.
    pure function anchored-x(centre: length, w: length) -> length {
        return clamp(centre - w / 2,
            root.panel-margin,
            root.width - w - root.panel-margin);
    }

    /// The settings' lists, which are built inside conditions and can't be
    /// read from here, so each leaves its `fade` in one of these: the first
    /// page's, and whichever page is behind it.
    property <ScrollFade> front-fade;
    property <ScrollFade> leaf-fade;

    /// A list's `fade`, clipped to its panel and faded with it, including the
    /// angle back to its current row. Zero-sized for a panel that is gone.
    pure function fade-within(list: ScrollFade, shown: float,
        x: length, y: length, w: length, h: length) -> ScrollFade {
        return {
            x: list.x,
            y: list.y,
            width: shown > root.shown-epsilon ? list.width : 0px,
            height: shown > root.shown-epsilon ? list.height : 0px,
            top: list.top,
            bottom: list.bottom,
            right: 0,
            clip-x: x,
            clip-y: y,
            clip-width: w,
            clip-height: h,
            way: shown > root.shown-epsilon ? list.way * shown : 0,
            way-x: list.way-x,
            way-y: list.way-y,
            way-up: list.way-up,
            way-lit: list.way-lit,
        };
    }

    /// Every scrolling list, for the soft edge on its ends (see `ScrollFade`).
    out property <[ScrollFade]> scroll-fades: [
        // Each of the menu's lists only while its page is drawn: the search's
        // rests where the other pages do, and would soften their rows.
        root.fade-within(subs-list.fade, root.menu-drill < 1.0 ? root.menu-shown : 0,
            menu.x, menu.y, menu.width, menu.height),
        root.fade-within(audio-list.fade, root.audio-shown,
            audio-panel.x, audio-panel.y, audio-panel.width, audio-panel.height),
        root.fade-within(find-list.fade, root.menu-leaf == 3 ? root.menu-shown : 0,
            menu.x, menu.y, menu.width, menu.height),
        root.fade-within(playlist-top-list.fade, root.playlist-shown,
            playlist-panel.x, playlist-panel.y,
            playlist-panel.width, playlist-panel.height),
        root.fade-within(playlist-leaf-list.fade, root.playlist-shown,
            playlist-panel.x, playlist-panel.y,
            playlist-panel.width, playlist-panel.height),
        root.fade-within(root.front-fade,
            root.settings-page == 0 && root.drill < 1.0 ? root.settings-shown : 0,
            settings.x, settings.y, settings.width, settings.height),
        root.fade-within(root.leaf-fade, root.drill > 0.0 ? root.settings-shown : 0,
            settings.x, settings.y, settings.width, settings.height),
        // The title, which isn't a list but runs out of its room the same way.
        {
            x: root.bar-x + root.lp-title,
            y: root.pills-y + root.bar-rise + root.pill-pad,
            width: root.loaded-shown > root.shown-epsilon ? root.title-room : 0px,
            height: root.pill-h - 2 * root.pill-pad,
            top: 0,
            bottom: 0,
            right: clamp((root.title-w - root.title-room) / Rows.fade, 0, 1),
            clip-x: root.bar-x,
            clip-y: root.pills-y + root.bar-rise,
            clip-width: root.left-w,
            clip-height: root.pill-h,
        },
    ];

    /// The room the title has: its group, less everything in it that is not
    /// the title.
    property <length> title-room: max(0px, root.left-w - root.left-fixed);

    /// Where the pipeline draws glass. A closed surface publishes a zero-sized
    /// rect, which the Rust side drops, so this stays a plain literal rather
    /// than an array built conditionally.
    out property <[GlassRect]> glass-rects: [
        // The whole bar on one pane: the timeline over the row of buttons,
        // with `bar-pad` round them.
        //
        // Glass because over a white frame a bare track all but vanishes, and
        // the glass's absorption is what darkens behind it. One pane rather
        // than a capsule for each row and group, because the rim is as wide as
        // the corner (`BEVEL`), so a capsule is rim the whole way through; a
        // pane taller than its corners has a flat middle for the rim to roll
        // down from. A part alone is too short for that, and is a capsule
        // like the pills.
        {
            x: root.panel-margin,
            y: root.bar-edge + root.bar-rise,
            width: root.bar-shown > root.shown-epsilon ? root.bar-drawn-w : 0,
            height: root.bar-shown > root.shown-epsilon ? root.bar-drawn-h : 0,
            opacity: root.bar-shown,
            // Opt in to tinting; the strength is the global slider.
            tint: 1.0,
            radius: min(root.panel-radius, root.bar-drawn-h / 2),
        },
        // The window's own buttons, on one pane.
        {
            x: root.window-pane-x,
            y: root.window-pane-y + root.window-drop,
            width: root.window-shown > root.shown-epsilon ? root.window-pane-w : 0,
            height: root.window-shown > root.shown-epsilon ? root.window-pane-h : 0,
            opacity: root.window-shown,
            radius: root.window-pane-h / 2,
            tint: 1.0,
        },
        // The disc under the ring (see `ring-disc`). After the bar, since a
        // later pane is drawn over an earlier one.
        {
            x: root.ring-disc-x,
            y: root.pills-y + root.bar-rise + root.pill-pad,
            width: root.pills-shown * root.ring-disc-on > root.shown-epsilon ? root.btn : 0,
            height: root.pills-shown * root.ring-disc-on > root.shown-epsilon ? root.btn : 0,
            opacity: root.pills-shown * root.ring-disc-on,
            radius: root.btn / 2,
            tint: 1.0,
            nested: true,
            ring: true,
        },
        // The disc under the button whose panel is open (see `open-disc`).
        {
            x: root.open-disc-x,
            y: root.pills-y + root.bar-rise + root.pill-pad,
            width: root.pills-shown * root.open-disc-on > root.shown-epsilon ? root.btn : 0,
            height: root.pills-shown * root.open-disc-on > root.shown-epsilon ? root.btn : 0,
            opacity: root.pills-shown * root.open-disc-on,
            radius: root.btn / 2,
            tint: 1.0,
            nested: true,
            open: true,
        },
        {
            x: root.flash-x(root.flash-ring),
            y: root.flash-y + root.flash-rise,
            width: root.flash-shown > root.shown-epsilon && root.flash-has-ring
                ? root.flash-ring : 0,
            height: root.flash-shown > root.shown-epsilon && root.flash-has-ring
                ? root.flash-ring : 0,
            opacity: root.flash-shown,
            // Half the size, so the rounded box the shader draws is a circle.
            radius: root.flash-ring / 2,
            tint: 1.0,
        },
        {
            x: root.flash-text-x + root.flash-slide,
            y: root.flash-text-y + root.flash-text-rise,
            width: root.flash-shown > root.shown-epsilon && root.flash-text != ""
                ? root.flash-text-w : 0,
            height: root.flash-shown > root.shown-epsilon && root.flash-text != ""
                ? root.flash-text-h : 0,
            opacity: root.flash-shown,
            radius: root.flash-text-h / 2,
            tint: 1.0,
        },
        // The hover label. Glass like everything else that carries words.
        {
            x: root.tip-x,
            y: root.tip-y + root.tip-rise,
            width: root.tip-on > root.shown-epsilon ? root.tip-w : 0,
            height: root.tip-on > root.shown-epsilon ? root.tip-h : 0,
            opacity: root.tip-on,
            radius: root.tip-h / 2,
            tint: 1.0,
        },
        {
            x: root.invite-x,
            y: root.invite-y + root.invite-rise,
            width: root.invite-shown > root.shown-epsilon ? root.invite-w : 0,
            height: root.invite-shown > root.shown-epsilon ? root.invite-h : 0,
            opacity: root.invite-shown,
            radius: root.panel-radius,
            tint: 1.0,
        },
        {
            x: root.end-x,
            y: root.end-y + root.end-rise,
            width: root.end-shown > root.shown-epsilon ? root.end-w : 0,
            height: root.end-shown > root.shown-epsilon ? root.end-h : 0,
            opacity: root.end-shown,
            radius: root.end-h / 2,
            tint: 1.0,
        },
        {
            x: root.credits-x,
            y: root.credits-y + root.credits-rise,
            width: root.credits-shown > root.shown-epsilon ? root.credits-w : 0,
            height: root.credits-shown > root.shown-epsilon ? root.pill-h : 0,
            opacity: root.credits-shown,
            radius: root.pill-h / 2,
            tint: 1.0,
        },
        {
            x: root.preview-x,
            y: root.preview-y + root.preview-rise,
            width: root.preview-shown > root.shown-epsilon ? root.preview-w : 0,
            height: root.preview-shown > root.shown-epsilon ? root.preview-h : 0,
            opacity: root.preview-shown,
            // With no tile it is a single line of figures, and a capsule like
            // every other one, since its 18px corner is more than half of 26px.
            radius: root.preview-has-tile ? root.preview-radius : root.preview-h / 2,
            tint: 1.0,
        },
        {
            x: menu.x,
            y: menu.y,
            width: root.menu-shown > root.shown-epsilon ? menu.width : 0,
            height: root.menu-shown > root.shown-epsilon ? menu.height : 0,
            opacity: root.menu-shown,
            radius: root.panel-radius,
            // Opt in to tinting; the strength is the global slider.
            tint: 1.0,
        },
        {
            x: audio-panel.x,
            y: audio-panel.y,
            width: root.audio-shown > root.shown-epsilon ? audio-panel.width : 0,
            height: root.audio-shown > root.shown-epsilon ? audio-panel.height : 0,
            opacity: root.audio-shown,
            radius: root.panel-radius,
            tint: 1.0,
        },
        {
            x: files-panel.x,
            y: files-panel.y,
            width: root.files-shown > root.shown-epsilon ? files-panel.width : 0,
            height: root.files-shown > root.shown-epsilon ? files-panel.height : 0,
            opacity: root.files-shown,
            radius: root.panel-radius,
            tint: 1.0,
        },
        {
            x: playlist-panel.x,
            y: playlist-panel.y,
            width: root.playlist-shown > root.shown-epsilon ? playlist-panel.width : 0,
            // The panel's height this frame, as every rect here takes it, not
            // the `playlist-h` it is animating towards.
            height: root.playlist-shown > root.shown-epsilon ? playlist-panel.height : 0,
            opacity: root.playlist-shown,
            radius: root.panel-radius,
            tint: 1.0,
        },
        {
            x: settings.x,
            y: settings.y,
            width: root.settings-shown > root.shown-epsilon ? settings.width : 0,
            height: root.settings-shown > root.shown-epsilon ? settings.height : 0,
            opacity: root.settings-shown,
            radius: root.panel-radius,
            // Opt in to tinting; the strength is the global slider.
            tint: 1.0,
        },
        // The pane under the ring on a row or a pill's choice (see `Ring`).
        // Last, since it lies on whichever surface it is in.
        {
            x: Ring.x,
            y: Ring.y,
            width: root.ring-pane-on > root.shown-epsilon ? Ring.width : 0,
            height: root.ring-pane-on > root.shown-epsilon ? Ring.height : 0,
            opacity: root.ring-pane-on,
            radius: Ring.radius,
            tint: 1.0,
            nested: true,
            ring: true,
            host-y: root.ring-host-y,
            host-height: root.ring-host-h,
        },
    ];

    /// How far the pane under the ring is on: with the ring held, and with
    /// the surface it is in, so it arrives with a panel opened from a key
    /// rather than ahead of it.
    property <float> ring-pane-on: root.ring-held * root.ring-host-shown;
    property <float> ring-held: Ring.held && Chrome.focus-visible ? 1 : 0;
    animate ring-held { duration: Motion.highlight; easing: ease-out; }
    /// How far in the surface the keys are steering is, in the order the
    /// key handler asks.
    property <float> ring-host-shown: root.menu-open ? root.menu-shown
        : root.audio-open ? root.audio-shown
        : root.playlist-open ? root.playlist-shown
        : root.settings-open ? root.settings-shown
        : root.files-open ? root.files-shown
        : root.centre-up ? root.end-shown
        : root.corner-offered ? root.credits-shown
        : root.invite-shown;
    /// Where that surface's glass is, top and height, for the pane to be cut
    /// to (see `GlassRect.host-y`).
    property <length> ring-host-y: root.menu-open ? menu.y
        : root.audio-open ? audio-panel.y
        : root.playlist-open ? playlist-panel.y
        : root.settings-open ? settings.y
        : root.files-open ? files-panel.y
        : root.centre-up ? root.end-y + root.end-rise
        : root.corner-offered ? root.credits-y + root.credits-rise
        : root.invite-y + root.invite-rise;
    property <length> ring-host-h: root.menu-open ? menu.height
        : root.audio-open ? audio-panel.height
        : root.playlist-open ? playlist-panel.height
        : root.settings-open ? settings.height
        : root.files-open ? files-panel.height
        : root.centre-up ? root.end-h
        : root.corner-offered ? root.pill-h
        : root.invite-h;

    title: "Death by MPV";
    // No frame: the film runs to the window's edges, the window's buttons
    // are its own (`window-pane-x`), and the picture is what drags it
    // (`video-surface`).
    no-frame: true;
    // The edge a frame would have given to take hold of. None while
    // maximized, since there is nothing to resize from.
    resize-border-width: root.maximized ? 0px : 8px;
    preferred-width: 1280px;
    preferred-height: 720px;
    // The floor: 960×540, 16:9 at three quarters of the opening size, which
    // still leaves the title some room once the transport has given way to
    // the right group.
    min-width: 960px;
    min-height: 540px;
    background: Paint.ground;
    default-font-family: Type.face;
    // For text that names no weight, since Slint's default of 400 is not one
    // the bundled files carry.
    default-font-weight: Type.weight-plain;
    forward-focus: keys;

    // Key dispatch is split across several small functions, because Slint's
    // compiler recurses once per nested statement, and one handler with every
    // binding overflowed the build script's stack in debug builds.

    /// Move the ring, wrapping at both ends, because these lists are short
    /// and the useful rows are at the ends: `Off` at the top of the subtitles,
    /// the last episode at the bottom. A page ending in its reset doesn't
    /// wrap (see `focus-has-reset`).
    function focus-move(delta: int) {
        if (root.focus-count <= 0) {
            return;
        }
        if (root.focus-has-reset) {
            root.focus-row = clamp(root.focus-row + delta, 0, root.focus-count - 1);
            return;
        }
        root.focus-row = root.focus-row + delta;
        if (root.focus-row < 0) {
            root.focus-row = root.focus-count - 1;
        }
        if (root.focus-row >= root.focus-count) {
            root.focus-row = 0;
        }
    }

    /// Press the row under the ring. Settings is split out below, since its
    /// pages nest deeply enough on their own for the compiler.
    function focus-activate() -> bool {
        // The ring can outlive its row, since opening a file replaces the
        // playlist and the tracks, so check before indexing a model.
        if (root.focus-row >= root.focus-count) {
            root.focus-row = 0;
        }
        if (root.menu-open) {
            if (root.account-open) {
                root.account-activate();
            } else if (root.find-open) {
                if (root.focus-row == 0) {
                    root.close-find();
                } else if (root.signed-in && root.focus-row == root.find-account-at) {
                    root.open-account();
                } else {
                    root.fetch-row(root.focus-row - 1);
                }
            } else if (root.subs-page != 0) {
                root.subs-page-activate();
            } else if (root.find-offered && root.focus-row == root.subs-focus-count - 1) {
                root.open-find();
            } else if (root.focus-row < root.subs-track-rows) {
                root.select-subtitle(root.focus-row == 0
                    ? -1
                    : root.sub-tracks[root.focus-row - 1].id);
            } else {
                root.open-subs-page(root.focus-row - root.subs-pages-at + 1);
            }
            return true;
        }
        if (root.audio-open) {
            if (root.has-audio) {
                root.select-audio(root.audio-tracks[root.focus-row].id);
            }
            return true;
        }
        if (root.playlist-open) {
            if (root.focus-row < root.playlist-lead) {
                root.playlist-back();
            } else if (root.focus-row < root.playlist-lead + root.playlist-rows) {
                root.playlist-pick(root.focus-row - root.playlist-lead);
            } else {
                root.autoplay = !root.autoplay;
                root.set-autoplay(root.autoplay);
            }
            return true;
        }
        if (root.files-open) {
            root.files-open = false;
            root.request-open(root.focus-row != 0);
            return true;
        }
        if (root.settings-open) {
            return root.focus-activate-settings();
        }
        if (!root.has-file && root.fatal != "") {
            if (root.focus-row == 0) {
                root.copy-details();
            } else {
                root.quit();
            }
            return true;
        }
        if (!root.has-file && root.fatal == "") {
            if (root.focus-row < root.invite-first) {
                if (!root.opening) {
                    root.open-path(root.resume-path, false);
                }
            } else if (root.focus-row < root.invite-first + 2) {
                root.request-open(root.focus-row == root.invite-first + 1);
            } else if (root.focus-row == root.invite-first + 2) {
                root.open-settings(true);
            } else {
                root.open-settings-page(4);
            }
            return true;
        }
        return false;
    }

    /// Row 0 of every page but the first is the way back, and the last row of
    /// a page of controls is its reset. Enter does nothing on a slider or a
    /// stepper, which left and right move.
    function focus-activate-settings() -> bool {
        if (root.settings-page == 0) {
            root.settings-page = root.focus-row + 1;
            // Start at the new page's top, since the row number that opened
            // it may not exist there.
            root.focus-row = 0;
            return true;
        }
        if (root.focus-row == 0) {
            root.settings-page = 0;
            return true;
        }
        if (root.settings-page == 3) {
            if (root.focus-row == 1) {
                root.set-motion(!Motion.enabled);
            } else if (root.focus-row == 2) {
                root.set-legible(!root.legible-glass);
            } else if (root.focus-row == 3) {
                root.set-tips-shown(!Tip.enabled);
            } else if (Tip.enabled) {
                root.set-tip-keys-shown(!Tip.with-keys);
            }
            return true;
        }
        if (root.settings-page == 5) {
            root.pick-language(root.focus-row - 1);
            return true;
        }
        if (root.settings-page == 2 && root.focus-row == 1) {
            root.ambience-on = !root.ambience-on;
            root.set-ambience(root.ambience-on);
            return true;
        }
        if (root.focus-row == root.settings-focus-count - 1) {
            if (root.focus-has-reset) {
                root.reset-row(root.settings-page);
            }
            return true;
        }
        return false;
    }

    // --- resetting a page -----------------------------------------------------
    //
    // Two presses, then a way back, because settings save at once and a look
    // tuned by eye can't be typed back in. The first press says what the
    // second will do; after the second, the same row offers to undo it until
    // the page is left.
    //
    // What each reset row resets: 1 the glass and 2 the ambient border, as
    // `settings-page` numbers their pages; then, from the subtitles menu,
    // 3 the timing, which is the film's alone and is undone from here rather
    // than from what the settings saved, and 4 the size and position. Zero is
    // none.
    property <int> reset-armed: 0;
    property <int> reset-undoable: 0;
    /// The subtitle delay and speed that stood when the timing was reset.
    property <float> reset-delay: 0;
    property <float> reset-sub-speed: 1;

    function reset-row(page: int) {
        if (root.reset-undoable == page) {
            if (page == 3) {
                root.set-timing(root.reset-delay, root.reset-sub-speed);
            } else {
                root.undo-reset(page);
            }
            root.reset-undoable = 0;
            return;
        }
        if (root.reset-armed != page) {
            root.reset-armed = page;
            reset-timer.stop();
            reset-timer.start();
            return;
        }
        reset-timer.stop();
        root.reset-armed = 0;
        root.reset-delay = root.sub-delay;
        root.reset-sub-speed = root.sub-speed;
        if (page == 1) {
            root.reset-section(0);
        } else if (page == 2) {
            root.reset-section(1);
        } else if (page == 3) {
            root.set-timing(0, 1);
        } else {
            root.reset-subtitles();
        }
        root.reset-undoable = page;
    }

    // --- removing a track ------------------------------------------------------
    //
    // Two presses, as a reset takes, because a downloaded subtitle's file goes
    // with it and getting it back is another download against a small daily
    // allowance. The first press says what the second will do. A track is
    // named by its id and its kind, since mpv numbers each kind from one.
    property <int> remove-armed: -1;
    property <bool> remove-armed-sub;

    function remove-row(id: int, subtitle: bool) {
        if (root.remove-armed == id && root.remove-armed-sub == subtitle) {
            remove-timer.stop();
            root.remove-armed = -1;
            root.remove-track(id, subtitle);
            return;
        }
        root.remove-armed = id;
        root.remove-armed-sub = subtitle;
        remove-timer.stop();
        remove-timer.start();
    }

    remove-timer := Timer {
        interval: root.armed-for;
        running: false;
        triggered => {
            root.remove-armed = -1;
            remove-timer.stop();
        }
    }

    changed menu-open => {
        root.leave-subs-page();
    }
    changed subs-page => {
        root.leave-subs-page();
    }

    /// What a page of the subtitles menu armed or offered to take back goes
    /// with it, as a settings page's reset does.
    function leave-subs-page() {
        root.remove-armed = -1;
        root.asked-row = -1px;
        root.placing-subtitles = false;
        root.forget-sync();
        if (root.reset-armed >= 3 || root.reset-undoable >= 3) {
            root.reset-armed = 0;
            root.reset-undoable = 0;
        }
    }

    // A page of the subtitle showing goes with it, whichever way it goes: C,
    // another file, or its track removed. It stays on the tracks, at Off.
    changed subs-showing => {
        if (!root.subs-showing && root.subs-page != 0) {
            root.subs-page = 0;
            root.focus-row = root.subs-open-row;
        }
    }
    changed audio-open => {
        root.remove-armed = -1;
    }

    // Taking out a panel's last track would leave the ring on no row, with
    // Enter pressing nothing and its pane where the row was. It goes to the
    // row that is last now.
    changed focus-count => {
        if (((root.menu-open && !root.find-open) || root.audio-open)
                && root.focus-count > 0 && root.focus-row >= root.focus-count) {
            root.focus-row = root.focus-count - 1;
        }
    }

    changed find-open => {
        root.remove-armed = -1;
        root.asked-row = -1px;
    }

    // The timing is a file's alone, so what would take a sync or a reset of it
    // back goes when another file opens under the menu, rather than put one
    // film's timing on the next. So does a pause a frame step made: a file
    // that opens paused is one to see where you are in. And the file says
    // what it is, by itself, however it came.
    changed current-path => {
        root.forget-sync();
        if (root.reset-armed == 3 || root.reset-undoable == 3) {
            root.reset-armed = 0;
            root.reset-undoable = 0;
        }
        root.stepped = false;
        root.glimpse-title();
    }

    // --- syncing subtitles to speech ----------------------------------------
    //
    // One row with three states, like the reset's: what it does, that it is
    // doing it, and that it can be taken back. Listening takes seconds, so
    // the row says so meanwhile and ignores presses, which would only start
    // it over. Undo is offered until its page is left, since the timing it
    // replaced may have been set by ear.

    /// How far down the open panel the middle of the row that last asked for
    /// something slow is, so the answer can be put beside it. Negative once
    /// that row is gone.
    property <length> asked-row: -1px;

    function sync-row() {
        // The sync is the timing page's first row, under its way back.
        root.asked-row = Rows.panel-pad + root.row-h + root.row-h / 2;
        if (root.sync-state == 2) {
            root.set-timing(root.sync-was-delay, root.sync-was-speed);
            root.sync-state = 0;
        } else if (root.sync-state == 0) {
            root.sync-state = 1;
            root.sync-subtitles();
        }
    }

    pure function sync-label() -> string {
        return root.sync-state == 1 ? @tr("Listening…")
            : root.sync-state == 2 ? @tr("Undo sync")
            : @tr("Sync to speech");
    }

    /// Leaving the page drops the undo. A run still listening is left to
    /// finish, and its answer is shown wherever the panel is by then.
    function forget-sync() {
        if (root.sync-state == 2) {
            root.sync-state = 0;
        }
    }

    /// Turn the interface's motion on or off, from the switch or from Enter
    /// on its row. Set here first so the next frame shows it before Rust has
    /// heard.
    function set-motion(on: bool) {
        Motion.enabled = on;
        root.set-animations(on);
    }

    /// Turn the tips on or off, the same way. None is visible while this page
    /// is open, but one can be held under it, so turning them off clears it.
    function set-tips-shown(on: bool) {
        Tip.enabled = on;
        if (!on) {
            Tip.clear();
        }
        root.set-tips(on);
    }

    function set-legible(on: bool) {
        root.legible-glass = on;
        root.set-legible-glass(on);
    }

    function set-tip-keys-shown(on: bool) {
        Tip.with-keys = on;
        root.set-tip-keys(on);
    }

    /// A slider's icon, by its place in `REGISTRY` in settings.rs. Kept in
    /// step by hand, because an image in the rows' model would have to be
    /// loaded at run time.
    pure function param-icon(index: int) -> image {
        if (index == 0) {
            return @image-url("../../../public/icons/blur.svg");
        }
        if (index == 1) {
            return @image-url("../../../public/icons/refraction.svg");
        }
        if (index == 2) {
            return @image-url("../../../public/icons/dispersion.svg");
        }
        if (index == 3) {
            return @image-url("../../../public/icons/edge-light.svg");
        }
        if (index == 4) {
            return @image-url("../../../public/icons/tint.svg");
        }
        if (index == 5) {
            return @image-url("../../../public/icons/dimming.svg");
        }
        if (index == 6) {
            return @image-url("../../../public/icons/shadow.svg");
        }
        if (index == 7) {
            return @image-url("../../../public/icons/edge-blur.svg");
        }
        if (index == 8) {
            return @image-url("../../../public/icons/angle.svg");
        }
        if (index == 9) {
            return @image-url("../../../public/icons/curve.svg");
        }
        return @image-url("../../../public/icons/curve-soft.svg");
    }

    /// The warning while the row is armed, since the next press throws a
    /// page of settings away.
    pure function reset-icon(page: int) -> image {
        return root.reset-armed == page && root.reset-undoable != page
            ? @image-url("../../../public/icons/warning.svg")
            : @image-url("../../../public/icons/reset.svg");
    }

    pure function reset-label(page: int) -> string {
        return root.reset-undoable == page ? @tr("Undo reset")
            : root.reset-armed == page ? @tr("Press again to reset")
            : page == 3 ? @tr("Reset timing")
            : @tr("Reset to defaults");
    }

    /// How long a row armed by its first press waits for the second: long
    /// enough to read the new wording and press again, short enough that an
    /// armed row won't catch a press meant for something else.
    property <duration> armed-for: 2500ms;

    reset-timer := Timer {
        interval: root.armed-for;
        running: false;
        triggered => {
            root.reset-armed = 0;
            reset-timer.stop();
        }
    }

    changed settings-page => {
        root.asked-row = -1px;
        root.reset-armed = 0;
        root.reset-undoable = 0;
        // Only on the way in, so the departing page stays drawn while it
        // slides out.
        if (root.settings-page != 0) {
            root.leaf-page = root.settings-page;
        }
    }

    changed settings-open => {
        root.reset-armed = 0;
        root.reset-undoable = 0;
        if (root.settings-open) {
            settings-rest.stop();
        } else {
            settings-rest.start();
        }
    }

    /// Puts a closed panel back on its front page once it has faded out, not
    /// as it closes, or the front page would slide in during the fade.
    settings-rest := Timer {
        interval: Motion.surface;
        running: false;
        triggered => {
            settings-rest.stop();
            if (!root.settings-open) {
                root.settings-page = 0;
            }
        }
    }

    /// The subtitles' three adjustments, from their rows and their keys.
    /// Position lets the line down to where it rests while it is set; the
    /// other two lift it back up (see `subtitle-lift`).
    function step-sub-delay(dir: float) {
        root.placing-subtitles = false;
        root.nudge-sub-delay(dir * root.delay-step);
    }

    function step-sub-scale(dir: float) {
        root.placing-subtitles = false;
        root.nudge-sub-scale(dir * root.sub-scale-step);
    }

    function step-sub-pos(dir: float) {
        root.placing-subtitles = true;
        root.nudge-sub-pos(dir * root.sub-pos-step);
    }

    /// Left and right, only where the row under the ring is something they
    /// can move. Elsewhere this returns false, and `focus-sideways` decides.
    function focus-adjust(delta: int) -> bool {
        if (root.menu-open && !root.find-open && root.subs-page != 0) {
            return root.subs-page-adjust(delta);
        }
        if (!root.settings-open || root.focus-row < 1) {
            return false;
        }
        if (root.settings-page == 1
            && root.focus-row <= root.glass-params.length) {
            root.set-param(root.glass-params[root.focus-row - 1].index,
                clamp(root.glass-params[root.focus-row - 1].fraction
                    + delta * root.focus-step, 0.0, 1.0));
            return true;
        }
        if (root.settings-page == 2 && root.is-slider(2, root.focus-row)) {
            root.set-param(root.border-params[root.focus-row - 2].index,
                clamp(root.border-params[root.focus-row - 2].fraction
                    + delta * root.focus-step, 0.0, 1.0));
            return true;
        }
        return false;
    }

    /// The same on the subtitles menu's pages, whose steppers are Timing's
    /// second row, and Size and Position's first two.
    function subs-page-adjust(delta: int) -> bool {
        if (root.subs-page == 1 && root.focus-row == 2) {
            root.step-sub-delay(delta);
            return true;
        }
        if (root.subs-page == 2 && root.focus-row == 1) {
            root.step-sub-scale(delta);
            return true;
        }
        if (root.subs-page == 2 && root.focus-row == 2) {
            root.step-sub-pos(delta);
            return true;
        }
        return false;
    }

    /// A hundredth of the range per press, because these are judged by eye,
    /// and at a twentieth the look you wanted fell between presses. The
    /// readout is never coarser than this, so every press shows.
    property <float> focus-step: 0.01;

    /// Tried before every other key, and answers only for keys the row under
    /// the ring can use, so Space still pauses with the playlist open.
    function on-focus(text: string, shift: bool, ctrl: bool) -> bool {
        if (root.focus-count <= 0) {
            return false;
        }
        // The shortcuts page is read, not walked, so the arrows scroll its
        // list. Nested rather than one `&&` chain, because `on-read` acts, and
        // a call with an effect doesn't belong beside the test that guards it.
        if (root.settings-open && root.settings-page == 4) {
            if (root.on-read(text)) {
                return true;
            }
        }
        // A key that brings the ring up does only that, since the row it is
        // on was chosen by nobody. The arrows are the exception, because where
        // they land isn't in doubt: Down starts at the top and Up at the bottom.
        if (text == Key.DownArrow) {
            if (!Chrome.focus-visible) {
                root.focus-show(0);
                return true;
            }
            root.focus-move(1);
            return true;
        }
        if (text == Key.UpArrow) {
            if (!Chrome.focus-visible) {
                // The bottom, but not a reset, which one more Enter would arm.
                root.focus-show(root.focus-count - 1
                    - (root.focus-has-reset ? 1 : 0));
                return true;
            }
            root.focus-move(-1);
            return true;
        }
        if (text == Key.Tab) {
            if (!Chrome.focus-visible) {
                root.focus-show(root.focus-row);
                return true;
            }
            root.focus-move(shift ? -1 : 1);
            return true;
        }
        if (text == Key.Return) {
            if (!Chrome.focus-visible && !root.continue-sure) {
                root.focus-show(root.focus-row);
                return true;
            }
            return root.focus-activate();
        }
        if (root.focus-jump(text)) {
            return true;
        }
        if (text == Key.LeftArrow || text == Key.RightArrow) {
            return root.focus-sideways(text == Key.RightArrow ? 1 : -1, shift || ctrl);
        }
        return false;
    }

    /// Left and right move the row the ring is on, where it is one they move.
    /// Otherwise, in a panel, they go the way its rows do: right opens the
    /// row the ring is on if it leads somewhere, left goes back a page if
    /// there is one, and anything else does nothing, since the film jumping
    /// behind a menu is a key pressed in the wrong place. Held with Shift or
    /// Ctrl they are the film's again, as they are with no panel open.
    function focus-sideways(delta: int, held: bool) -> bool {
        if (Chrome.focus-visible && root.focus-adjust(delta)) {
            return true;
        }
        if (!root.panel-open || held) {
            return false;
        }
        if (delta < 0) {
            root.page-back();
        } else if (Chrome.focus-visible) {
            root.focus-enter();
        }
        return true;
    }

    /// Back a page in the open panel, where it has one to go back to, and say
    /// whether it did. Escape's first step, and Left's.
    function page-back() -> bool {
        if (root.settings-open && root.settings-page != 0) {
            root.settings-page = 0;
            root.focus-row = 0;
            return true;
        }
        if (root.playlist-open && root.playlist-lead > 0) {
            root.playlist-back();
            return true;
        }
        if (root.menu-open && root.account-open) {
            root.close-account();
            return true;
        }
        if (root.menu-open && root.find-open) {
            root.close-find();
            return true;
        }
        if (root.menu-open && root.subs-page != 0) {
            root.close-subs-page();
            return true;
        }
        return false;
    }

    /// Right on a row with a chevron: a settings page, a season, a page of the
    /// subtitles menu. Enter does the same; a row that plays or picks
    /// something is left to Enter alone.
    function focus-enter() {
        if (root.settings-open && root.settings-page == 0) {
            root.focus-activate-settings();
        } else if (root.playlist-open && root.playlist-top
                && root.focus-row < root.playlist-rows
                && !root.playlist-groups[root.focus-row].leaf) {
            root.playlist-enter(root.focus-row);
        } else if (root.menu-open && !root.find-open && root.subs-page == 0
                && root.focus-row >= root.subs-track-rows) {
            root.focus-activate();
        } else if (root.menu-open && root.find-open && !root.account-open
                && root.signed-in && root.focus-row == root.find-account-at) {
            root.open-account();
        }
    }

    /// Home and End, Page Up and Page Down, in the two lists that can run to
    /// hundreds of rows. Taken here so they don't restart the film or change
    /// chapter with the list open. They bring the ring up where they land and
    /// stop at the ends rather than wrapping, since nobody aims a jump at the
    /// other end.
    function focus-jump(text: string) -> bool {
        if (!root.menu-open && !root.audio-open && !root.playlist-open) {
            return false;
        }
        if (text == Key.Home) {
            root.focus-show(root.list-first);
            return true;
        }
        if (text == Key.End) {
            root.focus-show(root.list-last);
            return true;
        }
        if (text == Key.PageUp || text == Key.PageDown) {
            root.focus-show(clamp(
                root.focus-row + (text == Key.PageDown ? root.list-page : -root.list-page),
                root.list-first, root.list-last));
            return true;
        }
        return false;
    }

    /// The list's own rows: not the way back above a part's page, nor the
    /// autoplay switch under the playlist, nor the pages and the search under
    /// the tracks, nor the account under the search's results.
    property <bool> find-listing: root.menu-open && root.find-open && !root.account-open;
    property <int> list-first: root.playlist-open ? root.playlist-lead
        : root.find-listing ? 1 : 0;
    property <int> list-last: root.playlist-open
        ? root.playlist-lead + root.playlist-rows - 1
        : root.find-listing ? root.find-hit-count
        : root.on-tracks && root.has-subs ? root.sub-tracks.length
        : root.focus-count - 1;
    /// A page is what the list shows less one row, so the row a jump left
    /// stays on screen to read against.
    property <int> list-page: max(1, Math.floor((root.playlist-open
        ? root.playlist-list-h
        : root.audio-open ? root.audio-list-h
        : root.find-open ? root.find-list-h
        : root.subs-list-h) / root.row-h) - 1);

    /// The same page as a distance, for the one list that is scrolled rather
    /// than walked.
    property <length> read-page: max(root.row-h, root.leaf-list-h - root.row-h);

    /// The reading keys on the shortcuts page, which has no rows to walk, so
    /// the keys move the list instead. Home and End ask for the whole list,
    /// and the list stops at its ends.
    function on-read(text: string) -> bool {
        if (text == Key.UpArrow) {
            root.read-move(-root.row-h);
            return true;
        }
        if (text == Key.DownArrow) {
            root.read-move(root.row-h);
            return true;
        }
        if (text == Key.PageUp) {
            root.read-move(-root.read-page);
            return true;
        }
        if (text == Key.PageDown) {
            root.read-move(root.read-page);
            return true;
        }
        if (text == Key.Home) {
            root.read-move(-root.shortcuts-natural);
            return true;
        }
        if (text == Key.End) {
            root.read-move(root.shortcuts-natural);
            return true;
        }
        return false;
    }

    /// Where the reading keys leave their movement for the list to pick up,
    /// since the page is built inside a conditional (see `ScrollList.asked-by`).
    property <length> read-by: 0px;
    property <int> read-tick: 0;

    function read-move(dy: length) {
        root.read-by = dy;
        root.read-tick += 1;
    }

    function on-playback(text: string) -> bool {
        if (text == " ") {
            // Playing, every way, is the film going on, which the chrome
            // would only cover; pausing is looking for where you are.
            root.key-wake = root.paused || root.at-end ? 2 : 0;
            // As the play button: at the end of a file there is nothing to
            // unpause, and on a saved place, playing goes on from it.
            if (root.arriving) {
                root.arrival-answer(false);
            } else if (root.at-end) {
                root.replay();
            } else {
                root.toggle-pause();
            }
            return true;
        }
        // Not with a panel open, where Home belongs to the list (`focus-jump`
        // or `on-read`), and a page with no use for it should do nothing
        // rather than restart the film.
        if (text == Key.Home && !root.panel-open && root.arriving) {
            root.arrival-answer(true);
            root.key-wake = 2;
            return true;
        }
        if (text == Key.Home && !root.panel-open) {
            root.restart();
            Flash.show(Flash.restart, 0.5);
            root.glimpse-timeline();
            return true;
        }
        return false;
    }

    // A seek shows the timeline alone, which is where the change is; the
    // buttons beside it would only cover more of the picture.
    function on-seek(text: string, ctrl: bool, shift: bool) -> bool {
        if (text == Key.LeftArrow) {
            if (ctrl) {
                root.key-wake = 1;
                // At either end mpv does nothing, so neither does the flash.
                if (!root.at-first) {
                    root.playlist-step(-1);
                    Flash.show(Flash.previous, 0.5);
                }
            } else if (shift) {
                // The small seek, for a missed line. No flash, since its glyph
                // means ten seconds and the timeline shows the change.
                root.seek-relative(-root.fine-seek-step);
                root.glimpse-timeline();
            } else {
                root.seek-relative(-root.seek-step);
                Flash.show(Flash.seek-back, 0.2);
                root.glimpse-timeline();
            }
            return true;
        }
        if (text == Key.RightArrow) {
            if (ctrl) {
                root.key-wake = 1;
                if (!root.at-last) {
                    root.playlist-step(1);
                    Flash.show(Flash.next, 0.5);
                }
            } else if (root.at-end) {
                // From the end, forward is the end pill's first offer: the
                // next file or season. Never the folder dialog, since an arrow
                // held a moment too long is not deliberate enough for one.
                root.key-wake = 2;
                if (!root.at-last) {
                    root.play-next();
                } else if (root.onward-path != "") {
                    root.end-onward();
                }
            } else if (shift) {
                root.seek-relative(root.fine-seek-step);
                root.glimpse-timeline();
            } else {
                root.seek-relative(root.seek-step);
                Flash.show(Flash.seek-forward, 0.8);
                root.glimpse-timeline();
            }
            return true;
        }
        return false;
    }

    // Every key here answers with its flash rather than the bar.
    function on-volume(text: string) -> bool {
        if (text == Key.UpArrow || text == Key.DownArrow) {
            root.nudge-volume(text == Key.UpArrow ? root.volume-step : -root.volume-step);
            root.key-wake = 1;
            Flash.show-figure(5);
            return true;
        }
        if (text == "m" || text == "M") {
            root.toggle-mute();
            root.key-wake = 1;
            Flash.show-figure(5);
            return true;
        }
        // mpv's own key for it.
        if (text == "#") {
            root.cycle-track(false, 1);
            root.key-wake = 1;
            Flash.show-figure(4);
            return true;
        }
        return false;
    }

    // Lower-case z pulls the subtitles earlier, shifted Z pushes them later —
    // mpv's own convention, and the shift state is already in the character.
    function on-subtitles(text: string) -> bool {
        if (text == "c" || text == "C") {
            root.toggle-subtitles();
            // Shown, because nothing else shows it: the subtitles button has no
            // state, and a scene with no dialogue doesn't either. The same
            // caption as J, read live.
            root.key-wake = 1;
            Flash.show-figure(3);
            return true;
        }
        // mpv's j and J: through the subtitle tracks, including none, saying
        // which one it landed on.
        if (text == "j" || text == "J") {
            root.cycle-track(true, text == "j" ? 1 : -1);
            root.key-wake = 1;
            Flash.show-figure(3);
            return true;
        }
        if (text == "z") {
            root.nudge-sub-delay(-root.delay-step);
            root.key-wake = 1;
            Flash.show(Flash.delay, 0.5);
            return true;
        }
        if (text == "Z") {
            root.nudge-sub-delay(root.delay-step);
            root.key-wake = 1;
            Flash.show(Flash.delay, 0.5);
            return true;
        }
        return false;
    }

    /// Whether a key may still act on the player: not on the fatal pane,
    /// where nothing can play, and a file loaded by Ctrl+O would replace the
    /// error with a bar over a black window. Fullscreen and Escape stay, as
    /// the ways out of a window.
    property <bool> keys-act: root.fatal == "";

    // Ctrl+O for a file, Ctrl+Shift+O for a folder.
    function on-open(text: string, ctrl: bool, shift: bool) -> bool {
        // Ctrl+letter arrives as the letter on some platforms and as the
        // control character (U+000F for Ctrl+O) on others.
        if (root.keys-act && ctrl && (text == "o" || text == "O" || text == "\u{000F}")) {
            root.request-open(shift);
            return true;
        }
        return false;
    }

    /// Every way the interface asks for a file or a folder comes through here,
    /// so an open already in flight is refused in one place.
    function request-open(folder: bool) {
        if (root.opening) {
            return;
        }
        if (folder) {
            root.open-folder();
        } else {
            root.open-file();
        }
    }

    // --- pace -----------------------------------------------------------------
    //
    // What the bar has no control for: speed, single frames, chapters, on
    // mpv's own keys so the habit carries over. Speed and chapters answer with
    // their figure, and frames with the picture itself.
    function on-pace(text: string) -> bool {
        if (text == "[" || text == "]") {
            root.step-speed(root.speed, text == "]" ? 1 : -1);
            root.key-wake = 1;
            Flash.show-figure(1);
            return true;
        }
        if (text == Key.Backspace) {
            root.reset-speed();
            root.key-wake = 1;
            Flash.show-figure(1);
            return true;
        }
        if (text == "," || text == ".") {
            root.frame-step(text == "." ? 1 : -1);
            root.stepped = true;
            root.step-landing = true;
            root.key-wake = 1;
            return true;
        }
        // Only with no panel open, for the reason Home gives above.
        if ((text == Key.PageUp || text == Key.PageDown) && !root.panel-open) {
            root.key-wake = 1;
            // No flash for a file with no chapters to go to.
            if (root.chapter-marks.length > 0) {
                root.chapter-step(text == Key.PageDown ? 1 : -1);
                Flash.show-figure(2);
            }
            return true;
        }
        return false;
    }

    // --- the failure pane's two rows --------------------------------------------

    /// Whether the details were just copied, so the row can say so.
    property <bool> copied: false;

    /// Put the headline and the driver's words on the clipboard, for a bug
    /// report, since this pane is the only place they appear.
    public function copy-details() {
        fatal-copy.select-all();
        fatal-copy.copy();
        fatal-copy.clear-selection();
        root.copied = true;
        copied-timer.stop();
        copied-timer.start();
    }

    copied-timer := Timer {
        interval: 2000ms;
        running: false;
        triggered => {
            root.copied = false;
            copied-timer.stop();
        }
    }

    /// The text to copy. A hidden one-pixel `TextInput`, because only a text
    /// input can put text on the clipboard.
    fatal-copy := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        read-only: true;
        text: root.fatal + "\n\n" + root.fatal-detail;
    }

    /// The end pill's choices, from the keyboard. With two, the first is the
    /// way on and the second is Restart.
    function end-activate(choice: int) {
        if (root.arriving) {
            root.arrival-answer(choice == 1);
        } else if (!root.end-two) {
            root.play-next();
        } else if (choice == 0) {
            root.end-onward();
        } else {
            root.replay();
        }
    }

    /// On to the next episode: the next file, or the next season when this
    /// was the last of one. Or, from the title sequence, on to the episode,
    /// and from credits a scene follows, on to the scene.
    function credits-activate() {
        if (root.corner-offer == 2) {
            root.take-resume-offer();
        } else if (root.corner-offer == 1) {
            root.skip-to(root.intro-end);
        } else if (root.corner-offer == 3) {
            root.skip-to(root.after-credits);
        } else if (!root.at-last) {
            root.play-next();
        } else {
            root.end-onward();
        }
    }

    function end-onward() {
        if (root.onward-path != "") {
            if (!root.opening) {
                root.open-path(root.onward-path, true);
            }
        } else {
            root.request-open(true);
        }
    }

    // --- the bar, from the keyboard -------------------------------------------
    //
    // Tab walks the bar's buttons while nothing is open and a film is loaded,
    // and Enter presses the one the ring is on. No other key changes meaning:
    // the arrows still seek and set the volume, and Space still pauses.
    //
    // Its own index rather than `focus-row`, which a panel resets as it
    // opens, so the ring comes back to the button that opened the panel.
    out property <int> bar-focus: 0;
    /// The ring was on the bar when the idle clock took the bar away, so the
    /// next Tab resumes at `bar-focus` rather than starting over.
    property <bool> bar-resume: false;
    /// The first stop after the bar's thirteen buttons: the centre pill's
    /// first choice, or the credits pill.
    property <int> pill-stop: 13;
    /// The bar's buttons, then the centre pill's choices while it is up, or
    /// the credits pill. The two are never up together.
    property <int> bar-count: root.pill-stop
        + (root.centre-up ? (root.end-two ? 2 : 1)
            : root.corner-offered ? 1 : 0);
    property <bool> bar-reach: root.has-file && !root.panel-open && root.fatal == "";

    function on-bar(text: string, shift: bool) -> bool {
        if (!root.bar-reach) {
            return false;
        }
        if (text == Key.Tab || text == Key.Backtab) {
            if (!Chrome.focus-visible) {
                if (!(root.bar-resume && root.bar-focus < root.bar-count
                        && root.bar-enabled(root.bar-focus))) {
                    root.bar-focus = shift || text == Key.Backtab ? root.bar-count - 1 : 0;
                }
                root.bar-resume = false;
                Chrome.focus-visible = true;
                return true;
            }
            root.bar-step(shift || text == Key.Backtab ? -1 : 1);
            return true;
        }
        if (!Chrome.focus-visible) {
            return false;
        }
        if (text == Key.Return) {
            // Every choice on a pill is the way back to the film.
            if (root.bar-focus >= root.pill-stop) {
                root.key-wake = 2;
            }
            root.bar-activate(root.bar-focus);
            return true;
        }
        if (text == Key.Escape) {
            // Only puts the ring away, so an Escape meant to clear it doesn't
            // also leave fullscreen. The next press does that. Done with the
            // bar, so the bar goes with it.
            Chrome.focus-visible = false;
            root.key-wake = 2;
            return true;
        }
        return false;
    }

    /// Along the bar, skipping a disabled button, where Enter would do
    /// nothing.
    ///
    /// Slint functions have no loops, so the skip is written out. One skip is
    /// enough because the two buttons that can be disabled aren't adjacent; a
    /// disabled button next to one of them would need another.
    function bar-step(delta: int) {
        root.bar-focus = root.bar-wrap(root.bar-focus + delta);
        if (!root.bar-enabled(root.bar-focus)) {
            root.bar-focus = root.bar-wrap(root.bar-focus + delta);
        }
        if (!root.bar-enabled(root.bar-focus)) {
            root.bar-focus = root.bar-wrap(root.bar-focus + delta);
        }
    }

    pure function bar-wrap(index: int) -> int {
        return index < 0 ? root.bar-count - 1 : index >= root.bar-count ? 0 : index;
    }

    /// Previous and Next, at 3 and 5, are the only buttons that can be
    /// disabled.
    pure function bar-enabled(index: int) -> bool {
        return !(index == 3 && root.at-first) && !(index == 5 && root.at-last);
    }

    // The ring on a bar button stands on a disc of glass of its own, laid on
    // the bar, so the material's rim lights the keyboard's place rather than
    // an outline; a wash alone is faint against the glass beside it. The
    // pill's choices keep the wash, being capsules within a pane already.
    property <bool> ring-disc: Chrome.focus-visible && root.bar-reach
        && root.bar-focus < root.pill-stop;
    property <float> ring-disc-on: root.ring-disc ? 1 : 0;
    animate ring-disc-on { duration: Motion.highlight; easing: ease-out; }
    /// Where the disc goes: the button the ring is on, where the layout put
    /// it.
    property <length> ring-disc-x: root.bar-button-x(root.bar-focus);

    // The button whose panel is open stands on a disc of glass too, a step
    // short of the ring's, which says which button the panel belongs to over
    // any frame; a held wash went unseen over a bright one.
    /// That button's place on the bar, or -1 with no panel open.
    property <int> open-button: root.playlist-open ? 0 : root.files-open ? 1
        : root.audio-open ? 8 : root.menu-open ? 9 : root.settings-open ? 10 : -1;
    /// Where the disc last stood, kept as it fades so it doesn't go to the
    /// bar's start on the way out.
    property <int> open-disc-at: 0;
    changed open-button => {
        if (root.open-button >= 0) {
            root.open-disc-at = root.open-button;
        }
    }
    property <bool> open-disc: root.open-button >= 0;
    property <float> open-disc-on: root.open-disc ? 1 : 0;
    animate open-disc-on { duration: Motion.highlight; easing: ease-out; }
    property <length> open-disc-x: root.bar-button-x(root.open-disc-at);

    pure function bar-button-x(index: int) -> length {
        if (index < 7) {
            return index == 0 ? playlist-button.absolute-position.x
                : index == 1 ? files-button.absolute-position.x
                : index == 2 ? back-button.absolute-position.x
                : index == 3 ? previous-button.absolute-position.x
                : index == 4 ? play-button.absolute-position.x
                : index == 5 ? next-button.absolute-position.x
                : forward-button.absolute-position.x;
        }
        return index == 7 ? mute-button.absolute-position.x
            : index == 8 ? audio-button.absolute-position.x
            : index == 9 ? subs-button.absolute-position.x
            : index == 10 ? settings-button.absolute-position.x
            : index == 11 ? panscan-button.absolute-position.x
            : fullscreen-button.absolute-position.x;
    }

    /// Left to right: playlist, open; back, previous, play, next, forward;
    /// mute, audio, subtitles, settings, panscan, fullscreen. The volume track
    /// isn't a stop, since Up and Down already set it. Split in two for the
    /// compiler, as the key handlers are.
    function bar-activate(index: int) {
        if (index >= root.pill-stop) {
            if (root.centre-up) {
                root.end-activate(index - root.pill-stop);
            } else {
                root.credits-activate();
            }
        } else if (index < 7) {
            root.bar-activate-left(index);
        } else {
            root.bar-activate-right(index);
        }
    }

    function bar-activate-left(index: int) {
        if (index == 0) {
            root.open-playlist(true);
            root.focus-show(root.focus-row);
        } else if (index == 1) {
            root.open-files(true);
            root.focus-show(0);
        } else if (index == 2) {
            root.seek-relative(-root.seek-step);
        } else if (index == 3) {
            if (!root.at-first) {
                root.playlist-step(-1);
            }
        } else if (index == 4) {
            if (root.at-end) {
                root.replay();
            } else {
                root.toggle-pause();
            }
        } else if (index == 5) {
            if (!root.at-last) {
                root.playlist-step(1);
            }
        } else {
            root.seek-relative(root.seek-step);
        }
    }

    function bar-activate-right(index: int) {
        if (index == 7) {
            root.toggle-mute();
        } else if (index == 8) {
            root.open-audio(true);
            root.focus-show(root.focus-row);
        } else if (index == 9) {
            root.open-menu(true);
            root.focus-show(root.focus-row);
        } else if (index == 10) {
            root.open-settings(true);
            root.focus-show(0);
        } else if (index == 11) {
            root.toggle-panscan();
        } else {
            root.toggle-fullscreen();
        }
    }

    function on-window(text: string) -> bool {
        // In or out, what was asked for is the picture at a new size, not
        // the bar over it, so the chrome goes.
        if (text == "f" || text == "F" || text == Key.F11) {
            root.toggle-fullscreen();
            root.key-wake = 2;
            Chrome.settling = true;
            return true;
        }
        // The picture answers, as it does a frame step.
        if (root.has-file && (text == "t" || text == "T")) {
            root.toggle-panscan();
            root.key-wake = 1;
            return true;
        }
        // Straight to the shortcuts page, the player's one reference. Pressed
        // again there, it closes the panel, as S does.
        if (root.keys-act && text == "?") {
            if (root.settings-open && root.settings-page == 4) {
                root.open-settings(false);
                root.key-wake = 2;
            } else {
                root.open-settings-page(4);
                root.focus-show(0);
            }
            return true;
        }
        // The ring comes up only when this opens the panel, not when it
        // closes it.
        if (root.keys-act && (text == "s" || text == "S")) {
            root.open-settings(!root.settings-open);
            if (root.settings-open) {
                root.focus-show(0);
            } else {
                root.key-wake = 2;
            }
            return true;
        }
        // A for the audio, V for the subtitles beside C, which turns them on
        // and off, and P for the playlist. None with no film, since they
        // describe one and would hang from a bar that isn't there.
        if (root.keys-act && root.has-file && (text == "a" || text == "A")) {
            root.open-audio(!root.audio-open);
            if (root.audio-open) {
                root.focus-show(root.focus-row);
            } else {
                root.key-wake = 2;
            }
            return true;
        }
        if (root.keys-act && root.has-file && (text == "v" || text == "V")) {
            root.open-menu(!root.menu-open);
            if (root.menu-open) {
                root.focus-show(root.focus-row);
            } else {
                root.key-wake = 2;
            }
            return true;
        }
        if (root.keys-act && root.has-file && (text == "p" || text == "P")) {
            root.open-playlist(!root.playlist-open);
            if (root.playlist-open) {
                root.focus-show(root.focus-row);
            } else {
                root.key-wake = 2;
            }
            return true;
        }
        if (root.keys-act && (text == "b" || text == "B")) {
            // Kept on a key as well as on its settings page, as the one effect
            // worth toggling mid-film. The picture's border answers it.
            root.ambience-on = !root.ambience-on;
            root.set-ambience(root.ambience-on);
            root.key-wake = 1;
            return true;
        }
        if (text == Key.Delete && (root.menu-open || root.audio-open)
                && Chrome.focus-visible) {
            return root.remove-focused-track();
        }
        // One Escape dismisses one thing, innermost first: a page within a
        // panel (see `page-back`), then the panel, then fullscreen. Closing a
        // panel is back to the film, and the chrome goes with it.
        if (text == Key.Escape) {
            if (root.page-back()) {
                return true;
            }
            root.key-wake = 2;
            if (root.settings-open) {
                root.settings-open = false;
            } else if (root.playlist-open) {
                root.playlist-open = false;
            } else if (root.files-open) {
                root.files-open = false;
            } else if (root.menu-open) {
                root.menu-open = false;
            } else if (root.audio-open) {
                root.audio-open = false;
            } else {
                // Out of fullscreen as into it, and with nothing to leave,
                // nothing to bring up.
                if (root.fullscreen) {
                    Chrome.settling = true;
                } else {
                    root.key-wake = 1;
                }
                root.leave-fullscreen();
            }
            return true;
        }
        return false;
    }

    // The panels share the space above the bar, so opening one closes the
    // others. Every button and key goes through these functions so they
    // can't drift apart. Each opens on its front page, and the lists on their
    // current row, centred.
    public function open-menu(open: bool) {
        root.menu-open = open;
        if (open) {
            root.close-others();
            root.menu-open = true;
            root.find-open = false;
            root.account-open = false;
            root.subs-page = 0;
            root.focus-row = root.subs-open-row;
            subs-list.centre(root.focus-row * root.row-h, root.row-h);
        }
    }

    public function open-audio(open: bool) {
        root.audio-open = open;
        if (open) {
            root.close-others();
            root.audio-open = true;
            root.focus-row = max(0, root.audio-current);
            audio-list.centre(root.focus-row * root.row-h, root.row-h);
        }
    }

    public function open-playlist(open: bool) {
        root.playlist-open = open;
        if (open) {
            root.close-others();
            root.playlist-open = true;
            // On the part holding the file playing, at its row, or on the
            // list of parts when that file is a part of its own.
            if (root.playlist-tiered && root.playlist-current-group >= 0
                    && !root.playlist-groups[root.playlist-current-group].leaf) {
                root.playlist-enter(root.playlist-current-group);
            } else {
                root.playlist-page = root.playlist-tiered ? -1 : 0;
                root.focus-row = max(0, root.playlist-tiered
                    ? root.playlist-current-group
                    : root.playlist-groups[0].open-row);
                // With a single part, its list is the drilled-in page.
                if (root.playlist-tiered) {
                    playlist-top-list.centre(root.focus-row * root.row-h, root.row-h);
                } else {
                    playlist-leaf-list.centre(root.focus-row * root.row-h, root.row-h);
                }
            }
        }
    }

    /// Open one part's page on the row to carry on from: the file playing,
    /// or else the first not yet finished.
    function playlist-enter(group: int) {
        root.playlist-page = group;
        root.focus-row = 1 + root.playlist-groups[group].open-row;
        playlist-leaf-list.centre(
            root.playlist-groups[group].open-row * root.row-h, root.row-h);
    }

    /// Back to the list of parts, on the part just left.
    public function playlist-back() {
        root.focus-row = max(0, root.playlist-page);
        root.playlist-page = -1;
        playlist-top-list.centre(root.focus-row * root.row-h, root.row-h);
    }

    /// A row of the list showing, pressed.
    function playlist-pick(row: int) {
        if (!root.playlist-top) {
            root.playlist-play(root.playlist-entries[row]);
        } else if (root.playlist-groups[row].leaf) {
            root.playlist-play(root.playlist-groups[row].entries[0]);
        } else {
            root.playlist-enter(row);
        }
    }

    /// Play a file of the list, or, for one in a season beside the list
    /// rather than in it, open that season at that file.
    function playlist-play(entry: PlaylistItem) {
        if (entry.index >= 0) {
            root.play-index(entry.index);
        } else if (!root.opening) {
            root.open-path(entry.path, true);
        }
    }

    public function open-settings(open: bool) {
        root.settings-open = open;
        if (open) {
            root.close-others();
            root.settings-open = true;
            root.settings-page = 0;
        }
    }

    /// Show one settings page, opening the panel if it is shut. Public so a
    /// test can walk the pages and check each page's height.
    public function open-settings-page(page: int) {
        root.open-settings(true);
        root.settings-page = page;
        root.focus-row = 0;
    }

    public function open-files(open: bool) {
        root.files-open = open;
        if (open) {
            root.close-others();
            root.files-open = true;
        }
    }

    /// Close every panel, so an opener only reopens its own, and a new panel
    /// can't be forgotten in someone else's list.
    function close-others() {
        root.menu-open = false;
        root.audio-open = false;
        root.playlist-open = false;
        root.settings-open = false;
        root.files-open = false;
        // The ring goes back to the top, which is also where the way in wants
        // it once everything closes over an empty window.
        root.focus-row = 0;
    }

    keys := FocusScope {
        // The chrome is woken after the key is handled, since the handler
        // says how far (`key-wake`).
        key-pressed(event) => {
            Chrome.input-seq += 1;
            root.key-wake = 0;
            // The film's own keys only with a film, or they would flash over
            // the way in and change a volume nothing shows.
            if (root.on-bar(event.text, event.modifiers.shift)
                || root.on-focus(event.text, event.modifiers.shift, event.modifiers.control)
                || root.on-open(event.text, event.modifiers.control, event.modifiers.shift)
                || (root.has-file
                    && (root.on-playback(event.text)
                        || root.on-seek(event.text, event.modifiers.control, event.modifiers.shift)
                        || root.on-pace(event.text)
                        || root.on-volume(event.text)
                        || root.on-subtitles(event.text)))
                || root.on-window(event.text)) {
                root.after-key(event.text);
                return EventResult.accept;
            }
            root.after-key(event.text);
            return EventResult.reject;
        }
    }

    // --- the pointer over the picture ---

    /// How far a hidden pointer must travel within `twitch-timer` to count.
    /// A knocked desk or a mouse set down moves it a few pixels, and in a
    /// dark room that is nobody asking for anything.
    property <length> twitch: 12px;
    /// Where that is measured from: the first move after it was hidden.
    property <length> twitch-x: 0px;
    property <length> twitch-y: 0px;
    property <bool> twitch-armed: false;
    twitch-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            twitch-timer.stop();
            root.twitch-armed = false;
        }
    }

    /// The pointer over the picture. A press always counts.
    function film-pointed(down: bool, x: length, y: length) {
        if (!down && root.pointer-hidden) {
            if (!root.twitch-armed) {
                root.twitch-x = x;
                root.twitch-y = y;
                root.twitch-armed = true;
                twitch-timer.start();
                return;
            }
            if (Math.sqrt(Math.pow((x - root.twitch-x) / 1px, 2)
                    + Math.pow((y - root.twitch-y) / 1px, 2)) < root.twitch / 1px) {
                return;
            }
        }
        root.twitch-armed = false;
        twitch-timer.stop();
        Chrome.pointed(down);
    }

    // Video, ambient border and glass, already composited by the pipeline.
    Image {
        source: root.video-frame;
        source-clip-x: 0;
        source-clip-y: 0;
        source-clip-width: root.video-clip-w;
        source-clip-height: root.video-clip-h;
        width: 100%;
        height: 100%;
        image-fit: fill;
    }

    // Dragging the picture moves the window, which has no title bar to take
    // hold of. A press that doesn't travel is still a click on the film.
    WindowMoveArea {
        enabled: !root.fullscreen;

        // Under the chrome, so buttons take clicks first. It doesn't hide the
        // cursor, because a `mouse-cursor` binding is only read while a mouse
        // event is routed, never when the pointer should go (see
        // `pointer-hidden`).
        video-surface := TouchArea {
            /// `Chrome.input-seq` as of this area's last pointer event.
            property <int> seen: -1;

            width: 100%;
            height: 100%;
            pointer-event(event) => {
                root.film-pointed(event.kind == PointerEventKind.down,
                    self.mouse-x, self.mouse-y);
                self.seen = Chrome.input-seq;
            }
            // A pointer leaving the picture for somewhere in the window lands
            // on chrome, which counts its arrival as input in the same event.
            // With nothing counted, it left the window, and the chrome goes
            // with it rather than waiting out the clock.
            changed has-hover => {
                if (!self.has-hover && Chrome.input-seq == self.seen) {
                    Chrome.rest();
                }
            }
            clicked => {
                // A click away from an open panel closes it, as a desktop menu
                // does, rather than pausing the film under it.
                if (root.panel-open) {
                    root.close-others();
                } else {
                    root.video-clicked();
                }
            }
            // In or out of fullscreen, so the chrome goes, as for F.
            double-clicked => {
                root.video-double-clicked();
                root.put-away();
                Chrome.settling = true;
            }
            // The wheel over the picture only wakes the bar: a brushed wheel or
            // a touchpad shouldn't change the volume, which has its own track.
            // Accepted so this area keeps its hover.
            scroll-event(event) => {
                Chrome.bump();
                return EventResult.accept;
            }
        }
    }

    // --- drilling into a settings page ---
    //
    // The two pages slide, the old one out the side the new one comes in
    // from, and the panel eases to the new height, so the change can be
    // followed rather than happening in one frame. Back reverses it.

    /// The corner the panels that drill clip their pages to, so a page
    /// sliding past a corner is cut where the glass is. A circle, which
    /// stands at most two thirds of a pixel proud of the glass's own corner,
    /// inside the glass's soft edge.
    property <length> drill-corner: root.panel-radius;

    /// 0 on the front page, 1 on a page behind it. One number is enough
    /// because the tree is two deep.
    property <float> drill: root.settings-page == 0 ? 0.0 : 1.0;
    /// Which page the drilled-in pane draws. Held rather than read from
    /// `settings-page`, which is 0 during the way back, while the pane
    /// sliding out still has to draw its page.
    property <int> leaf-page: 1;

    // Eased at both ends, since it is something moved rather than a surface
    // fading in.
    animate drill {
        duration: Motion.drill;
        easing: ease-in-out;
    }

    // Settings: a front page listing what can be adjusted, each with a page
    // of its own, so everything tunable is in one place. The slider rows come
    // from the registry in `settings`, so adding a knob needs no edit here.
    settings := Rectangle {
        /// The page, unconstrained: the front list, or a page's way back and
        /// what is under it. From row counts (see `page-natural`).
        property <length> body: root.settings-page == 0 ? root.front-natural
            : root.row-h + root.page-natural(root.settings-page);

        width: 340px;
        height: min(root.panel-pad + self.body, root.panel-max-h);
        x: root.anchored-x(root.settings-anchor, self.width);
        // From its own height, so the panel keeps its bottom edge and grows
        // upward, and the glass, read from this rectangle, follows.
        y: root.bar-top - self.height - Rows.offset + root.settings-rise;

        // With `drill`, by the same numbers, so the box and its pages move as
        // one. Not while the window is resized (see `resizing`).
        animate height {
            duration: root.resizing ? 0ms : Motion.drill;
            easing: ease-in-out;
        }
        visible: root.settings-shown > root.shown-epsilon;
        opacity: root.settings-shown;
        clip: true;
        border-radius: root.drill-corner;

        // Catches what the rows don't, so a click on the padding doesn't
        // reach the play/pause handler underneath.
        TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        // The page it is on and the page it is going to, side by side, both
        // placed by `drill`. At rest `drill` is exactly 0 or 1, so only the
        // page showing is built.
        if root.drill < 1.0: Rectangle {
            x: -root.drill * parent.width;
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                padding-top: Rows.panel-pad;
                padding-bottom: Rows.panel-pad;
                // Top-aligned, or the rows would spread apart while the
                // height animates.
                alignment: start;

                if root.settings-page == 0: ScrollList {
                    height: root.front-list-h;
                    rest-height: root.front-rest-h;
                    content-height: root.front-natural;
                    init => {
                        root.front-fade = self.fade;
                    }
                    changed fade => {
                        root.front-fade = self.fade;
                    }
                    reveal-top: root.settings-reveal-top;
                    reveal-h: root.settings-reveal-h;
                    reveal-tick: root.settings-reveal-tick;

                    MenuHeading {
                        text: @tr("EFFECTS");
                    }
                    // No switch, because turning the glass off would erase
                    // this panel's own glass and leave its rows floating over
                    // the video. The settings file still has the flag, for
                    // work on the shader.
                    DrillRow {
                        icon: @image-url("../../../public/icons/glass.svg");
                        label: @tr("Liquid glass");
                        focused: root.settings-open && root.focus-row == 0;
                        opened => {
                            root.settings-page = 1;
                        }
                    }
                    // The switch's glyph pair, so the icon says whether the
                    // effect is on before the page is opened.
                    DrillRow {
                        icon: root.ambience-on
                            ? @image-url("../../../public/icons/ambience-on.svg")
                            : @image-url("../../../public/icons/ambience-slash.svg");
                        label: @tr("Ambient border");
                        focused: root.settings-open && root.focus-row == 1;
                        opened => {
                            root.settings-page = 2;
                        }
                    }

                    // The player itself, where the group above is about the
                    // picture: how the interface behaves and how to drive it.
                    // The subtitles' own tuning is in their menu, beside the
                    // line it changes.
                    MenuHeading {
                        text: @tr("INTERFACE");
                        after-content: true;
                    }
                    DrillRow {
                        icon: @image-url("../../../public/icons/accessibility.svg");
                        label: @tr("Accessibility");
                        focused: root.settings-open && root.focus-row == 2;
                        opened => {
                            root.settings-page = 3;
                        }
                    }
                    DrillRow {
                        icon: @image-url("../../../public/icons/shortcuts.svg");
                        label: @tr("Shortcuts");
                        focused: root.settings-open && root.focus-row == 3;
                        opened => {
                            root.settings-page = 4;
                        }
                    }
                    DrillRow {
                        icon: @image-url("../../../public/icons/language.svg");
                        label: @tr("Language");
                        focused: root.settings-open && root.focus-row == 4;
                        opened => {
                            root.settings-page = 5;
                        }
                    }
                }
            }
        }

        if root.drill > 0.0: Rectangle {
            x: (1.0 - root.drill) * parent.width;
            width: parent.width;
            height: parent.height;

            VerticalLayout {
                padding-top: Rows.panel-pad;
                padding-bottom: Rows.panel-pad;
                alignment: start;

                if root.leaf-page == 1: VerticalLayout {
                    BackRow {
                        label: @tr("LIQUID GLASS");
                        focused: root.focus-row == 0;
                        back => {
                            root.settings-page = 0;
                        }
                    }
                    ScrollList {
                        height: root.leaf-list-h;
                        rest-height: root.leaf-rest-h;
                        content-height: root.page-natural(1);
                        init => {
                            root.leaf-fade = self.fade;
                        }
                        changed fade => {
                            root.leaf-fade = self.fade;
                        }
                        reveal-top: root.settings-reveal-top;
                        reveal-h: root.settings-reveal-h;
                        reveal-tick: root.settings-reveal-tick;

                        for item[idx] in root.glass-params: ParamSlider {
                            label: item.label;
                            name-w: root.param-name-w;
                            icon: root.param-icon(item.index);
                            fraction: item.fraction;
                            readout: item.readout;
                            focused: root.focus-row == idx + 1;
                            moved(f) => {
                                root.set-param(item.index, f);
                            }
                        }
                        Rectangle {
                            height: Rows.group-gap;
                        }
                        MenuRow {
                            icon: root.reset-icon(1);
                            label: root.reset-label(1);
                            focused: root.focus-row == root.leaf-focus-count - 1;
                            picked => {
                                root.reset-row(1);
                            }
                        }
                    }
                }

                if root.leaf-page == 2: VerticalLayout {
                    BackRow {
                        label: @tr("AMBIENT BORDER");
                        focused: root.focus-row == 0;
                        back => {
                            root.settings-page = 0;
                        }
                    }
                    ScrollList {
                        height: root.leaf-list-h;
                        rest-height: root.leaf-rest-h;
                        content-height: root.page-natural(2);
                        init => {
                            root.leaf-fade = self.fade;
                        }
                        changed fade => {
                            root.leaf-fade = self.fade;
                        }
                        reveal-top: root.settings-reveal-top;
                        reveal-h: root.settings-reveal-h;
                        reveal-tick: root.settings-reveal-tick;

                        // Whether, then how: the switch heads its own tuning.
                        ToggleRow {
                            label: @tr("Ambient border");
                            checked: root.ambience-on;
                            focused: root.focus-row == 1;
                            toggled(on) => {
                                root.ambience-on = on;
                                root.set-ambience(on);
                            }
                        }
                        Rectangle {
                            height: Rows.group-gap;
                        }
                        for item[idx] in root.border-params: ParamSlider {
                            label: item.label;
                            name-w: root.param-name-w;
                            icon: root.param-icon(item.index);
                            fraction: item.fraction;
                            readout: item.readout;
                            focused: root.focus-row == idx + 2;
                            moved(f) => {
                                root.set-param(item.index, f);
                            }
                        }
                        Rectangle {
                            height: Rows.group-gap;
                        }
                        MenuRow {
                            icon: root.reset-icon(2);
                            label: root.reset-label(2);
                            focused: root.focus-row == root.leaf-focus-count - 1;
                            picked => {
                                root.reset-row(2);
                            }
                        }
                    }
                }

                // How much the interface does on its own: moving, keeping its
                // words readable, and explaining itself.
                if root.leaf-page == 3: VerticalLayout {
                    BackRow {
                        label: @tr("ACCESSIBILITY");
                        focused: root.focus-row == 0;
                        back => {
                            root.settings-page = 0;
                        }
                    }
                    ScrollList {
                        height: root.leaf-list-h;
                        rest-height: root.leaf-rest-h;
                        content-height: root.page-natural(3);
                        init => {
                            root.leaf-fade = self.fade;
                        }
                        changed fade => {
                            root.leaf-fade = self.fade;
                        }
                        reveal-top: root.settings-reveal-top;
                        reveal-h: root.settings-reveal-h;
                        reveal-tick: root.settings-reveal-tick;

                        // Everything that moves (see `Motion`). Off, each change
                        // lands in the frame it was asked for.
                        ToggleRow {
                            label: @tr("Animations");
                            checked: Motion.enabled;
                            focused: root.focus-row == 1;
                            toggled(on) => {
                                root.set-motion(on);
                            }
                        }
                        // The glass held dark enough for its words over a
                        // bright frame (see The Legible Glass Rule). Off, it is
                        // only what the glass page makes it, and its words can
                        // vanish over a white scene.
                        ToggleRow {
                            label: @tr("Darken bright glass");
                            checked: root.legible-glass;
                            focused: root.focus-row == 2;
                            toggled(on) => {
                                root.set-legible(on);
                            }
                        }
                        // The names the bar's controls show under the pointer,
                        // which someone who knows the bar may not want rising
                        // over the film.
                        ToggleRow {
                            label: @tr("Tooltips");
                            checked: Tip.enabled;
                            focused: root.focus-row == 3;
                            toggled(on) => {
                                root.set-tips-shown(on);
                            }
                        }
                        // For someone who wants the names but knows the keys.
                        // Faded while tips are off.
                        ToggleRow {
                            label: @tr("Shortcuts in tooltips");
                            checked: Tip.with-keys;
                            enabled: Tip.enabled;
                            focused: root.focus-row == 4;
                            toggled(on) => {
                                root.set-tip-keys-shown(on);
                            }
                        }
                    }
                }

                // The system's language first, which the player speaks until
                // told otherwise, then English, which it is written in, then
                // the bundled ones, each under its own untranslated name.
                if root.leaf-page == 5: VerticalLayout {
                    BackRow {
                        label: @tr("LANGUAGE");
                        focused: root.focus-row == 0;
                        back => {
                            root.settings-page = 0;
                        }
                    }
                    ScrollList {
                        height: root.leaf-list-h;
                        rest-height: root.leaf-rest-h;
                        content-height: root.page-natural(5);
                        init => {
                            root.leaf-fade = self.fade;
                        }
                        changed fade => {
                            root.leaf-fade = self.fade;
                        }
                        reveal-top: root.settings-reveal-top;
                        reveal-h: root.settings-reveal-h;
                        reveal-tick: root.settings-reveal-tick;
                        // The language spoken now, for the angle that points
                        // back to it.
                        current-top: root.language-choice * root.row-h;
                        current-h: root.language-choice >= 0 ? root.row-h : 0px;

                        MenuRow {
                            label: @tr("System language");
                            active: root.language-choice == 0;
                            focused: root.focus-row == 1;
                            picked => {
                                root.pick-language(0);
                            }
                        }
                        MenuRow {
                            label: "English";
                            active: root.language-choice == 1;
                            focused: root.focus-row == 2;
                            picked => {
                                root.pick-language(1);
                            }
                        }
                        for name[idx] in root.language-names: MenuRow {
                            label: name;
                            active: root.language-choice == idx + 2;
                            focused: root.focus-row == idx + 3;
                            picked => {
                                root.pick-language(idx + 2);
                            }
                        }
                    }
                }

                if root.leaf-page == 4: VerticalLayout {
                    BackRow {
                        label: @tr("SHORTCUTS");
                        focused: root.focus-row == 0;
                        back => {
                            root.settings-page = 0;
                        }
                    }
                    ScrollList {
                        height: root.leaf-list-h;
                        rest-height: root.leaf-rest-h;
                        content-height: root.page-natural(4);
                        init => {
                            root.leaf-fade = self.fade;
                        }
                        changed fade => {
                            root.leaf-fade = self.fade;
                        }
                        // The one list here the keyboard scrolls rather than
                        // walks; see `on-read`.
                        asked-by: root.read-by;
                        asked-tick: root.read-tick;

                        // A heading rides with its group's first row rather than
                        // being an entry of its own, so there is one list rather
                        // than two to keep in step.
                        for item[idx] in root.shortcuts: VerticalLayout {
                            if item.heading != "": MenuHeading {
                                text: item.heading;
                                icon: item.icon;
                                after-content: idx > 0;
                            }
                            // The drop row hides where dropping doesn't work.
                            // It has no heading, so no section is left empty.
                            if !item.dropping || root.drop-supported: ShortcutRow {
                                label: item.label;
                                shortcut: item.keys;
                                inert: true;
                            }
                        }
                    }
                }
            }
        }
    }

    // Tracks: subtitles and audio together, since picking either is usually
    // the same errand, getting a foreign film to say the right things. Sized
    // from row counts, so its glass rect matches what is drawn.
    menu := Rectangle {
        width: 380px;
        height: root.menu-h;
        clip: true;
        border-radius: root.drill-corner;
        // With `menu-drill`, as a settings page's height is with its slide.
        animate height {
            duration: root.resizing ? 0ms : Motion.drill;
            easing: ease-in-out;
        }
        x: root.anchored-x(root.subs-anchor, self.width);
        y: root.bar-top - self.height - Rows.offset + root.menu-rise;
        visible: root.menu-shown > root.shown-epsilon;
        opacity: root.menu-shown;

        // Catches what the rows don't, so a click on the padding doesn't
        // reach the play/pause handler underneath.
        TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        // The tracks, the menu's own page.
        Rectangle {
            x: -root.menu-drill * parent.width;
            width: parent.width;
            height: root.subs-h;
            y: root.menu-moving ? parent.height - self.height : 0;
            visible: root.menu-drill < 1.0;

            VerticalLayout {
                padding-top: Rows.panel-pad;
                padding-bottom: Rows.panel-pad;

                MenuHeading {
                    text: @tr("SUBTITLES");
                    icon: @image-url("../../../public/icons/subtitles.svg");
                }
                subs-list := ScrollList {
                    height: root.subs-list-h;
                    content-height: root.subs-natural;
                    // Off while none is showing, as the rows below light it.
                    current-top: (root.subs-visible ? root.sub-current + 1 : 0) * root.row-h;
                    current-h: root.has-subs && (!root.subs-visible || root.sub-current >= 0)
                        ? root.row-h : 0px;

                    if root.subs-empty: EmptyRow {
                        label: @tr("No subtitles");
                    }
                    if root.has-subs: MenuRow {
                        label: @tr("Off");
                        active: !root.subs-visible;
                        focused: root.on-tracks && root.focus-row == 0;
                        picked => {
                            root.select-subtitle(-1);
                        }
                    }
                    for track[idx] in root.sub-tracks: MenuRow {
                        label: track.label;
                        // Not `track.selected` alone: turning subtitles off keeps
                        // `sid`, so turning them on returns to this track, and mpv
                        // goes on reporting it as selected while it is hidden.
                        active: track.selected && root.subs-visible;
                        focused: root.on-tracks && root.focus-row == idx + 1;
                        removable: track.external;
                        armed: root.remove-armed == track.id && root.remove-armed-sub;
                        armed-for: root.armed-for;
                        picked => {
                            root.select-subtitle(track.id);
                        }
                        removed => {
                            root.remove-row(track.id, true);
                        }
                    }
                }
                // Under the list rather than in it, so they stay in reach
                // however many tracks a film has and are never read as one
                // more: the ways to the pages of the one showing, and to a
                // page of other subtitles.
                if root.has-subs && (root.subs-showing || root.find-offered): Rectangle {
                    height: Rows.group-gap;
                }
                // Says how far off the timing is, as its page's stepper
                // does, so a film synced last week reads so from here.
                if root.subs-showing: DrillRow {
                    icon: @image-url("../../../public/icons/clock.svg");
                    label: @tr("Timing");
                    detail: abs(root.sub-delay) >= 0.005 ? root.sub-delay-text : "";
                    focused: root.on-tracks && root.focus-row == root.subs-pages-at;
                    opened => {
                        root.open-subs-page(1);
                    }
                }
                if root.subs-showing: DrillRow {
                    icon: @image-url("../../../public/icons/text-size.svg");
                    label: @tr("Size & position");
                    focused: root.on-tracks && root.focus-row == root.subs-pages-at + 1;
                    opened => {
                        root.open-subs-page(2);
                    }
                }
                if root.find-offered: DrillRow {
                    icon: @image-url("../../../public/icons/search.svg");
                    label: @tr("Find subtitles");
                    focused: root.on-tracks && root.focus-row == root.subs-focus-count - 1;
                    opened => {
                        root.open-find();
                    }
                }
            }
        }

        // Timing, or size and position, sliding in over the tracks as the
        // search's page does. Only built while one shows.
        if root.menu-drill > 0.0 && root.menu-leaf != 3: Rectangle {
            x: (1.0 - root.menu-drill) * parent.width;
            width: parent.width;
            height: root.menu-leaf == 1 ? root.timing-page-h : root.placing-page-h;
            y: root.menu-moving ? parent.height - self.height : 0;

            VerticalLayout {
                padding-top: Rows.panel-pad;
                padding-bottom: Rows.panel-pad;
                alignment: start;

                if root.menu-leaf == 1: VerticalLayout {
                    BackRow {
                        label: @tr("TIMING");
                        focused: root.subs-ring(1, 0);
                        back => {
                            root.close-subs-page();
                        }
                    }
                    // Above Timing, as the thing to try before setting the
                    // delay by hand; what it settles on shows in that row.
                    MenuRow {
                        icon: @image-url("../../../public/icons/subtitle-time.svg");
                        label: root.sync-label();
                        focused: root.subs-ring(1, 1);
                        picked => {
                            root.sync-row();
                        }
                    }
                    StepperRow {
                        icon: @image-url("../../../public/icons/clock.svg");
                        label: @tr("Timing");
                        focused: root.subs-ring(1, 2);
                        value: root.sub-delay-text;
                        value-w: root.timing-value-w;
                        stepped(dir) => {
                            root.step-sub-delay(dir);
                        }
                    }
                    if root.timing-resettable: Rectangle {
                        height: Rows.group-gap;
                    }
                    if root.timing-resettable: MenuRow {
                        icon: root.reset-icon(3);
                        label: root.reset-label(3);
                        focused: root.subs-ring(1, 3);
                        picked => {
                            root.reset-row(3);
                        }
                    }
                }

                // Steppers, since these are read as numbers (see `StepperRow`).
                if root.menu-leaf == 2: VerticalLayout {
                    BackRow {
                        label: @tr("SIZE & POSITION");
                        focused: root.subs-ring(2, 0);
                        back => {
                            root.close-subs-page();
                        }
                    }
                    StepperRow {
                        icon: @image-url("../../../public/icons/text-size.svg");
                        label: @tr("Size");
                        focused: root.subs-ring(2, 1);
                        value: root.sub-scale-text;
                        stepped(dir) => {
                            root.step-sub-scale(dir);
                        }
                    }
                    StepperRow {
                        icon: @image-url("../../../public/icons/arrows-up-down.svg");
                        label: @tr("Position");
                        focused: root.subs-ring(2, 2);
                        value: root.sub-pos-text;
                        stepped(dir) => {
                            root.step-sub-pos(dir);
                        }
                    }
                    Rectangle {
                        height: Rows.group-gap;
                    }
                    MenuRow {
                        icon: root.reset-icon(4);
                        label: root.reset-label(4);
                        focused: root.subs-ring(2, 3);
                        picked => {
                            root.reset-row(4);
                        }
                    }
                }
            }
        }

        // The search's page, sliding in over the tracks.
        Rectangle {
            x: (1.0 - root.menu-drill) * parent.width;
            width: parent.width;
            height: parent.height;
            visible: root.menu-drill > 0.0 && root.menu-drill < 2.0 && root.menu-leaf == 3;

            VerticalLayout {
                padding-top: Rows.panel-pad;
                padding-bottom: Rows.panel-pad;
                alignment: start;

                BackRow {
                    label: @tr("FIND SUBTITLES");
                    focused: root.menu-open && root.find-open && root.focus-row == 0;
                    back => {
                        root.close-find();
                    }
                }
                if root.find-state != 2: EmptyRow {
                    label: root.find-state == 1 ? @tr("Searching OpenSubtitles…")
                        : root.find-state == 3 ? @tr("No subtitles found")
                        : root.find-said;
                }
                find-list := ScrollList {
                    height: root.find-list-h;
                    rest-height: root.find-rest-h;
                    content-height: root.find-state == 2
                        ? root.find-hits.length * root.row-h : 0px;

                    for hit[idx] in root.find-hits: FoundRow {
                        label: hit.label;
                        detail: hit.detail;
                        busy: root.find-fetching == idx;
                        focused: root.find-listing && root.focus-row == idx + 1;
                        picked => {
                            root.fetch-row(idx);
                        }
                    }
                }

                // Under the gap, what is OpenSubtitles' rather than the
                // film's, so neither reads as one more result.
                Rectangle {
                    height: Rows.group-gap;
                }
                if root.signed-in: DrillRow {
                    icon: @image-url("../../../public/icons/account.svg");
                    label: @tr("Signed in as {}", root.find-account);
                    detail: root.find-left >= 0 ? @tr("{} left today", root.find-left) : "";
                    focused: root.find-listing && root.focus-row == root.find-account-at;
                    opened => {
                        root.open-account();
                    }
                }
                // OpenSubtitles asks a free key for this where its subtitles
                // are searched or picked, which is here.
                NoteRow {
                    height: root.credit-h;
                    text: @tr("Subtitles provided by OpenSubtitles.com");
                }
            }
        }

        // The account's page, sliding in over the search's. Only built while
        // it shows (see `AccountPage`).
        if root.menu-drill > 1.0: AccountPage {
            x: (2.0 - root.menu-drill) * parent.width;
            width: parent.width;
            height: parent.height;
            signed-in: root.signed-in;
            account: root.find-account;
            left: root.find-left;
            busy: root.signing-in;
            why: root.sign-in-why;
            said: root.sign-in-said;
            ring-row: root.focus-row;
            active: root.account-shown;
            presses: root.sign-in-presses;
            back => {
                root.close-account();
            }
            submitted(name, password) => {
                root.sign-in(name, password);
            }
            sign-out => {
                root.sign-out();
                root.close-account();
            }
            // Escape goes back a page, as everywhere; Enter is the row's own
            // press, even with the ring away, since a field was typed into;
            // the rest walk the ring, which a key from a field brings up.
            ring-key(event) => {
                if (event.text == Key.Escape) {
                    return root.page-back();
                }
                if (event.text == Key.Return) {
                    return root.focus-activate();
                }
                Chrome.focus-visible = true;
                if (event.text == Key.Backtab) {
                    return root.on-focus(Key.Tab, true, false);
                }
                return root.on-focus(event.text, event.modifiers.shift,
                    event.modifiers.control);
            }
            pointed(row) => {
                root.focus-row = row;
            }
        }
    }

    // The audio tracks, a panel of their own beside the subtitles' menu.
    audio-panel := Rectangle {
        width: 380px;
        height: root.audio-h;
        clip: true;
        x: root.anchored-x(root.audio-anchor, self.width);
        y: root.bar-top - self.height - Rows.offset + root.audio-rise;
        visible: root.audio-shown > root.shown-epsilon;
        opacity: root.audio-shown;

        TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        VerticalLayout {
            padding-top: Rows.panel-pad;
            padding-bottom: Rows.panel-pad;

            MenuHeading {
                text: @tr("AUDIO");
                icon: @image-url("../../../public/icons/speaking.svg");
            }
            audio-list := ScrollList {
                height: root.audio-list-h;
                content-height: root.audio-natural;
                current-top: root.audio-current * root.row-h;
                current-h: root.audio-current >= 0 ? root.row-h : 0px;

                if !root.has-audio: EmptyRow {
                    label: @tr("No audio tracks");
                }
                for track[idx] in root.audio-tracks: MenuRow {
                    label: track.label;
                    active: track.selected;
                    focused: root.audio-open && root.focus-row == idx;
                    removable: track.external;
                    armed: root.remove-armed == track.id && !root.remove-armed-sub;
                    armed-for: root.armed-for;
                    picked => {
                        root.select-audio(track.id);
                    }
                    removed => {
                        root.remove-row(track.id, false);
                    }
                }
            }
        }
    }

    // Opening: two rows, so it stays a menu rather than a mode. The button
    // says what it is for, and the rows say what the difference is.
    files-panel := Rectangle {
        width: 260px;
        height: root.panel-pad + 2 * root.row-h;
        clip: true;
        x: root.anchored-x(root.files-anchor, self.width);
        y: root.bar-top - self.height - Rows.offset + root.files-rise;
        visible: root.files-shown > root.shown-epsilon;
        opacity: root.files-shown;

        TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        VerticalLayout {
            padding-top: Rows.panel-pad;
            padding-bottom: Rows.panel-pad;

            ShortcutRow {
                label: @tr("Open file…");
                shortcut: @tr("Ctrl+O");
                focused: root.files-open && root.focus-row == 0;
                picked => {
                    root.files-open = false;
                    root.request-open(false);
                }
            }
            ShortcutRow {
                label: @tr("Open folder…");
                shortcut: @tr("Ctrl+Shift+O");
                focused: root.files-open && root.focus-row == 1;
                picked => {
                    root.files-open = false;
                    root.request-open(true);
                }
            }
        }
    }

    // Playlist: its own panel, since it is the one list that grows without
    // bound, and it has a setting of its own.
    playlist-panel := Rectangle {
        width: 380px;
        height: root.playlist-h;
        clip: true;
        border-radius: root.drill-corner;

        // With `playlist-drill`, as the settings panel's height is with
        // `drill`, so the box and its pages move as one. Not while the window
        // is resized (see `resizing`).
        animate height {
            duration: root.resizing ? 0ms : Motion.drill;
            easing: ease-in-out;
        }
        x: root.anchored-x(root.playlist-anchor, self.width);
        y: root.bar-top - self.height - Rows.offset + root.playlist-rise;
        visible: root.playlist-shown > root.shown-epsilon;
        opacity: root.playlist-shown;

        TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        VerticalLayout {
            padding-top: Rows.panel-pad;
            padding-bottom: Rows.panel-pad;
            // Top-aligned, or the rows would spread apart while the height
            // animates.
            alignment: start;

            // The two pages side by side, placed by `playlist-drill`. Unlike
            // the settings pages, both are always built, because they are
            // called by name to centre a row, which an element inside a
            // condition can't be. The list of parts is short anyway.
            Rectangle {
                height: root.playlist-pages-h;
                clip: true;

                Rectangle {
                    x: -root.playlist-drill * parent.width;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        alignment: start;

                        MenuHeading {
                            text: root.playlist-heading;
                            titular: root.playlist-named;
                            // The same mark as the button that opened the
                            // panel, whether the words beside it are
                            // PLAYLIST or a show's name.
                            icon: @image-url("../../../public/icons/playlist.svg");
                        }
                        // The list of parts: a season to open, or a file
                        // standing in the list as itself.
                        playlist-top-list := ScrollList {
                            height: root.playlist-top-list-h;
                            rest-height: root.playlist-top-rest-h;
                            content-height: root.playlist-top-natural;
                            current-top: root.playlist-current-group * root.row-h;
                            current-h: root.playlist-current-group >= 0 ? root.row-h : 0px;

                            VerticalLayout {
                                alignment: start;

                                for group[idx] in root.playlist-groups: Rectangle {
                                    height: root.row-h;

                                    if group.leaf: PlaylistRow {
                                        label: group.entries[0].label;
                                        length: group.entries[0].length;
                                        progress: group.entries[0].progress;
                                        finished: group.entries[0].finished;
                                        failed: group.entries[0].failed;
                                        active: group.current;
                                        // Leaves the chevron's column empty,
                                        // so this row's figures line up with
                                        // the parts' around it.
                                        trail: root.playlist-drills
                                            ? Rows.trail-x + 28px : Rows.trail-x;
                                        focused: root.playlist-open
                                            && root.playlist-top
                                            && root.focus-row == idx;
                                        picked => {
                                            root.playlist-pick(idx);
                                        }
                                    }
                                    if !group.leaf: GroupRow {
                                        label: group.label;
                                        detail: group.detail;
                                        active: group.current;
                                        focused: root.playlist-open
                                            && root.playlist-top
                                            && root.focus-row == idx;
                                        opened => {
                                            root.playlist-pick(idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    x: (1.0 - root.playlist-drill) * parent.width;
                    width: parent.width;
                    height: parent.height;

                    VerticalLayout {
                        alignment: start;

                        // A part's page is headed by the way back to the list
                        // of parts, as a settings page is. A single part has
                        // no list to go back to, so it has the heading.
                        if root.playlist-tiered: BackRow {
                            label: root.playlist-groups[root.playlist-leaf].heading;
                            titular: root.playlist-groups[root.playlist-leaf].titular;
                            focused: root.playlist-open && !root.playlist-top
                                && root.focus-row == 0;
                            back => {
                                root.playlist-back();
                            }
                        }
                        if !root.playlist-tiered: MenuHeading {
                            text: root.playlist-heading;
                            titular: root.playlist-named;
                            icon: @image-url("../../../public/icons/playlist.svg");
                        }
                        playlist-leaf-list := ScrollList {
                            height: root.playlist-leaf-list-h;
                            rest-height: root.playlist-leaf-rest-h;
                            content-height: root.playlist-leaf-natural;
                            // A part holding the file playing opens on it, so
                            // `open-row` is its row.
                            current-top: root.playlist-groups[root.playlist-shown-group].open-row
                                * root.row-h;
                            current-h: root.playlist-current-group >= 0
                                && root.playlist-current-group == root.playlist-shown-group
                                ? root.row-h : 0px;

                            VerticalLayout {
                                alignment: start;

                                for entry[idx] in root.playlist-entries: PlaylistRow {
                                    label: entry.label;
                                    length: entry.length;
                                    progress: entry.progress;
                                    finished: entry.finished;
                                    failed: entry.failed;
                                    active: entry.current;
                                    focused: root.playlist-open
                                        && !root.playlist-top
                                        && root.focus-row == idx + root.playlist-lead;
                                    picked => {
                                        root.playlist-pick(idx);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // Fixed at the bottom rather than scrolling or sliding with the
            // pages, as a setting about whichever list is showing.
            Rectangle {
                height: Rows.group-gap;
            }
            ToggleRow {
                label: @tr("Autoplay next");
                checked: root.autoplay;
                focused: root.playlist-open
                    && root.focus-row == root.playlist-lead + root.playlist-rows;
                toggled(on) => {
                    root.autoplay = on;
                    root.set-autoplay(on);
                }
            }
        }
    }

    // The bar is one pane of glass: the timeline row over a row of buttons in
    // three groups of what belongs together. These are its contents; the
    // glass is the pipeline's, from `glass-rects`.
    //
    // Each is placed from the bar geometry rather than by a layout, so reading
    // its geometry every frame costs nothing. Inside a group a HorizontalLayout
    // is fine, since nothing outside asks where its children ended up.

    // The pane itself, under the rows, so a click on it that no control takes
    // doesn't reach the film underneath.
    Rectangle {
        x: root.panel-margin;
        y: root.bar-edge + root.bar-rise;
        width: root.bar-drawn-w;
        height: root.bar-drawn-h;
        visible: root.bar-shown > root.shown-epsilon;

        bar-pane := TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }
    }

    // --- timeline ---
    //
    // One row the bar's width: a time at each end and the track between.

    Rectangle {
        x: root.bar-x;
        y: root.timeline-y + root.timeline-sink + root.bar-rise;
        width: root.time-w;
        height: root.timeline-h;
        visible: root.timeline-shown > root.shown-epsilon;
        opacity: root.timeline-shown;

        Text {
            width: 100%;
            height: 100%;
            text: root.elapsed;
            font-family: Type.numerals;
            color: Paint.strong;
            font-size: Type.readout;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // The hit area is the row's full height rather than the 5px track, which
    // would be miserable to grab.
    Rectangle {
        x: root.scrub-x;
        y: root.timeline-y + root.timeline-sink + root.bar-rise;
        width: root.scrub-w;
        height: root.timeline-h;
        visible: root.timeline-shown > root.shown-epsilon;
        opacity: root.timeline-shown;

        accessible-role: slider;
        accessible-label: @tr("Position");
        accessible-value: @tr("{} of {}", root.elapsed, root.total);
        accessible-action-increment => {
            root.seek-relative(root.seek-step);
        }
        accessible-action-decrement => {
            root.seek-relative(-root.seek-step);
        }

        timeline-rail := Rectangle {
            y: (parent.height - self.height) / 2;
            width: 100%;
            height: scrub.has-hover || scrub.pressed ? 7px : 5px;
            border-radius: self.height / 2;
            background: Paint.rail;
            animate height { duration: Motion.track-grow; easing: ease-out; }

            // Sized by width rather than clipped, so it stays crisp without a
            // layer. Never taller than it is long, like a slider's fill, so
            // the first seconds aren't a sliver in the rail's round end.
            Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: parent.width * clamp(root.progress, 0, 1);
                height: min(parent.height, self.width);
                border-radius: self.height < 2px ? 0px : self.height / 2;
                background: Paint.played;
            }

            // Chapter starts as dots: Knob where the played length covers
            // one, Quiet ahead of it. A mark at the very start is left out,
            // since it is the start rather than a boundary.
            for mark in root.chapter-marks: Rectangle {
                visible: root.duration > 0 && mark > 0.5;
                x: parent.width * clamp(mark / max(root.duration, 1), 0, 1) - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: self.height;
                height: parent.height - 2px;
                border-radius: self.height / 2;
                background: mark / max(root.duration, 1) <= root.progress
                    ? Paint.knob : Paint.quiet;
            }
        }

        scrub := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
                // Also on enter and exit, so a pointer that arrives and stops
                // gets a preview.
                root.preview-at(self.mouse-x / self.width);
                // The button coming up ends a click or a drag wherever the
                // pointer is. Not `clicked`, which a release off the track
                // never fires, and a drag often wanders off the row. A drag
                // cancelled by the window losing the pointer ends the same way.
                if (event.button == PointerEventButton.left
                    && (event.kind == PointerEventKind.up
                        || event.kind == PointerEventKind.cancel)) {
                    root.seek-fraction(self.mouse-x / self.width);
                }
            }
            moved => {
                root.preview-at(self.mouse-x / self.width);
                // `moved` fires on hover too; the press check is what makes
                // this a drag rather than a follow-the-cursor seek.
                if (self.pressed) {
                    root.seek-scrub(self.mouse-x / self.width);
                }
            }
            // A wheel raises no pointer event, and the seek doesn't count as
            // activity, since a key's seek mustn't wake the bar.
            scroll-event(event) => {
                Chrome.bump();
                root.seek-relative(event.delta-y > 0
                    ? root.scroll-seek-step
                    : -root.scroll-seek-step);
                return EventResult.accept;
            }
        }

        // No event says a drag has stopped, so while the button is down the
        // scrubber is told where the pointer is a few times a second and
        // works out whether that is news. Bound to `pressed` rather than
        // started and stopped by events, so there is no stop to forget.
        Timer {
            interval: 60ms;
            running: scrub.pressed;
            triggered => {
                root.seek-held(scrub.mouse-x / scrub.width);
            }
        }
    }

    Rectangle {
        x: root.total-x;
        y: root.timeline-y + root.timeline-sink + root.bar-rise;
        width: root.time-w;
        height: root.timeline-h;
        visible: root.timeline-shown > root.shown-epsilon;
        opacity: root.timeline-shown;

        Text {
            width: 100%;
            height: 100%;
            text: root.total;
            font-family: Type.numerals;
            color: Paint.strong;
            font-size: Type.readout;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // --- the way in ---------------------------------------------------------
    //
    // Glass with no fill, like every panel, even with no film: the pipeline
    // composites anyway, so the glass resolves over a black frame into a
    // faint lift with an edge, which a fill would cover.
    Rectangle {
        x: root.invite-x;
        y: root.invite-y + root.invite-rise;
        width: root.invite-w;
        height: root.invite-h;
        // A fill only where there is no glass to cover: after a failure,
        // which leaves no render context for the glass pass, and while
        // nothing is drawn behind the pane yet (see `backdrop` and `mark`).
        property <bool> bare: root.fatal != "" || !root.backdrop;
        border-radius: self.bare ? root.panel-radius : 0px;
        visible: root.invite-shown > root.shown-epsilon;
        opacity: root.invite-shown;
        clip: true;

        // In the glass's own outline, which is the shape it stands in for.
        Squircle {
            radius: root.panel-radius;
            fill: parent.bare ? Paint.wash-soft : transparent;
        }

        // So a click that misses a row doesn't reach the play/pause handler.
        TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        VerticalLayout {
            padding-top: Rows.panel-pad;
            padding-bottom: Rows.panel-pad;

            // No rows that open a file: with no render context, a film would
            // play with no picture.
            if root.fatal != "": VerticalLayout {
                Rectangle {
                    height: root.invite-line-h;

                    HorizontalLayout {
                        padding-left: Rows.label-x;
                        padding-right: Rows.trail-x;

                        Text {
                            text: root.fatal;
                            color: Paint.strong;
                            font-size: Type.title;
                            font-weight: Type.weight-title;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    height: Rows.group-gap;
                }

                // The driver's own words, allowed to wrap to three lines,
                // since this is the only copy of them.
                Rectangle {
                    height: root.invite-detail-h;

                    HorizontalLayout {
                        padding-left: Rows.label-x;
                        padding-right: Rows.label-x;

                        Text {
                            text: root.fatal-detail;
                            color: Paint.body;
                            font-size: Type.hint;
                            wrap: word-wrap;
                            overflow: elide;
                            vertical-alignment: top;
                        }
                    }
                }

                // The gap is inside the line's height, so a failure with no
                // note leaves no space for one.
                if root.fatal-note-h > 0px: Rectangle {
                    height: root.fatal-note-h;

                    HorizontalLayout {
                        padding-top: Rows.group-gap;
                        padding-left: Rows.label-x;
                        padding-right: Rows.trail-x;

                        Text {
                            text: root.fatal-note;
                            color: Paint.body;
                            font-size: Type.hint;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                // Something to do about it: copy the words, or leave.
                Rectangle {
                    height: Rows.group-gap;
                }
                MenuRow {
                    label: root.copied ? @tr("Copied") : @tr("Copy details");
                    focused: !root.has-file && root.focus-row == 0;
                    picked => {
                        root.copy-details();
                    }
                }
                MenuRow {
                    label: @tr("Close the player");
                    focused: !root.has-file && root.focus-row == 1;
                    picked => {
                        root.quit();
                    }
                }
            }

            // What you were watching comes first, since an empty window is
            // most often opened to get back to it. Its show goes on a line of
            // its own, so the episode keeps room for its number.
            if root.fatal == "" && root.invite-show: MenuHeading {
                text: root.resume-show;
                titular: true;
            }
            // With nothing to continue, the player's own name goes where the
            // show's would, so the first window anyone sees says what is
            // asking. Natural case, as a name.
            if root.invite-named: MenuHeading {
                text: "Death by MPV";
                titular: true;
            }
            // A gap after it, since it is a film and the rows below open
            // dialogs.
            if root.fatal == "" && root.has-resume: ResumeRow {
                label: root.resume-title;
                progress: root.resume-progress;
                left: root.resume-left;
                focused: !root.has-file && root.focus-row == 0;
                opacity: root.opening ? 0.5 : 1.0;
                animate opacity { duration: Motion.surface; easing: ease-out; }
                picked => {
                    if (!root.opening) {
                        root.open-path(root.resume-path, false);
                    }
                }
            }
            if root.fatal == "" && root.has-resume: Rectangle {
                height: Rows.group-gap;
            }

            // The same rows, words and keys as the files panel on the bar, so
            // they are learned once. Dimmed and inert while an open is in
            // flight, or a second click would queue a second scan. Dimmed here
            // rather than by `ShortcutRow`, whose `inert` reference rows must
            // not fade.
            if root.fatal == "": ShortcutRow {
                label: @tr("Open file…");
                shortcut: @tr("Ctrl+O");
                focused: !root.has-file && root.focus-row == root.invite-first;
                inert: root.opening;
                opacity: root.opening ? 0.5 : 1.0;
                animate opacity { duration: Motion.surface; easing: ease-out; }
                picked => {
                    root.request-open(false);
                }
            }
            if root.fatal == "": ShortcutRow {
                label: @tr("Open folder…");
                shortcut: @tr("Ctrl+Shift+O");
                focused: !root.has-file && root.focus-row == root.invite-first + 1;
                inert: root.opening;
                opacity: root.opening ? 0.5 : 1.0;
                animate opacity { duration: Motion.surface; easing: ease-out; }
                picked => {
                    root.request-open(true);
                }
            }
            // The bar's way to the settings is gone until there is a film.
            // Still working, so not dimmed while opening.
            if root.fatal == "": ShortcutRow {
                label: @tr("Settings");
                shortcut: "S";
                focused: !root.has-file && root.focus-row == root.invite-first + 2;
                picked => {
                    root.open-settings(true);
                }
            }
            // The reference, one key away from the moment someone is most
            // likely to wonder what the keys are.
            if root.fatal == "": ShortcutRow {
                label: @tr("Shortcuts");
                shortcut: "?";
                focused: !root.has-file && root.focus-row == root.invite-first + 3;
                picked => {
                    root.open-settings-page(4);
                }
            }

            // One line for two things never said at once: what else you could
            // do, and what is happening now. The drop is stated rather than
            // shown, because the shell reports nothing until the file lands.
            // The gap comes with the line, so with neither there is no row.
            if root.fatal == "" && root.invite-note-h > 0px: Rectangle {
                height: root.invite-note-h;

                HorizontalLayout {
                    padding-top: Rows.group-gap;
                    padding-left: Rows.label-x;
                    padding-right: Rows.trail-x;

                    Text {
                        // Two branches suffice, since the row exists only when
                        // one of them applies.
                        text: root.opening
                            ? @tr("Opening {}…", root.opening-name)
                            : @tr("Or drop a file or folder onto the window");
                        color: Paint.body;
                        font-size: Type.hint;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // --- the action flash ---------------------------------------------------
    //
    // No `TouchArea` anywhere in here, deliberately: it sits over the middle
    // of the picture, where a click means play or pause.
    Rectangle {
        x: root.flash-x(root.flash-ring);
        y: root.flash-y + root.flash-rise;
        width: root.flash-ring;
        height: root.flash-ring;
        visible: root.flash-shown > root.shown-epsilon && root.flash-has-ring;
        opacity: root.flash-shown;

        Image {
            source: root.flash-icons[Flash.icon];
            width: root.flash-glyph;
            height: root.flash-glyph;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            colorize: Paint.lit;
        }
    }

    Rectangle {
        x: root.flash-text-x + root.flash-slide;
        y: root.flash-text-y + root.flash-text-rise;
        width: root.flash-text-w;
        height: root.flash-text-h;
        visible: root.flash-shown > root.shown-epsilon && root.flash-text != "";
        opacity: root.flash-shown;

        Image {
            source: @image-url("../../../public/icons/warning.svg");
            visible: root.flash-warns;
            x: root.flash-text-pad;
            y: (parent.height - self.height) / 2;
            width: root.flash-mark;
            height: root.flash-mark;
            image-fit: contain;
            colorize: Paint.lit;
        }

        Text {
            width: parent.width - 2 * root.flash-text-pad - root.flash-mark-w;
            height: 100%;
            x: root.flash-text-pad + root.flash-mark-w;
            text: root.flash-text;
            color: Paint.lit;
            font-size: Type.title;
            font-weight: Type.weight-title;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    /// Measured, never drawn, because the capsule is sized around words that
    /// change width. Its font must match the visible text exactly.
    flash-measure := Text {
        text: root.flash-text;
        font-size: Type.title;
        font-weight: Type.weight-title;
        visible: false;
        width: 0px;
        height: 0px;
    }

    // A season's end is said once, over its way on: the one thing at the end
    // the interface states rather than offers. No glass of its own, as the end
    // is lit by a frame dimmed far enough for white words to read on it.
    Text {
        text: root.season-done;
        visible: root.at-end && root.at-last && root.season-done != ""
            && root.end-shown > root.shown-epsilon;
        opacity: root.end-shown;
        x: root.end-x + (root.end-w - self.width) / 2;
        y: root.end-y + root.end-rise - Rows.offset - self.height;
        color: Paint.body;
        font-size: Type.hint;
    }

    // --- the button a finished film leaves behind ---------------------------
    //
    // Not tied to `controls-visible`: the bar hides after a few still seconds,
    // and this should still be there when it does. At the end of the last
    // file it offers a second thing (see `end-two`).
    Rectangle {
        x: root.end-x;
        y: root.end-y + root.end-rise;
        width: root.end-w;
        height: root.end-h;
        visible: root.end-shown > root.shown-epsilon;
        opacity: root.end-shown;

        // The way on first and Restart second, since at the end of a season
        // the next one is the likely wish.
        EndChoice {
            x: root.end-inset;
            y: root.end-inset;
            width: root.end-first-w;
            height: parent.height - 2 * root.end-inset;
            inset: root.end-inset;
            pad: root.end-choice-pad;
            gap: root.end-gap;
            // Only while the pill is up, so the choice takes the ring's pane as
            // it arrives rather than holding it unseen behind the credits pill.
            focused: root.centre-up && root.bar-reach && root.bar-focus == root.pill-stop;
            icon: root.arriving ? @image-url("../../../public/icons/play.svg")
                : !root.end-two || root.onward-path != ""
                ? @image-url("../../../public/icons/step-forward.svg")
                : @image-url("../../../public/icons/folder-open.svg");
            label: root.end-two ? root.end-first-label : root.end-label;
            picked => {
                root.end-activate(0);
            }
        }

        if root.end-two: EndChoice {
            x: root.end-inset + root.end-first-w + root.btn-gap;
            y: root.end-inset;
            width: root.end-second-w;
            height: parent.height - 2 * root.end-inset;
            inset: root.end-inset;
            pad: root.end-choice-pad;
            gap: root.end-gap;
            focused: root.centre-up && root.bar-reach && root.bar-focus == root.pill-stop + 1;
            icon: @image-url("../../../public/icons/rewind.svg");
            label: root.end-label;
            picked => {
                root.end-activate(1);
            }
        }
    }

    // Measures, never drawn: a `Text` because only the font knows how wide
    // a string is, outside what it sizes because that width depends on the
    // answer. Each must match its visible text's font exactly.

    /// The film's length as the timeline writes it, and the widest a time
    /// under an hour can read; `time-w` holds the wider of the two.
    time-measure := Text {
        text: root.total;
        font-family: Type.numerals;
        font-size: Type.readout;
        visible: false;
        width: 0px;
        height: 0px;
    }

    minutes-measure := Text {
        text: "00:00";
        font-family: Type.numerals;
        font-size: Type.readout;
        visible: false;
        width: 0px;
        height: 0px;
    }

    end-measure := Text {
        text: root.end-two ? root.end-first-label : root.end-label;
        font-size: Type.prompt;
        font-weight: Type.weight-title;
        visible: false;
        width: 0px;
        height: 0px;
    }

    end-folder-measure := Text {
        text: root.end-label;
        font-size: Type.prompt;
        font-weight: Type.weight-title;
        visible: false;
        width: 0px;
        height: 0px;
    }

    // --- the way on, while the credits roll ---------------------------------
    //
    // Not tied to `controls-visible`, for the end pill's reason: the bar
    // leaves three still seconds after the credits start, and this stays.
    Rectangle {
        x: root.credits-x;
        y: root.credits-y + root.credits-rise;
        width: root.credits-w;
        height: root.pill-h;
        visible: root.credits-shown > root.shown-epsilon;
        opacity: root.credits-shown;

        EndChoice {
            width: parent.width;
            height: parent.height;
            pad: root.pill-text-pad;
            gap: root.end-gap;
            focused: root.bar-reach && root.bar-focus == root.pill-stop && !root.centre-up;
            // Next's glyph for the next file, and Skip's for further into
            // this one; not Forward's, which has its ten seconds drawn in.
            icon: root.corner-says == 2 ? @image-url("../../../public/icons/play.svg")
                : root.corner-says-skip ? @image-url("../../../public/icons/skip.svg")
                : @image-url("../../../public/icons/step-forward.svg");
            label: root.credits-label;
            picked => {
                root.credits-activate();
            }
        }
    }

    credits-measure := Text {
        text: root.credits-label;
        font-size: Type.prompt;
        font-weight: Type.weight-title;
        visible: false;
        width: 0px;
        height: 0px;
    }

    // --- the hover label ----------------------------------------------------
    //
    // Declared after the bar so it draws over it, should a narrow window ever
    // make the two meet.

    tip-label-measure := Text {
        text: root.tip-text;
        font-size: Type.body;
        visible: false;
        width: 0px;
        height: 0px;
    }

    tip-keys-measure := Text {
        text: root.tip-key;
        font-size: Type.readout;
        visible: false;
        width: 0px;
        height: 0px;
    }

    Rectangle {
        x: root.tip-x;
        y: root.tip-y + root.tip-rise;
        width: root.tip-w;
        height: root.tip-h;
        visible: root.tip-on > root.shown-epsilon;
        opacity: root.tip-on;

        HorizontalLayout {
            padding-left: root.tip-pad;
            padding-right: root.tip-pad;
            spacing: root.tip-gap;
            alignment: center;

            Text {
                // A shortcuts row's two roles: the name, and the key smaller.
                text: root.tip-text;
                color: Paint.body;
                font-size: Type.body;
                vertical-alignment: center;
            }

            if root.tip-key != "": Text {
                text: root.tip-key;
                color: Paint.body;
                font-size: Type.readout;
                vertical-alignment: center;
            }
        }
    }

    speed-measure := Text {
        text: root.speed-text;
        font-size: Type.readout;
        visible: false;
        width: 0px;
        height: 0px;
    }

    delay-measure := Text {
        text: root.sub-delay-widest;
        font-size: Type.readout;
        visible: false;
        width: 0px;
        height: 0px;
    }

    param-measure := Text {
        text: root.param-names;
        font-size: Type.readout;
        visible: false;
        width: 0px;
        height: 0px;
    }

    title-measure := Text {
        text: root.opening
            ? @tr("Opening {}…", root.opening-name)
            : root.media-title;
        font-size: Type.title;
        font-weight: Type.weight-title;
        visible: false;
        width: 0px;
        height: 0px;
    }

    episode-measure := Text {
        text: root.media-episode;
        font-size: Type.title;
        font-weight: Type.weight-title;
        visible: false;
        width: 0px;
        height: 0px;
    }

    // The seek preview. Declared after the track so it draws over the bar,
    // with no TouchArea, so it never takes the pointer from the track.
    Rectangle {
        x: root.preview-x;
        y: root.preview-y + root.preview-rise;
        width: root.preview-w;
        height: root.preview-h;
        visible: root.preview-shown > root.shown-epsilon;
        opacity: root.preview-shown;
        clip: true;

        // An `Image` has no corner of its own, so a clip on the box around it
        // rounds the thumbnail, which sets it in rather than pastes it on.
        Rectangle {
            x: root.preview-pad;
            y: root.preview-pad;
            width: root.preview-tile-w * 1px;
            height: root.preview-tile-h * 1px;
            visible: root.preview-has-tile;
            border-radius: root.preview-tile-radius;
            clip: true;

            Image {
                width: 100%;
                height: 100%;
                source: root.preview-sprite;
                // One tile out of the atlas, as the video takes the used part
                // of its grow-only target.
                source-clip-x: root.preview-clip-x;
                source-clip-y: root.preview-clip-y;
                source-clip-width: root.preview-tile-w;
                source-clip-height: root.preview-tile-h;
                image-fit: fill;
            }
        }

        Text {
            x: 0;
            y: root.preview-has-tile
                ? root.preview-h - root.preview-caption - root.preview-pad
                : 0;
            width: 100%;
            height: root.preview-has-tile ? root.preview-caption : root.preview-h;
            text: root.preview-time;
            font-family: Type.numerals;
            color: Paint.strong;
            font-size: Type.readout;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // --- what is loaded ---
    Rectangle {
        x: root.bar-x;
        y: root.pills-y + root.bar-rise;
        width: root.left-w;
        height: root.pill-h;
        visible: root.loaded-shown > root.shown-epsilon;
        opacity: root.loaded-shown;
        clip: true;

        HorizontalLayout {
            padding-left: root.pill-pad;
            padding-right: root.pill-text-pad;
            padding-top: root.pill-pad;
            padding-bottom: root.pill-pad;
            spacing: root.btn-gap;

            playlist-button := IconButton {
                icon: @image-url("../../../public/icons/playlist.svg");
                tip: @tr("Playlist");
                keys: "P";
                focused: root.bar-reach && root.bar-focus == 0;
                open: root.playlist-open;
                clicked => {
                    root.open-playlist(!root.playlist-open);
                }
            }
            files-button := IconButton {
                icon: @image-url("../../../public/icons/folder-open.svg");
                // What pressing it does, which is offer both; the menu's rows
                // carry the two keys.
                tip: @tr("Open a file or folder");
                keys: "";
                focused: root.bar-reach && root.bar-focus == 1;
                open: root.files-open;
                clicked => {
                    root.open-files(!root.files-open);
                }
            }

            Text {
                // While something else opens, the title names what is coming,
                // as the one piece of chrome about which file this is.
                text: root.title-text;
                color: Paint.strong;
                font-size: Type.title;
                font-weight: Type.weight-title;
                // Cut off rather than pushing the speed out of the group, and
                // the cut end blurs away like a list's (see `scroll-fades`).
                overflow: clip;
                // Clipped text asks for its whole length, which the layout
                // would take from the speed.
                min-width: 0px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                horizontal-alignment: left;
            }

            // A speed other than normal stays on screen beside what plays at
            // it, rather than only in a passing flash.
            if root.speed-shown: Text {
                text: root.speed-text;
                color: Paint.body;
                font-size: Type.readout;
                vertical-alignment: center;
            }
        }
    }

    // --- transport ---
    Rectangle {
        x: root.center-x;
        y: root.pills-y + root.bar-rise;
        width: root.center-w;
        height: root.pill-h;
        visible: root.pills-shown > root.shown-epsilon;
        opacity: root.pills-shown;

        HorizontalLayout {
            padding: root.pill-pad;
            spacing: root.btn-gap;

            back-button := IconButton {
                icon: @image-url("../../../public/icons/seek-backward.svg");
                tip: @tr("Back {} seconds", root.seek-step);
                keys: "←";
                focused: root.bar-reach && root.bar-focus == 2;
                clicked => {
                    root.seek-relative(-root.seek-step);
                }
            }
            previous-button := IconButton {
                icon: @image-url("../../../public/icons/step-backward.svg");
                tip: root.at-first ? @tr("No earlier file") : @tr("Previous file");
                keys: root.at-first ? "" : @tr("Ctrl+←");
                enabled: !root.at-first;
                focused: root.bar-reach && root.bar-focus == 3;
                clicked => {
                    root.playlist-step(-1);
                }
            }
            play-button := IconButton {
                // Three states: at the end of a file, play means start again,
                // and with no file there is nothing to pause.
                icon: root.at-end
                    ? @image-url("../../../public/icons/rewind.svg")
                    : root.paused || !root.has-file
                    ? @image-url("../../../public/icons/play.svg")
                    : @image-url("../../../public/icons/pause.svg");
                // The same three states, naming what pressing will do.
                tip: root.at-end ? @tr("Restart")
                    : root.paused || !root.has-file ? @tr("Play") : @tr("Pause");
                keys: root.at-end ? @tr("Home") : @tr("Space");
                focused: root.bar-reach && root.bar-focus == 4;
                clicked => {
                    if (root.at-end) {
                        root.replay();
                    } else {
                        root.toggle-pause();
                    }
                }
            }
            next-button := IconButton {
                icon: @image-url("../../../public/icons/step-forward.svg");
                tip: root.at-last ? @tr("No later file") : @tr("Next file");
                keys: root.at-last ? "" : @tr("Ctrl+→");
                enabled: !root.at-last;
                focused: root.bar-reach && root.bar-focus == 5;
                clicked => {
                    root.playlist-step(1);
                }
            }
            forward-button := IconButton {
                icon: @image-url("../../../public/icons/seek-forward.svg");
                tip: @tr("Forward {} seconds", root.seek-step);
                keys: "→";
                focused: root.bar-reach && root.bar-focus == 6;
                clicked => {
                    root.seek-relative(root.seek-step);
                }
            }
        }
    }

    // --- sound, effects and the rest ---
    Rectangle {
        x: root.right-x;
        y: root.pills-y + root.bar-rise;
        width: root.right-w;
        height: root.pill-h;
        visible: root.pills-shown > root.shown-epsilon;
        opacity: root.pills-shown;

        HorizontalLayout {
            padding: root.pill-pad;
            spacing: root.btn-gap;

            mute-button := IconButton {
                icon: root.muted
                    ? @image-url("../../../public/icons/volume-mute.svg")
                    : root.volume-icons[root.volume-index];
                // What pressing will do, since the glyph already shows the
                // state.
                tip: root.muted ? @tr("Unmute") : @tr("Mute");
                keys: "M";
                focused: root.bar-reach && root.bar-focus == 7;
                clicked => {
                    root.toggle-mute();
                }
            }

            // Volume, spanning mpv's full 0..200 range.
            vol-track := Rectangle {
                width: root.vol-w;

                // The level as a number, which nothing else on the bar gives:
                // the track has 96px for 200 steps, and the glyph moves in tens.
                property <string> tip: root.volume-said;
                property <string> tip-keys: root.muted ? "" : "↑ ↓";
                property <length> tip-cx: self.absolute-position.x + self.width / 2;
                /// This track's claim on the tip, as a button holds one.
                property <int> tip-claim: -1;
                /// How far the level is heard. The fill fades out with a mute
                /// and back in with an unmute, as a switch's track turns, and
                /// the unity dot turns with it rather than ahead of it.
                property <float> heard: root.muted ? 0.0 : 1.0;
                animate heard { duration: Motion.switch; easing: ease-out; }

                // A level that moves under the pointer shows at once, without
                // the wait, as the answer to whatever moved it.
                changed tip => {
                    if (Tip.seq == self.tip-claim) {
                        self.tip-claim = Tip.show(self.tip, self.tip-keys, self.tip-cx);
                    }
                }

                accessible-role: slider;
                accessible-label: @tr("Volume");
                accessible-value: root.muted ? @tr("Muted") : Math.round(root.volume) + "%";
                accessible-action-increment => {
                    root.nudge-volume(root.volume-step);
                }
                accessible-action-decrement => {
                    root.nudge-volume(-root.volume-step);
                }

                vol-rail := Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 100%;
                    height: vol.has-hover || vol.pressed ? 7px : 5px;
                    border-radius: self.height / 2;
                    background: Paint.rail;
                    animate height { duration: Motion.track-grow; easing: ease-out; }

                    // Never taller than it is long, as a slider's fill is.
                    Rectangle {
                        x: 0;
                        y: (parent.height - self.height) / 2;
                        width: parent.width
                            * clamp(root.volume / root.volume-max, 0, 1);
                        height: min(parent.height, self.width);
                        border-radius: self.height < 2px ? 0px
                            : self.height / 2;
                        background: Paint.fill;
                        opacity: vol-track.heard;
                    }

                    // Unity gain: the track runs to mpv's 200%, so this marks
                    // where normal is. A dot, because a line would divide the
                    // track into two ranges. Inset a pixel so it stays round as
                    // the track grows, it turns dark once the fill reaches it,
                    // like the switch knob. At exactly 100% that shows as a
                    // notch, where light would only lengthen the fill's cap.
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: self.height;
                        height: parent.height - 2px;
                        border-radius: self.height / 2;
                        // Keyed on the fill as drawn rather than the level, so
                        // muted, with no fill, the dot stays light.
                        background: root.volume >= 100
                            ? Paint.knob.mix(Paint.quiet, vol-track.heard)
                            : Paint.quiet;
                    }
                }

                vol := TouchArea {
                    mouse-cursor: pointer;
                    pointer-event(event) => {
                        Chrome.pointed(event.kind == PointerEventKind.down);
                    }
                    moved => {
                        if (self.pressed) {
                            root.set-volume(self.mouse-x / self.width * root.volume-max);
                        }
                    }
                    // Unlike a button's, its tip stays on a press, since it
                    // shows the result.
                    clicked => {
                        root.set-volume(self.mouse-x / self.width * root.volume-max);
                    }
                    // The one place the wheel is the volume. Activity for the
                    // timeline's wheel's reason.
                    scroll-event(event) => {
                        Chrome.bump();
                        root.nudge-volume(event.delta-y > 0
                            ? root.volume-step
                            : -root.volume-step);
                        return EventResult.accept;
                    }
                    changed has-hover => {
                        if (self.has-hover) {
                            vol-track.tip-claim = Tip.point(vol-track.tip,
                                vol-track.tip-keys, vol-track.tip-cx);
                        } else {
                            Tip.release(vol-track.tip-claim);
                        }
                    }
                }
            }

            // The audio panel's mark is its heading's, so the button and what
            // it opens wear the same glyph.
            audio-button := IconButton {
                icon: @image-url("../../../public/icons/speaking.svg");
                tip: @tr("Audio");
                keys: "A";
                focused: root.bar-reach && root.bar-focus == 8;
                open: root.audio-open;
                clicked => {
                    root.open-audio(!root.audio-open);
                }
            }
            // Opens the subtitles menu. It shows no on/off state, because a
            // button that looks like a switch gets clicked like one; the
            // menu's Off row and C are the switch.
            subs-button := IconButton {
                icon: @image-url("../../../public/icons/subtitles.svg");
                tip: @tr("Subtitles");
                keys: "V";
                focused: root.bar-reach && root.bar-focus == 9;
                open: root.menu-open;
                clicked => {
                    root.open-menu(!root.menu-open);
                }
            }
            settings-button := IconButton {
                icon: @image-url("../../../public/icons/settings.svg");
                tip: @tr("Settings");
                keys: "S";
                focused: root.bar-reach && root.bar-focus == 10;
                open: root.settings-open;
                clicked => {
                    root.open-settings(!root.settings-open);
                }
            }
            panscan-button := IconButton {
                // What a press does, as fullscreen's glyph is: filling while
                // the picture fits, fitting while it fills.
                icon: root.panscan
                    ? @image-url("../../../public/icons/panscan-off.svg")
                    : @image-url("../../../public/icons/panscan-on.svg");
                // Names the direction it will go, which the shortcuts list,
                // covering both in one row, can't.
                tip: root.panscan ? @tr("Fit the window") : @tr("Fill the window");
                keys: "T";
                focused: root.bar-reach && root.bar-focus == 11;
                clicked => {
                    root.toggle-panscan();
                }
            }
            fullscreen-button := IconButton {
                icon: root.fullscreen
                    ? @image-url("../../../public/icons/fullscreen-off.svg")
                    : @image-url("../../../public/icons/fullscreen-on.svg");
                tip: root.fullscreen ? @tr("Leave fullscreen") : @tr("Fullscreen");
                keys: "F";
                focused: root.bar-reach && root.bar-focus == 12;
                clicked => {
                    root.toggle-fullscreen();
                }
            }
        }
    }
    // --- the window's own buttons -------------------------------------------
    Rectangle {
        x: root.window-pane-x;
        y: root.window-pane-y + root.window-drop;
        width: root.window-pane-w;
        height: root.window-pane-h;
        visible: root.window-shown > root.shown-epsilon;
        opacity: root.window-shown;

        // Under the buttons, so a click on the glass between them doesn't
        // reach the film.
        window-pane := TouchArea {
            pointer-event(event) => {
                Chrome.pointed(event.kind == PointerEventKind.down);
            }
        }

        minimize-button := IconButton {
            x: root.window-btn-pad;
            y: root.window-btn-pad;
            width: root.window-btn;
            height: root.window-btn;
            icon: @image-url("../../../public/icons/minimize.svg");
            // No tip, since there is no key to teach; the name is for screen
            // readers.
            accessible-label: @tr("Minimize");
            clicked => {
                root.minimize();
            }
        }
        maximize-button := IconButton {
            x: root.window-btn-pad + root.window-btn-step;
            y: root.window-btn-pad;
            width: root.window-btn;
            height: root.window-btn;
            icon: root.maximized
                ? @image-url("../../../public/icons/unmaximize.svg")
                : @image-url("../../../public/icons/maximize.svg");
            accessible-label: root.maximized ? @tr("Restore") : @tr("Maximize");
            clicked => {
                root.maximized = !root.maximized;
            }
        }
        close-button := IconButton {
            x: root.window-btn-pad + 2 * root.window-btn-step;
            y: root.window-btn-pad;
            width: root.window-btn;
            height: root.window-btn;
            icon: @image-url("../../../public/icons/close.svg");
            accessible-label: @tr("Close");
            clicked => {
                root.quit();
            }
        }
    }
}

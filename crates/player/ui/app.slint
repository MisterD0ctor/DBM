// The player's window: the film, and over it the surfaces in their own files,
// the bar, the panels, the pills, the way in, the flash and the tips. The
// window decides which are up, walks them with the keyboard, and gathers
// their glass and soft edges for the render pipeline (see `Surfaces`), which
// owns the material while this scene owns layout and content.

import { Find, FindState } from "find.slint";
import { Removal, Tracks } from "tracks.slint";
import { Subtitles, SyncState } from "subtitles.slint";
import { Playlist } from "playlist.slint";
import { Reset, Resets, Settings } from "settings.slint";
import { Playback } from "playback.slint";
import { Chrome, Figure, Flash, Tip } from "globals.slint";
import {
    FoundItem, GlassRect, ParamItem, PlaylistGroup, PlaylistItem, ScrollFade, TrackItem
} from "models.slint";
import { Motion, Paint, Rows, Type } from "theme.slint";
import { EndChoice, IconButton } from "controls.slint";
import {
    BackRow, DrillRow, EmptyRow, FoundRow, GroupRow, MenuHeading, MenuRow, NoteRow,
    ParamSlider, PlaylistRow, ResumeRow, ShortcutRow, StepperRow, ToggleRow, Tucked,
} from "rows.slint";
import { AccountPage } from "account.slint";
import { Ring } from "ring.slint";
import { ScrollList } from "scroll_list.slint";
import { Shapes, Squircle } from "squircle.slint";
import { Measure } from "measure.slint";
import { Bar, ControlBar } from "bar.slint";
import { Bounds, Panel, Surfaces } from "surface.slint";
import { ActionFlash } from "flash.slint";
import { HoverTip } from "tip.slint";
import { SeekPreview } from "preview.slint";
import { CornerPill, EndPill } from "pills.slint";
import { WayIn } from "way_in.slint";
import { WindowButtons } from "window_buttons.slint";
import { AudioPanel } from "audio_panel.slint";
import { FilesPanel } from "files_panel.slint";
import { PlaylistPanel } from "playlist_panel.slint";
import { MenuPage, SubtitlesMenu } from "subtitles_menu.slint";
import { SettingsPage, SettingsPanel } from "settings_panel.slint";

// What the Rust side reaches besides the window: the globals it drives, the
// structs it fills in, and the enums both sides name.
export {
    Chrome, Flash, Tip, Motion, Paint, Shapes, GlassRect, ParamItem, PlaylistGroup, PlaylistItem,
    TrackItem, Find, Tracks, Subtitles, Playlist, Settings, Playback, Figure, FindState, Reset,
    SyncState, Panel, MenuPage, SettingsPage
}

/// What a key does to the chrome once it has been handled.
enum KeyWake {
    /// Brings it up.
    wake,
    /// Brings up nothing, for a key whose own answer is enough (its flash,
    /// the timeline, the picture), though what is up stays up.
    keep,
    /// Puts it away, for a key that asked for the picture: more of it, or
    /// the film going on.
    hide,
}

export component MainWindow inherits Window {
    // For the task bar and the window switcher, at 256px because window
    // managers scale down better than up. The Windows executable's icon is a
    // separate resource compiled in by `build.rs`.
    icon: @image-url("../icons/128x128@2x.png");
    title: "Death by MPV";

    // No frame: the film runs to the window's edges, the window's buttons
    // are its own (`WindowButtons`), and the picture is what drags it
    // (`video-surface`).
    no-frame: true;

    // The edge a frame would have given to take hold of. None while
    // maximized, since there is nothing to resize from.
    resize-border-width: root.maximized ? 0px : 8px;
    preferred-width: 1280px;
    preferred-height: 720px;

    // The floor: 960×540, 16:9 at three quarters of the opening size, which
    // still leaves the title some room once the transport has given way to
    // the right group. Read by `interface::scale`, which holds the window to
    // it at a larger interface size too.
    out property <length> floor-width: 960px;
    out property <length> floor-height: 540px;
    min-width: root.floor-width;
    min-height: root.floor-height;
    background: Paint.ground;
    default-font-family: Type.face;

    // For text that names no weight, since Slint's default of 400 is not one
    // the bundled files carry.
    default-font-weight: Type.weight-plain;
    forward-focus: keys;

    // --- from the render pipeline ------------------------------------------------
    // Written from the rendering notifier, and only when the texture is
    // recreated, never per frame.
    in property <image> video-frame;

    // Targets only grow, so resizing costs no reallocation, which leaves the
    // texture larger than the image in it. This is the part in use, which
    // the video's `source-clip` trims to.
    in property <int> video-clip-w: 1;
    in property <int> video-clip-h: 1;

    // --- what the Rust side sets and is asked ------------------------------------
    //
    // Keys are handled here rather than in Rust because Slint's `Key.*`
    // constants are private-use characters, so Rust gets named intentions
    // rather than keycodes.
    /// Whether a picture is drawn behind the way in for its glass to bend.
    /// It needs a film left unfinished and a seek-preview atlas built for it,
    /// so a fresh profile stays at Ground (see the way in's fill).
    in property <bool> backdrop;

    /// Whether a file dropped on this window reaches the player, from
    /// `dropped::SUPPORTED`. The two places that mention dropping, under the
    /// way in and on the shortcuts page, only do so where it works.
    in property <bool> drop-supported;

    /// Why the player can't show video at all, or empty when it can.
    ///
    /// Set once, during graphics setup, and never cleared: every way it can be
    /// set leaves the player with no render context for the rest of the run.
    in property <string> fatal: "";

    /// The failure in the graphics driver's or mpv's own words, kept apart so
    /// `fatal` stays readable. On screen because a packaged build has no
    /// console for it.
    in property <string> fatal-detail: "";

    /// What usually puts it right, worded for the failure it is. Not always
    /// the driver: refused shaders can be the player's fault, and blaming the
    /// driver would send someone to update one that was never the problem.
    in property <string> fatal-note: "";
    in-out property <bool> fullscreen: false;

    /// The panel drawn unseen this frame, at no opacity, so that its first
    /// opening does not also pay for drawing it the first time (see `warm`).
    in property <Panel> warming: Panel.none;
    callback quit();

    /// Straight to the window rather than through `minimized`, which a Wayland
    /// client is never told has been undone (see `window::minimize`).
    callback minimize();
    callback toggle-fullscreen();
    callback leave-fullscreen();

    /// A click on the video, deferred in Rust so that a double-click can
    /// cancel it rather than pause and unpause on the way to fullscreen.
    callback video-clicked();
    callback video-double-clicked();

    /// Put the failure's headline and the driver's words on the clipboard.
    /// Public for the test that reads the clipboard back.
    public function copy-details() {
        way-in.copy-details();
    }

    // --- mirrored from mpv, via PlayerState --------------------------------------
    //
    // What a change of these sets off: the ring going to a pill that came up,
    // the clock woken by a film ending, the title shown as a file starts.
    /// `Playback.paused`, mirrored so its changes are acted on here.
    property <bool> paused: Playback.paused;

    /// `Playback.has-file`, mirrored so its changes are acted on here.
    property <bool> has-file: Playback.has-file;

    // Otherwise a ring left up by the way in would land on the bar as a film
    // arrives, on a button nobody chose. A ring a pill has taken stays: a file
    // opened from outside arrives with its question in the same frame, and the
    // two handlers run in no promised order.
    changed has-file => {
        if (root.bar-focus < root.pill-stop
                || !(root.arriving || root.at-end || root.corner-offered)) {
            Chrome.focus-visible = false;
        }
        root.bar-resume = false;
    }

    /// `Playback.at-end`, mirrored so its changes are acted on here.
    property <bool> at-end: Playback.at-end;

    // A film ending wakes the clock although nobody touched anything: the bar
    // comes back with the way on, and the fade gets frames, which nothing else
    // asks for once mpv stops producing them. The ring goes to the pill, as
    // for the credits, so Enter at the end of anything is the way on.
    changed at-end => {
        if (root.at-end) {
            Chrome.bump();
            root.ring-to-pill();
        } else if (!root.corner-offered && !root.arriving) {
            root.ring-off-pill();
        }
    }

    /// `Playback.arriving`, mirrored so its changes are acted on here.
    property <bool> arriving: Playback.arriving;

    // A file held on its saved place is a question, answered in the middle of
    // the picture. The panel it was chosen from closes and the ring goes to
    // the pill, so choosing an episode and going on with it is Enter, Enter.
    changed arriving => {
        if (root.arriving) {
            Chrome.bump();
            root.close-panel();
            root.bar-focus = root.pill-stop;
            Chrome.focus-visible = true;
        } else if (!root.corner-offered && !root.at-end) {
            root.ring-off-pill();
        }
    }

    property <bool> has-resume: Playback.resume-path != "";

    /// `Playback.path`, mirrored so its changes are acted on here.
    property <string> current-path: Playback.path;

    // The timing is a file's alone, so what would take a sync or a reset of it
    // back goes when another file opens under the menu, rather than put one
    // film's timing on the next. So does a pause a frame step made: a file
    // that opens paused is one to see where you are in. And the file says
    // what it is, by itself, however it came.
    changed current-path => {
        menu.file-changed();
        root.stepped = false;
        root.glimpse-title();
    }

    // --- the panels --------------------------------------------------------------
    //
    // One open at a time, since they share the space above the bar. Each is
    // a `GlassPanel` in a file of its own, which owns its pages and its rows;
    // the window opens and closes them, and walks the open one with the
    // keyboard (see "keyboard reach").
    /// The panel open over the film. One at a time, since they share the
    /// space above the bar (see `show-panel`).
    property <Panel> open-panel: Panel.none;

    // Read on the Rust side, and by the tests.
    out property <bool> menu-open: root.open-panel == Panel.subtitles;
    out property <bool> audio-open: root.open-panel == Panel.audio;
    out property <bool> playlist-open: root.open-panel == Panel.playlist;
    out property <bool> files-open: root.open-panel == Panel.files;
    out property <bool> settings-open: root.open-panel == Panel.settings;

    /// Whether any panel is open. Tips open on the line panels do, so a tip
    /// stands down while any panel is up rather than working out whether it
    /// would land under it.
    property <bool> panel-open: root.open-panel != Panel.none;

    changed panel-open => {
        if (!root.panel-open && root.pill-owed) {
            root.pill-owed = false;
            if (root.corner-offered || root.centre-up) {
                root.ring-to-pill();
            }
        }
    }

    // Every button and key opens a panel through these functions, so they
    // can't drift apart. Each opens on its front page, and the lists on their
    // current row, centred.

    /// Open `panel` in place of whichever is open, or close it if it is the
    /// one open.
    function show-panel(panel: Panel, open: bool) {
        if (open) {
            root.open-panel = panel;
            root.focus-row = 0;
        } else if (root.open-panel == panel) {
            root.close-panel();
        }
    }

    public function open-menu(open: bool) {
        root.show-panel(Panel.subtitles, open);
        if (open) {
            menu.opening();
        }
    }

    public function open-audio(open: bool) {
        root.show-panel(Panel.audio, open);
        if (open) {
            audio-panel.opening();
        }
    }

    public function open-playlist(open: bool) {
        root.show-panel(Panel.playlist, open);
        if (open) {
            playlist-panel.opening();
        }
    }

    public function open-settings(open: bool) {
        root.show-panel(Panel.settings, open);
        if (open) {
            root.settings-page = SettingsPage.front;
        }
    }

    /// Show one settings page, opening the panel if it is shut. Public so a
    /// test can walk the pages and check each page's height.
    public function open-settings-page(page: SettingsPage) {
        root.open-settings(true);
        root.settings-page = page;
        root.focus-row = 0;
    }

    public function open-files(open: bool) {
        root.show-panel(Panel.files, open);
    }

    /// Open a panel, or close it if it is the one open, as its button does.
    function toggle-panel(panel: Panel) {
        if (panel == Panel.playlist) {
            root.open-playlist(!root.playlist-open);
        } else if (panel == Panel.files) {
            root.open-files(!root.files-open);
        } else if (panel == Panel.audio) {
            root.open-audio(!root.audio-open);
        } else if (panel == Panel.subtitles) {
            root.open-menu(!root.menu-open);
        } else {
            root.open-settings(!root.settings-open);
        }
    }

    /// Close the open panel. The ring goes back to the top, which is also
    /// where the way in wants it once the panel closes over an empty window.
    function close-panel() {
        root.open-panel = Panel.none;
        root.focus-row = 0;
    }

    /// Where a panel is, and how much of it is in: its column and its
    /// height, up from a bottom edge always one `Rows.offset` above the bar.
    pure function bounds-of(panel: Panel) -> Bounds {
        return panel == Panel.subtitles
            ? menu.bounds
            : panel == Panel.audio
            ? audio-panel.bounds
            : panel == Panel.playlist
            ? playlist-panel.bounds
            : panel == Panel.files
            ? files-panel.bounds
            : settings.bounds;
    }

    pure function panel-shown-of(panel: Panel) -> float {
        return panel == Panel.subtitles ? menu.shown
            : panel == Panel.audio ? audio-panel.shown
            : panel == Panel.playlist ? playlist-panel.shown
            : panel == Panel.files ? files-panel.shown
            : settings.shown;
    }

    property <Bounds> panel-bounds: root.bounds-of(root.open-panel);
    property <length> panel-x: root.panel-bounds.x;
    property <length> panel-w: root.panel-bounds.width;
    property <length> panel-h: root.panel-bounds.height;

    /// The open panel's right edge, for the test that drags a list's thumb.
    out property <length> panel-right: root.panel-x + root.panel-w;

    /// And its left, for the one that presses the way back to a list's
    /// current row.
    out property <length> panel-left: root.panel-x;

    /// Which page the settings panel shows (see `SettingsPanel.page`). Out
    /// so a test can say which page a key left it on.
    out property <SettingsPage> settings-page: SettingsPage.front;

    /// The playlist's page (see `PlaylistPanel.page`), which the Rust side
    /// keeps on the same part when the parts around it change.
    in-out property <int> playlist-page: 0;

    /// The subtitles menu's search and sign-in pages are the ones it shows
    /// (see `SubtitlesMenu`), read and set on the Rust side.
    in-out property <bool> find-open: false;
    in-out property <bool> account-open: false;

    /// How far down the open panel the middle of the row that last asked for
    /// something slow is, so the answer can be put beside it. Negative once
    /// that row is gone.
    property <length> asked-row: -1px;

    /// The claim on the flash of the hint up beside a page, if any.
    property <int> hint-claim: -1;

    /// Delete on a tracks panel: arms the track the ring is on, or removes it
    /// if it is armed, where it can be removed; says whether it could.
    function remove-focused-track() -> bool {
        if (root.audio-open) {
            return audio-panel.remove-ringed();
        }
        return menu.remove-ringed();
    }

    // The menu's ways in, public for the Rust side and the tests that walk
    // them (see `SubtitlesMenu`).
    public function open-find() {
        menu.open-find();
    }

    public function offer-sign-in(row: int, why: string) -> bool {
        return menu.offer-sign-in(row, why);
    }

    public function close-account() {
        menu.close-account();
    }

    public function open-subs-page(page: MenuPage) {
        if (!root.menu-open) {
            root.open-menu(true);
        }
        menu.open-subs-page(page);
    }

    /// Back to the list of parts. Public for the test that presses it.
    public function playlist-back() {
        playlist-panel.back();
    }

    // The menu's sizes and scroll, for the tests.
    out property <length> subs-natural: menu.natural;
    out property <length> subs-h: menu.tracks-h;
    out property <length> subs-list-h: menu.tracks-list-h;
    out property <length> subs-scroll: menu.scroll;

    // The playlist's sizes and scroll, for the tests.
    out property <length> playlist-natural: playlist-panel.natural;
    out property <length> playlist-h: playlist-panel.panel-h;
    out property <length> playlist-list-h: playlist-panel.list-h;
    out property <length> playlist-list-top: playlist-panel.list-top;
    out property <length> playlist-scroll: playlist-panel.scroll;

    // The audio panel's sizes, for the tests.
    out property <length> audio-natural: audio-panel.natural;
    out property <length> audio-h: audio-panel.panel-h;
    out property <length> audio-list-h: audio-panel.list-h;

    // A track armed for removal (see `Removal`) waits for its second press
    // while the question is being read and starts over once it is left, so
    // nobody is timed out of an answer they were still reading.
    Timer {
        interval: Motion.armed-for;
        running: Removal.armed >= 0 && !Removal.held;
        triggered => {
            Removal.disarm();
        }
    }

    // A row armed by its first press waits for the second (see `Resets`).
    property <int> reset-armed-seq: Resets.armed-seq;

    changed reset-armed-seq => {
        reset-timer.stop();
        reset-timer.start();
    }

    reset-timer := Timer {
        interval: Motion.armed-for;
        running: false;
        triggered => {
            Resets.armed = Reset.none;
            reset-timer.stop();
        }
    }

    // --- the chrome --------------------------------------------------------------
    //
    // When the bar and the window's buttons are up, and what comes up alone:
    // the timeline after a seek, what is loaded as a file starts.
    // Rust owns the idle clock; what it means is decided here. The chrome
    // stays up while a panel is open, while a film is paused, since pausing
    // is stopping to look at where you are, and under a pointer resting on
    // the bar or the window's buttons, rather than leaving from under the
    // hand about to use them.
    property <bool> controls-visible: !Chrome.idle || root.panel-open
        || (root.paused && root.has-file && !root.stepped)
        || bar.hovered || root.window-hovered;

    property <bool> window-hovered: window-buttons.hovered;

    // A ring on the bar goes with the bar, or Enter twenty minutes later
    // would press whatever it was last on. A ring on a pill stays, since the
    // pills outlast the bar on purpose. With no film the ring is on the way
    // in, which stays too.
    //
    // The place is kept for the next Tab, because reading along the bar one
    // tip at a time is slow enough for the idle clock to run out partway.
    changed controls-visible => {
        if (!root.controls-visible && root.has-file && root.bar-focus < root.pill-stop) {
            root.bar-resume = Chrome.focus-visible;
            Chrome.focus-visible = false;
        }
    }

    /// Whether the pause is one a frame step made. Stepping is looking at
    /// the picture, which the bar would cover the foot of, not at where you
    /// are, so the bar isn't held for it.
    property <bool> stepped: false;

    /// A step sent and not yet landed. mpv steps from a pause by playing a
    /// frame and pausing again, and that moment of play is no one resuming.
    property <bool> step-landing: false;

    // Given up on after a while, since a step that never shows as play
    // would otherwise outlast it and keep a later resume from counting.
    Timer {
        interval: 500ms;
        running: root.step-landing;
        triggered => {
            root.step-landing = false;
        }
    }

    changed paused => {
        if (root.paused) {
            root.step-landing = false;
        } else if (!root.step-landing) {
            root.stepped = false;
        }
    }

    /// Whether the timeline is up on its own, after a seek from the keyboard:
    /// the one thing a seek changes, without the buttons.
    property <bool> timeline-glimpse: false;

    glimpse-timer := Timer {
        interval: Chrome.hide-after;
        running: false;
        triggered => {
            glimpse-timer.stop();
            root.timeline-glimpse = false;
        }
    }

    /// Whether what is loaded is up on its own, the bar's title group without
    /// the rest: as a file starts, since its name is the one thing worth
    /// seeing then, and while an open is in flight, since "Opening …" there
    /// is the only sign a slow scan hasn't been ignored.
    property <bool> title-glimpse: Playlist.opening || root.title-lingering;

    /// A file's three seconds of that, as it starts; an open's last as long
    /// as the open.
    property <bool> title-lingering: false;

    title-timer := Timer {
        interval: Chrome.hide-after;
        running: false;
        triggered => {
            title-timer.stop();
            root.title-lingering = false;
        }
    }

    // Ends `Chrome.settling`: long enough for a window going in or out of
    // fullscreen to reach its new size, short enough that a hand reaching
    // for the mouse straight after finds the chrome.
    Timer {
        interval: 500ms;
        running: Chrome.settling;
        triggered => {
            Chrome.settling = false;
        }
    }

    /// The seek is newer news than the file's name, so it takes the title's
    /// place.
    function glimpse-timeline() {
        root.key-wake = KeyWake.keep;
        root.timeline-glimpse = true;
        glimpse-timer.stop();
        glimpse-timer.start();
        root.title-lingering = false;
        title-timer.stop();
    }

    function glimpse-title() {
        root.title-lingering = true;
        title-timer.stop();
        title-timer.start();
    }

    /// Put the chrome away for a key or a double-click that asked for the
    /// picture, glimpses and all.
    function put-away() {
        Chrome.rest();
        root.timeline-glimpse = false;
        glimpse-timer.stop();
        root.title-lingering = false;
        title-timer.stop();
    }

    /// Whether the pointer should be off screen: over a film with the chrome
    /// gone, but never on an empty window, where it is how the way in is
    /// reached.
    ///
    /// Decided here and carried out by `cursor` on the Rust side, which says
    /// why a `mouse-cursor` binding can't do it. `out` so a test can read the
    /// decision.
    out property <bool> pointer-hidden: root.has-file && !root.controls-visible;

    changed pointer-hidden => {
        Chrome.hide-pointer(root.pointer-hidden);
    }

    // The bar's geometry, for the tests and the Rust side.
    out property <length> timeline-y: bar.timeline-y;
    out property <length> scrub-x: bar.scrub-x;
    out property <length> scrub-w: bar.scrub-w;
    out property <length> vol-cx: bar.vol-cx;
    out property <length> vol-cy: bar.vol-cy;
    out property <length> subs-anchor: bar.subs-anchor;
    out property <length> playlist-anchor: bar.playlist-anchor;

    // --- subtitles above the bar -------------------------------------------------
    /// The highest a subtitle may rest while the bar is up, as a fraction of
    /// the window's height from the top: the bar's top. The Rust side holds
    /// a line resting lower up to it, keeping mpv's bottom margin above it,
    /// so the bar arriving reads as the floor rising (see `subline`).
    out property <float> subtitle-floor: bar.edge / root.height;

    /// How much of that applies this frame, faded with the bar so the line
    /// climbs and settles rather than leaping.
    ///
    /// Not while Position is being set: held up by the bar, the line wouldn't
    /// visibly move for small steps, so it drops to where it rests until
    /// Size or Timing is used or the page is left.
    out property <float> subtitle-lift: (root.controls-visible || root.timeline-glimpse
        || root.title-glimpse) && root.has-file && !menu.placing-shown ? 1.0 : 0.0;

    animate subtitle-lift {
        duration: Motion.surface;
        easing: ease-out;
    }

    // --- resizing ----------------------------------------------------------------
    /// Whether the window is being resized: from its size first changing
    /// until it has kept still for a moment, and from startup until it first
    /// settles.
    ///
    /// While it is, the panels' eased page heights jump, or they would trail
    /// the window's edge for the whole drag. A binding on the size rather
    /// than a flag set by a handler, because the handler runs a frame late,
    /// and that frame would ease.
    property <bool> resizing: root.width != root.settled-width
        || root.height != root.settled-height;

    /// How far the settings panel is from its target height, for the test
    /// that drags the window's size and expects it to be zero.
    out property <length> resize-lag: root.settings-open ? settings.lag : 0px;

    /// The window's size once it last kept still.
    property <length> settled-width: -1px;
    property <length> settled-height: -1px;

    /// Called from the window's size handlers, further down beside the tip's,
    /// since a property can only have one.
    function window-resized() {
        resize-settle.stop();
        resize-settle.start();
    }

    resize-settle := Timer {
        interval: 200ms;
        running: true;
        triggered => {
            resize-settle.stop();
            root.settled-width = root.width;
            root.settled-height = root.height;
        }
    }

    // A resize moves every control out from under the tip, so it goes at once
    // rather than fading in the wrong place.
    changed width => {
        tip.cut();
        root.window-resized();
    }

    changed height => {
        tip.cut();
        root.window-resized();
    }

    // --- keyboard reach ----------------------------------------------------------
    //
    // Every panel can be driven from the keyboard, because a player that
    // hides its chrome after three seconds shouldn't need a mouse to change
    // the subtitle track.
    //
    // One integer rather than a focus scope per row. The panels are already
    // arithmetic, and an index can skip what a traversal order can't:
    // headings, the empty row and the shortcuts reference, where a ring would
    // be a dead step to press through.
    //
    // The arrow keys already seek and set the volume, so a panel claims them
    // only while the row under the ring can use them: left and right adjust
    // a focused slider or stepper, and otherwise still seek.
    /// Which row the keyboard is on inside whatever is open. `out` for the
    /// tests, since the ring is only a wash and gives them nothing to read.
    out property <int> focus-row: 0;

    /// How many rows what is on screen offers the keyboard. Zero, as when a
    /// film plays with nothing open, means the keys ignore the ring.
    property <int> focus-count:
        root.menu-open ? menu.rows
        : root.audio-open ? Tracks.audio.length
        : root.playlist-open ? playlist-panel.rows
        : root.files-open ? files-panel.rows
        : root.settings-open ? settings.rows
        : !root.has-file ? way-in.rows
        : 0;

    // Taking out a panel's last track, or the switch under Tooltips, would
    // leave the ring on no row, with Enter pressing nothing and its pane where
    // the row was. It goes to the row that is last now.
    changed focus-count => {
        if (((root.menu-open && !root.find-open) || root.audio-open || root.settings-open)
                && root.focus-count > 0 && root.focus-row >= root.focus-count) {
            root.focus-row = root.focus-count - 1;
        }
    }

    /// Whether the first Enter presses Continue on an empty window. Elsewhere
    /// the first Enter only shows the ring, since nobody chose the row it
    /// would press, but Continue is what the window was opened to get back to.
    property <bool> continue-sure: !root.has-file && root.fatal == ""
        && !root.panel-open && root.has-resume && root.focus-row == 0;

    /// A page whose last row is its reset. The ring stops at the ends of
    /// these rather than wrapping, so Up from the top can't land on the row
    /// that throws a page of tuning away.
    property <bool> focus-has-reset: root.settings-open
        ? settings.ends-in-reset
        : root.menu-open && menu.ends-in-reset;

    /// Scroll whichever list the ring is in to keep its row in view.
    function focus-scroll() {
        if (root.menu-open) {
            menu.reveal();
        } else if (root.audio-open) {
            audio-panel.reveal();
        } else if (root.playlist-open) {
            playlist-panel.reveal();
        } else if (root.settings-open) {
            settings.reveal();
        }
    }

    changed focus-row => {
        root.focus-scroll();
    }

    /// Turn the ring on at a row and bring that row into view. The scroll is
    /// explicit because the ring often comes up on the row it was already on,
    /// which the wheel may have moved off screen since.
    function focus-show(row: int) {
        Chrome.focus-visible = true;
        root.focus-row = row;
        root.focus-scroll();
    }

    // Key dispatch is split across several small functions, because Slint's
    // compiler recurses once per nested statement, and one handler with every
    // binding overflowed the build script's stack in debug builds.

    /// Move the ring, wrapping at both ends, because these lists are short
    /// and the useful rows are at the ends: `Off` at the top of the subtitles,
    /// the last episode at the bottom. A page ending in its reset doesn't
    /// wrap (see `focus-has-reset`).
    function focus-move(delta: int) {
        if (root.focus-count <= 0) {
            return;
        }
        if (root.focus-has-reset) {
            root.focus-row = clamp(root.focus-row + delta, 0, root.focus-count - 1);
            return;
        }
        root.focus-row = root.focus-row + delta;
        if (root.focus-row < 0) {
            root.focus-row = root.focus-count - 1;
        }
        if (root.focus-row >= root.focus-count) {
            root.focus-row = 0;
        }
    }

    /// Press the row under the ring. Settings is split out below, since its
    /// pages nest deeply enough on their own for the compiler.
    function focus-activate() -> bool {
        // The ring can outlive its row, since opening a file replaces the
        // playlist and the tracks. It is then on no row, so this press only
        // shows where it is now, rather than pressing a row nobody chose.
        if (root.focus-row >= root.focus-count) {
            if (root.focus-count > 0) {
                root.focus-show(0);
                return true;
            }
            root.focus-row = 0;
        }
        if (root.menu-open) {
            menu.activate();
            return true;
        }
        if (root.audio-open) {
            audio-panel.activate();
            return true;
        }
        if (root.playlist-open) {
            playlist-panel.activate();
            return true;
        }
        if (root.files-open) {
            files-panel.activate(root.focus-row);
            return true;
        }
        if (root.settings-open) {
            return settings.activate();
        }
        if (!root.has-file) {
            way-in.activate(root.focus-row);
            return true;
        }
        return false;
    }

    /// Left and right, only where the row under the ring is something they
    /// can move. Elsewhere this returns false, and `focus-sideways` decides.
    function focus-adjust(delta: int) -> bool {
        if (root.menu-open) {
            return menu.adjust(delta);
        }
        if (root.settings-open) {
            return settings.adjust(delta);
        }
        return false;
    }

    /// Tried before every other key, and answers only for keys the row under
    /// the ring can use, so Space still pauses with the playlist open.
    function on-focus(text: string, shift: bool, ctrl: bool) -> bool {
        if (root.focus-count <= 0) {
            return false;
        }
        // The shortcuts page is read, not walked, so the arrows scroll its
        // list (see `SettingsPanel.read`).
        if (root.settings-open) {
            if (settings.read(text)) {
                return true;
            }
        }
        // A key that brings the ring up does only that, since the row it is
        // on was chosen by nobody. The arrows are the exception, because where
        // they land isn't in doubt: Down starts at the top and Up at the bottom.
        if (text == Key.DownArrow) {
            if (!Chrome.focus-visible) {
                root.focus-show(0);
                return true;
            }
            root.focus-move(1);
            return true;
        }
        if (text == Key.UpArrow) {
            if (!Chrome.focus-visible) {
                // The bottom, but not a reset, which one more Enter would arm.
                root.focus-show(root.focus-count - 1
                    - (root.focus-has-reset ? 1 : 0));
                return true;
            }
            root.focus-move(-1);
            return true;
        }
        if (text == Key.Tab) {
            if (!Chrome.focus-visible) {
                root.focus-show(root.focus-row);
                return true;
            }
            root.focus-move(shift ? -1 : 1);
            return true;
        }
        if (text == Key.Return) {
            if (!Chrome.focus-visible && !root.continue-sure) {
                root.focus-show(root.focus-row);
                return true;
            }
            return root.focus-activate();
        }
        if (root.focus-jump(text)) {
            return true;
        }
        if (text == Key.LeftArrow || text == Key.RightArrow) {
            return root.focus-sideways(text == Key.RightArrow ? 1 : -1, shift || ctrl);
        }
        return false;
    }

    /// Left and right move the row the ring is on, where it is one they move.
    /// Otherwise, in a panel, they go the way its rows do: right opens the
    /// row the ring is on if it leads somewhere, left goes back a page if
    /// there is one, and anything else does nothing, since the film jumping
    /// behind a menu is a key pressed in the wrong place. Held with Shift or
    /// Ctrl they are the film's again, as they are with no panel open.
    function focus-sideways(delta: int, held: bool) -> bool {
        if (Chrome.focus-visible && root.focus-adjust(delta)) {
            return true;
        }
        if (!root.panel-open || held) {
            return false;
        }
        if (delta < 0) {
            root.page-back();
        } else if (Chrome.focus-visible) {
            root.focus-enter();
        }
        return true;
    }

    /// Back a page in the open panel, where it has one to go back to, and say
    /// whether it did. Escape's first step, and Left's.
    function page-back() -> bool {
        if (root.settings-open && settings.go-back()) {
            return true;
        }
        if (root.playlist-open && playlist-panel.go-back()) {
            return true;
        }
        if (root.menu-open && menu.go-back()) {
            return true;
        }
        return false;
    }

    /// Right on a row with a chevron: a settings page, a season, a page of the
    /// subtitles menu. Enter does the same; a row that plays or picks
    /// something is left to Enter alone.
    function focus-enter() {
        if (root.settings-open) {
            settings.enter-ringed();
        } else if (root.playlist-open) {
            playlist-panel.enter-ringed();
        } else if (root.menu-open) {
            menu.enter-ringed();
        }
    }

    /// Home and End, Page Up and Page Down, in the two lists that can run to
    /// hundreds of rows. Taken here so they don't restart the film or change
    /// chapter with the list open. They bring the ring up where they land and
    /// stop at the ends rather than wrapping, since nobody aims a jump at the
    /// other end.
    function focus-jump(text: string) -> bool {
        if (!root.menu-open && !root.audio-open && !root.playlist-open) {
            return false;
        }
        if (text == Key.Home) {
            root.focus-show(root.list-first);
            return true;
        }
        if (text == Key.End) {
            root.focus-show(root.list-last);
            return true;
        }
        if (text == Key.PageUp || text == Key.PageDown) {
            root.focus-show(clamp(
                root.focus-row + (text == Key.PageDown ? root.list-page : -root.list-page),
                root.list-first, root.list-last));
            return true;
        }
        return false;
    }

    property <int> list-first: root.playlist-open ? playlist-panel.lead
        : root.menu-open ? menu.list-first : 0;

    property <int> list-last: root.playlist-open ? playlist-panel.rows - 1
        : root.menu-open && menu.list-last >= 0 ? menu.list-last
        : root.focus-count - 1;

    /// A page is what the list shows less one row, so the row a jump left
    /// stays on screen to read against.
    property <int> list-page: max(1, Math.floor((root.playlist-open
        ? root.playlist-list-h
        : root.audio-open ? root.audio-list-h
        : menu.list-h) / Rows.row) - 1);

    // --- the bar, from the keyboard ----------------------------------------------
    //
    // Tab walks the bar's buttons while nothing is open and a film is loaded,
    // and Enter presses the one the ring is on. No other key changes meaning:
    // the arrows still seek and set the volume, and Space still pauses.
    //
    // Its own index rather than `focus-row`, which a panel resets as it
    // opens, so the ring comes back to the button that opened the panel.
    out property <int> bar-focus: 0;

    /// The ring was on the bar when the idle clock took the bar away, so the
    /// next Tab resumes at `bar-focus` rather than starting over.
    property <bool> bar-resume: false;

    /// The first stop after the bar's thirteen buttons: the centre pill's
    /// first choice, or the credits pill.
    property <int> pill-stop: 13;

    /// The bar's buttons, then the centre pill's choices while it is up, or
    /// the credits pill. The two are never up together.
    property <int> bar-count: root.pill-stop
        + (root.centre-up ? (end-pill.two ? 2 : 1)
            : root.corner-offered ? 1 : 0);

    property <bool> bar-reach: root.has-file && !root.panel-open && root.fatal == "";

    function on-bar(text: string, shift: bool) -> bool {
        if (!root.bar-reach) {
            return false;
        }
        if (text == Key.Tab || text == Key.Backtab) {
            if (!Chrome.focus-visible) {
                if (!(root.bar-resume && root.bar-focus < root.bar-count
                        && root.bar-enabled(root.bar-focus))) {
                    root.bar-focus = shift || text == Key.Backtab ? root.bar-count - 1 : 0;
                }
                root.bar-resume = false;
                Chrome.focus-visible = true;
                return true;
            }
            root.bar-step(shift || text == Key.Backtab ? -1 : 1);
            return true;
        }
        if (!Chrome.focus-visible) {
            return false;
        }
        if (text == Key.Return) {
            // Every choice on a pill is the way back to the film.
            if (root.bar-focus >= root.pill-stop) {
                root.key-wake = KeyWake.hide;
            }
            root.bar-activate(root.bar-focus);
            return true;
        }
        if (text == Key.Escape) {
            // Only puts the ring away, so an Escape meant to clear it doesn't
            // also leave fullscreen. The next press does that. Done with the
            // bar, so the bar goes with it.
            Chrome.focus-visible = false;
            root.key-wake = KeyWake.hide;
            return true;
        }
        return false;
    }

    /// Along the bar, skipping a disabled button, where Enter would do
    /// nothing.
    ///
    /// Slint functions have no loops, so the skip is written out. One skip is
    /// enough because the two buttons that can be disabled aren't adjacent; a
    /// disabled button next to one of them would need another.
    function bar-step(delta: int) {
        root.bar-focus = root.bar-wrap(root.bar-focus + delta);
        if (!root.bar-enabled(root.bar-focus)) {
            root.bar-focus = root.bar-wrap(root.bar-focus + delta);
        }
        if (!root.bar-enabled(root.bar-focus)) {
            root.bar-focus = root.bar-wrap(root.bar-focus + delta);
        }
    }

    pure function bar-wrap(index: int) -> int {
        return index < 0 ? root.bar-count - 1 : index >= root.bar-count ? 0 : index;
    }

    /// Previous and Next, at 3 and 5, are the only buttons that can be
    /// disabled.
    pure function bar-enabled(index: int) -> bool {
        return !(index == 3 && Playback.at-first) && !(index == 5 && Playback.at-last);
    }

    /// Left to right: playlist, open; back, previous, play, next, forward;
    /// mute, audio, subtitles, settings, panscan, fullscreen. The volume track
    /// isn't a stop, since Up and Down already set it. Split in two for the
    /// compiler, as the key handlers are.
    function bar-activate(index: int) {
        if (index >= root.pill-stop) {
            if (root.centre-up) {
                end-pill.activate(index - root.pill-stop);
            } else {
                corner.activate();
            }
        } else if (index < 7) {
            root.bar-activate-left(index);
        } else {
            root.bar-activate-right(index);
        }
    }

    function bar-activate-left(index: int) {
        if (index == 0) {
            root.open-playlist(true);
            root.focus-show(root.focus-row);
        } else if (index == 1) {
            root.open-files(true);
            root.focus-show(0);
        } else if (index == 2) {
            Playback.seek-relative(-Playback.seek-step);
        } else if (index == 3) {
            if (!Playback.at-first) {
                Playlist.step(-1);
            }
        } else if (index == 4) {
            if (root.at-end) {
                Playback.replay();
            } else {
                Playback.toggle-pause();
            }
        } else if (index == 5) {
            if (!Playback.at-last) {
                Playlist.step(1);
            }
        } else {
            Playback.seek-relative(Playback.seek-step);
        }
    }

    function bar-activate-right(index: int) {
        if (index == 7) {
            Playback.toggle-mute();
        } else if (index == 8) {
            root.open-audio(true);
            root.focus-show(root.focus-row);
        } else if (index == 9) {
            root.open-menu(true);
            root.focus-show(root.focus-row);
        } else if (index == 10) {
            root.open-settings(true);
            root.focus-show(0);
        } else if (index == 11) {
            Playback.toggle-panscan();
        } else {
            root.toggle-fullscreen();
        }
    }

    /// The end pill is up: at the end of a file, or at the start of one held
    /// on its saved place. Never both, so it is one surface, one glass and
    /// one stop. Mirrored so its changes are acted on here.
    property <bool> centre-up: end-pill.up;

    /// The corner pill offers something (see `CornerPill`), mirrored the same
    /// way.
    property <bool> corner-offered: corner.offered;

    // The credits or the title sequence starting brings up their pill alone,
    // not the bar: the pill is the one thing on offer, and the bar would only
    // cover the names. Doing nothing is watching them. The ring goes to the
    // pill so Enter skips them, and leaves with the pill, or Enter would skip
    // the episode that just started.
    changed corner-offered => {
        if (root.corner-offered) {
            root.ring-to-pill();
        } else if (!root.centre-up) {
            // At the end the end pill takes the same stop, and its first
            // choice is the same way on, so the ring stays for it.
            root.ring-off-pill();
        }
    }

    /// What the corner pill says, for the tests.
    out property <string> credits-label: corner.label;

    /// A pill came up while a panel was open, so the ring is owed to it once
    /// the panel closes.
    property <bool> pill-owed: false;

    /// Put the ring on the pill that just came up. An open panel keeps the
    /// ring, which is on one of its rows, and the pill gets it when the panel
    /// closes instead.
    function ring-to-pill() {
        if (root.panel-open) {
            root.pill-owed = true;
        } else if (root.bar-reach) {
            root.bar-focus = root.pill-stop;
            Chrome.focus-visible = true;
        }
    }

    /// The ring goes with the pill it was on, or Enter would press a choice
    /// that is no longer there. Over a panel the ring is the panel's, and
    /// stays.
    function ring-off-pill() {
        if (root.bar-focus >= root.pill-stop) {
            if (!root.panel-open) {
                Chrome.focus-visible = false;
            }
            root.bar-focus = 0;
        }
    }

    // --- what the keys do --------------------------------------------------------
    //
    // What each key does to the film and the window, tried in order by the
    // key handler at the bottom (see `keys`), after the bar and the ring have
    // had their say.
    /// What the key being handled does to the chrome.
    property <KeyWake> key-wake: KeyWake.wake;

    /// Shift and the rest pressed alone, which arrive as keys of their own
    /// ahead of the key they modify, and would wake the bar before a Shift+→
    /// could decide it shouldn't.
    function lone-modifier(text: string) -> bool {
        return text == Key.Shift || text == Key.ShiftR || text == Key.Control
            || text == Key.ControlR || text == Key.Alt || text == Key.AltGr
            || text == Key.Meta || text == Key.MetaR;
    }

    function after-key(text: string) {
        if (root.key-wake == KeyWake.hide) {
            root.put-away();
        } else if ((root.key-wake == KeyWake.wake && !root.lone-modifier(text)) || !Chrome.idle) {
            Chrome.bump();
        }
    }

    // The keys follow YouTube's first, since nearly everyone has them in
    // their hands already, and Netflix's where YouTube has none; the player's
    // own fill the gaps neither has a key for.
    // Shift is read from the modifier, not from the letter's case, which
    // Caps Lock turns over.
    function on-playback(text: string, shift: bool) -> bool {
        if (text == " " || text == "k" || text == "K") {
            // Playing, every way, is the film going on, which the chrome
            // would only cover; pausing is looking for where you are.
            root.key-wake = root.paused || root.at-end ? KeyWake.hide : KeyWake.wake;
            // As the play button: at the end of a file there is nothing to
            // unpause, and on a saved place, playing goes on from it.
            if (root.arriving) {
                Playback.arrival-answer(false);
            } else if (root.at-end) {
                Playback.replay();
            } else {
                Playback.toggle-pause();
            }
            return true;
        }
        // Not with a panel open, where Home belongs to the list (`focus-jump`
        // or `on-read`), and a page with no use for it should do nothing
        // rather than restart the film.
        if (text == Key.Home && !root.panel-open && root.arriving) {
            Playback.arrival-answer(true);
            root.key-wake = KeyWake.hide;
            return true;
        }
        if (text == Key.Home && !root.panel-open) {
            Playback.restart();
            Flash.show(Flash.restart, 0.5);
            root.glimpse-timeline();
            return true;
        }
        // A tenth of the way per digit, 0 the start. Not with a panel open,
        // whose rows are what the keyboard is in.
        if (!root.panel-open && text.character-count == 1 && text.is-float()) {
            Playback.jump-to(text.to-float() / 10);
            root.glimpse-timeline();
            return true;
        }
        // Shift+N and Shift+P, through the playlist. At either end mpv does
        // nothing, so neither does the flash.
        if (shift && (text == "n" || text == "N" || text == "p" || text == "P")) {
            root.key-wake = KeyWake.keep;
            if ((text == "n" || text == "N") && !Playback.at-last) {
                Playlist.step(1);
                Flash.show(Flash.next, 0.5);
            } else if ((text == "p" || text == "P") && !Playback.at-first) {
                Playlist.step(-1);
                Flash.show(Flash.previous, 0.5);
            }
            return true;
        }
        return false;
    }

    // A seek shows the timeline alone, which is where the change is; the
    // buttons beside it would only cover more of the picture.
    function on-seek(text: string, ctrl: bool, shift: bool) -> bool {
        if ((text == Key.LeftArrow || text == Key.RightArrow) && ctrl) {
            return root.chapter-key(text == Key.RightArrow ? 1 : -1);
        }
        if (text == Key.LeftArrow || text == "j" || text == "J") {
            if (shift && text == Key.LeftArrow) {
                // The small seek, for a missed line. No flash, since its glyph
                // means ten seconds and the timeline shows the change.
                Playback.seek-relative(-Playback.fine-seek-step);
                root.glimpse-timeline();
            } else {
                Playback.seek-relative(-Playback.seek-step);
                Flash.show(Flash.seek-back, 0.2);
                root.glimpse-timeline();
            }
            return true;
        }
        if (text == Key.RightArrow || text == "l" || text == "L") {
            if (root.at-end) {
                // From the end, forward is the end pill's first offer: the
                // next file or season. Never the folder dialog, since an arrow
                // held a moment too long is not deliberate enough for one.
                root.key-wake = KeyWake.hide;
                if (!Playback.at-last) {
                    Playback.play-next();
                } else if (Playback.onward-path != "") {
                    Playlist.open-onward();
                }
            } else if (shift && text == Key.RightArrow) {
                Playback.seek-relative(Playback.fine-seek-step);
                root.glimpse-timeline();
            } else {
                Playback.seek-relative(Playback.seek-step);
                Flash.show(Flash.seek-forward, 0.8);
                root.glimpse-timeline();
            }
            return true;
        }
        return false;
    }

    // Every key here answers with its flash rather than the bar.
    function on-volume(text: string) -> bool {
        if (text == Key.UpArrow || text == Key.DownArrow) {
            Playback.nudge-volume(text == Key.UpArrow ? Playback.volume-step : -Playback.volume-step);
            root.key-wake = KeyWake.keep;
            Flash.show-figure(Figure.volume);
            return true;
        }
        if (text == "m" || text == "M") {
            Playback.toggle-mute();
            root.key-wake = KeyWake.keep;
            Flash.show-figure(Figure.volume);
            return true;
        }
        // mpv's own key for it.
        if (text == "#") {
            Tracks.cycle(false, 1);
            root.key-wake = KeyWake.keep;
            Flash.show-figure(Figure.audio-track);
            return true;
        }
        return false;
    }

    // Z pulls the subtitles earlier and Shift+Z pushes them later, mpv's own
    // convention.
    function on-subtitles(text: string, shift: bool) -> bool {
        if (!shift && (text == "c" || text == "C")) {
            Subtitles.toggle();
            // Shown, because a scene with no dialogue shows nothing, and the
            // button's mark is under the bar while the bar is away. The same
            // caption as Shift+C, read live.
            root.key-wake = KeyWake.keep;
            Flash.show-figure(Figure.subtitle-track);
            return true;
        }
        // Through the subtitle tracks, including none, saying which one it
        // landed on: C's own subject, one shift away.
        if (shift && (text == "c" || text == "C")) {
            Tracks.cycle(true, 1);
            root.key-wake = KeyWake.keep;
            Flash.show-figure(Figure.subtitle-track);
            return true;
        }
        // YouTube's for the captions' size. = as well as +, which on most
        // keyboards is the same key unshifted. The line itself answers.
        if (text == "+" || text == "=" || text == "-") {
            menu.step-sub-scale(text == "-" ? -1 : 1);
            root.key-wake = KeyWake.keep;
            return true;
        }
        if (text == "z" || text == "Z") {
            Subtitles.nudge-delay(shift ? Subtitles.delay-step : -Subtitles.delay-step);
            root.key-wake = KeyWake.keep;
            Flash.show(Flash.delay, 0.5);
            return true;
        }
        return false;
    }

    /// Whether a key may still act on the player: not on the fatal pane,
    /// where nothing can play, and a file loaded by Ctrl+O would replace the
    /// error with a bar over a black window. Fullscreen and Escape stay, as
    /// the ways out of a window.
    property <bool> keys-act: root.fatal == "";

    // Ctrl+O for a file, Ctrl+Shift+O for a folder.
    function on-open(text: string, ctrl: bool, shift: bool) -> bool {
        // Ctrl+letter arrives as the letter on some platforms and as the
        // control character (U+000F for Ctrl+O) on others.
        if (root.keys-act && ctrl && (text == "o" || text == "O" || text == "\u{000F}")) {
            Playlist.request-open(shift);
            return true;
        }
        return false;
    }

    function on-window(text: string, shift: bool) -> bool {
        // In or out, what was asked for is the picture at a new size, not
        // the bar over it, so the chrome goes.
        if (text == "f" || text == "F" || text == Key.F11) {
            root.toggle-fullscreen();
            root.key-wake = KeyWake.hide;
            Chrome.settling = true;
            return true;
        }
        // The picture answers, as it does a frame step.
        if (root.has-file && (text == "t" || text == "T")) {
            Playback.toggle-panscan();
            root.key-wake = KeyWake.keep;
            return true;
        }
        // Straight to the shortcuts page, the player's one reference. Pressed
        // again there, it closes the panel, as S does.
        if (root.keys-act && text == "?") {
            if (root.settings-open && root.settings-page == SettingsPage.shortcuts) {
                root.open-settings(false);
                root.key-wake = KeyWake.hide;
            } else {
                root.open-settings-page(SettingsPage.shortcuts);
                root.focus-show(0);
            }
            return true;
        }
        // Always the settings, even while the corner pill offers a skip, which
        // Enter takes: a key that sometimes skips the credits and sometimes
        // opens a panel can't be pressed without looking first. The ring comes
        // up only when this opens the panel, not when it closes it.
        if (root.keys-act && (text == "s" || text == "S")) {
            root.open-settings(!root.settings-open);
            if (root.settings-open) {
                root.focus-show(0);
            } else {
                root.key-wake = KeyWake.hide;
            }
            return true;
        }
        // A for the audio, V for the subtitles beside C, which turns them on
        // and off, and P for the playlist. None with no film, since they
        // describe one and would hang from a bar that isn't there.
        if (root.keys-act && root.has-file && (text == "a" || text == "A")) {
            root.open-audio(!root.audio-open);
            if (root.audio-open) {
                root.focus-show(root.focus-row);
            } else {
                root.key-wake = KeyWake.hide;
            }
            return true;
        }
        if (root.keys-act && root.has-file && (text == "v" || text == "V")) {
            root.open-menu(!root.menu-open);
            if (root.menu-open) {
                root.focus-show(root.focus-row);
            } else {
                root.key-wake = KeyWake.hide;
            }
            return true;
        }
        if (root.keys-act && root.has-file && !shift && (text == "p" || text == "P")) {
            root.open-playlist(!root.playlist-open);
            if (root.playlist-open) {
                root.focus-show(root.focus-row);
            } else {
                root.key-wake = KeyWake.hide;
            }
            return true;
        }
        if (root.keys-act && (text == "b" || text == "B")) {
            // Kept on a key as well as on its settings page, as the one effect
            // worth toggling mid-film. The picture's border answers it.
            Settings.ambience-on = !Settings.ambience-on;
            Settings.set-ambience(Settings.ambience-on);
            root.key-wake = KeyWake.keep;
            return true;
        }
        if (text == Key.Delete && (root.menu-open || root.audio-open)
                && Chrome.focus-visible) {
            return root.remove-focused-track();
        }
        // One Escape dismisses one thing, innermost first: a page within a
        // panel (see `page-back`), then the panel, then fullscreen. Closing a
        // panel is back to the film, and the chrome goes with it.
        if (text == Key.Escape) {
            if (root.page-back()) {
                return true;
            }
            root.key-wake = KeyWake.hide;
            if (root.panel-open) {
                root.close-panel();
            } else {
                // Out of fullscreen as into it, and with nothing to leave,
                // nothing to bring up.
                if (root.fullscreen) {
                    Chrome.settling = true;
                } else {
                    root.key-wake = KeyWake.keep;
                }
                root.leave-fullscreen();
            }
            return true;
        }
        return false;
    }

    // --- pace --------------------------------------------------------------------
    //
    // What the bar has no control for: speed, single frames, chapters. Speed
    // and chapters answer with their figure, and frames with the picture
    // itself.
    function on-pace(text: string) -> bool {
        if (text == "<" || text == ">") {
            Playback.step-speed(Playback.speed, text == ">" ? 1 : -1);
            root.key-wake = KeyWake.keep;
            Flash.show-figure(Figure.speed);
            return true;
        }
        if (text == Key.Backspace) {
            Playback.reset-speed();
            root.key-wake = KeyWake.keep;
            Flash.show-figure(Figure.speed);
            return true;
        }
        if (text == "," || text == ".") {
            Playback.frame-step(text == "." ? 1 : -1);
            root.stepped = true;
            root.step-landing = true;
            root.key-wake = KeyWake.keep;
            return true;
        }
        // Only with no panel open, for the reason Home gives above.
        if ((text == Key.PageUp || text == Key.PageDown) && !root.panel-open) {
            return root.chapter-key(text == Key.PageDown ? 1 : -1);
        }
        return false;
    }

    /// A chapter on or back, from PgUp and PgDn or from Ctrl and the arrows.
    function chapter-key(direction: int) -> bool {
        root.key-wake = KeyWake.keep;
        // No flash for a file with no chapters to go to.
        if (Playback.chapter-marks.length > 0) {
            Playback.chapter-step(direction);
            Flash.show-figure(Figure.chapter);
        }
        return true;
    }

    // --- glass and soft edges ----------------------------------------------------
    //
    // What the render pipeline draws under the scene: each surface's glass,
    // in the order it is laid, and each list's soft ends.
    /// A list's `fade`, clipped to its panel and faded with it, including the
    /// angle back to its current row. Zero-sized for a panel that is gone,
    /// and for one going while another opens: the edge is drawn over
    /// whatever ends up under it, and the panel arriving in the same corner
    /// would have the top of its first row softened away (`DBM_SHOWCASE=
    /// open-switch`).
    pure function fade-within(list: ScrollFade, open: bool, shown: float,
        x: length, y: length, w: length, h: length) -> ScrollFade {
        return {
            x: list.x,
            y: list.y,
            width: root.edge-shown(open, shown) > Surfaces.gone ? list.width : 0px,
            height: root.edge-shown(open, shown) > Surfaces.gone ? list.height : 0px,
            top: list.top,
            bottom: list.bottom,
            right: 0,
            clip-x: x,
            clip-y: y,
            clip-width: w,
            clip-height: h,
            way: root.edge-shown(open, shown) > Surfaces.gone ? list.way * shown : 0,
            way-x: list.way-x,
            way-y: list.way-y,
            way-up: list.way-up,
            way-lit: list.way-lit,
        };
    }

    /// How much of a panel's soft edges is drawn: as much as the panel is
    /// shown, unless another panel is open (see `fade-within`).
    pure function edge-shown(open: bool, shown: float) -> float {
        return open || !root.panel-open ? shown : 0;
    }

    /// Every scrolling list, for the soft edge on its ends (see `ScrollFade`).
    out property <[ScrollFade]> scroll-fades: [
        // Each of the menu's lists only while its page is drawn: the search's
        // rests where the other pages do, and would soften their rows.
        root.fade-within(menu.tracks-fade, root.menu-open, menu.tracks-shown,
            menu.x, menu.y, menu.width, menu.height),
        root.fade-within(audio-panel.fade, root.audio-open, audio-panel.shown,
            audio-panel.x, audio-panel.y, audio-panel.width, audio-panel.height),
        root.fade-within(menu.find-fade, root.menu-open, menu.find-shown,
            menu.x, menu.y, menu.width, menu.height),
        root.fade-within(playlist-panel.parts-fade, root.playlist-open, playlist-panel.shown,
            playlist-panel.x, playlist-panel.y,
            playlist-panel.width, playlist-panel.height),
        root.fade-within(playlist-panel.leaf-fade, root.playlist-open, playlist-panel.shown,
            playlist-panel.x, playlist-panel.y,
            playlist-panel.width, playlist-panel.height),
        root.fade-within(settings.front-fade, root.settings-open, settings.front-shown,
            settings.x, settings.y, settings.width, settings.height),
        root.fade-within(settings.leaf-fade, root.settings-open, settings.leaf-shown,
            settings.x, settings.y, settings.width, settings.height),
        bar.title-fade,
    ];

    /// Where the pipeline draws glass. A closed surface publishes a zero-sized
    /// rect, which the Rust side drops, so this stays a plain literal rather
    /// than an array built conditionally.
    out property <[GlassRect]> glass-rects: [
        bar.glass,
        window-buttons.glass,
        bar.ring-disc-glass,
        bar.open-disc-glass,
        flash.ring-glass,
        flash.words-glass,
        // The hover label. Glass like everything else that carries words.
        tip.glass,
        way-in.glass,
        end-pill.glass,
        corner.glass,
        preview.glass,
        menu.glass,
        audio-panel.glass,
        files-panel.glass,
        playlist-panel.glass,
        settings.glass,
        // The pane under the ring on a row or a pill's choice (see `Ring`).
        // Last, since it lies on whichever surface it is in.
        {
            x: Ring.x,
            y: Ring.y,
            width: root.ring-pane-on > Surfaces.gone ? Ring.width : 0,
            height: root.ring-pane-on > Surfaces.gone ? Ring.height : 0,
            opacity: root.ring-pane-on,
            radius: Ring.radius,
            tint: 1.0,
            nested: true,
            ring: true,
            host-y: root.ring-host-y,
            host-height: root.ring-host-h,
        },
    ];

    /// How far the pane under the ring is on: with the ring held, and with
    /// the surface it is in, so it arrives with a panel opened from a key
    /// rather than ahead of it.
    property <float> ring-pane-on: root.ring-held * root.ring-host-shown;
    property <float> ring-held: Ring.held && Chrome.focus-visible ? 1 : 0;
    animate ring-held { duration: Motion.highlight; easing: ease-out; }

    /// How far in the surface the keys are steering is, in the order the
    /// key handler asks.
    property <float> ring-host-shown: root.panel-open ? root.panel-shown-of(root.open-panel)
        : root.centre-up ? end-pill.shown
        : root.corner-offered ? corner.shown
        : way-in.shown;

    /// Where that surface's glass is, top and height, for the pane to be cut
    /// to (see `GlassRect.host-y`).
    property <length> ring-host-y: root.panel-open ? root.panel-bounds.y
        : root.centre-up ? end-pill.bounds.y
        : root.corner-offered ? corner.bounds.y
        : way-in.bounds.y;

    property <length> ring-host-h: root.panel-open ? root.panel-h
        : root.centre-up ? end-pill.bounds.height
        : root.corner-offered ? corner.bounds.height
        : way-in.bounds.height;

    // --- the key handler ---------------------------------------------------------
    keys := FocusScope {
        // The chrome is woken after the key is handled, since the handler
        // says how far (`key-wake`).
        key-pressed(event) => {
            Chrome.input-seq += 1;
            root.key-wake = KeyWake.wake;
            // A letter under Ctrl or the system key is another program's
            // shortcut, or the desktop's (copy, paste, select all), and not
            // the player's letter, so only Ctrl+O is taken. Windows sends
            // AltGr as Ctrl+Alt, which types a letter as plainly as Shift does.
            if (((event.modifiers.control && !event.modifiers.alt) || event.modifiers.meta)
                    && event.text.to-lowercase() != event.text.to-uppercase()) {
                let taken = root.on-open(event.text, event.modifiers.control,
                    event.modifiers.shift);
                root.after-key(event.text);
                return taken ? EventResult.accept : EventResult.reject;
            }
            // The film's own keys only with a film, or they would flash over
            // the way in and change a volume nothing shows.
            if (root.on-bar(event.text, event.modifiers.shift)
                || root.on-focus(event.text, event.modifiers.shift, event.modifiers.control)
                || root.on-open(event.text, event.modifiers.control, event.modifiers.shift)
                || (root.has-file
                    && (root.on-playback(event.text, event.modifiers.shift)
                        || root.on-seek(event.text, event.modifiers.control, event.modifiers.shift)
                        || root.on-pace(event.text)
                        || root.on-volume(event.text)
                        || root.on-subtitles(event.text, event.modifiers.shift)))
                || root.on-window(event.text, event.modifiers.shift)) {
                root.after-key(event.text);
                return EventResult.accept;
            }
            root.after-key(event.text);
            return EventResult.reject;
        }
    }

    // --- the pointer over the picture --------------------------------------------
    /// How far a hidden pointer must travel within `twitch-timer` to count.
    /// A knocked desk or a mouse set down moves it a few pixels, and in a
    /// dark room that is nobody asking for anything.
    property <length> twitch: 12px;

    /// Where that is measured from: the first move after it was hidden.
    property <length> twitch-x: 0px;
    property <length> twitch-y: 0px;
    property <bool> twitch-armed: false;

    twitch-timer := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            twitch-timer.stop();
            root.twitch-armed = false;
        }
    }

    /// How long a pointer may be out of the window before the chrome goes
    /// with it. Reaching for an edge to resize the window overshoots it, and
    /// that is nobody leaving.
    property <duration> leave-grace: 500ms;

    leave-timer := Timer {
        interval: root.leave-grace;
        running: false;
        triggered => {
            leave-timer.stop();
            if (video-surface.away && Chrome.input-seq == video-surface.seen) {
                Chrome.rest();
            }
        }
    }

    /// The pointer over the picture. A press always counts, and so does a
    /// pointer coming back into the window: no knock carries it in.
    function film-pointed(down: bool, entering: bool, x: length, y: length) {
        if (!down && !entering && root.pointer-hidden) {
            if (!root.twitch-armed) {
                root.twitch-x = x;
                root.twitch-y = y;
                root.twitch-armed = true;
                twitch-timer.start();
                return;
            }
            if (Math.sqrt(Math.pow((x - root.twitch-x) / 1px, 2)
                    + Math.pow((y - root.twitch-y) / 1px, 2)) < root.twitch / 1px) {
                return;
            }
        }
        root.twitch-armed = false;
        twitch-timer.stop();
        Chrome.pointed(down);
    }

    // Video, ambient border and glass, already composited by the pipeline.
    Image {
        source: root.video-frame;
        source-clip-x: 0;
        source-clip-y: 0;
        source-clip-width: root.video-clip-w;
        source-clip-height: root.video-clip-h;
        width: 100%;
        height: 100%;
        image-fit: fill;
    }

    // Dragging the picture moves the window, which has no title bar to take
    // hold of. A press that doesn't travel is still a click on the film.
    WindowMoveArea {
        enabled: !root.fullscreen;

        // Under the chrome, so buttons take clicks first. It doesn't hide the
        // cursor, because a `mouse-cursor` binding is only read while a mouse
        // event is routed, never when the pointer should go (see
        // `pointer-hidden`).
        video-surface := TouchArea {
            /// `Chrome.input-seq` as of this area's last pointer event.
            property <int> seen: -1;
            /// Whether the pointer has left the window since it was last here.
            property <bool> away: false;

            width: 100%;
            height: 100%;
            pointer-event(event) => {
                if (self.away) {
                    leave-timer.stop();
                }
                root.film-pointed(event.kind == PointerEventKind.down, self.away,
                    self.mouse-x, self.mouse-y);
                self.away = false;
                self.seen = Chrome.input-seq;
            }
            // A pointer leaving the picture for somewhere in the window lands
            // on chrome, which counts its arrival as input in the same event.
            // With nothing counted, it left the window, and the chrome goes
            // with it if it stays away (`leave-grace`) rather than waiting out
            // the clock.
            changed has-hover => {
                if (!self.has-hover && Chrome.input-seq == self.seen) {
                    self.away = true;
                    leave-timer.start();
                }
            }
            clicked => {
                // A click away from an open panel closes it, as a desktop menu
                // does, rather than pausing the film under it.
                if (root.panel-open) {
                    root.close-panel();
                } else {
                    root.video-clicked();
                }
            }
            // In or out of fullscreen, so the chrome goes, as for F.
            double-clicked => {
                root.video-double-clicked();
                root.put-away();
                Chrome.settling = true;
            }
            // The wheel over the picture only wakes the bar: a brushed wheel or
            // a touchpad shouldn't change the volume, which has its own track.
            // Accepted so this area keeps its hover.
            scroll-event(event) => {
                Chrome.bump();
                return EventResult.accept;
            }
        }
    }

    // --- the surfaces ------------------------------------------------------------
    //
    // Over the film in the order they are drawn, each in its own file.
    menu := SubtitlesMenu {
        open: root.menu-open;
        warming: root.warming == Panel.subtitles;
        anchor: bar.subs-anchor;
        room: root.width;
        floor: bar.top;
        resizing: root.resizing;
        ring-row <=> root.focus-row;
        find-open <=> root.find-open;
        account-open <=> root.account-open;
        asked-row <=> root.asked-row;
        hint-claim <=> root.hint-claim;
        fields-left => {
            keys.focus();
        }
        // Escape goes back a page, as everywhere; Enter is the row's own
        // press, even with the ring away, since a field was typed into; the
        // rest walk the ring, which a key from a field brings up.
        account-key(event) => {
        if (event.text == Key.Escape) {
            return root.page-back();
        }
        if (event.text == Key.Return) {
            return root.focus-activate();
        }
        Chrome.focus-visible = true;
        if (event.text == Key.Backtab) {
            return root.on-focus(Key.Tab, true, false);
        }
        return root.on-focus(event.text, event.modifiers.shift,
            event.modifiers.control);
        }
    }

    settings := SettingsPanel {
        open: root.settings-open;
        warming: root.warming == Panel.settings;
        anchor: bar.settings-anchor;
        room: root.width;
        floor: bar.top;
        resizing: root.resizing;
        drop-supported: root.drop-supported;
        ring-row <=> root.focus-row;
        page <=> root.settings-page;
        asked-row <=> root.asked-row;
        hint-claim <=> root.hint-claim;
    }

    // The audio tracks, a panel of their own beside the subtitles' menu.
    audio-panel := AudioPanel {
        open: root.audio-open;
        warming: root.warming == Panel.audio;
        anchor: bar.audio-anchor;
        room: root.width;
        floor: bar.top;
        ring-row <=> root.focus-row;
    }

    files-panel := FilesPanel {
        open: root.files-open;
        warming: root.warming == Panel.files;
        anchor: bar.files-anchor;
        room: root.width;
        floor: bar.top;
        ring-row: root.focus-row;
        chosen => {
            root.close-panel();
        }
    }

    // Playlist: its own panel, since it is the one list that grows without
    // bound, and it has a setting of its own.
    playlist-panel := PlaylistPanel {
        open: root.playlist-open;
        warming: root.warming == Panel.playlist;
        anchor: bar.playlist-anchor;
        room: root.width;
        floor: bar.top;
        resizing: root.resizing;
        ring-row <=> root.focus-row;
        page <=> root.playlist-page;
    }

    // The bar is one pane of glass: the timeline row over a row of buttons in
    // three groups of what belongs together.
    bar := ControlBar {
        width: 100%;
        height: 100%;
        controls-visible: root.controls-visible;
        timeline-glimpse: root.timeline-glimpse;
        title-glimpse: root.title-glimpse;
        fullscreen: root.fullscreen;
        subtitles-showing: menu.showing;
        open-panel: root.open-panel;
        ring-at: root.bar-focus;
        reach: root.bar-reach;
        pill-stop: root.pill-stop;
        toggled(panel) => {
            root.toggle-panel(panel);
        }
        toggle-fullscreen => {
            root.toggle-fullscreen();
        }
    }

    way-in := WayIn {
        width: 100%;
        height: 100%;
        open: !root.has-file && !root.settings-open;
        ring-row: root.focus-row;
        fatal: root.fatal;
        fatal-detail: root.fatal-detail;
        fatal-note: root.fatal-note;
        backdrop: root.backdrop;
        drop-supported: root.drop-supported;
        settings-asked => {
            root.open-settings(true);
        }
        shortcuts-asked => {
            root.open-settings-page(SettingsPage.shortcuts);
        }
        quit => {
            root.quit();
        }
    }

    flash := ActionFlash {
        width: 100%;
        height: 100%;
        open-panel: root.open-panel;
        asked-row: root.asked-row;
        beside-bounds: root.bounds-of(self.beside);
        floor: bar.top;
        widest: bar.rows-w;
        has-file: root.has-file;
        way-in-foot: way-in.bounds.y + way-in.bounds.height;
    }

    end-pill := EndPill {
        width: 100%;
        height: 100%;
        ring-at: root.centre-up && root.bar-reach ? root.bar-focus - root.pill-stop : -1;
        floor: bar.top;
        widest: bar.rows-w;
        panel-open: root.panel-open;
        panel-x: root.panel-x;
        panel-w: root.panel-w;
        panel-h: root.panel-h;
        preview-open: preview.open;
        preview: preview.bounds;
        resizing: root.resizing;
    }

    corner := CornerPill {
        width: 100%;
        height: 100%;
        ring-at: !root.centre-up && root.bar-reach ? root.bar-focus - root.pill-stop : -1;
        fatal: root.fatal;
        panel-open: root.panel-open;
        widest: bar.right-w;
        raised: bar.pill-raise;
        raised-floor: bar.edge;
        preview-open: preview.open;
        preview: preview.bounds;
    }

    // --- the hover label ---------------------------------------------------------
    //
    // Declared after the bar so it draws over it, should a narrow window ever
    // make the two meet.
    tip := HoverTip {
        width: 100%;
        height: 100%;
        panel-open: root.panel-open;
        buttons-shown: bar.pills-shown;
        floor: bar.top;
        widest: bar.rows-w;
        pill-up: root.corner-offered;
        pill-x: corner.bounds.x;
        pill-h: Bar.pill-h;
    }

    // The seek preview. Declared after the track so it draws over the bar.
    preview := SeekPreview {
        width: 100%;
        height: 100%;
        pointed: bar.scrub-pointed;
        pointer-x: bar.scrub-pointer-x;
        track-x: bar.scrub-x;
        track-w: bar.scrub-w;
        bar-up: root.controls-visible;
        floor: bar.top;
        panel-open: root.panel-open;
        panel-x: root.panel-x;
        panel-w: root.panel-w;
    }

    // --- the window's own buttons ------------------------------------------------
    window-buttons := WindowButtons {
        width: 100%;
        height: 100%;
        up: root.controls-visible || !root.has-file;
        fullscreen: root.fullscreen;
        maximized <=> root.maximized;
        floor: bar.top;
        panel-open: root.panel-open;
        panel-x: root.panel-x;
        panel-w: root.panel-w;
        panel-h: root.panel-h;
        minimize => {
            root.minimize();
        }
        quit => {
            root.quit();
        }
    }
}

// The structs the Rust side fills in and the interface draws from: the
// glass each surface asks for, and the rows of the settings, track and
// playlist panels.

/// A surface the pipeline draws glass beneath. Lengths are logical pixels;
/// the Rust side scales them by the window's scale factor.
export struct GlassRect {
    x: length,
    y: length,
    width: length,
    height: length,
    radius: length,
    /// How much the glass pulls toward its tint colour, 0..1.
    tint: float,
    /// How far the surface has faded in, 0..1. The glass has to fade with
    /// it: full-strength glass under a half-faded surface reads as a hole in
    /// the picture.
    opacity: float,
    /// A pane laid on another, as the disc under the ring lies on its pill.
    /// It casts no shadow, which would fall on the picture past the edge of
    /// the pane beneath, and doesn't reach past that edge itself.
    nested: bool,
    /// Under the keyboard's ring: milk glass, lighter than the glass it lies
    /// on over every frame, with its rim lit hard.
    ring: bool,
    /// Under a bar button whose panel is open: milk glass as the ring's pane
    /// is, a step less milky.
    open: bool,
    /// For the pane under the ring, the top and height of the surface its
    /// row is in, which it is cut to: a page rising into a panel growing to
    /// fit it is partly outside the panel, where the pane would lie on the
    /// bar. Zero high for every other pane.
    host-y: length,
    host-height: length,
}

/// The glyph before a heading's words when the player draws it (see
/// `HeadMark`), by name, since it is drawn from the icon's file.
export enum HeadGlyph {
    none,
    speaking,
    subtitles,
    playlist,
    back,
}

/// A heading over a scrolling list, or a page's way back, for the player to
/// draw over the finished frame once the list's soft edge is done, so the
/// rows can run on under it (see `heads.rs`). Slint lays it out and draws
/// none of what is here. Lengths are logical pixels from the window's
/// top-left.
export struct HeadMark {
    /// The words, in the box their `Text` lays them out in: from its left,
    /// centred down it, and cut with an ellipsis where they run past it.
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
    font-size: length,
    font-weight: int,
    letter-spacing: length,
    color: color,
    /// The glyph before them, a square of `glyph-size` from its top-left.
    glyph: HeadGlyph,
    glyph-x: length,
    glyph-y: length,
    glyph-size: length,
    glyph-color: color,
    /// A way back's wash, with the glass's corner (see `Squircle`).
    /// Transparent for a heading, which has none.
    wash-x: length,
    wash-y: length,
    wash-width: length,
    wash-height: length,
    wash-radius: length,
    wash-color: color,
    /// The surface it is cut to, as the soft edge is, and how much of it is
    /// on: its panel's fade, and nothing for a page that isn't drawn.
    clip-x: length,
    clip-y: length,
    clip-width: length,
    clip-height: length,
    opacity: float,
}

/// A scrolling list, or a line of words too long for its place, for the
/// soft edge the pipeline puts on each end that has content past it (see
/// `fade` on the Rust side). Lengths are logical pixels.
export struct ScrollFade {
    x: length,
    y: length,
    width: length,
    height: length,
    /// How far the list is from its top and its bottom, as a share of the
    /// strip that fades: 0 at rest at that end, 1 once a strip's worth of
    /// rows has gone past it.
    top: float,
    bottom: float,
    /// How much of `height` lies past the list's own top and bottom, where
    /// its view runs on under a heading or to its panel's edge. The strip at
    /// that end is that much deeper, so its inner side stays where the
    /// list's rows begin to go.
    top-reach: length,
    bottom-reach: length,
    /// The same for the right-hand end of a line of words, such as the title
    /// in the bar. Zero for a list.
    right: float,
    /// The panel the list is in, since a list sliding in or out of its panel
    /// is partly outside it, and only the inside is on screen.
    clip-x: length,
    clip-y: length,
    clip-width: length,
    clip-height: length,
    /// The way back to the list's current row while that row is out of sight
    /// (see `WayToCurrent`): how much of it is on, its panel's fade included.
    /// The pipeline draws it after the soft edge, which would otherwise thin
    /// it away with the rows.
    way: float,
    /// Its centre.
    way-x: length,
    way-y: length,
    way-up: bool,
    /// How far its hover circle has come in, 0..1.
    way-lit: float,
}

/// One subtitle OpenSubtitles holds for the film, as a row on the search
/// page.
export struct FoundItem {
    /// The release it was timed against.
    label: string,
    /// Its language, and what sets it apart: timed for this very file, for
    /// the hard of hearing, or machine-made.
    detail: string,
    exact: bool,
}

export struct ParamItem {
    /// The name the setting is saved under (see `settings::registry`), so a
    /// row identifies the parameter itself rather than its place in the
    /// registry.
    key: string,
    label: string,
    /// What it does, shown beside the panel when the row is rested on;
    /// empty where the name says it.
    hint: string,
    /// Normalised 0..1, so the slider needs no knowledge of the real range.
    fraction: float,
    /// Where none of it is, 0..1: 0 for most, the middle for a value either
    /// side of nothing, which the fill grows out from.
    origin: float,
    /// Formatted for display by the Rust side, which owns the range.
    readout: string,
}

export struct TrackItem {
    id: int,
    label: string,
    selected: bool,
    /// Loaded from its own file rather than carried in the film's: fetched,
    /// dropped, or found beside it. Only these can be removed.
    external: bool,
}

export struct PlaylistItem {
    /// Its place in mpv's playlist, or -1 for a file in a season beside the
    /// list rather than in it.
    index: int,
    /// Where it is, for opening a file that is not in the list.
    path: string,
    label: string,
    current: bool,
    /// How long this file is, already formatted. Empty for a file the player
    /// has never opened.
    length: string,
    /// How far through it the resume point sits, 0..1. Zero for a file that
    /// was never started, and for one that was finished.
    progress: float,
    /// Watched to its end or into its credits, and not started again since.
    /// `progress` is zero for both, so this is what tells a finished episode
    /// from one never started.
    finished: bool,
    /// Why it failed to play during this run, as the notice said it; empty
    /// for a file that played or hasn't been tried.
    why: string,
    /// Its row draws the resume measure: something started, or something
    /// done, and nothing failed. Decided with the names that size the panel
    /// (see `PlaylistGroup.measured-names`), so the two can't disagree.
    measured: bool,
}

/// A film the way in offers to pick back up: its name, and where it was left.
export struct ResumeItem {
    path: string,
    /// The show, for an episode; empty for a film, whose own name is the title.
    show: string,
    title: string,
    /// How far through it the saved place sits, 0..1.
    progress: float,
    /// How much is left, already worded: "43 min left".
    left: string,
}

/// One part of a playlist, as the panel shows it (see `playlist-groups`).
export struct PlaylistGroup {
    /// How its row names it: Season 7, Specials, a show's name and season.
    label: string,
    /// How its page's way back names it: SEASON 7, or a show's name in its
    /// own case, which `titular` marks.
    heading: string,
    titular: bool,
    /// How many files, already worded: "10 episodes".
    detail: string,
    /// It holds the file playing.
    current: bool,
    /// A single file, listed among the parts as itself.
    leaf: bool,
    /// The row its page opens on: the file playing, or the first unfinished.
    open-row: int,
    entries: [PlaylistItem],
    /// Its files' names, one to a line, for the measures that size the panel
    /// to its page (see `PlaylistPanel.panel-w`). Those whose rows draw a resume measure
    /// come apart, since it takes room from the name.
    names: string,
    measured-names: string,
}

/// Which way a step goes: forward, as most keys mean, or back.
export enum Way {
    forward,
    back,
}

/// Which kind of track a menu or a key means.
export enum Pick {
    subtitles,
    audio,
}

/// What the arrival pill was answered: stay on the saved place, or start the
/// file over.
export enum ArrivalAnswer {
    saved,
    beginning,
}

// Opening: two rows, so it stays a menu rather than a mode. The button says
// what it is for, and the rows say what the difference is.

import { Playlist } from "playlist.slint";
import { ShortcutRow } from "rows.slint";
import { GlassPanel } from "panel.slint";
import { Measure } from "measure.slint";
import { Rows, Type } from "theme.slint";

export component FilesPanel inherits GlassPanel {
    /// The row the keyboard's ring is on, which every panel shares.
    in property <int> ring-row;
    /// A row was chosen, which closes the panel ahead of the dialog.
    callback chosen();

    out property <int> rows: 2;

    /// Press a row: a file for the first, a folder for the second.
    public function activate(row: int) {
        root.chosen();
        Playlist.request-open(row != 0);
    }

    property <string> file-label: @tr("Open file…");
    property <string> file-keys: @tr("Ctrl+O");
    property <string> folder-label: @tr("Open folder…");
    property <string> folder-keys: @tr("Ctrl+Shift+O");

    /// As wide as its rows' words and keys ask, which in some languages is
    /// wider than in English, and never narrower than in English. 12px is
    /// the row's own gap between the two.
    width: max(260px, Rows.label-x + labels.preferred-width + 12px
        + keys.preferred-width + Rows.trail-x);
    height: root.panel-pad + 2 * root.row-h;

    VerticalLayout {
        padding-top: Rows.panel-pad;
        padding-bottom: Rows.panel-pad;

        ShortcutRow {
            label: root.file-label;
            shortcut: root.file-keys;
            focused: root.open && root.ring-row == 0;
            picked => {
                root.activate(0);
            }
        }
        ShortcutRow {
            label: root.folder-label;
            shortcut: root.folder-keys;
            focused: root.open && root.ring-row == 1;
            picked => {
                root.activate(1);
            }
        }
    }

    labels := Measure {
        text: root.file-label + "\n" + root.folder-label;
        font-size: Type.body;
    }
    keys := Measure {
        text: root.file-keys + "\n" + root.folder-keys;
        font-size: Type.readout;
    }
}

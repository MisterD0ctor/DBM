// The rows panels are made of, and the two marks they share: the wash under
// a hovered or focused row, and the bar beside the current one. Each row
// fills its panel's width and insets its own wash, so the rows at the ends of
// a list are no special case (see `Rows`).

import { Chrome, Flash, Tip } from "globals.slint";
import { Icons, Motion, Paint, Rails, Rows, Type } from "theme.slint";
import { Glyph, Shade, StepButton, SwitchMark } from "controls.slint";
import { HeadGlyph, HeadMark, ResumeItem } from "models.slint";
import { RingPane } from "ring.slint";
import { Squircle } from "squircle.slint";

/// The mark beside the current row: the subtitle track in use, the episode
/// playing.
///
/// A shape, because weight and alpha alone are close to invisible over moving
/// video in a list of names that differ by two characters. It sits inside the
/// wash, so a row that is both current and focused wears both marks without
/// them touching.
export component ActiveMark inherits Rectangle {
    in property <bool> on;
    /// The keyboard's ring is on the row, so the mark stands on milk glass.
    in property <bool> ring;

    width: 100%;
    height: 100%;

    mark := Rectangle {
        x: Rows.gap + 4px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 14px;
        border-radius: self.width / 2;
        background: root.ring ? Paint.on-ring : Paint.lit;
        opacity: root.on ? 1.0 : 0.0;
        animate opacity { duration: Motion.highlight; easing: ease-out; }
    }
}

/// The wash behind a hovered or focused row. It fills the row and insets
/// itself, so the row only says why it is lit.
///
/// Under the ring there is a pane of milk glass of its own instead (see
/// `Ring`), and the ring's wash only where there is no glass.
export component RowHighlight inherits Rectangle {
    in property <bool> hovered;
    in property <bool> ring;
    /// The wash is drawn by the player instead (see `BackRow.lifted`).
    in property <bool> lifted;
    /// The wash's colour as it eases, for the player to draw it in.
    out property <color> wash: wash.fill;

    width: 100%;
    height: 100%;

    // Full row height, so adjacent washes meet without a seam and the end
    // ones sit `gap` from the panel edge, which is the panel's padding.
    //
    // At the row's own radius rather than the panel's corner moved in by the
    // gap: a row is too short for that corner's long ease, and its ends came
    // out drawn out. The gap to the panel narrows by under a pixel at the
    // corner instead.
    wash := Squircle {
        x: Rows.gap;
        width: parent.width - 2 * Rows.gap;
        radius: Rows.radius;
        fill: root.ring ? (Paint.glass ? transparent : Paint.wash-ring)
            : root.hovered ? Paint.wash-soft : transparent;
        animate fill { duration: Motion.highlight; easing: ease-out; }
        visible: !root.lifted && self.fill.alpha > 0;
    }

    RingPane {
        x: Rows.gap;
        width: parent.width - 2 * Rows.gap;
        radius: Rows.radius;
        on: root.ring;
    }
}

/// One selectable line in a panel. It has no background, because the glass
/// under it comes from the pipeline; only the wash is drawn on top.
export component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    /// Whether the keyboard is on this row.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    /// What the row does, drawn before the words. For an action among rows
    /// that carry icons, like a settings page's reset under its sliders, so
    /// it keeps their column of marks. A choice in a list has none: its mark
    /// is the one that says it is chosen.
    in property <image> icon;
    private property <bool> iconic: root.icon.width > 0;
    /// A track loaded from its own file, which can be removed. The row ends
    /// in a button for it (see `removed`).
    in property <bool> removable;
    /// The button has been pressed once, and the next press removes the
    /// track. The row asks beside the button rather than in place of the
    /// name, which is what says which track the press would take.
    in property <bool> armed;
    /// How long it waits for that press, for the wash behind the question
    /// to drain over.
    in property <duration> armed-for;
    /// What it does, for the window to say beside the panel once the row has
    /// been rested on as long as a tip waits; empty for most rows.
    in property <string> hint;
    callback picked();
    callback removed();
    /// The question is being read: the pointer or the ring is on its row, so
    /// the wait for the second press holds until they leave.
    callback held(bool);
    /// The row has been rested on long enough for its hint, or left.
    callback explained(bool);

    height: Rows.row;

    private property <bool> dwelt: root.hint != "" && Tip.enabled
        && (touch.has-hover || root.ring);
    private property <bool> said;
    changed dwelt => {
        if (!root.dwelt && root.said) {
            root.said = false;
            root.explained(false);
        }
    }
    Timer {
        interval: Motion.tip-delay;
        running: root.dwelt && !root.said;
        triggered => {
            root.said = true;
            root.explained(true);
        }
    }

    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-label: root.label;
    accessible-action-default => {
        root.picked();
    }

    RowHighlight {
        hovered: touch.has-hover;
        ring: root.ring;
    }

    ActiveMark {
        on: root.active;
        ring: root.ring;
    }

    // Placed and spaced like a stepper's icon, so the marks and the labels
    // down a page each stay in one column.
    if root.iconic: Glyph {
        source: root.icon;
        x: Rows.label-x;
        y: (parent.height - self.height) / 2;
        width: Icons.row;
        height: Icons.row;
        shade: root.ring ? Shade.on-ring : Shade.lit;
    }

    Text {
        x: Rows.label-x + (root.iconic ? Icons.row + Rows.dense-gap : 0px);
        width: (root.armed ? root.ask-x - 8px
            : parent.width - Rows.trail-x - (root.removable ? root.bin + Rows.group-gap : 0px))
            - self.x;
        height: 100%;
        text: root.label;
        color: root.ring ? Paint.on-ring : root.active ? Paint.lit : Paint.body;
        font-size: Type.body;
        font-weight: root.active ? Type.weight-current : Type.weight-plain;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.picked();
        }
    }

    // The remove button, at the trailing edge where a drill row keeps its
    // chevron. It sits over the row's own press, so a click removes the track
    // without choosing it first; Delete does the same from the keyboard. Each
    // takes two presses (see `armed`), since a downloaded file goes with it.
    //
    // It takes clicks over the row's full height from just before the disc,
    // because a click just off the disc would choose the track instead, the
    // one miss that does the opposite.
    private property <length> bin: Rows.bin;
    private property <length> bin-x: root.width - Rows.trail-x - root.bin + 6px;
    /// How far before the disc, or before the question while it asks, the
    /// button begins: its press, and the capsule the question stands on.
    private property <length> bin-lead: 12px;

    // While armed, the question stands on a capsule that drains towards the
    // button as the wait runs out, so how long the row will go on asking is
    // in sight. It stays full while it is being read, and with animations
    // off.
    private property <length> ask-x: root.bin-x - question.width - root.bin-lead;
    private property <bool> bin-hovered;
    private property <bool> hold: root.armed
        && (touch.has-hover || root.bin-hovered || root.ring);
    changed hold => {
        root.held(root.hold);
    }
    private property <bool> draining: root.armed && !root.hold && Motion.enabled;
    // Set rather than bound, since nothing reads a bound one until the row is
    // armed, and an animation needs the value it starts from.
    private property <float> asking: 1;
    animate asking { duration: root.draining ? root.armed-for : 0ms; }
    changed draining => {
        root.asking = root.draining ? 0 : 1;
    }
    if root.armed: Rectangle {
        private property <length> full: root.bin-x + root.bin - root.ask-x;
        x: root.bin-x + root.bin - self.width;
        y: (parent.height - self.height) / 2;
        width: max(0px, self.full * root.asking);
        height: root.bin;
        border-radius: min(self.width, self.height) / 2;
        background: root.ring ? Paint.on-ring-wash : Paint.wash-strong;
    }
    question := Text {
        x: root.bin-x - self.width;
        height: 100%;
        visible: root.armed;
        text: @tr("Remove?");
        color: root.ring ? Paint.on-ring : Paint.lit;
        font-size: Type.readout;
        vertical-alignment: center;
    }

    if root.removable: Rectangle {
        // The question is part of the button while it asks, as a press on
        // the word is a press meant for it.
        x: root.armed ? root.ask-x : root.bin-x - root.bin-lead;
        width: parent.width - self.x;
        height: parent.height;

        accessible-role: button;
        accessible-label: root.armed ? @tr("Press again to remove") : @tr("Remove");
        accessible-action-default => {
            root.removed();
        }

        Rectangle {
            x: root.bin-x - parent.x;
            y: (parent.height - self.height) / 2;
            width: root.bin;
            height: root.bin;
            border-radius: self.width / 2;
            // The capsule is the wash while it asks.
            background: !bin-touch.has-hover || root.armed ? transparent
                : root.ring ? Paint.on-ring-wash : Paint.wash-strong;
            animate background { duration: Motion.highlight; easing: ease-out; }

            Glyph {
                source: root.armed ? @image-url("../../../public/icons/warning.svg")
                    : @image-url("../../../public/icons/trash.svg");
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: Icons.row;
                height: Icons.row;
                shade: root.ring ? Shade.on-ring : Shade.lit;
            }
        }

        bin-touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                Chrome.pointed-at(event.kind == PointerEventKind.down,
                    event.kind == PointerEventKind.move, root.focused);
            }
            clicked => {
                root.removed();
            }
            changed has-hover => {
                root.bin-hovered = self.has-hover;
            }
        }
    }
}

/// One subtitle a search found: the release it was timed against, and beside
/// it, smaller, its language and what sets it apart. While it is being
/// fetched, the second column says so instead.
export component FoundRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    /// Being fetched now.
    in property <bool> busy;
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    callback picked();

    height: Rows.row;

    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.detail;
    accessible-action-default => {
        root.picked();
    }

    RowHighlight {
        hovered: touch.has-hover;
        ring: root.ring;
    }

    ActiveMark {
        on: root.busy;
        ring: root.ring;
    }

    // The detail takes what it needs and the release name the rest, because
    // the name is what runs long and the detail is what tells two apart.
    HorizontalLayout {
        padding-left: Rows.label-x;
        padding-right: Rows.trail-x;
        spacing: Rows.group-gap;

        Text {
            text: root.label;
            color: root.ring ? Paint.on-ring : root.busy ? Paint.lit : Paint.body;
            font-size: Type.body;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            horizontal-stretch: 1;
        }

        Text {
            text: root.busy ? @tr("Downloading…") : root.detail;
            color: root.ring ? Paint.on-ring : Paint.body;
            font-size: Type.readout;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 0;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.picked();
        }
    }
}

/// A playlist line: what it is, how long it is, and how far into it you got.
///
/// Its own component rather than an option on `MenuRow`, because the label
/// has to make room for the time and the measure, and every menu row would
/// otherwise carry that arithmetic.
export component PlaylistRow inherits Rectangle {
    /// Whether the keyboard is on this row.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <string> label;
    in property <string> length;
    in property <float> progress;
    in property <bool> active;
    /// Why it failed to play, as the notice said it; empty for a file that
    /// played or hasn't been tried. The row shows the warning where its
    /// running time goes, and keeps it after the notice has gone.
    in property <string> why;
    private property <bool> failed: root.why != "";
    in property <bool> finished;
    /// Whether the measure is drawn (see `PlaylistItem.measured`).
    in property <bool> measured;
    /// The running time's column, at least as wide as an hour-long time. A
    /// column sized to each row's own time would step the measures in and out
    /// with the digits, a zigzag down a season.
    private property <length> time-col: max(Rows.time-col, time.width);
    /// Where the row's trailing column ends: further in on a page whose
    /// other rows carry a chevron, so the time and the measure line up with
    /// theirs.
    in property <length> trail: Rows.trail-x;
    callback picked();

    height: Rows.row;

    accessible-role: button;
    accessible-checkable: true;
    accessible-checked: root.active;
    accessible-label: root.failed ? @tr("{}, could not play", root.label)
        : root.finished ? @tr("{}, watched", root.label) : root.label;
    accessible-action-default => {
        root.picked();
    }

    RowHighlight {
        hovered: touch.has-hover;
        ring: root.ring;
    }

    ActiveMark {
        on: root.active;
        ring: root.ring;
    }

    Text {
        x: Rows.label-x;
        // Clear of the time on the trailing edge, so a long title elides
        // rather than running underneath it.
        width: parent.width - Rows.label-x - root.trail - root.time-col
            - Rows.group-gap - (root.measured ? Rows.measure + Rows.group-gap : 0);
        height: 100%;
        text: root.label;
        color: root.ring ? Paint.on-ring : root.active ? Paint.lit : Paint.body;
        font-size: Type.body;
        font-weight: root.active ? Type.weight-current : Type.weight-plain;
        vertical-alignment: center;
        overflow: elide;
    }

    // Right-aligned, so a column of them reads as a column.
    time := Text {
        x: parent.width - root.trail - self.width;
        height: 100%;
        text: root.failed ? "" : root.length;
        // Lit under the ring, as the name is. The same in every row with a
        // figure.
        color: root.ring ? Paint.on-ring : Paint.body;
        font-size: Type.readout;
        vertical-alignment: center;
    }

    // The warning in the time's place. Why the file wouldn't play was said
    // when it failed, and words here would take width from the title, so it
    // is said again beside the panel once the pointer or the ring has rested
    // on the row as long as a tip waits: once each time it comes, so passing
    // down the list raises nothing.
    private property <bool> dwelt: root.failed && (touch.has-hover || root.ring);
    private property <bool> said;
    changed dwelt => {
        if (!root.dwelt) {
            root.said = false;
        }
    }
    Timer {
        interval: Motion.tip-delay;
        running: root.dwelt && !root.said;
        triggered => {
            root.said = true;
            Flash.warn(root.why);
        }
    }

    Glyph {
        source: @image-url("../../../public/icons/warning.svg");
        visible: root.failed;
        x: parent.width - root.trail - self.width;
        y: (parent.height - self.height) / 2;
        width: Icons.row;
        height: Icons.row;
        shade: root.ring ? Shade.on-ring : Shade.lit;
    }

    // How far into it you got. A hairline rather than a bar, since it is
    // something the row knows, not a control. The unfilled part stays
    // visible, because that is what makes it a measure: a lone bright
    // segment only says that something happened.
    //
    // Beside the running time on the row's own line, because under the
    // title it read as a divider at the column's width, or as an underline
    // at the words' width.
    Rectangle {
        x: parent.width - root.trail - root.time-col - Rows.group-gap - Rows.measure;
        y: (parent.height - self.height) / 2;
        width: Rows.measure;
        height: Rails.measure;
        visible: root.measured;
        background: root.ring ? Paint.on-ring-rail : Paint.rail;
        border-radius: self.height / 2;

        Rectangle {
            x: 0;
            // Never a sliver, since a file barely started still has to show
            // it was started. Full when finished, since a position left in
            // the credits is no reason to draw it short.
            width: root.finished ? parent.width
                : max(self.height, parent.width * root.progress);
            height: 100%;
            background: root.ring ? Paint.on-ring : Paint.strong;
            border-radius: parent.border-radius;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.picked();
        }
    }
}

/// One part of a playlist made of several: a season, or one show's files in
/// a folder that holds several.
///
/// A drill row with a count of its files. The figure stands in the running
/// times' column and the chevron in its own, which the file rows on the same
/// page leave empty so the columns line up. It has no watched measure: the
/// page it opens says that better.
export component GroupRow inherits Rectangle {
    /// Under the pointer its glyph leans the way it goes (`Rows.lean`).
    private property <length> lean: touch.has-hover ? Rows.lean : 0px;
    animate lean { duration: Motion.lean; easing: ease-out; }

    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <string> label;
    /// "10 episodes".
    in property <string> detail;
    /// It holds the file playing.
    in property <bool> active;
    /// Where the figure's column ends: clear of the chevron by a drill row's
    /// spacing. A file row beside this one is given the same end.
    private property <length> column-end: root.width - Rows.trail-x - Rows.chevron-col;
    private property <length> time-col: max(Rows.time-col, detail-text.width);
    callback opened();

    height: Rows.row;

    accessible-role: button;
    accessible-label: @tr("{}, {}", root.label, root.detail);
    accessible-action-default => {
        root.opened();
    }

    RowHighlight {
        hovered: touch.has-hover;
        ring: root.ring;
    }

    ActiveMark {
        on: root.active;
        ring: root.ring;
    }

    Text {
        x: Rows.label-x;
        width: root.column-end - root.time-col - Rows.group-gap - self.x;
        height: 100%;
        text: root.label;
        color: root.ring ? Paint.on-ring : root.active ? Paint.lit : Paint.body;
        font-size: Type.body;
        font-weight: root.active ? Type.weight-current : Type.weight-plain;
        vertical-alignment: center;
        overflow: elide;
    }

    detail-text := Text {
        x: root.column-end - self.width;
        height: 100%;
        text: root.detail;
        color: root.ring ? Paint.on-ring : Paint.body;
        font-size: Type.readout;
        vertical-alignment: center;
    }

    Glyph {
        source: @image-url("../../../public/icons/angle-small-right.svg");
        x: parent.width - Rows.trail-x - Icons.row + root.lean;
        y: (parent.height - self.height) / 2;
        width: Icons.row;
        height: Icons.row;
        shade: root.ring ? Shade.on-ring : Shade.lit;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.opened();
        }
    }
}

/// One of the way in's offers to pick up where you stopped: a film left
/// unfinished, and how far into it you got.
///
/// A play mark in front says this row starts something where every other row
/// in the pane opens a dialog. First the show, which says more about what
/// the row is than the episode's number does, or a film's own name; under
/// it the episode and how much is left, so a film and an episode hold their
/// words in the same place.
export component ResumeRow inherits Rectangle {
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <ResumeItem> film;
    callback picked();
    /// The pointer or the ring has come to it, which is when its film
    /// lights the window.
    callback come-to();

    height: Rows.resume-row;

    /// Its two lines, a hint's height each, centred in the row together.
    private property <length> line: Rows.note-line;
    private property <length> top: (root.height - 2 * root.line) / 2;

    private property <bool> come: touch.has-hover || root.ring;
    changed come => {
        if (root.come) {
            root.come-to();
        }
    }

    accessible-role: button;
    accessible-label: @tr("Continue {}", root.film.show == ""
        ? root.film.title : root.film.show + ", " + root.film.title);
    accessible-action-default => {
        root.picked();
    }

    RowHighlight {
        hovered: touch.has-hover;
        ring: root.ring;
    }

    // At the title's weight: it is what the window is most often opened
    // for, and every word is the same white, so weight is what can say so.
    Text {
        x: Rows.label-x;
        y: root.top;
        width: measure.x - Rows.group-gap - self.x;
        height: root.line;
        text: root.film.show == ""
            ? root.film.title : root.film.show;
        color: root.ring ? Paint.on-ring : Paint.strong;
        font-size: Type.body;
        font-weight: Type.weight-title;
        vertical-alignment: center;
        overflow: elide;
    }

    // What is left rather than how long it runs: on an empty window the
    // question is how long finishing takes.
    Text {
        x: Rows.label-x;
        y: root.top + root.line;
        width: parent.width - Rows.trail-x - self.x;
        height: root.line;
        text: root.film.show == ""
            ? root.film.left : root.film.title + " · " + root.film.left;
        color: root.ring ? Paint.on-ring : Paint.body;
        font-size: Type.hint;
        vertical-alignment: center;
        overflow: elide;
    }

    // The same resume measure as a playlist row's, where a row's trailing
    // column ends.
    measure := Rectangle {
        x: parent.width - Rows.trail-x - self.width;
        y: (root.height - self.height) / 2;
        width: Rows.measure;
        height: Rails.measure;
        background: root.ring ? Paint.on-ring-rail : Paint.rail;
        border-radius: self.height / 2;

        Rectangle {
            x: 0;
            width: max(self.height, parent.width * root.film.progress);
            height: 100%;
            background: root.ring ? Paint.on-ring : Paint.strong;
            border-radius: parent.border-radius;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.picked();
        }
    }
}

/// A menu row with its keyboard shortcut on the right, since seeing it there
/// is how a shortcut gets learned.
export component ShortcutRow inherits Rectangle {
    /// Whether the keyboard is on this row.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <string> label;
    in property <string> shortcut;
    /// A row that states a binding rather than performing one. It takes no
    /// pointer and never lights, since a wash would offer a press that does
    /// nothing.
    in property <bool> inert: false;
    callback picked();

    height: Rows.row;

    // Slint requires a constant role, so an inert row says it isn't a button
    // by being a disabled one.
    accessible-role: button;
    accessible-enabled: !root.inert;
    accessible-label: root.shortcut == "" ? root.label
        : @tr("{}, {}", root.label, root.shortcut);
    accessible-action-default => {
        if (!root.inert) {
            root.picked();
        }
    }

    RowHighlight {
        hovered: !root.inert && touch.has-hover;
        ring: !root.inert && root.ring;
    }

    HorizontalLayout {
        padding-left: Rows.label-x;
        padding-right: Rows.trail-x;
        spacing: Rows.keys-gap;

        Text {
            text: root.label;
            font-size: Type.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            color: root.ring && !root.inert ? Paint.on-ring : Paint.body;
        }

        Text {
            text: root.shortcut;
            color: root.ring && !root.inert ? Paint.on-ring : Paint.body;
            font-size: Type.readout;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.inert ? default : pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            if (!root.inert) {
                root.picked();
            }
        }
    }
}

/// A labelled slider. Reports a normalised position; the range lives in the
/// registry on the Rust side.
export component ParamSlider inherits Rectangle {
    /// Whether the keyboard is on this row. Left and right move it.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <string> label;
    in property <image> icon;
    in property <float> fraction;
    /// Where none of it is, 0..1, which the fill grows out from: the start,
    /// or the middle for a value either side of nothing.
    in property <float> origin;
    in property <string> readout;
    /// How wide the name is set: the widest of a page's names, so the tracks
    /// down a page start together whatever the language makes of them.
    in property <length> name-w;
    /// What it does, for the window to say beside the panel once the row has
    /// been rested on as long as a tip waits; empty where the name says it.
    in property <string> hint;
    callback moved(float);
    /// The row has been rested on long enough for its hint, or left.
    callback explained(bool);

    height: Rows.slider-row;

    // As a tip waits on the bar, and only while there are tips: what the
    // glass page's words mean is a tip's question.
    private property <bool> dwelt: root.hint != "" && Tip.enabled
        && (drag.has-hover || root.ring);
    private property <bool> said;
    changed dwelt => {
        if (!root.dwelt && root.said) {
            root.said = false;
            root.explained(false);
        }
    }
    Timer {
        interval: Motion.tip-delay;
        running: root.dwelt && !root.said;
        triggered => {
            root.said = true;
            root.explained(true);
        }
    }

    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.readout;
    accessible-action-increment => {
        root.moved(clamp(root.fraction + 0.01, 0.0, 1.0));
    }
    accessible-action-decrement => {
        root.moved(clamp(root.fraction - 0.01, 0.0, 1.0));
    }

    // No hover wash, because the growing track answers a pointer; the
    // keyboard has nothing like that, so the row lights under the ring.
    RowHighlight {
        ring: root.ring;
    }

    layout := HorizontalLayout {
        spacing: Rows.dense-gap;
        padding-left: Rows.label-x;
        padding-right: Rows.trail-x;

        Rectangle {
            width: Icons.row;

            Glyph {
                source: root.icon;
                width: Icons.row;
                height: Icons.row;
                x: 0;
                y: (parent.height - self.height) / 2;
                shade: root.ring ? Shade.on-ring : Shade.lit;
            }
        }

        name-text := Text {
            width: root.name-w;
            text: root.label;
            color: root.ring ? Paint.on-ring : Paint.body;
            font-size: Type.readout;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;

            rail := Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: drag.has-hover || drag.pressed ? Rails.slider + Rails.grow : Rails.slider;
                border-radius: self.height / 2;
                background: root.ring ? Paint.on-ring-rail : Paint.rail;
                animate height { duration: Motion.track-grow; easing: ease-out; }

                /// A track either side of none keeps a circle the track's
                /// height at none, so the value travels the track less that.
                property <bool> centred: root.origin > 0;
                property <length> travel: self.width - (self.centred ? self.height : 0px);

                // From the start, a capsule never taller than it is long:
                // below the track's height it is a circle as wide as the
                // value, growing out of the rail's tip. At full height, a
                // small value would stand in the rail's round end as a sliver
                // wider than the curve. Under 2px there is nothing to round,
                // and the renderer draws the attempt as a cross, so the
                // smallest are square.
                //
                // From the middle, never smaller than the circle at none,
                // which over a bright frame says where the middle is, and
                // which the least move away stretches into a capsule.
                Rectangle {
                    x: rail.travel * min(root.origin, clamp(root.fraction, 0, 1));
                    y: (parent.height - self.height) / 2;
                    width: rail.travel * abs(clamp(root.fraction, 0, 1) - root.origin)
                        + (rail.centred ? parent.height : 0px);
                    height: min(parent.height, self.width);
                    border-radius: self.height < 2px ? 0px : self.height / 2;
                    background: root.ring ? Paint.on-ring : Paint.fill;
                }
            }

            drag := TouchArea {
                /// The value under the pointer, the fill's round end centred
                /// on it where the track is centred.
                pure function at(x: length) -> float {
                    return (x - (rail.width - rail.travel) / 2) / rail.travel;
                }

                mouse-cursor: pointer;
                pointer-event(event) => {
                    Chrome.pointed-at(event.kind == PointerEventKind.down,
                        event.kind == PointerEventKind.move, root.focused);
                }
                moved => {
                    if (self.pressed) {
                        root.moved(self.at(self.mouse-x));
                    }
                }
                clicked => {
                    root.moved(self.at(self.mouse-x));
                }
            }
        }

        value-text := Text {
            width: 46px;
            text: root.readout;
            color: root.ring ? Paint.on-ring : Paint.body;
            font-size: Type.readout;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

/// A row that is a switch and nothing else. A row that also led somewhere
/// would have two targets with no visible boundary between them.
///
/// It reports the value it wants rather than flipping `checked`, because
/// assigning to a bound property in Slint drops the binding for good, and the
/// switch would stop following changes from a key or from Rust.
export component ToggleRow inherits Rectangle {
    /// Whether the keyboard is on this row.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <string> label;
    in property <bool> checked;
    /// The value the row wants; the owner of the state applies it.
    callback toggled(bool);

    height: Rows.toggle-row;

    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.toggled(!root.checked);
    }

    RowHighlight {
        hovered: switch-touch.has-hover;
        ring: root.ring;
    }

    layout := HorizontalLayout {
        padding-left: Rows.label-x;
        padding-right: Rows.trail-x;
        spacing: 12px;

        Rectangle {
            width: Icons.switch;

            SwitchMark {
                y: (parent.height - self.height) / 2;
                checked: root.checked;
                ring: root.ring;
            }
        }

        // Body, the rows' own step, because a setting about a list is
        // furniture beside it; at Strong the switch under the playlist
        // out-inked the episodes it governs.
        Text {
            text: root.label;
            color: root.ring ? Paint.on-ring : Paint.body;
            font-size: Type.body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

    }

    switch-touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

/// A row that is there only while the switch above it is on, sliding out
/// from underneath that switch rather than appearing, and back under it on
/// the way out. At the panel's own pace, so the rows after it move with the
/// panel's edge instead of jumping.
export component Tucked inherits Rectangle {
    in property <bool> shown;
    /// Its height once out: the row's own.
    in property <length> full: Rows.toggle-row;

    height: root.shown ? root.full : 0px;
    animate height {
        duration: Motion.drill;
        easing: ease-in-out;
    }
    // The part still underneath is cut off at the foot of the row above.
    clip: true;
    // Tucked away, it is out of reach of the pointer and a screen reader.
    visible: self.height > 0;

    Rectangle {
        y: parent.height - root.full;
        height: root.full;

        @children
    }
}

/// A row that leads somewhere: an icon naming the subject, the label, and a
/// chevron. An effect that can be off shows it with its glyph rather than a
/// switch, because a switch beside a chevron is two things to press in one row.
export component DrillRow inherits Rectangle {
    /// Under the pointer its glyph leans the way it goes (`Rows.lean`).
    private property <length> lean: touch.has-hover ? Rows.lean : 0px;
    animate lean { duration: Motion.lean; easing: ease-out; }

    /// Whether the keyboard is on this row.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <image> icon;
    in property <string> label;
    /// Optional: a figure about where it leads, before the chevron, as the
    /// account's row says how many downloads are left.
    in property <string> detail;
    callback opened();

    height: Rows.row;

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        root.opened();
    }

    RowHighlight {
        hovered: touch.has-hover;
        ring: root.ring;
    }

    HorizontalLayout {
        padding-left: Rows.label-x;
        padding-right: Rows.trail-x;
        spacing: Rows.drill-gap;

        Rectangle {
            width: Icons.row;

            Glyph {
                source: root.icon;
                width: Icons.row;
                height: Icons.row;
                x: 0;
                y: (parent.height - self.height) / 2;
                // With the words: the icon names the same subject, so the
                // ring lights the two together.
                shade: root.ring ? Shade.on-ring : Shade.lit;
            }
        }

        Text {
            text: root.label;
            color: root.ring ? Paint.on-ring : Paint.body;
            font-size: Type.body;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            horizontal-stretch: 1;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: root.ring ? Paint.on-ring : Paint.body;
            font-size: Type.readout;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        Rectangle {
            width: Icons.row;

            Glyph {
                source: @image-url("../../../public/icons/angle-small-right.svg");
                width: Icons.row;
                height: Icons.row;
                x: root.lean;
                y: (parent.height - self.height) / 2;
                shade: root.ring ? Shade.on-ring : Shade.lit;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.opened();
        }
    }
}

/// An adjustment read as a number rather than a position, such as a subtitle
/// delay of 0.30 s later, where the useful move is one step at a time. Sliders are
/// for the material parameters, where the eye judges the result.
export component StepperRow inherits Rectangle {
    /// Whether the keyboard is on this row. Left and right step it.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <image> icon;
    in property <string> label;
    in property <string> value;
    /// How wide the value is set, for one that reads wider than a number.
    in property <length> value-w: Rows.stepper-value;
    /// -1 or +1; the caller owns the step size.
    callback stepped(float);

    height: Rows.stepper-row;

    accessible-role: spinbox;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-action-increment => {
        root.stepped(1);
    }
    accessible-action-decrement => {
        root.stepped(-1);
    }

    // As on the sliders: the two buttons light under the pointer, but the
    // keyboard is on the row, not on either of them.
    RowHighlight {
        ring: root.ring;
    }

    layout := HorizontalLayout {
        padding-left: Rows.label-x;
        padding-right: Rows.trail-x;
        spacing: Rows.dense-gap;

        Rectangle {
            width: Icons.row;

            Glyph {
                source: root.icon;
                width: Icons.row;
                height: Icons.row;
                x: 0;
                y: (parent.height - self.height) / 2;
                shade: root.ring ? Shade.on-ring : Shade.lit;
            }
        }

        Text {
            text: root.label;
            color: root.ring ? Paint.on-ring : Paint.body;
            font-size: Type.readout;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            width: Rows.stepper-disc;

            StepButton {
                y: (parent.height - self.height) / 2;
                // U+2212, not a hyphen: it matches the digits either side.
                glyph: "−";
                lit: root.ring;
                clicked => {
                    root.stepped(-1);
                }
            }
        }

        value-text := Text {
            width: root.value-w;
            text: root.value;
            color: root.ring ? Paint.on-ring : Paint.strong;
            font-size: Type.readout;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: Rows.stepper-disc;

            StepButton {
                y: (parent.height - self.height) / 2;
                glyph: "+";
                lit: root.ring;
                clicked => {
                    root.stepped(1);
                }
            }
        }
    }
}

/// The header of a page that has one above it, doubling as the way back,
/// since a title bar is where the eye already is when leaving a page.
export component BackRow inherits Rectangle {
    /// Under the pointer its glyph leans the way it goes (`Rows.lean`).
    private property <length> lean: touch.has-hover ? Rows.lean : 0px;
    animate lean { duration: Motion.lean; easing: ease-out; }

    /// Whether the keyboard is on this row.
    in property <bool> focused;
    private property <bool> ring: root.focused && Chrome.focus-visible;
    in property <string> label;
    /// True when the label is a name, such as a show's over its episodes:
    /// set at `Type.named` with no letter-spacing, as a heading that is one
    /// is (see `MenuHeading.titular`). False for a kicker such as SEASON 7,
    /// at the smaller `Type.label` and tracked. The case is the label's own.
    in property <bool> titular;
    /// Drawn by the player over the finished frame rather than by Slint, so
    /// the list under it can run on under it (see `HeadMark`): its wash,
    /// arrow and words, while the player can (`Chrome.lifts-heads`). Slint
    /// lays it out and keeps its press and its ring's glass, which the
    /// pipeline draws anyway.
    in property <bool> lifted;
    private property <bool> drawn-after: root.lifted && Chrome.lifts-heads;
    /// What the player draws, when it is lifted.
    out property <HeadMark> mark: {
        text: root.label,
        x: words.absolute-position.x,
        y: words.absolute-position.y,
        width: words.width,
        height: words.height,
        font-size: words.font-size,
        font-weight: words.font-weight,
        letter-spacing: words.letter-spacing,
        color: root.ink,
        glyph: HeadGlyph.back,
        glyph-x: arrow.absolute-position.x,
        glyph-y: arrow.absolute-position.y,
        glyph-size: arrow.width,
        glyph-color: root.ring ? Paint.on-ring : Paint.lit,
        wash-x: root.absolute-position.x + Rows.gap,
        wash-y: root.absolute-position.y,
        wash-width: root.width - 2 * Rows.gap,
        wash-height: root.height,
        wash-radius: Rows.radius,
        wash-color: highlight.wash,
        opacity: 1,
    };
    private property <color> ink: root.ring ? Paint.on-ring
        : touch.has-hover ? Paint.lit : Paint.body;
    callback back();

    height: Rows.row;

    accessible-role: button;
    accessible-label: @tr("Back from {}", root.label);
    accessible-action-default => {
        root.back();
    }

    highlight := RowHighlight {
        hovered: touch.has-hover;
        ring: root.ring;
        lifted: root.drawn-after;
    }

    // The arrow is laid out like `DrillRow`'s icon, because a back row is the
    // way out of a page of those, and the two read as one movement only if
    // they match. Hung in the margin, it lined the label up with the headings
    // but pinched the arrow between the panel edge and the first letter.
    layout := HorizontalLayout {
        padding-left: Rows.label-x;
        padding-right: Rows.trail-x;
        spacing: Rows.drill-gap;

        Rectangle {
            width: Icons.row;

            arrow := Glyph {
                source: @image-url("../../../public/icons/angle-small-left.svg");
                width: Icons.row;
                height: Icons.row;
                x: -root.lean;
                y: (parent.height - self.height) / 2;
                shade: root.ring ? Shade.on-ring : Shade.lit;
                visible: !root.drawn-after;
            }
        }

        words := Text {
            text: root.label;
            // Laid out still when lifted, since the player draws the words
            // where this would.
            color: root.drawn-after ? transparent : root.ink;
            font-size: root.titular ? Type.named : Type.label;
            font-weight: Type.weight-plain;
            letter-spacing: root.titular ? 0 : Type.label-track;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            Chrome.pointed-at(event.kind == PointerEventKind.down,
                event.kind == PointerEventKind.move, root.focused);
        }
        clicked => {
            root.back();
        }
    }
}

/// A line that states a fact rather than offering an action. No hover, no
/// hit area: there is nothing here to press.
export component EmptyRow inherits Rectangle {
    in property <string> label;

    height: Rows.row;

    Text {
        x: Rows.label-x;
        width: parent.width - Rows.label-x - Rows.trail-x;
        height: 100%;
        text: root.label;
        color: Paint.body;
        font-size: Type.body;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// Prose about the rows rather than one of them, in the Hint role: why a page
/// opened, or whose the subtitles are. It wraps to the lines its height
/// holds (see `Rows.note-line`) and elides past them.
export component NoteRow inherits Rectangle {
    in property <string> text;

    Text {
        x: Rows.label-x;
        width: parent.width - Rows.label-x - Rows.trail-x;
        height: 100%;
        text: root.text;
        color: Paint.body;
        font-size: Type.hint;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: center;
    }
}

/// A section label, as a box around the text so it can take the panel's
/// width and elide, since a heading can be a show's name of any length.
export component MenuHeading inherits Rectangle {
    in property <string> text;
    /// True when the heading is a name, such as the show a playlist holds:
    /// set at `Type.named` with no letter-spacing, being the person's word
    /// rather than the interface's. False for a kicker such as SUBTITLES, at
    /// the smaller `Type.label` and tracked. The case is the text's own, and
    /// the weight and colour are the same either way.
    in property <bool> titular;
    /// Whether a group already ended above this one, so the heading takes the
    /// group gap above it. Without it, a kicker sits as far from the group it
    /// names as from the one before, and labels neither. The heading owns the
    /// space because the row above doesn't know it is last.
    in property <bool> after-content;
    /// What the section is about, drawn before the words. Optional, because
    /// over rows with icons of their own, as on the settings page, it would
    /// say it twice.
    in property <image> icon;
    /// Drawn by the player over the finished frame rather than by Slint, so
    /// the list under it can run on under its words (see `HeadMark`), while
    /// the player can (`Chrome.lifts-heads`). Slint lays it out and draws
    /// none of it. Its mark is then `glyph`, by name, which Slint draws from
    /// the same file when it draws the heading itself.
    in property <bool> lifted;
    in property <HeadGlyph> glyph;
    private property <bool> drawn-after: root.lifted && Chrome.lifts-heads;
    /// What the player draws, when it is lifted.
    out property <HeadMark> mark: {
        text: root.text,
        x: words.absolute-position.x,
        y: words.absolute-position.y,
        width: words.width,
        height: words.height,
        font-size: words.font-size,
        font-weight: words.font-weight,
        letter-spacing: words.letter-spacing,
        color: Paint.body,
        glyph: root.glyph,
        glyph-x: root.absolute-position.x + root.icon-x,
        glyph-y: root.absolute-position.y + root.icon-y,
        glyph-size: Icons.row,
        glyph-color: Paint.body,
        opacity: 1,
    };
    private property <bool> iconic: root.icon.width > 0 || root.glyph != HeadGlyph.none;
    private property <length> icon-gap: Rows.drill-gap;
    private property <length> icon-x: Rows.label-x;
    private property <length> icon-y: root.height - Rows.heading + (Rows.heading - Icons.row) / 2;

    height: Rows.heading + (root.after-content ? Rows.group-gap : 0px);

    // Where the row labels start, with the words moved over for it, because
    // the margin to the wash's edge can't hold the mark.
    if root.iconic && !root.drawn-after: Image {
        source: root.glyph == HeadGlyph.speaking
            ? @image-url("../../../public/icons/speaking.svg")
            : root.glyph == HeadGlyph.subtitles
            ? @image-url("../../../public/icons/subtitles.svg")
            : root.glyph == HeadGlyph.playlist
            ? @image-url("../../../public/icons/playlist.svg")
            : root.icon;
        x: root.icon-x;
        y: root.icon-y;
        width: Icons.row;
        height: Icons.row;
        image-fit: contain;
        // The heading's own alpha, so the mark and the words are one thing.
        colorize: Paint.body;
    }

    words := Text {
        // Aligned with the row labels below it, not with the panel edge.
        x: Rows.label-x + (root.iconic ? Icons.row + root.icon-gap : 0px);
        width: parent.width - self.x - Rows.trail-x;
        // Held to the bottom, so the gap above stays above.
        y: parent.height - self.height;
        height: Rows.heading;
        text: root.text;
        // Laid out still when lifted, since the player draws the words where
        // this would.
        color: root.drawn-after ? transparent : Paint.body;
        font-size: root.titular ? Type.named : Type.label;
        // The rows' own weight: a kicker is told from its rows by case, size
        // and tracking, and must not out-weigh its own content. A show's name
        // takes the same weight, since both are headings; any heavier, it
        // read as a small copy of the playing row.
        font-weight: Type.weight-plain;
        letter-spacing: root.titular ? 0 : Type.label-track;
        vertical-alignment: center;
        overflow: elide;
    }
}
